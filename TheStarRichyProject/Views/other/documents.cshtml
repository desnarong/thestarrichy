@{
    ViewData["Title"] = "เอกสาร";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
                <i class="bx bx-file fs-4 text-white"></i>
                <h5 class="mb-0 text-white fw-semibold">เอกสาร</h5>
            </div>
            <div class="card-body p-4">
                <div class="table-responsive">
                    <table id="tblDocuments" class="table table-bordered table-hover table-sm nowrap" style="width:100%;font-size:.85rem;">
                        <thead class="text-center" style="background:linear-gradient(135deg,#e3f2fd,#bbdefb);">
                            <tr>
                                <th style="width:5%;">ลำดับ</th>
                                <th style="width:55%;">รายละเอียด</th>
                                <th style="width:40%;">ชื่อไฟล์</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/assets/js/app.js"></script>
    <script>
        $(function(){
            var dt = null;

            function norm(raw){
                var d = raw;
                if(typeof d === 'string'){
                    try { d = JSON.parse(d); } catch(e) { return []; }
                }
                if(d && Array.isArray(d.data)) return d.data;
                if(d && Array.isArray(d.result)) return d.result;
                return Array.isArray(d) ? d : [];
            }

            function esc(s){
                return s == null ? '' : String(s).replace(/&/g,'&').replace(/</g,'<').replace(/>/g,'>').replace(/"/g,'"');
            }

            function loadDocuments(){
                $('#tblDocuments tbody').html('<tr><td colspan="3" class="text-center text-muted py-3"><i class="bx bx-loader bx-spin me-2"></i>กำลังโหลดข้อมูล...</td></tr>');

                $.get('@Url.Action("GetDocuments","other")', function(json){
                    var rows = norm(json);
                    var $tbody = $('#tblDocuments tbody');
                    $tbody.empty();

                    if(rows.length === 0){
                        $tbody.html('<tr><td colspan="3" class="text-center text-muted py-3">ไม่พบข้อมูลเอกสาร</td></tr>');
                        return;
                    }

                    rows.forEach(function(r){
                        var num = esc(r.Num || '');
                        var desc = esc(r.Filedescription || '');
                        var fileName = esc(r.Filelocationname || '');

                        $tbody.append('<tr>' +
                            '<td class="text-center fw-semibold">' + num + '</td>' +
                            '<td>' + desc + '</td>' +
                            '<td>' + fileName + '</td>' +
                        '</tr>');
                    });

                    if(dt) { dt.destroy(); }
                    dt = $('#tblDocuments').DataTable({
                        paging: true,
                        pageLength: 25,
                        lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'ทั้งหมด']],
                        ordering: true,
                        searching: true,
                        destroy: true,
                        language: {
                            emptyTable: 'ไม่พบข้อมูล',
                            zeroRecords: 'ไม่พบข้อมูล',
                            search: 'ค้นหา:',
                            lengthMenu: 'แสดง _MENU_ รายการ',
                            info: '_START_-_END_ จาก _TOTAL_',
                            paginate: { first: '«', last: '»', next: '›', previous: '‹' }
                        }
                    });
                }).fail(function(){
                    $('#tblDocuments tbody').html('<tr><td colspan="3" class="text-center text-danger py-3">เกิดข้อผิดพลาดในการดึงข้อมูล</td></tr>');
                });
            }

            loadDocuments();
        });
    </script>
}
