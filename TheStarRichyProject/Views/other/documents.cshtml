@{
    ViewData["Title"] = "เอกสาร";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
                <i class="bx bx-file fs-4 text-white"></i>
                <h5 class="mb-0 text-white fw-semibold">เอกสาร</h5>
            </div>
            <div class="card-body p-4">
                <!-- begin widget-list -->
                <div class="widget-list widget-list-rounded">
                    <!-- begin widget-list-item -->
                    <a href="#" class="widget-list-item">
                        <div class="widget-list-media">
                            <i class="fas fa-link" style="background-color: var(--vz-warning); color: var(--vz-white);"></i>
                        </div>
                        <div class="widget-list-content">
                            <h4 class="widget-list-title" data-key="t-regulation">1. กฎระเบียบ</h4>
                        </div>
                        <div class="widget-list-action text-nowrap text-muted" data-key="t-off">
                            ปิด
                            <i class="fas fa-angle-right fa-lg ms-2"></i>
                        </div>
                    </a>
                    <!-- end widget-list-item -->
                    <!-- begin widget-list-item -->
                    <a href="#" class="widget-list-item">
                        <div class="widget-list-media">
                            <i class="fas fa-link" style="background-color: var(--vz-warning); color: var(--vz-white);"></i>
                        </div>
                        <div class="widget-list-content">
                            <h4 class="widget-list-title" data-key="t-hold-application">2. ใบสมัคร hold ยอด</h4>
                        </div>
                        <div class="widget-list-action text-nowrap text-muted" data-key="t-hold-application-description">
                            ใบสมัครขอสิทธิ์ซื้อสินค้าเพื่อแจงยอดภายหลัง
                            <i class="fas fa-angle-right fa-lg ms-2"></i>
                        </div>
                    </a>
                    <!-- end widget-list-item -->
                </div>
                <!-- end widget-list -->
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script src="~/assets/js/app.js"></script>
}