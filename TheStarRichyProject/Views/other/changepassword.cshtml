@{
    ViewData["Title"] = "เปลี่ยนรหัสผ่าน";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
.pw-card{max-width:520px;margin:auto;}
.pw-strength{height:5px;border-radius:3px;transition:width .3s,background .3s;background:#e0e0e0;}
.pw-strength .bar{height:100%;border-radius:3px;width:0;transition:width .3s,background .3s;}
.step-badge{width:28px;height:28px;border-radius:50%;display:inline-flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;flex-shrink:0;}
.step-line{width:2px;background:#dee2e6;flex:1;min-height:20px;margin:3px 0;}
.eye-btn{cursor:pointer;color:#888;}
.eye-btn:hover{color:#1565c0;}
</style>

<div class="row justify-content-center mt-2">
  <div class="col-12 pw-card">

    <!-- Page header -->
    <div class="card shadow-sm border-0 mb-3">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1a237e,#1565c0);">
        <i class="bx bx-lock-alt fs-4 text-white"></i>
        <div>
          <h5 class="mb-0 text-white fw-semibold">เปลี่ยนรหัสผ่าน</h5>
          <div style="font-size:.72rem;color:rgba(255,255,255,.75);">Change Password</div>
        </div>
      </div>
    </div>

    <!-- Alert zone -->
    <div id="alertZone" class="d-none mb-3"></div>

    <!-- Steps indicator -->
    <div class="d-flex align-items-center gap-2 mb-3 px-1">
      <div class="d-flex flex-column align-items-center">
        <div id="step1Badge" class="step-badge bg-primary text-white">1</div>
      </div>
      <div class="step-line bg-primary" id="lineA" style="min-height:2px;height:2px;width:100%;"></div>
      <div class="d-flex flex-column align-items-center">
        <div id="step2Badge" class="step-badge bg-secondary text-white">2</div>
      </div>
      <div class="step-line bg-secondary" id="lineB" style="min-height:2px;height:2px;width:100%;"></div>
      <div class="d-flex flex-column align-items-center">
        <div id="step3Badge" class="step-badge bg-secondary text-white"><i class="bx bx-check" style="font-size:.8rem;"></i></div>
      </div>
    </div>
    <div class="d-flex justify-content-between mb-3 px-1">
      <span style="font-size:.68rem;color:#555;">ตรวจสอบรหัสเก่า</span>
      <span style="font-size:.68rem;color:#555;">กำหนดรหัสใหม่</span>
      <span style="font-size:.68rem;color:#555;">สำเร็จ</span>
    </div>

    <!-- ─── Step 1: ตรวจสอบรหัสผ่านเก่า ─── -->
    <div id="step1" class="card shadow-sm border-0 mb-3">
      <div class="card-body p-4">
        <h6 class="fw-semibold mb-3 text-primary"><i class="bx bx-shield-quarter me-2"></i>ขั้นตอนที่ 1 — ยืนยันรหัสผ่านเก่า</h6>
        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:.85rem;">รหัสผ่านเก่า <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text"><i class="bx bx-lock"></i></span>
            <input type="password" class="form-control" id="oldPassword" placeholder="กรอกรหัสผ่านปัจจุบัน" autocomplete="current-password" />
            <span class="input-group-text eye-btn" onclick="togglePw('oldPassword',this)"><i class="bx bx-hide"></i></span>
          </div>
          <div id="oldPwError" class="invalid-feedback d-none" style="font-size:.78rem;"></div>
        </div>
        <div class="d-flex gap-2 justify-content-end">
          <button class="btn btn-primary px-4" id="btnCheckOld">
            <span id="btnCheckOldText"><i class="bx bx-right-arrow-alt me-1"></i>ตรวจสอบ</span>
            <span id="btnCheckOldSpinner" class="d-none"><i class="bx bx-loader bx-spin me-1"></i>กำลังตรวจสอบ...</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ─── Step 2: กำหนดรหัสผ่านใหม่ ─── -->
    <div id="step2" class="card shadow-sm border-0 mb-3 d-none">
      <div class="card-body p-4">
        <h6 class="fw-semibold mb-3 text-primary"><i class="bx bx-key me-2"></i>ขั้นตอนที่ 2 — กำหนดรหัสผ่านใหม่</h6>

        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:.85rem;">รหัสผ่านใหม่ <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text"><i class="bx bx-lock-open"></i></span>
            <input type="password" class="form-control" id="newPassword" placeholder="อย่างน้อย 6 ตัวอักษร" autocomplete="new-password" oninput="checkStrength(this.value)" />
            <span class="input-group-text eye-btn" onclick="togglePw('newPassword',this)"><i class="bx bx-hide"></i></span>
          </div>
          <!-- Strength bar -->
          <div class="pw-strength mt-1"><div class="bar" id="strengthBar"></div></div>
          <div id="strengthLabel" style="font-size:.7rem;color:#888;margin-top:2px;"></div>
          <div id="newPwError" class="invalid-feedback d-none" style="font-size:.78rem;"></div>
        </div>

        <div class="mb-3">
          <label class="form-label fw-semibold" style="font-size:.85rem;">ยืนยันรหัสผ่านใหม่ <span class="text-danger">*</span></label>
          <div class="input-group">
            <span class="input-group-text"><i class="bx bx-lock-open"></i></span>
            <input type="password" class="form-control" id="confirmPassword" placeholder="กรอกรหัสผ่านใหม่อีกครั้ง" autocomplete="new-password" />
            <span class="input-group-text eye-btn" onclick="togglePw('confirmPassword',this)"><i class="bx bx-hide"></i></span>
          </div>
          <div id="confirmPwError" class="invalid-feedback d-none" style="font-size:.78rem;"></div>
        </div>

        <!-- Password rules -->
        <div class="border rounded p-2 mb-3" style="background:#f8f9fa;font-size:.72rem;">
          <div class="fw-semibold mb-1 text-muted">เงื่อนไขรหัสผ่าน</div>
          <div id="rule1" class="text-danger"><i class="bx bx-x me-1"></i>อย่างน้อย 6 ตัวอักษร</div>
          <div id="rule2" class="text-danger"><i class="bx bx-x me-1"></i>ไม่ควรใช้รหัสผ่านเก่าซ้ำ</div>
        </div>

        <div class="d-flex gap-2 justify-content-end">
          <button class="btn btn-outline-secondary px-4" id="btnBack"><i class="bx bx-arrow-back me-1"></i>ย้อนกลับ</button>
          <button class="btn btn-success px-4" id="btnSave">
            <span id="btnSaveText"><i class="bx bx-save me-1"></i>บันทึกรหัสผ่าน</span>
            <span id="btnSaveSpinner" class="d-none"><i class="bx bx-loader bx-spin me-1"></i>กำลังบันทึก...</span>
          </button>
        </div>
      </div>
    </div>

    <!-- ─── Step 3: สำเร็จ ─── -->
    <div id="step3" class="card shadow-sm border-0 mb-3 d-none">
      <div class="card-body p-4 text-center">
        <div style="font-size:3.5rem;color:#2e7d32;"><i class="bx bx-check-circle"></i></div>
        <h5 class="fw-bold text-success mt-2">เปลี่ยนรหัสผ่านสำเร็จ!</h5>
        <p class="text-muted" style="font-size:.85rem;">รหัสผ่านของคุณถูกเปลี่ยนเรียบร้อยแล้ว<br>กรุณาใช้รหัสผ่านใหม่ในการเข้าสู่ระบบครั้งต่อไป</p>
        <hr>
        <a href="javascript:location.reload()" class="btn btn-outline-primary me-2"><i class="bx bx-refresh me-1"></i>เปลี่ยนรหัสอีกครั้ง</a>
      </div>
    </div>

  </div>
</div>

<script>
(function(){
    var oldPwOk = false;
    var oldPwValue = '';

    // ─── Toggle show/hide password ─────────────────────────
    window.togglePw = function(id, btn){
        var inp = document.getElementById(id);
        var ico = btn.querySelector('i');
        if(inp.type === 'password'){
            inp.type = 'text';
            ico.className = 'bx bx-show';
        } else {
            inp.type = 'password';
            ico.className = 'bx bx-hide';
        }
    };

    // ─── Password strength ─────────────────────────────────
    window.checkStrength = function(val){
        var bar = document.getElementById('strengthBar');
        var lbl = document.getElementById('strengthLabel');
        var r1  = document.getElementById('rule1');
        var r2  = document.getElementById('rule2');
        var score = 0;
        if(val.length >= 6)  score++;
        if(val.length >= 8)  score++;
        if(/[A-Z]/.test(val)) score++;
        if(/[0-9]/.test(val)) score++;
        if(/[^A-Za-z0-9]/.test(val)) score++;

        var widths = ['0%','20%','40%','60%','80%','100%'];
        var colors = ['#e0e0e0','#f44336','#ff9800','#fdd835','#66bb6a','#2e7d32'];
        var labels = ['','อ่อนมาก','อ่อน','พอใช้','ดี','แข็งแรงมาก'];

        bar.style.width  = widths[score];
        bar.style.background = colors[score];
        lbl.textContent  = labels[score];
        lbl.style.color  = colors[score];

        r1.className = val.length >= 6 ? 'text-success' : 'text-danger';
        r1.innerHTML = '<i class="bx '+(val.length>=6?'bx-check':'bx-x')+' me-1"></i>อย่างน้อย 6 ตัวอักษร';

        r2.className = (val !== oldPwValue) ? 'text-success' : 'text-danger';
        r2.innerHTML = '<i class="bx '+(val!==oldPwValue?'bx-check':'bx-x')+' me-1"></i>ไม่ควรใช้รหัสผ่านเก่าซ้ำ';
    };

    function showAlert(type, msg){
        var z = document.getElementById('alertZone');
        z.className = 'alert alert-'+type+' alert-dismissible fade show mb-3';
        z.innerHTML = msg + '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
    }

    function showError(id, msg){
        var el = document.getElementById(id);
        el.textContent = msg; el.classList.remove('d-none');
    }
    function hideError(id){ document.getElementById(id).classList.add('d-none'); }

    function setStepBadge(step){
        var b1 = document.getElementById('step1Badge');
        var b2 = document.getElementById('step2Badge');
        var b3 = document.getElementById('step3Badge');
        var la = document.getElementById('lineA');
        var lb = document.getElementById('lineB');
        if(step >= 1){ b1.className = 'step-badge bg-primary text-white'; }
        if(step >= 2){ b2.className = 'step-badge bg-primary text-white'; la.classList.remove('bg-secondary'); la.style.background='#1565c0'; }
        if(step >= 3){ b3.className = 'step-badge bg-success text-white'; b3.innerHTML='<i class="bx bx-check" style="font-size:.8rem;"></i>'; lb.style.background='#2e7d32'; }
        if(step < 2){ b2.className = 'step-badge bg-secondary text-white'; }
        if(step < 3){ b3.className = 'step-badge bg-secondary text-white'; b3.innerHTML='<i class="bx bx-check" style="font-size:.8rem;"></i>'; }
    }

    // ─── Step 1: Check old password ───────────────────────
    document.getElementById('btnCheckOld').addEventListener('click', function(){
        var pw = document.getElementById('oldPassword').value.trim();
        hideError('oldPwError');
        if(!pw){ showError('oldPwError','กรุณากรอกรหัสผ่านเก่า'); return; }

        document.getElementById('btnCheckOldText').classList.add('d-none');
        document.getElementById('btnCheckOldSpinner').classList.remove('d-none');
        this.disabled = true;

        $.ajax({
            url: '@Url.Action("CheckOldPassword","other")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ OldPassword: pw }),
            success: function(res){
                document.getElementById('btnCheckOldText').classList.remove('d-none');
                document.getElementById('btnCheckOldSpinner').classList.add('d-none');
                document.getElementById('btnCheckOld').disabled = false;

                var success = res && (res.success === true || res.Success === true);
                if(success){
                    oldPwOk = true;
                    oldPwValue = pw;
                    document.getElementById('step1').classList.add('d-none');
                    document.getElementById('step2').classList.remove('d-none');
                    setStepBadge(2);
                    checkStrength('');
                } else {
                    var msg = (res && (res.message || res.Message)) || 'รหัสผ่านเก่าไม่ถูกต้อง';
                    showError('oldPwError', msg);
                    document.getElementById('oldPassword').value = '';
                    document.getElementById('oldPassword').focus();
                    showAlert('danger', '<i class="bx bx-error-circle me-2"></i>'+msg);
                }
            },
            error: function(){
                document.getElementById('btnCheckOldText').classList.remove('d-none');
                document.getElementById('btnCheckOldSpinner').classList.add('d-none');
                document.getElementById('btnCheckOld').disabled = false;
                showAlert('danger', '<i class="bx bx-error-circle me-2"></i>เกิดข้อผิดพลาดในการเชื่อมต่อ');
            }
        });
    });

    // ─── Back button ──────────────────────────────────────
    document.getElementById('btnBack').addEventListener('click', function(){
        document.getElementById('step2').classList.add('d-none');
        document.getElementById('step1').classList.remove('d-none');
        document.getElementById('newPassword').value = '';
        document.getElementById('confirmPassword').value = '';
        setStepBadge(1);
    });

    // ─── Step 2: Save new password ────────────────────────
    document.getElementById('btnSave').addEventListener('click', function(){
        hideError('newPwError'); hideError('confirmPwError');
        var np = document.getElementById('newPassword').value;
        var cp = document.getElementById('confirmPassword').value;

        var ok = true;
        if(!np || np.length < 6){
            showError('newPwError','รหัสผ่านต้องมีอย่างน้อย 6 ตัวอักษร');
            ok = false;
        } else if(np === oldPwValue){
            showError('newPwError','ไม่ควรใช้รหัสผ่านเก่าซ้ำ');
            ok = false;
        }
        if(np !== cp){
            showError('confirmPwError','รหัสผ่านไม่ตรงกัน');
            ok = false;
        }
        if(!ok) return;

        document.getElementById('btnSaveText').classList.add('d-none');
        document.getElementById('btnSaveSpinner').classList.remove('d-none');
        this.disabled = true;

        $.ajax({
            url: '@Url.Action("ChangePassword","other")',
            type: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ NewPassword: np }),
            success: function(res){
                document.getElementById('btnSaveText').classList.remove('d-none');
                document.getElementById('btnSaveSpinner').classList.add('d-none');
                document.getElementById('btnSave').disabled = false;

                var success = res && (res.success === true || res.Success === true);
                if(success){
                    document.getElementById('step2').classList.add('d-none');
                    document.getElementById('step3').classList.remove('d-none');
                    setStepBadge(3);
                } else {
                    var msg = (res && (res.message || res.Message)) || 'เกิดข้อผิดพลาดในการบันทึก';
                    showAlert('danger', '<i class="bx bx-error-circle me-2"></i>'+msg);
                }
            },
            error: function(){
                document.getElementById('btnSaveText').classList.remove('d-none');
                document.getElementById('btnSaveSpinner').classList.add('d-none');
                document.getElementById('btnSave').disabled = false;
                showAlert('danger', '<i class="bx bx-error-circle me-2"></i>เกิดข้อผิดพลาดในการเชื่อมต่อ');
            }
        });
    });

    // ─── Enter key support ─────────────────────────────────
    document.getElementById('oldPassword').addEventListener('keydown', function(e){
        if(e.key === 'Enter') document.getElementById('btnCheckOld').click();
    });
    document.getElementById('confirmPassword').addEventListener('keydown', function(e){
        if(e.key === 'Enter') document.getElementById('btnSave').click();
    });

}());
</script>

@section scripts{
    <script src="~/assets/js/app.js"></script>
}