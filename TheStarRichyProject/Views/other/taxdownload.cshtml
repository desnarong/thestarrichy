@{
    ViewData["Title"] = "ดาวน์โหลดเอกสารภาษี";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
/* ─── Document preview styles ─── */
.doc-wrap{font-family:'Cordia New','CordiaUPC','TH Sarabun New','Sarabun',Arial,sans-serif;font-size:14pt;background:#fff;color:#000;padding:.8rem 1rem;max-width:860px;margin:0 auto;}
.doc-wrap table{border-collapse:collapse;width:100%;}
.doc-wrap table td,.doc-wrap table th{padding:2px 5px;vertical-align:top;}
.doc-wrap table.noborder td,.doc-wrap table.noborder th{border:none;}
.doc-wrap .doc-title{font-size:1.05rem;font-weight:700;text-align:center;}
.doc-wrap .doc-subtitle{font-size:.78rem;text-align:center;margin-bottom:4px;}
.doc-wrap .section-label{font-size:.75rem;color:#555;}
.doc-wrap .field-underline{border:none;border-bottom:1px solid #333;min-width:60px;display:inline-block;}
.doc-wrap .chk-row{display:flex;align-items:flex-start;gap:4px;margin-bottom:2px;}
.doc-wrap .chk-box{width:12px;height:12px;border:1px solid #333;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;}
.doc-wrap .checked::after{content:'✔';font-size:9px;line-height:1;}
.doc-wrap .amt-col{text-align:right;min-width:90px;}
.doc-wrap .header-band{background:#f0f0f0;font-weight:700;text-align:center;}
.doc-company-logo{width:72px;height:72px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
@@media print{
  body *{visibility:hidden;}
  #printSection,#printSection *{visibility:visible;}
  #printSection{position:fixed;top:0;left:0;width:100%;}
}
</style>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
        <i class="bx bx-download fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">ดาวน์โหลดเอกสารภาษี</h5>
      </div>
      <div class="card-body p-3">

        <!-- ── Search bar ───────────────────────────────── -->
        <div class="border rounded p-3 mb-3" style="background:#fafafa;">
          <h6 class="mb-0 fw-semibold mb-2">ค้นหาเอกสาร</h6>
          <div class="row g-2 align-items-end">
            <div class="col-auto">
              <label class="form-label mb-1 fw-semibold" style="font-size:.8rem;">ประเภทเอกสาร</label>
              <div class="d-flex gap-3">
                <div class="form-check mb-0">
                  <input class="form-check-input" type="radio" name="document_type" id="rdoTaxInvoice" value="tax" checked>
                  <label class="form-check-label" for="rdoTaxInvoice" style="font-size:.85rem;">ใบกำกับภาษี</label>
                </div>
                <div class="form-check mb-0">
                  <input class="form-check-input" type="radio" name="document_type" id="rdoWithhold" value="withhold">
                  <label class="form-check-label" for="rdoWithhold" style="font-size:.85rem;">หนังสือรับรองหัก ณ ที่จ่าย (50ทวิ)</label>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <label for="fromDate" class="form-label mb-1 fw-semibold" style="font-size:.8rem;">จากวันที่</label>
              <input type="date" class="form-control form-control-sm" id="fromDate" />
            </div>
            <div class="col-md-3">
              <label for="toDate" class="form-label mb-1 fw-semibold" style="font-size:.8rem;">ถึงวันที่</label>
              <input type="date" class="form-control form-control-sm" id="toDate" />
            </div>
            <div class="col-auto">
              <button class="btn btn-primary btn-sm px-4" id="btnSearch">
                <i class="bx bx-search me-1"></i>ค้นหา
              </button>
            </div>
          </div>
        </div>

        <!-- ── Table 1: ใบกำกับภาษี ──────────────────── -->
        <div class="mb-4">
          <h6 class="fw-semibold mb-2">รายการเอกสาร <span class="text-danger">ใบกำกับภาษี</span></h6>
          <div class="table-responsive">
            <table id="tblTaxInvoice" class="table table-bordered table-hover table-sm nowrap" style="width:100%;font-size:.8rem;">
              <thead class="text-center" style="background:linear-gradient(135deg,#e3f2fd,#bbdefb);">
                <tr>
                  <th>เลขที่เอกสาร</th>
                  <th>วันที่เอกสาร</th>
                  <th class="text-danger">เลขที่อ้างอิง</th>
                  <th>ประเภทเอกสาร</th>
                  <th>ยอดรวม (รวมภาษี)</th>
                  <th>ดูและดาวน์โหลด</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <!-- ── Table 2: หนังสือรับรอง 50ทวิ ─────────── -->
        <div class="mb-3">
          <h6 class="fw-semibold mb-2">หนังสือรับรองหัก ณ ที่จ่าย (50ทวิ)</h6>
          <div class="table-responsive">
            <table id="tblWithhold" class="table table-bordered table-hover table-sm nowrap" style="width:100%;font-size:.8rem;">
              <thead class="text-center" style="background:linear-gradient(135deg,#fce4ec,#f8bbd9);">
                <tr>
                  <th>เลขที่เอกสาร</th>
                  <th class="text-danger">รอบปีภาษี</th>
                  <th class="text-danger">วันที่จ่าย</th>
                  <th>จำนวนเงินที่จ่าย</th>
                  <th>ภาษีที่หัก</th>
                  <th>ดูและดาวน์โหลด</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>


      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     Modal: ใบเสร็จรับเงิน / ใบกำกับภาษี / ใบส่งของ
═══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="taxDetailModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header p-0 border-0">
        <div style="background:#00c853;width:100%;padding:.45rem 1rem;" class="d-flex align-items-center justify-content-between flex-wrap gap-1">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="text-white" style="font-size:.75rem;opacity:.9;">ขึ้นต้นด้วย <b>BKKO</b> ➜ ใบส่งของ/ใบกำกับภาษี</span>
            <span class="text-white" style="font-size:.75rem;opacity:.9;">| ขึ้นต้นด้วย <b>R</b> ➜ ใบแจงยอด</span>
            <span class="fw-bold text-white fs-5 ms-2" id="taxModalBillTitle">ใบกำกับภาษี</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-light" id="btnCaptureTax" onclick="captureTaxBill()"><i class="bx bx-camera me-1"></i>บันทึกรูป</button>
            <button class="btn btn-sm btn-outline-light" onclick="printDoc('taxInvoiceDoc')"><i class="bx bx-printer me-1"></i>พิมพ์/PDF</button>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
        </div>
      </div>
      <div class="modal-body p-2" id="taxDetailBody">
        <div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-success"></i></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     Modal: หนังสือรับรองการหักภาษี ณ ที่จ่าย (50ทวิ)
═══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="withholdModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header p-2" style="background:linear-gradient(135deg,#c62828,#ef5350);">
        <span class="fw-bold text-white"><i class="bx bx-file-blank me-2"></i>หนังสือรับรองการหักภาษี ณ ที่จ่าย (50ทวิ)</span>
        <div class="d-flex gap-2 ms-auto">
          <button class="btn btn-sm btn-light" onclick="printDoc('withholdDoc')"><i class="bx bx-printer me-1"></i>พิมพ์ / บันทึก PDF</button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
      </div>
      <div class="modal-body p-2" id="withholdBody">
        <div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-danger"></i></div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
    var dtTax=null, dtYearly=null;
    var allTax=[];

    function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
    function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
    function fmt2(v){var n=parseFloat(v);return isNaN(n)?'0.00':n.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
    function fmtDate(v){if(!v)return'';var d=new Date(v);if(isNaN(d.getTime()))return String(v);return d.toLocaleDateString('th-TH');}
    function fmtDateFull(v){if(!v)return'';var d=new Date(v);if(isNaN(d.getTime()))return String(v);return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0')+'/'+(d.getFullYear()+543);}
    function p(o,keys,def){def=def===undefined?'':def;for(var i=0;i<keys.length;i++){if(o&&o[keys[i]]!=null)return o[keys[i]];}return def;}

    function initDt(id, rows, cols, dtRef){
        if(dtRef){dtRef.destroy();}
        var $t=$('#'+id); $t.find('tbody').empty();
        rows.forEach(function(r){
            var cells=cols.map(function(fn){return'<td>'+fn(r)+'</td>';}).join('');
            $t.find('tbody').append('<tr>'+cells+'</tr>');
        });
        return $t.DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],
            ordering:true,searching:true,destroy:true,
            language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',
                lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',
                paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
    }

    // ── TaxInvoice table columns ──────────────────────────
    var taxCols=[
        function(r){return'<span class="fw-semibold text-primary">'+esc(p(r,['BillNo','billNo']))+'</span>';},
        function(r){return fmtDate(p(r,['BillDate','billDate']));},
        function(r){return esc(p(r,['ReferenceNo','referenceNo']));},
        function(r){return esc(p(r,['BilltypeCode','billtypeCode','BillTypeCode']));},
        function(r){return'<span class="fw-bold text-success">'+fmt2(p(r,['Pricebeincludetax','TotalAmount','totalAmount'],0))+'</span>';},
        function(r){
            var bn=esc(p(r,['BillNo','billNo']));
            return'<button class="btn btn-sm btn-primary py-0 px-2" onclick="showTaxDetail(\''+bn+'\')">'+
                '<i class="bx bx-show me-1"></i>ดูเอกสาร</button>';
        }
    ];

    // ── Yearly summary ────────────────────────────────────
    function buildYearly(rows){
        var map={};
        rows.forEach(function(r){
            var d=new Date(p(r,['BillDate','billDate']));
            var yr=isNaN(d.getTime())?'ไม่ระบุ':String(d.getFullYear()+543);
            if(!map[yr])map[yr]={yr:yr,cnt:0,amt:0};
            map[yr].cnt++; map[yr].amt+=parseFloat(p(r,['Pricebeincludetax','TotalAmount','totalAmount'],0))||0;
        });
        var yRows=Object.values(map).sort(function(a,b){return String(b.yr).localeCompare(String(a.yr));});
        dtYearly=initDt('tblYearly',yRows,[
            function(r){return'<b>'+esc(r.yr)+'</b>';},
            function(r){return r.cnt;},
            function(r){return'<span class="text-success fw-bold">'+fmt2(r.amt)+'</span>';}
        ],dtYearly);
    }

    // ── Load data ─────────────────────────────────────────
    function loadData(){
        var f=$('#fromDate').val(), t=$('#toDate').val();
        $('#tblTaxInvoice tbody').html('<tr><td colspan="6" class="text-center text-muted py-3"><i class="bx bx-loader bx-spin me-2"></i>กำลังโหลดข้อมูล...</td></tr>');
        $.get('@Url.Action("GetTaxInvoiceData","other")',{fromDate:f,toDate:t},function(json){
            allTax=norm(json);
            dtTax=initDt('tblTaxInvoice',allTax,taxCols,dtTax);

        }).fail(function(){
            $('#tblTaxInvoice tbody').html('<tr><td colspan="6" class="text-center text-danger">เกิดข้อผิดพลาดในการดึงข้อมูล</td></tr>');
        });
        initDt('tblWithhold',[],[function(r){return'';},function(r){return'';},function(r){return'';},
            function(r){return'';},function(r){return'';},function(r){return'';}],null);
    }

    // ══════════════════════════════════════════════════════
    // showTaxDetail — ใบเสร็จรับเงิน / ใบกำกับภาษี
    // ══════════════════════════════════════════════════════
    window.showTaxDetail = function(billNo){
        $('#taxDetailBody').html('<div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-primary"></i></div>');
        new bootstrap.Modal(document.getElementById('taxDetailModal')).show();
        var hd=allTax.find(function(r){return p(r,['BillNo','billNo'])===billNo;})||{};

        $.get('@Url.Action("GetTaxInvoiceDetailData","other")',{billNo:billNo},function(json){
            var lines=norm(json);
            
            var companyName=p(hd,['Companyname','companyname'],'บริษัท เดอะสตาร์ริชชี จำกัด (สำนักงานใหญ่)');
            var companyAddr=p(hd,['Companyaddress','companyaddress'],'เลขที่ 16/8 หมู่ 4 ตำบลบึงยี่โถ อำเภอธัญบุรี จังหวัดปทุมธานี 12130');
            var companyTel=p(hd,['Companytelephone','companytelephone'],'021260742');
            var companyTaxID=p(hd,['CompanyTaxID','companyTaxID'],'0135564012380');
            var custTitle=p(hd,['CustomerTitle','customerTitle','TitleName','titleName'],'');
            var custName=p(hd,['CustomerName','customerName'],'');
            var custFullDisplayName=(custTitle?custTitle+' ':'')+custName;
            var custAddr=p(hd,['CustomerAddress','customerAddress'],'');
            var custShipAddr=p(hd,['ShippingAddress','shippingAddress','DeliveryAddress','deliveryAddress'],'');
            var custTel=p(hd,['CustomerTelephone','customerTelephone'],'');
            var custTaxID=p(hd,['CustomerTaxID','customerTaxID'],'');
            var membercode=p(hd,['Membercode','membercode'],'');
            var createby=p(hd,['Createby','createby'],'');
            var paymentType=p(hd,['PaymentType','paymentType'],'');
            var billDate=fmtDateFull(p(hd,['BillDate','billDate']));
            var refNo=p(hd,['ReferenceNo','referenceNo'],'');
            var priceBeforeTax=parseFloat(p(hd,['Pricebeforetax','pricebeforetax'],0))||0;
            var taxFee=parseFloat(p(hd,['Taxfee','taxfee'],0))||0;
            var priceIncTax=parseFloat(p(hd,['Pricebeincludetax','pricebeincludetax'],0))||0;
            var shipping=parseFloat(p(hd,['ShippingFee','shippingFee'],0))||0;
            var totalPV=parseFloat(p(hd,['TotalPV','totalPV'],0))||0;
            var netTotal=priceIncTax+shipping;
            var expireDate=fmtDateFull(p(hd,['ExpireDate','expireDate'],''));
            var trackingNo=p(hd,['TrackingURL','trackingURL','TrackingNo','trackingNo'],'');
            var orderType=p(hd,['Billtype','billtype','BilltypeCode','billtypeCode','BillConfirmType','billConfirmType'],'');
            var billNoUpper=String(billNo).toUpperCase();
            var docTypeLabel=(billNoUpper.indexOf('BKKO')===0||billNoUpper.indexOf('BKK')===0)?'ใบส่งของ/ใบกำกับภาษี':'ใบแจงยอด';
            $('#taxModalBillTitle').text(docTypeLabel);

            // Number to Thai text (kept for printDoc fallback)
            var dispBefore=priceBeforeTax||0;
            if(!dispBefore&&priceIncTax) dispBefore=priceIncTax/1.07;
            var dispTax=taxFee||(priceIncTax-dispBefore)||0;
            var dispInc=priceIncTax||0;

            var html='<div id="taxInvoiceDoc" style="font-family:\'Cordia New\',\'CordiaUPC\',\'TH Sarabun New\',Arial,sans-serif;font-size:14pt;background:#fff;color:#000;padding:.8rem 1rem;max-width:860px;margin:0 auto;">';

            // ── Company header + Doc number box ──────────────────────────
            html+='<table style="width:100%;border-collapse:collapse;margin-bottom:6px;"><tr>';
            html+='<td style="vertical-align:top;padding-right:12px;">';
            html+='<div style="font-size:15pt;font-weight:700;color:#1a237e;line-height:1.2;">'+esc(companyName)+'</div>';
            html+='<div style="font-size:12pt;">'+esc(companyAddr)+'</div>';
            html+='<div style="font-size:12pt;">โทร: '+esc(companyTel)+'&nbsp;&nbsp; เลขที่ผู้เสียภาษี: '+esc(companyTaxID)+'</div>';
            html+='</td>';
            html+='<td style="vertical-align:top;text-align:right;white-space:nowrap;">';
            html+='<div style="font-size:14pt;font-weight:700;color:#c00;margin-bottom:4px;">'+esc(docTypeLabel)+'</div>';
            html+='<table style="margin-left:auto;border-collapse:collapse;font-size:12pt;border:1.5px solid #c00;">';
            html+='<tr><td style="text-align:right;padding:3px 8px;color:#555;border-bottom:1px solid #eee;white-space:nowrap;">เลขที่</td><td style="padding:3px 10px;font-weight:700;color:#1a237e;border-bottom:1px solid #eee;white-space:nowrap;">'+esc(billNo)+'</td></tr>';
            html+='<tr><td style="text-align:right;padding:3px 8px;color:#555;border-bottom:1px solid #eee;white-space:nowrap;">วันที่</td><td style="padding:3px 10px;border-bottom:1px solid #eee;white-space:nowrap;">'+billDate+'</td></tr>';
            html+='<tr><td style="text-align:right;padding:3px 8px;color:#555;white-space:nowrap;">อ้างอิง</td><td style="padding:3px 10px;white-space:nowrap;">'+esc(refNo)+'</td></tr>';
            html+='</table></td>';
            html+='</tr></table>';
            html+='<hr style="margin:4px 0;border:0;border-top:1px solid #bbb;">';

            // ── Customer + Shipping/Order info ────────────────────────────
            html+='<table style="width:100%;border-collapse:collapse;margin-bottom:6px;"><tr>';
            html+='<td style="vertical-align:top;width:52%;padding-right:12px;border-right:1px solid #ddd;">';
            html+='<div style="margin-bottom:3px;font-size:13pt;"><span style="color:#555;">ผู้ซื้อ :</span> <b>'+esc(custFullDisplayName)+'</b></div>';
            html+='<div style="margin-bottom:3px;font-size:13pt;"><span style="color:#555;">รหัสสมาชิก :</span> '+esc(membercode)+'</div>';
            html+='<div style="border-bottom:1px solid #aaa;min-height:1.4rem;font-size:12pt;padding-bottom:2px;">'+esc(custTaxID||'')+'</div>';
            html+='</td>';
            html+='<td style="vertical-align:top;padding-left:12px;">';
            html+='<div style="margin-bottom:3px;font-size:12pt;"><span style="color:#555;">ที่อยู่จัดส่ง :</span> <span style="border-bottom:1px solid #aaa;display:inline-block;min-width:150px;">'+esc(custShipAddr||custAddr||'')+'</span></div>';
            html+='<div style="margin-bottom:3px;font-size:12pt;"><span style="color:#555;">โทร :</span> <span style="border-bottom:1px solid #aaa;display:inline-block;min-width:100px;">'+esc(custTel||'')+'</span></div>';
            html+='<div style="margin-bottom:3px;font-size:12pt;"><span style="color:#555;">ประเภทชำระ :</span> <span style="border:1px solid #888;padding:0 6px;display:inline-block;">'+esc(paymentType||'')+'</span></div>';
            html+='<div style="font-size:12pt;"><span style="color:#c00;font-weight:600;">ประเภทการสั่ง :</span> <span style="color:#c00;">'+esc(orderType||'topup/hurry active/ hold')+'</span>';
            if(expireDate) html+=' &nbsp; <span style="color:#555;">วันหมดอายุ :</span> '+esc(expireDate);
            html+='</div>';
            html+='</td></tr></table>';

            // ── Product table ─────────────────────────────────────────────
            html+='<table style="width:100%;border-collapse:collapse;font-size:13pt;border:1px solid #aaa;">';
            html+='<thead><tr style="background:#e8e8e8;">';
            var ths=[['ลำดับ','32px','center'],['รหัสสินค้า','90px','left'],['ชื่อสินค้า','','left'],['จำนวน','60px','center'],['หน่วย','60px','center'],['ราคา/หน่วย','95px','right'],['รวม','95px','right'],['PV','75px','right']];
            ths.forEach(function(h){html+='<th style="border:1px solid #aaa;padding:3px 5px;text-align:'+h[2]+';'+(h[1]?'width:'+h[1]+';':'')+'">'+h[0]+'</th>';});
            html+='</tr></thead><tbody>';
            var totalLineAmt=0,totalLinePV=0;
            if(lines.length===0){
                html+='<tr><td colspan="8" style="text-align:center;height:40px;color:#999;border:1px solid #eee;">ไม่พบรายการสินค้า</td></tr>';
            } else {
                lines.forEach(function(ln,idx){
                    var qty=p(ln,['Quantity','quantity'],0);
                    var unit=p(ln,['Unitname','unitname','UnitName'],p(ln,['Unit','unit'],''));
                    var ppu=parseFloat(p(ln,['PriceperUnit','priceperUnit','UnitPrice','unitprice'],0))||0;
                    var ltot=parseFloat(p(ln,['TotalAmount','totalAmount','TotalPrice','totalPrice'],0))||0;
                    var lpv=parseFloat(p(ln,['PV','pv','TotalPV','totalPV'],0))||0;
                    totalLineAmt+=ltot; totalLinePV+=lpv;
                    html+='<tr>';
                    html+='<td style="text-align:center;border:1px solid #ccc;padding:3px 4px;">'+(idx+1)+'</td>';
                    html+='<td style="border:1px solid #ccc;padding:3px 5px;">'+esc(p(ln,['ProductCode','productCode','ProductID','productID']))+'</td>';
                    html+='<td style="border:1px solid #ccc;padding:3px 5px;">'+esc(p(ln,['ProductName','productName']))+'</td>';
                    html+='<td style="text-align:center;border:1px solid #ccc;padding:3px 4px;">'+esc(String(qty))+'</td>';
                    html+='<td style="text-align:center;border:1px solid #ccc;padding:3px 4px;">'+esc(unit)+'</td>';
                    html+='<td style="text-align:right;border:1px solid #ccc;padding:3px 5px;">'+fmt2(ppu)+'</td>';
                    html+='<td style="text-align:right;border:1px solid #ccc;padding:3px 5px;font-weight:600;color:#c00;">'+fmt2(ltot)+'</td>';
                    html+='<td style="text-align:right;border:1px solid #ccc;padding:3px 5px;">'+fmt2(lpv)+'</td>';
                    html+='</tr>';
                });
            }
            var fillRows=Math.max(0,3-lines.length);
            for(var fi=0;fi<fillRows;fi++) html+='<tr><td colspan="8" style="height:20px;border:1px solid #eee;">&nbsp;</td></tr>';
            html+='</tbody></table>';

            // ── Footer ────────────────────────────────────────────────────
            html+='<table style="width:100%;border-collapse:collapse;margin-top:6px;font-size:13pt;"><tr>';
            html+='<td style="vertical-align:top;width:55%;padding-right:10px;border-right:1px solid #ddd;">';
            html+='<div><span style="color:#555;">รูปแบบ :</span> ส่งปิลไปกับฝลัด / ไม่ส่งปิลไป</div>';
            html+='<div style="margin-top:3px;"><span style="color:#555;">Tracking number :</span> <span style="border-bottom:1px solid #aaa;display:inline-block;min-width:180px;padding-bottom:1px;">'+esc(trackingNo||'')+'</span></div>';
            html+='<div style="margin-top:3px;"><span style="color:#555;">หมายเหตุ :</span> ค้างรับ / รับแล้ว-วันที่รับ</div>';
            html+='<div style="margin-top:3px;"><span style="color:#555;">ผู้ทำรายการ :</span> '+esc(createby||'')+'</div>';
            html+='<div style="margin-top:3px;"><span style="color:#555;">สถานะ :</span> ยืนยัน/ยังไม่ยืนยัน</div>';
            html+='</td>';
            html+='<td style="vertical-align:top;padding-left:10px;">';
            html+='<table style="width:100%;border-collapse:collapse;font-size:13pt;">';
            html+='<tr><td style="padding:4px 8px;">ค่าส่ง</td><td style="text-align:right;padding:4px 8px;">'+fmt2(shipping)+'</td></tr>';
            html+='<tr style="background:#e0f7f4;"><td style="padding:5px 8px;font-weight:700;">ยอดรวมทั้งสิ้น</td><td style="text-align:right;padding:5px 10px;font-weight:700;color:#00796b;font-size:15pt;">'+fmt2(netTotal||dispInc)+'</td></tr>';
            html+='<tr style="background:#e0f7f4;margin-top:2px;"><td style="padding:5px 8px;font-weight:700;">PV</td><td style="text-align:right;padding:5px 10px;font-weight:700;color:#00796b;font-size:15pt;">'+fmt2(totalPV||totalLinePV)+'</td></tr>';
            html+='</table></td>';
            html+='</tr></table>';
            html+='</div>';

            $('#taxDetailBody').html(html);
        }).fail(function(){
            $('#taxDetailBody').html('<div class="text-center text-danger py-3"><i class="bx bx-error-circle fs-3"></i><br>เกิดข้อผิดพลาดในการดึงข้อมูล</div>');
        });
    };

    // ══════════════════════════════════════════════════════
    // showWithholdDetail — หนังสือรับรอง 50ทวิ
    // ══════════════════════════════════════════════════════
    window.showWithholdDetail = function(data){
        var payDate=p(data,['PayDate','payDate','BillDate'],'');
        var docNo=p(data,['DocNo','docNo','BillNo','billNo'],'');
        var custFullName=p(data,['CustomerName','MemberName','memberName'],'');
        var custTaxID=p(data,['CustomerTaxID','TaxID','taxID'],'');
        var custAddr=p(data,['CustomerAddress','address'],'');
        var payAmt=parseFloat(p(data,['TotalAmount','amount'],0))||0;
        var taxAmt=parseFloat(p(data,['TaxAmount','taxAmount','WithHoldingTax'],0))||0;
        var incomeType=parseInt(p(data,['IncomeType','incomeType'],5))||5;

        var html='<div id="withholdDoc" class="doc-wrap" style="border:1px solid #999;">';
        html+='<div style="font-size:.65rem;border-bottom:1px solid #ccc;padding-bottom:3px;margin-bottom:6px;">';
        html+='<b>ฉบับที่ 1</b> (สำหรับผู้ถูกหักภาษี ณ ที่จ่าย ใช้แนบพร้อมกับแบบแสดงรายการภาษี)&nbsp;&nbsp;&nbsp;';
        html+='<b>ฉบับที่ 2</b> (สำหรับผู้ถูกหักภาษี ณ ที่จ่าย เก็บไว้เป็นหลักฐาน)';
        html+='</div>';

        html+='<div style="text-align:center;margin-bottom:6px;">';
        html+='<div class="doc-title">หนังสือรับรองการหักภาษี ณ ที่จ่าย</div>';
        html+='<div class="doc-subtitle">ตามมาตรา 50 ทวิแห่งประมวลรัษฎากร</div>';
        html+='</div>';

        html+='<div style="text-align:right;font-size:.75rem;margin-bottom:8px;">';
        html+='เล่มที่ <span class="field-underline" style="min-width:40px;">&nbsp;</span>&nbsp;&nbsp;&nbsp;';
        html+='เลขที่ <span class="field-underline" style="min-width:120px;font-weight:700;font-size:.82rem;">'+esc(docNo)+'</span>';
        html+='</div>';

        // ผู้มีหน้าที่หักภาษี
        html+='<div style="background:#e8eaf6;border:1px solid #7986cb;padding:3px 6px;margin-bottom:3px;font-size:.72rem;font-weight:700;">ผู้มีหน้าที่หักภาษี ณ ที่จ่าย : -</div>';
        html+='<table class="noborder" style="font-size:.72rem;margin-bottom:8px;">';
        html+='<tr><td style="width:70%;">ชื่อ <span style="font-weight:700;">บริษัท เดอะสตาร์ริชชี จำกัด (สำนักงานใหญ่)</span></td>';
        html+='<td style="text-align:right;">เลขประจำตัวผู้เสียภาษี<br><span style="font-family:monospace;font-weight:700;font-size:.8rem;">0 1 3 5 5 6 4 0 1 2 3 8 0</span></td></tr>';
        html+='<tr><td colspan="2">ที่อยู่ 16/8 หมู่ 4 ตำบลบึงยี่โถ อำเภอธัญบุรี จังหวัดปทุมธานี 12130</td></tr>';
        html+='</table>';

        // ผู้ถูกหักภาษี
        html+='<div style="background:#fce4ec;border:1px solid #e91e63;padding:3px 6px;margin-bottom:3px;font-size:.72rem;font-weight:700;">ผู้ถูกหักภาษี ณ ที่จ่าย : -</div>';
        html+='<table class="noborder" style="font-size:.72rem;margin-bottom:8px;">';
        html+='<tr><td style="width:70%;">ชื่อ <span style="font-weight:700;">'+esc(custFullName)+'</span></td>';
        html+='<td style="text-align:right;">เลขประจำตัวผู้เสียภาษี<br><span style="font-family:monospace;font-weight:700;font-size:.8rem;">'+esc(custTaxID)+'</span></td></tr>';
        html+='<tr><td colspan="2">ที่อยู่ '+esc(custAddr)+'</td></tr>';
        html+='</table>';

        // ลำดับที่และแบบ
        html+='<table class="noborder" style="font-size:.72rem;margin-bottom:6px;"><tr>';
        html+='<td>ลำดับที่ <span style="font-weight:700;">'+esc(docNo)+'</span> ในแบบ </td>';
        html+='<td><span class="chk-box"></span> ภ.ง.ด.1ก &nbsp;<span class="chk-box"></span> 2 &nbsp;';
        html+='<span class="chk-box checked"></span> <b>3</b> &nbsp;<span class="chk-box"></span> 53</td>';
        html+='</tr></table>';

        // Income type table
        var incomeTypes=[
            '1. เงินเดือน ค่าจ้าง เบี้ยเลี้ยง โบนัส ฯลฯ ตามมาตรา 40(1)',
            '2. ค่าธรรมเนียม ค่านายหน้า ฯลฯ ตามมาตรา 40(2)',
            '3. ค่าแห่งลิขสิทธิ์ ฯลฯ ตามมาตรา 40(3)',
            '4. ดอกเบี้ย เงินปันผล ฯลฯ ตามมาตรา 40(4)',
            '5. รางวัล ส่วนลด หรือประโยชน์ใดๆ เนื่องจากการส่งเสริมการขาย ตามมาตรา 3 เตรส',
            '6. อื่นๆ (ระบุ)'
        ];
        html+='<table style="font-size:.7rem;">';
        html+='<thead><tr class="header-band">';
        html+='<th style="width:24px;text-align:center;">&nbsp;</th>';
        html+='<th>ประเภทเงินได้พึงประเมินจ่าย</th>';
        html+='<th style="width:80px;text-align:center;">วัน/เดือน/ปีภาษีที่จ่าย</th>';
        html+='<th style="width:88px;text-align:right;">จำนวนเงินที่จ่าย</th>';
        html+='<th style="width:88px;text-align:right;">ภาษีที่หักนำส่ง</th>';
        html+='</tr></thead><tbody>';

        incomeTypes.forEach(function(label,i){
            var chk=(i+1===incomeType);
            html+='<tr>';
            html+='<td style="text-align:center;"><span class="chk-box'+(chk?' checked':'')+'"></span></td>';
            html+='<td>'+esc(label)+'</td>';
            html+='<td style="text-align:center;">'+(chk?esc(fmtDateFull(payDate)):'')+'</td>';
            html+='<td style="text-align:right;">'+(chk&&payAmt?'<b>'+fmt2(payAmt)+'</b>':'')+'</td>';
            html+='<td style="text-align:right;">'+(chk&&taxAmt?'<b>'+fmt2(taxAmt)+'</b>':'')+'</td>';
            html+='</tr>';
        });

        html+='<tr style="background:#f5f5f5;font-weight:700;"><td colspan="2" style="text-align:right;font-size:.73rem;">รวมเงินที่จ่ายและภาษีที่หักนำส่ง</td>';
        html+='<td></td><td style="text-align:right;">'+fmt2(payAmt)+'</td><td style="text-align:right;">'+fmt2(taxAmt)+'</td></tr>';
        html+='</tbody></table>';

        html+='<div class="border p-1 mt-1" style="font-size:.7rem;background:#fff9c4;">';
        html+='<b>รวมเงินภาษีที่หักนำส่ง (ตัวอักษร)</b> — (กรอกตัวอักษรจำนวนเงิน)';
        html+='</div>';

        // ผู้ที่จ่ายเงิน
        html+='<div style="font-size:.7rem;margin-top:6px;display:flex;gap:12px;align-items:center;">';
        html+='<span>ผู้ที่จ่ายเงิน</span>';
        html+='<span><span class="chk-box checked"></span> (1) หัก ณ ที่จ่าย</span>';
        html+='<span><span class="chk-box"></span> (2) ออกให้ตลอดไป</span>';
        html+='<span><span class="chk-box"></span> (3) ออกให้ครั้งเดียว</span>';
        html+='<span><span class="chk-box"></span> (4) อื่นๆ</span>';
        html+='</div>';

        // Signature
        html+='<div style="text-align:center;margin-top:20px;font-size:.72rem;">';
        html+='ขอรับรองว่าข้อความและตัวเลขดังกล่าวข้างต้นถูกต้องตรงกับความจริงทุกประการ<br><br>';
        html+='ลงชื่อ <span class="field-underline" style="min-width:180px;">&nbsp;</span> ผู้จ่ายเงิน&nbsp;&nbsp;';
        html+='(วันที่) <span class="field-underline" style="min-width:80px;">'+esc(fmtDateFull(payDate))+'</span>';
        html+='</div>';
        html+='</div>';

        $('#withholdBody').html(html);
        new bootstrap.Modal(document.getElementById('withholdModal')).show();
    };

    // ── Capture helper ────────────────────────────────────
    window.captureTaxBill = function(){
        var el=document.getElementById('taxInvoiceDoc');
        if(!el){alert('ไม่พบข้อมูลเอกสาร');return;}
        if(typeof html2canvas==='undefined'){alert('html2canvas ไม่พร้อมใช้งาน');return;}
        html2canvas(el,{scale:2,useCORS:true,backgroundColor:'#fff'}).then(function(canvas){
            var a=document.createElement('a');
            a.href=canvas.toDataURL('image/png');
            a.download='bill_'+Date.now()+'.png';
            a.click();
        });
    };

    // ── Print helper ──────────────────────────────────────
    window.printDoc = function(docId){
        var el=document.getElementById(docId);
        if(!el){alert('ไม่พบเอกสาร');return;}
        var win=window.open('','_blank','width=950,height=750');
        if(!win){alert('กรุณาอนุญาตให้เปิด Popup จาก Browser เพื่อพิมพ์/บันทึก PDF');return;}
        win.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>เอกสาร</title>');
        win.document.write('<style>');
        win.document.write('@@import url("https://fonts.googleapis.com/css2?family=Sarabun:wght@@400;700&display=swap");');
        win.document.write('body{font-family:"Cordia New","CordiaUPC","TH Sarabun New","Sarabun",Arial,sans-serif;font-size:14pt;margin:0;padding:10px;}');
        win.document.write('.doc-wrap{max-width:100%;}');
        win.document.write('.doc-company-logo{width:72px;height:72px;display:flex;align-items:center;justify-content:center;}');
        win.document.write('table{border-collapse:collapse;width:100%;}td,th{border:1px solid #888;padding:2px 5px;vertical-align:top;}');
        win.document.write('.noborder td,.noborder th{border:none !important;}');
        win.document.write('.header-band{background:#eee;font-weight:700;text-align:center;}');
        win.document.write('.amt-col{text-align:right;min-width:80px;}');
        win.document.write('.section-label{font-size:.7rem;color:#666;}');
        win.document.write('.chk-box{width:11px;height:11px;border:1px solid #333;display:inline-flex;align-items:center;justify-content:center;}');
        win.document.write('.checked::after{content:"✔";font-size:8px;}');
        win.document.write('.field-underline{border:none;border-bottom:1px solid #333;min-width:60px;display:inline-block;}');
        win.document.write('@@page{margin:10mm;size:A4;}');
        win.document.write('<\/style><\/head><body>');
        win.document.write(el.outerHTML);
        win.document.write('<\/body><\/html>');
        win.document.close();
        setTimeout(function(){win.focus();win.print();},500);
    };

    // ── Events ────────────────────────────────────────────
    $('#btnSearch').on('click', loadData);
    loadData();
});
</script>

