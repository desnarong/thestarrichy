@{
    ViewData["Title"] = "ดาวน์โหลดเอกสารภาษี";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
                <i class="bx bx-download fs-4 text-white"></i>
                <h5 class="mb-0 text-white fw-semibold">ดาวน์โหลดเอกสารภาษี</h5>
            </div>
            <div class="card-body p-4">
                <!-- ค้นหาเอกสาร -->
                <div class="mb-4">
                    <h5 class="mb-3 fw-semibold">ค้นหาเอกสาร</h5>
                    <div class="row g-3">
                        <div class="col-md-12">
                            <label class="form-label fw-semibold">ประเภทเอกสาร</label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="document_type" id="tax_invoice" value="" checked>
                                    <label class="form-check-label" for="tax_invoice">ใบกำกับภาษี</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="document_type" id="tax_report" value="">
                                    <label class="form-check-label" for="tax_report">รายงานสรุปภาษี</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-12">
                            <div class="row g-3 align-items-end">
                                <div class="col-md-3">
                                    <label for="fromDate" class="form-label fw-semibold">จากวันที่</label>
                                    <input type="text" class="form-control" id="fromDate" />
                                </div>
                                <div class="col-md-3">
                                    <label for="toDate" class="form-label fw-semibold">ถึงวันที่</label>
                                    <input type="text" class="form-control" id="toDate" />
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary w-100" data-key="t-search">ค้นหา</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- รายการเอกสาร -->
                <div>
                    <h5 class="mb-3 fw-semibold">รายการเอกสาร</h5>
                    <div class="table-responsive">
                        <table id="data-table-responsive" class="table table-striped table-bordered nowrap" style="width:100%"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        $("#data-table-responsive").DataTable({
            "responsive": true,
            "processing": true,
            "serverSide": false,
            "filter": false,
            "orderMulti": false,
            "ordering": true,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
            "pageLength": 25,
            "destroy": true,
            "searching": false,
            "contentType": "application/json; charset=utf-8",
            "columns": [
                { title: "รหัสเอกสาร", "data": '', "targets": 0, "orderable": true, "data-key": "t-document-code" },
                { title: "วันที่เอกสาร", "data": '', "data-key": "t-document-date" },
                { title: "ประเภทเอกสาร", "data": '', "data-key": "t-document-type" },
                { title: "ยอดรวม", "data": '', "data-key": "t-amount" },
                { title: "สถานะ", "data": '', "data-key": "t-status" },
                { title: "ดาวน์โหลด", "data": '', "data-key": "t-download" }
            ],
        });
    });
</script>

@section scripts{
    <script src="~/assets/js/app.js"></script>
}