            html+='<td style="text-align:center;width:33%;">______________________<br>ผู้รับเงิน<br><span style="font-size:.65rem;">'+billDate+'</span></td>';
            html+='<td style="text-align:center;width:33%;">______________________<br>ผู้รับสินค้า<br><span style="font-size:.65rem;">'+esc(custName)+'</span></td>';
