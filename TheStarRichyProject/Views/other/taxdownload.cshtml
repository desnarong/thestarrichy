        html+='</table>';

        // ผู้ถูกหักภาษี
        html+='<div style="background:#fce4ec;border:1px solid #e91e63;padding:3px 6px;margin-bottom:3px;font-size:.72rem;font-weight:700;">ผู้ถูกหักภาษี ณ ที่จ่าย : -</div>';
        html+='<table class="noborder" style="font-size:.72rem;margin-bottom:8px;">';
        html+='<tr><td style="width:70%;">ชื่อ <span style="font-weight:700;">'+esc(custFullName)+'</span></td>';
        html+='<td style="text-align:right;">เลขประจำตัวผู้เสียภาษี<br><span style="font-family:monospace;font-weight:700;font-size:.8rem;">'+esc(custTaxID)+'</span></td></tr>';
        html+='<tr><td colspan="2">ที่อยู่ '+esc(custAddr)+'</td></tr>';
