            html+='<tr style="background:#e8f5e9;"><td><b>จำนวนเงินสุทธิ</b></td><td class="amt-col"><b style="color:#2e7d32;">'+fmt2(netTotal||dispInc)+'</b></td></tr>';
            if(totalPV) html+='<tr><td style="font-size:.65rem;color:#666;">PV รวม</td><td class="amt-col" style="font-size:.65rem;color:#1565c0;">'+fmt2(totalPV)+'</td></tr>';
            html+='</table></td>';
