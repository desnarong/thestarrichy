// ฟังก์ชันแปลงตัวเลขเป็นตัวอักษรภาษาไทย
function numberToThaiBaht(num) {
    if (isNaN(num) || num === 0) return 'ศูนย์บาทถ้วน';
    var thaiNum = ['', 'หนึ่ง', 'สอง', 'สาม', 'สี่', 'ห้า', 'หก', 'เจ็ด', 'แปด', 'เก้า'];
    var thaiUnit = ['', 'สิบ', 'ร้อย', 'พัน', 'หมื่น', 'แสน', 'ล้าน'];
    var baht = Math.floor(num);
    var satang = Math.round((num - baht) * 100);
    var result = '';
    
    if (baht > 0) {
        var bahtStr = '';
        var strBaht = baht.toString();
        for (var i = 0; i < strBaht.length; i++) {
            var digit = parseInt(strBaht[i]);
            var pos = strBaht.length - i - 1;
            if (digit === 1 && pos === 0 && i > 0) {
                bahtStr += 'เอ็ด';
            } else if (digit === 2 && pos === 1) {
                bahtStr += 'ยี่';
            } else if (digit === 1 && pos === 1) {
                bahtStr += '';
            } else if (digit > 0) {
                bahtStr += thaiNum[digit];
            }
            if (digit > 0 && pos > 0) {
                bahtStr += thaiUnit[pos % 6];
                if (pos === 6) bahtStr += thaiUnit[6];
            }
        }
        result += bahtStr + 'บาท';
    }
    
    if (satang > 0) {
        var satangStr = satang.toString();
        if (satangStr.length === 1) satangStr = '0' + satangStr;
        var s1 = parseInt(satangStr[0]);
        var s2 = parseInt(satangStr[1]);
        if (s1 > 0) {
            if (s1 === 2) result += 'ยี่';
            else if (s1 === 1) result += '';
            else result += thaiNum[s1];
            result += 'สิบ';
        }
        if (s2 > 0) {
            if (s2 === 1) result += 'เอ็ด';
            else result += thaiNum[s2];
        }
        result += 'สตางค์';
    } else {
        result += 'ถ้วน';
    }
    return result;
}

