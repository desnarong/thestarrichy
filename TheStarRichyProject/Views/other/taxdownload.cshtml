    // ── Print helper ──────────────────────────────────────
    window.printDoc = function(docId){
        var el=document.getElementById(docId);
        if(!el){alert('ไม่พบเอกสาร');return;}
        var win=window.open('','_blank','width=950,height=750');
        if(!win){alert('กรุณาอนุญาตให้เปิด Popup จาก Browser เพื่อพิมพ์/บันทึก PDF');return;}
        win.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>เอกสาร</title>');
        win.document.write('<style>');
        win.document.write('@@import url("https://fonts.googleapis.com/css2?family=Sarabun:wght@@400;700&display=swap");');
        win.document.write('body{font-family:"Sarabun",Arial,sans-serif;font-size:.78rem;margin:0;padding:10px;}');
        win.document.write('.doc-wrap{max-width:100%;}');
        win.document.write('.doc-company-logo{width:72px;height:72px;border:2px solid #333;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.65rem;text-align:center;color:#1565c0;}');
        win.document.write('table{border-collapse:collapse;width:100%;}td,th{border:1px solid #888;padding:2px 5px;vertical-align:top;}');
        win.document.write('.noborder td,.noborder th{border:none !important;}');
        win.document.write('.header-band{background:#eee;font-weight:700;text-align:center;}');
        win.document.write('.amt-col{text-align:right;min-width:80px;}');
        win.document.write('.section-label{font-size:.7rem;color:#666;}');
        win.document.write('.chk-box{width:11px;height:11px;border:1px solid #333;display:inline-flex;align-items:center;justify-content:center;}');
        win.document.write('.checked::after{content:"✔";font-size:8px;}');
        win.document.write('.field-underline{border:none;border-bottom:1px solid #333;min-width:60px;display:inline-block;}');
        win.document.write('@@page{margin:10mm;size:A4;}');
        win.document.write('</style></head><body>');
        win.document.write(el.outerHTML);
        win.document.write('</body></html>');
        win.document.close();
        setTimeout(function(){win.focus();win.print();},500);
    };

    // ── Events ────────────────────────────────────────────
    $('#btnSearch').on('click', loadData);
    $('#btnToggleYearly').on('click', function(){
        var $s=$('#sectionYearly');
        $s.toggleClass('d-none');
        if(!$s.hasClass('d-none'))buildYearly(allTax);
        $(this).html($s.hasClass('d-none')?
            '<i class="bx bx-calendar me-1"></i>แสดงตารางสรุปเป็นปี':
            '<i class="bx bx-calendar me-1"></i>ซ่อนตารางสรุปเป็นปี');
    });

    loadData();
});
</script>

