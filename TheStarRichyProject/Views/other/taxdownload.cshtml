        win.document.write('    border-collapse: collapse !important; '); // บังคับให้เส้นตารางแนบสนิทกัน ไม่แยก spacing
        win.document.write('    width: 100% !important; ');
        win.document.write('    margin-top: 2px !important; ');
        win.document.write('} ');

        

        // ⭐ 4. จัดการข้อยกเว้นสำหรับแถวที่ไม่เอาเส้นขอบ (.noborder) ตามในโค้ด html ของคุณ
        win.document.write('.noborder td, .noborder th, .noborder tr { ');
        win.document.write('    border: none !important; ');
        win.document.write('    border-width: 0 !important; ');
        win.document.write('} ');

        // ⭐ 5. บังคับให้สีพื้นหลังของส่วนหัวตารางแสดงผลเด่นชัด (.header-band ที่เป็นสี #eee)
        win.document.write('.header-band { ');
        win.document.write('    background-color: #eee !important; ');
        win.document.write('    font-weight: 700 !important; ');
        win.document.write('} ');

        win.document.write('<\/style>');
        win.document.write('<\/head><body>');
        win.document.write(el.outerHTML);
        win.document.write('<\/body><\/html>');
        win.document.close();
        setTimeout(function(){win.focus();win.print();},500);
    };

    // ── Events ────────────────────────────────────────────
    $('input[name="document_type"]').on('change', function(){
        toggleDocSections();
        if(selectedDocType()==='withhold' && allWithhold.length===0){
            loadWithholdData();
        }
    });
    $('#btnSearch').on('click', loadData);
    loadData();
});
</script>

