@{
    ViewData["Title"] = "ดาวน์โหลดเอกสารภาษี";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
/* ─── Document preview styles ─── */
.doc-wrap{font-family:'Sarabun',Arial,sans-serif;font-size:.78rem;background:#fff;color:#000;padding:1rem 1.2rem;max-width:860px;margin:0 auto;}
.doc-wrap table{border-collapse:collapse;width:100%;}
.doc-wrap table td,.doc-wrap table th{border:1px solid #888;padding:2px 5px;vertical-align:top;}
.doc-wrap table.noborder td,.doc-wrap table.noborder th{border:none;}
.doc-wrap .doc-title{font-size:1.05rem;font-weight:700;text-align:center;}
.doc-wrap .doc-subtitle{font-size:.78rem;text-align:center;margin-bottom:4px;}
.doc-wrap .section-label{font-size:.72rem;color:#555;}
.doc-wrap .field-underline{border:none;border-bottom:1px solid #333;min-width:60px;display:inline-block;}
.doc-wrap .chk-row{display:flex;align-items:flex-start;gap:4px;margin-bottom:2px;}
.doc-wrap .chk-box{width:12px;height:12px;border:1px solid #333;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0;margin-top:2px;}
.doc-wrap .checked::after{content:'✔';font-size:9px;line-height:1;}
.doc-wrap .amt-col{text-align:right;min-width:90px;}
.doc-wrap .header-band{background:#f0f0f0;font-weight:700;text-align:center;}
.doc-company-logo{width:72px;height:72px;border:2px solid #333;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:.65rem;text-align:center;color:#1565c0;flex-shrink:0;}
@@media print{
  body *{visibility:hidden;}
  #printSection,#printSection *{visibility:visible;}
  #printSection{position:fixed;top:0;left:0;width:100%;}
}
</style>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
        <i class="bx bx-download fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">ดาวน์โหลดเอกสารภาษี</h5>
      </div>
      <div class="card-body p-3">

        <!-- ── Search bar ───────────────────────────────── -->
        <div class="border rounded p-3 mb-3" style="background:#fafafa;">
          <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
            <h6 class="mb-0 fw-semibold">ค้นหาเอกสาร</h6>
            <div class="d-flex align-items-center gap-3">
              <span class="text-danger fw-semibold" style="font-size:.78rem;"><i class="bx bx-check-circle me-1"></i>มี API ดึงข้อมูล</span>
              <a href="javascript:void(0)" id="btnToggleYearly" class="text-danger fw-semibold" style="font-size:.78rem;text-decoration:underline;">
                <i class="bx bx-calendar me-1"></i>แสดงตารางสรุปเป็นปี
              </a>
            </div>
          </div>
          <div class="row g-2 align-items-end">
            <div class="col-auto">
              <label class="form-label mb-1 fw-semibold" style="font-size:.8rem;">ประเภทเอกสาร</label>
              <div class="d-flex gap-3">
                <div class="form-check mb-0">
                  <input class="form-check-input" type="radio" name="document_type" id="rdoTaxInvoice" value="tax" checked>
                  <label class="form-check-label" for="rdoTaxInvoice" style="font-size:.85rem;">ใบกำกับภาษี</label>
                </div>
                <div class="form-check mb-0">
                  <input class="form-check-input" type="radio" name="document_type" id="rdoWithhold" value="withhold">
                  <label class="form-check-label" for="rdoWithhold" style="font-size:.85rem;">หนังสือรับรองหัก ณ ที่จ่าย (50ทวิ)</label>
                </div>
              </div>
            </div>
            <div class="col-md-3">
              <label for="fromDate" class="form-label mb-1 fw-semibold" style="font-size:.8rem;">จากวันที่</label>
              <input type="date" class="form-control form-control-sm" id="fromDate" />
            </div>
            <div class="col-md-3">
              <label for="toDate" class="form-label mb-1 fw-semibold" style="font-size:.8rem;">ถึงวันที่</label>
              <input type="date" class="form-control form-control-sm" id="toDate" />
            </div>
            <div class="col-auto">
              <button class="btn btn-primary btn-sm px-4" id="btnSearch">
                <i class="bx bx-search me-1"></i>ค้นหา
              </button>
            </div>
          </div>
        </div>

        <!-- ── Table 1: ใบกำกับภาษี ──────────────────── -->
        <div class="mb-4">
          <h6 class="fw-semibold mb-2">รายการเอกสาร <span class="text-danger">ใบกำกับภาษี</span></h6>
          <div class="table-responsive">
            <table id="tblTaxInvoice" class="table table-bordered table-hover table-sm nowrap" style="width:100%;font-size:.8rem;">
              <thead class="text-center" style="background:linear-gradient(135deg,#e3f2fd,#bbdefb);">
                <tr>
                  <th>เลขที่เอกสาร</th>
                  <th>วันที่เอกสาร</th>
                  <th class="text-danger">เลขที่อ้างอิง</th>
                  <th>ประเภทเอกสาร</th>
                  <th>ยอดรวม (รวมภาษี)</th>
                  <th>ดูและดาวน์โหลด</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <!-- ── Table 2: หนังสือรับรอง 50ทวิ ─────────── -->
        <div class="mb-3">
          <h6 class="fw-semibold mb-2">หนังสือรับรองหัก ณ ที่จ่าย (50ทวิ)</h6>
          <div class="table-responsive">
            <table id="tblWithhold" class="table table-bordered table-hover table-sm nowrap" style="width:100%;font-size:.8rem;">
              <thead class="text-center" style="background:linear-gradient(135deg,#fce4ec,#f8bbd9);">
                <tr>
                  <th>เลขที่เอกสาร</th>
                  <th class="text-danger">รอบปีภาษี</th>
                  <th class="text-danger">วันที่จ่าย</th>
                  <th>จำนวนเงินที่จ่าย</th>
                  <th>ภาษีที่หัก</th>
                  <th>ดูและดาวน์โหลด</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

        <!-- ── Yearly summary ──────────────────────────── -->
        <div id="sectionYearly" class="d-none mb-3">
          <h6 class="fw-semibold mb-2 text-danger"><i class="bx bx-calendar me-1"></i>ตารางสรุปเป็นปี</h6>
          <div class="table-responsive">
            <table id="tblYearly" class="table table-bordered table-hover table-sm nowrap" style="width:100%;font-size:.8rem;">
              <thead class="text-center" style="background:linear-gradient(135deg,#e8f5e9,#c8e6c9);">
                <tr>
                  <th>ปีภาษี</th><th>จำนวนใบกำกับ</th><th>ยอดรวมใบกำกับ (รวมภาษี)</th>
                </tr>
              </thead>
              <tbody></tbody>
            </table>
          </div>
        </div>

      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     Modal: ใบเสร็จรับเงิน / ใบกำกับภาษี
═══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="taxDetailModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header p-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
        <span class="fw-bold text-white"><i class="bx bx-receipt me-2"></i>ใบเสร็จรับเงิน / ใบกำกับภาษี</span>
        <div class="d-flex gap-2 ms-auto">
          <button class="btn btn-sm btn-light" onclick="printDoc('taxInvoiceDoc')"><i class="bx bx-printer me-1"></i>พิมพ์ / บันทึก PDF</button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
      </div>
      <div class="modal-body p-2" id="taxDetailBody">
        <div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-primary"></i></div>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════════
     Modal: หนังสือรับรองการหักภาษี ณ ที่จ่าย (50ทวิ)
═══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="withholdModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header p-2" style="background:linear-gradient(135deg,#c62828,#ef5350);">
        <span class="fw-bold text-white"><i class="bx bx-file-blank me-2"></i>หนังสือรับรองการหักภาษี ณ ที่จ่าย (50ทวิ)</span>
        <div class="d-flex gap-2 ms-auto">
          <button class="btn btn-sm btn-light" onclick="printDoc('withholdDoc')"><i class="bx bx-printer me-1"></i>พิมพ์ / บันทึก PDF</button>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
        </div>
      </div>
      <div class="modal-body p-2" id="withholdBody">
        <div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-danger"></i></div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
    var dtTax=null, dtYearly=null;
    var allTax=[];

    function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
    function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
    function fmt2(v){var n=parseFloat(v);return isNaN(n)?'0.00':n.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
    function fmtDate(v){if(!v)return'';var d=new Date(v);if(isNaN(d.getTime()))return String(v);return d.toLocaleDateString('th-TH');}
    function fmtDateFull(v){if(!v)return'';var d=new Date(v);if(isNaN(d.getTime()))return String(v);return String(d.getDate()).padStart(2,'0')+'/'+String(d.getMonth()+1).padStart(2,'0')+'/'+(d.getFullYear()+543);}
    function p(o,keys,def){def=def===undefined?'':def;for(var i=0;i<keys.length;i++){if(o&&o[keys[i]]!=null)return o[keys[i]];}return def;}

    function initDt(id, rows, cols, dtRef){
        if(dtRef){dtRef.destroy();}
        var $t=$('#'+id); $t.find('tbody').empty();
        rows.forEach(function(r){
            var cells=cols.map(function(fn){return'<td>'+fn(r)+'</td>';}).join('');
            $t.find('tbody').append('<tr>'+cells+'</tr>');
        });
        return $t.DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],
            ordering:true,searching:true,destroy:true,
            language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',
                lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',
                paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
    }

    // ── TaxInvoice table columns ──────────────────────────
    var taxCols=[
        function(r){return'<span class="fw-semibold text-primary">'+esc(p(r,['BillNo','billNo']))+'</span>';},
        function(r){return fmtDate(p(r,['BillDate','billDate']));},
        function(r){return esc(p(r,['ReferenceNo','referenceNo']));},
        function(r){return esc(p(r,['BilltypeCode','billtypeCode','BillTypeCode']));},
        function(r){return'<span class="fw-bold text-success">'+fmt2(p(r,['Pricebeincludetax','TotalAmount','totalAmount'],0))+'</span>';},
        function(r){
            var bn=esc(p(r,['BillNo','billNo']));
            return'<button class="btn btn-sm btn-primary py-0 px-2" onclick="showTaxDetail(\''+bn+'\')">'+
                '<i class="bx bx-show me-1"></i>ดูเอกสาร</button>';
        }
    ];

    // ── Yearly summary ────────────────────────────────────
    function buildYearly(rows){
        var map={};
        rows.forEach(function(r){
            var d=new Date(p(r,['BillDate','billDate']));
            var yr=isNaN(d.getTime())?'ไม่ระบุ':String(d.getFullYear()+543);
            if(!map[yr])map[yr]={yr:yr,cnt:0,amt:0};
            map[yr].cnt++; map[yr].amt+=parseFloat(p(r,['Pricebeincludetax','TotalAmount','totalAmount'],0))||0;
        });
        var yRows=Object.values(map).sort(function(a,b){return String(b.yr).localeCompare(String(a.yr));});
        dtYearly=initDt('tblYearly',yRows,[
            function(r){return'<b>'+esc(r.yr)+'</b>';},
            function(r){return r.cnt;},
            function(r){return'<span class="text-success fw-bold">'+fmt2(r.amt)+'</span>';}
        ],dtYearly);
    }

    // ── Load data ─────────────────────────────────────────
    function loadData(){
        var f=$('#fromDate').val(), t=$('#toDate').val();
        $('#tblTaxInvoice tbody').html('<tr><td colspan="6" class="text-center text-muted py-3"><i class="bx bx-loader bx-spin me-2"></i>กำลังโหลดข้อมูล...</td></tr>');
        $.get('@Url.Action("GetTaxInvoiceData","other")',{fromDate:f,toDate:t},function(json){
            allTax=norm(json);
            dtTax=initDt('tblTaxInvoice',allTax,taxCols,dtTax);
            if(!$('#sectionYearly').hasClass('d-none'))buildYearly(allTax);
        }).fail(function(){
            $('#tblTaxInvoice tbody').html('<tr><td colspan="6" class="text-center text-danger">เกิดข้อผิดพลาดในการดึงข้อมูล</td></tr>');
        });
        initDt('tblWithhold',[],[function(r){return'';},function(r){return'';},function(r){return'';},
            function(r){return'';},function(r){return'';},function(r){return'';}],null);
    }

    // ══════════════════════════════════════════════════════
    // showTaxDetail — ใบเสร็จรับเงิน / ใบกำกับภาษี
    // ══════════════════════════════════════════════════════
    window.showTaxDetail = function(billNo){
        $('#taxDetailBody').html('<div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-primary"></i></div>');
        new bootstrap.Modal(document.getElementById('taxDetailModal')).show();
        var hd=allTax.find(function(r){return p(r,['BillNo','billNo'])===billNo;})||{};

        $.get('@Url.Action("GetTaxInvoiceDetailData","other")',{billNo:billNo},function(json){
            var lines=norm(json);

            var companyName=p(hd,['Companyname','companyname'],'บริษัท เดอะสตาร์ริชชี จำกัด (สำนักงานใหญ่)');
            var companyAddr=p(hd,['Companyaddress','companyaddress'],'เลขที่ 16/8 หมู่ 4 ตำบลบึงยี่โถ อำเภอธัญบุรี จังหวัดปทุมธานี 12130');
            var companyTel=p(hd,['Companytelephone','companytelephone'],'021260742');
            var companyTaxID=p(hd,['CompanyTaxID','companyTaxID'],'0135564012380');
            var custName=p(hd,['CustomerName','customerName'],'');
            var custAddr=p(hd,['CustomerAddress','customerAddress'],'');
            var custTel=p(hd,['CustomerTelephone','customerTelephone'],'');
            var custTaxID=p(hd,['CustomerTaxID','customerTaxID'],'');
            var membercode=p(hd,['Membercode','membercode'],'');
            var createby=p(hd,['Createby','createby'],'');
            var paymentType=p(hd,['PaymentType','paymentType'],'');
            var billDate=fmtDateFull(p(hd,['BillDate','billDate']));
            var refNo=p(hd,['ReferenceNo','referenceNo'],'');
            var priceBeforeTax=parseFloat(p(hd,['Pricebeforetax','pricebeforetax'],0))||0;
            var taxFee=parseFloat(p(hd,['Taxfee','taxfee'],0))||0;
            var priceIncTax=parseFloat(p(hd,['Pricebeincludetax','pricebeincludetax'],0))||0;
            var shipping=parseFloat(p(hd,['ShippingFee','shippingFee'],0))||0;
            var totalPV=parseFloat(p(hd,['TotalPV','totalPV'],0))||0;
            var netTotal=priceIncTax+shipping;

            // Number to Thai text
            function thaiAmount(n){
                var units=['','หนึ่ง','สอง','สาม','สี่','ห้า','หก','เจ็ด','แปด','เก้า'];
                var places=['','สิบ','ร้อย','พัน','หมื่น','แสน','ล้าน'];
                if(!n||n===0)return'ศูนย์บาทถ้วน';
                var s=Math.round(n*100);
                var satang=s%100; var baht=Math.floor(s/100);
                function toWord(num){
                    if(num===0)return'';
                    var digits=[]; var tmp=num;
                    while(tmp>0){digits.unshift(tmp%10);tmp=Math.floor(tmp/10);}
                    var w='';
                    for(var i=0;i<digits.length;i++){
                        var d=digits[i]; var pos=digits.length-1-i;
                        if(d===0)continue;
                        if(pos===1&&d===1)w+='สิบ';
                        else if(pos===0&&d===1&&digits.length>1)w+='เอ็ด';
                        else w+=units[d];
                        if(d!==0&&pos>0)w+=places[pos];
                    }return w;
                }
                var result=toWord(baht)+'บาท';
                if(satang>0)result+=toWord(satang)+'สตางค์'; else result+='ถ้วน';
                return result;
            }

            var pt=String(paymentType).toLowerCase();
            var isXfer=pt.indexOf('โอน')>-1||pt.indexOf('transfer')>-1;
            var isCash=pt.indexOf('สด')>-1||pt.indexOf('cash')>-1;
            var isCredit=pt.indexOf('เครดิต')>-1||pt.indexOf('credit')>-1;

            var dispTax=taxFee||(priceIncTax-priceBeforeTax)||0;
            var dispBefore=priceBeforeTax||0;
            if(!dispBefore&&priceIncTax) dispBefore=priceIncTax/1.07;
            if(!dispTax&&priceIncTax) dispTax=priceIncTax-dispBefore;
            var dispInc=priceIncTax||0;

            var html='<div id="taxInvoiceDoc" class="doc-wrap" style="border:1px solid #bbb;">';

            // Header
            html+='<table class="noborder" style="margin-bottom:4px;"><tr>';
            html+='<td style="width:76px;padding:0 6px 0 0;vertical-align:middle;">';
            html+='<div class="doc-company-logo">STAR<br>RICHY</div></td>';
            html+='<td style="vertical-align:top;padding:0 6px 0 0;">';
            html+='<div style="font-size:.9rem;font-weight:700;color:#1a237e;">'+esc(companyName)+'</div>';
            html+='<div style="font-size:.68rem;">'+esc(companyAddr)+'</div>';
            html+='<div style="font-size:.68rem;">TEL. '+esc(companyTel)+'</div>';
            html+='</td>';
            html+='<td style="width:220px;text-align:center;vertical-align:top;padding:0;">';
            html+='<div style="background:#1a237e;color:#fff;padding:4px 8px;font-size:.88rem;font-weight:700;">ใบเสร็จรับเงิน/ใบกำกับภาษี</div>';
            html+='<div style="font-size:.62rem;color:#666;">RECEIPT INVOICE / TAX INVOICE</div>';
            html+='<table class="noborder" style="font-size:.7rem;margin-top:2px;">';
            html+='<tr><td style="text-align:right;color:#555;">เลขประจำตัวผู้เสียภาษี</td><td style="font-family:monospace;font-weight:700;color:#1a237e;">'+esc(companyTaxID)+'</td></tr>';
            html+='<tr><td style="text-align:right;font-weight:700;font-size:.85rem;color:#c62828;">เลขที่</td><td style="font-weight:700;font-size:.85rem;color:#c62828;">'+esc(billNo)+'</td></tr>';
            html+='<tr><td style="text-align:right;color:#555;">หน้า</td><td>1 / 1</td></tr>';
            html+='</table></td>';
            html+='</tr></table>';
            html+='<hr style="border-color:#1a237e;border-width:2px;margin:3px 0;">';

            // Customer + Bill detail
            html+='<table class="noborder" style="margin-bottom:4px;"><tr>';
            html+='<td style="width:55%;vertical-align:top;padding-right:6px;">';
            html+='<div><span class="section-label">ชื่อ </span><b>'+esc(custName)+'</b></div>';
            html+='<div><span class="section-label">ที่อยู่ </span>'+esc(custAddr)+'</div>';
            html+='<div><span class="section-label">โทร. </span>'+esc(custTel)+'</div>';
            html+='</td>';
            html+='<td style="vertical-align:top;padding:0;">';
            html+='<table class="noborder" style="font-size:.7rem;width:100%;">';
            html+='<tr><td class="section-label">เลขที่</td><td style="font-weight:700;text-align:right;color:#1a237e;">'+esc(billNo)+'</td></tr>';
            html+='<tr><td class="section-label">รหัสลูกค้า</td><td style="text-align:right;">'+esc(membercode)+'</td></tr>';
            html+='<tr><td class="section-label">วันที่</td><td style="text-align:right;">'+billDate+'</td></tr>';
            html+='<tr><td class="section-label">เลขประจำตัวผู้เสียภาษี</td><td style="text-align:right;font-family:monospace;">'+esc(custTaxID)+'</td></tr>';
            html+='<tr><td class="section-label">ผู้ทำรายการ</td><td style="text-align:right;">'+esc(createby)+'</td></tr>';
            html+='</table></td>';
            html+='</tr></table>';

            // Product table
            html+='<table style="font-size:.73rem;">';
            html+='<thead><tr class="header-band">';
            html+='<th style="width:32px;text-align:center;">ลำดับ</th>';
            html+='<th style="width:72px;">รหัสสินค้า</th>';
            html+='<th>รายการสินค้า</th>';
            html+='<th style="width:48px;text-align:right;">PV</th>';
