@{
    ViewBag.Title = "ทีมซ้าย";
    ViewBag.pTitle = "Left Team";
    ViewBag.pageTitle = "ทีมซ้าย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <!-- Summary Cards -->
    <div class="col-md-6 mb-3">
        <div class="card summary-card success">
            <div class="card-body">
                <h6 class="text-muted">จำนวนสมาชิก</h6>
                <h3 id="totalMembers" class="mb-0">0</h3>
            </div>
        </div>
    </div>
    <div class="col-md-6 mb-3">
        <div class="card summary-card info">
            <div class="card-body">
                <h6 class="text-muted">PV รวม</h6>
                <h3 id="totalPV" class="mb-0">0</h3>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header bg-success">
                <h5 class="card-title text-white mb-0">
                    <i class="ri-arrow-left-line"></i> ทีมซ้าย
                </h5>
            </div>
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover" id="leftTeamTable">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>รหัส</th>
                                <th>ชื่อ</th>
                                <th>วันที่สมัคร</th>
                                <th>PV</th>
                                <th>สถานะ</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr><td colspan="6" class="text-center py-5">กำลังโหลด...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        loadLeftTeam();
    });

    async function loadLeftTeam() {
        try {
            const response = await fetch('/home/GetMemberInfo');
            const data = await response.json();
            const memberInfo = typeof data === 'string' ? JSON.parse(data) : data;
            const memberCode = (memberInfo?.membercode || memberInfo?.memberInfo?.[0]?.membercode || '').toString().trim();

            if (!memberCode) {
                throw new Error('ไม่พบรหัสสมาชิก');
            }

            const teamResponse = await fetch(`/teaminfomation/GetLeftTeam?memberCode=${memberCode}`);
            const teamResult = await teamResponse.json();
            const teamData = extractRows(typeof teamResult === 'string' ? JSON.parse(teamResult) : teamResult);

            renderTable(teamData);
            updateSummary(teamData);
        } catch (error) {
            console.error('Error:', error);
            $('#tableBody').html('<tr><td colspan="6" class="text-center text-danger">เกิดข้อผิดพลาด</td></tr>');
        }
    }

    function renderTable(data) {
        const tbody = $('#tableBody');
        tbody.empty();

        if (!data || !Array.isArray(data) || data.length === 0) {
            tbody.html('<tr><td colspan="6" class="text-center">ไม่พบข้อมูล</td></tr>');
            return;
        }

        data.forEach((member, index) => {
            const memberCode = member.MemberLeftCode || member.memberLeftCode || '-';
            const memberName = member.MemberLeftName || member.memberLeftName || '-';
            const pv = Number(member.personalpv ?? member.personalPV ?? member.pv ?? 0);
            const statusRaw = ((member.status || member.memberstatus || member.activeStatus || member.Qualify || member.qualify || '') + '').toLowerCase();
            const isActive = statusRaw.includes('active') || statusRaw.includes('Yes') || statusRaw.includes('1');
            const statusClass = isActive ? 'success' : 'secondary';
            const statusText = isActive ? 'ใช้งาน' : 'ไม่ใช้งาน';

            tbody.append(`
                <tr>
                    <td>${index + 1}</td>
                    <td><strong>${memberCode}</strong></td>
                    <td>${memberName}</td>
                    <td>${formatDate(member.registerdate || member.registerDate || member.RegisterDate)}</td>
                    <td><span class="badge bg-success">${pv.toLocaleString()}</span></td>
                    <td><span class="badge bg-${statusClass}">${statusText}</span></td>
                </tr>
            `);
        });
    }

    function updateSummary(data) {
        if (!data || !Array.isArray(data)) return;
        
        $('#totalMembers').text(data.length);
        const totalPV = data.reduce((sum, m) => sum + (parseFloat(m.personalpv ?? m.personalPV ?? m.pv) || 0), 0);
        $('#totalPV').text(totalPV.toFixed(0));
    }

    function formatDate(dateStr) {
        if (!dateStr) return 'N/A';
        const date = new Date(dateStr);
        if (Number.isNaN(date.getTime())) return 'N/A';
        return date.toLocaleDateString('th-TH');
    }

    function extractRows(payload) {
        if (Array.isArray(payload)) return payload;
        if (!payload || typeof payload !== 'object') return [];

        const candidates = [payload.data, payload.result, payload.items, payload.rows, payload.members];
        for (const c of candidates) {
            if (Array.isArray(c)) return c;
        }
        return [];
    }
</script>


@section scripts{
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
}