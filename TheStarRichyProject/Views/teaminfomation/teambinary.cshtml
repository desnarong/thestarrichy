@{
    ViewBag.Title = "ทีมไบนารี่";
    ViewBag.pTitle = "Team Binary";
    ViewBag.pageTitle = "ทีมไบนารี่";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <input type="text" id="memberCodeSearch" class="form-control" 
                                   placeholder="ค้นหารหัสสมาชิก...">
                            <button class="btn btn-primary" onclick="searchMember()">
                                <i class="ri-search-line"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                    <div class="col-md-8 text-end">
                        <button class="btn btn-info" onclick="loadCurrentMember()">
                            <i class="ri-refresh-line"></i> รีเฟรช
                        </button>
                        <button class="btn btn-secondary" onclick="goToParent()">
                            <i class="ri-arrow-up-line"></i> สายงานบน
                        </button>
                        <button class="btn btn-success" onclick="expandAll()">
                            <i class="ri-arrow-down-line"></i> ขยายทั้งหมด
                        </button>
                        <button class="btn btn-warning" onclick="collapseAll()">
                            <i class="ri-collapse-line"></i> ย่อทั้งหมด
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div id="binaryTreeContainer" class="text-center"></div>
                <div id="loadingIndicator" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">กำลังโหลดข้อมูล...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentMemberCode = '';
    let parentMemberCode = '';
    let treeData = null;
    let currentViewedMemberCode = '';
    let navigationHistory = [];

    $(document).ready(function() {
        loadCurrentMember();
    });

    async function loadCurrentMember() {
        try {
            const response = await fetch('/home/GetMemberInfo');
            
            if (!response.ok) {
                throw new Error('Failed to load member info');
            }
            
            const data = await response.json();
            
            // Handle both string (JSON) and object response
            let memberInfo;
            if (typeof data === 'string') {
                memberInfo = JSON.parse(data);
            } else {
                memberInfo = data;
            }
            
            // Response is flat object with membercode directly, not memberInfo[0]
            if (memberInfo && memberInfo.membercode) {
                currentMemberCode = memberInfo.membercode;
                loadBinaryTeam(currentMemberCode, { resetHistory: true });
            } else if (memberInfo && memberInfo.memberInfo && memberInfo.memberInfo.length > 0) {
                // Fallback for nested format
                currentMemberCode = memberInfo.memberInfo[0].membercode;
                loadBinaryTeam(currentMemberCode, { resetHistory: true });
            } else {
                showAlert('warning', 'ไม่พบข้อมูลสมาชิก');
            }
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'ไม่สามารถโหลดข้อมูลสมาชิกได้: ' + error.message);
        }
    }

    async function registerTeam(memberCode) {
        let url = '/member/register';
        if (memberCode) {
            url += `?id=${memberCode}`;
        }
            window.location.href=url;
    }

    async function loadBinaryTeam(memberCode, options = {}) {
        try {
            showLoading(true);

            const isBackNavigation = !!options.isBackNavigation;
            const shouldResetHistory = !!options.resetHistory;
            const requestedCode = (memberCode || '').toString().trim();

            if (shouldResetHistory) {
                navigationHistory = [];
                currentViewedMemberCode = '';
            }

            if (requestedCode) {
                if (!isBackNavigation && currentViewedMemberCode && currentViewedMemberCode !== requestedCode) {
                    navigationHistory.push(currentViewedMemberCode);
                }

                if (isBackNavigation && navigationHistory.length > 0 && navigationHistory[navigationHistory.length - 1] === requestedCode) {
                    navigationHistory.pop();
                }
            }
            
            // สร้าง URL - ถ้ามี memberCode ให้ส่งไปด้วย (สำหรับค้นหา/คลิกดูทีมคนอื่น)
            // ถ้าไม่มี จะดึงจาก JWT อัตโนมัติ
            let url = '/home/GetMemberBinaryTeam';
            if (requestedCode) {
                url += `?membercode=${requestedCode}`;
            }
            
            const response = await fetch(url);
            
            if (!response.ok) {
                throw new Error('Failed to load binary team');
            }
            
            const data = await response.json();
            
            // Handle both string (JSON) and object response
            let result;
            if (typeof data === 'string') {
                result = JSON.parse(data);
            } else {
                result = data;
            }
            
            treeData = result;

            const payload = Array.isArray(result) ? (result[0] || null) : result;
            const binaryTree = payload ? getNodeValue(payload, ['BinaryTree', 'binaryTree'], null) : null;
            const currentNode = Array.isArray(binaryTree)
                ? (binaryTree[0] || null)
                : (binaryTree || payload);
            const resolvedCode = requestedCode || getFirstNonEmptyValue(currentNode, ['ChildCode', 'childCode', 'Membercode', 'membercode'], '');

            if (resolvedCode) {
                currentViewedMemberCode = resolvedCode;
            }

            renderBinaryTree(result, resolvedCode || (Array.isArray(result) ? (result[0]?.Membercode || '') : ''));
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + error.message);
        } finally {
            showLoading(false);
        }
    }

    function getNodeValue(node, keys, fallback = null) {
        if (!node || !Array.isArray(keys)) return fallback;
        for (const key of keys) {
            if (node[key] !== undefined && node[key] !== null) {
                return node[key];
            }
        }
        return fallback;
    }

    function getNodeChildren(node) {
        const children = getNodeValue(node, ['Children', 'children'], []);
        return Array.isArray(children) ? children : [];
    }

    function findNodeInTree(nodes, targetCode) {
        if (!Array.isArray(nodes) || nodes.length === 0 || !targetCode) {
            return null;
        }

        const normalizedTarget = targetCode.toString().trim().toUpperCase();

        for (const node of nodes) {
            const memberCode = getFirstNonEmptyValue(node, ['Membercode', 'membercode'], '').toUpperCase();
            const childCode = getFirstNonEmptyValue(node, ['ChildCode', 'childCode'], '').toUpperCase();

            if (memberCode === normalizedTarget || childCode === normalizedTarget) {
                return node;
            }

            const foundInChildren = findNodeInTree(getNodeChildren(node), normalizedTarget);
            if (foundInChildren) {
                return foundInChildren;
            }
        }

        return null;
    }

    function getFirstNonEmptyValue(node, keys, fallback = '') {
        if (!node || !Array.isArray(keys)) return fallback;
        for (const key of keys) {
            const value = node[key];
            if (value !== undefined && value !== null && value.toString().trim() !== '') {
                return value.toString().trim();
            }
        }
        return fallback;
    }

    function isTreeEmptyNode(node) {
        if (!node) return true;
        const isEmptyFlag = !!getNodeValue(node, ['IsEmptyNode', 'isEmptyNode'], false);
        const membercode = (getNodeValue(node, ['Membercode', 'membercode'], '') || '').toString();
        const childCode = (getNodeValue(node, ['ChildCode', 'childCode'], '') || '').toString();
        const membername = (getNodeValue(node, ['Membername', 'membername'], '') || '').toString();
        return isEmptyFlag || membercode.startsWith('EMPTY_') || membername === '(ว่าง)' || (!membercode && !childCode);
    }

    function pickBinaryChildren(children) {
        if (!Array.isArray(children) || children.length === 0) {
            return { leftChild: null, rightChild: null };
        }

        const leftCandidates = [];
        const rightCandidates = [];
        const neutralCandidates = [];

        children.forEach((child) => {
            const level = (getNodeValue(child, ['PositionLevel', 'positionLevel'], '') || '').toString().toLowerCase();
            if (level.includes('left')) {
                leftCandidates.push(child);
            } else if (level.includes('right')) {
                rightCandidates.push(child);
            } else {
                neutralCandidates.push(child);
            }
        });

        const leftReal = leftCandidates.find(c => !isTreeEmptyNode(c));
        const rightReal = rightCandidates.find(c => !isTreeEmptyNode(c));
        const neutralReal = neutralCandidates.find(c => !isTreeEmptyNode(c));

        let leftChild = leftReal || leftCandidates[0] || neutralReal || neutralCandidates[0] || rightReal || rightCandidates[0] || null;
        let rightChild = rightReal || rightCandidates.find(c => c !== leftChild) || neutralReal || neutralCandidates.find(c => c !== leftChild) || leftReal || leftCandidates.find(c => c !== leftChild) || null;

        if (leftChild && rightChild && leftChild === rightChild) {
            rightChild = children.find(c => c !== leftChild) || null;
        }

        return { leftChild, rightChild };
    }

    function renderBinaryTree(data, centerCode) {
        const container = $('#binaryTreeContainer');
        container.empty();

        if (!data) {
            container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
            return;
        }

        const payload = Array.isArray(data) ? (data[0] || null) : data;
        if (!payload) {
            container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
            return;
        }

        const binaryTree = getNodeValue(payload, ['BinaryTree', 'binaryTree'], null);
        if (!binaryTree) {
            renderOldStyle(Array.isArray(data) ? data : [data], centerCode);
            return;
        }

        const rootNodes = Array.isArray(binaryTree) ? binaryTree : [binaryTree];
        if (rootNodes.length === 0) {
            container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
            return;
        }

        let html = `<div class="binary-tree-container">`;
        rootNodes.forEach((rootNode) => {
            html += renderTreeNode(rootNode, 0);
        });
        html += `</div>`;
        container.html(html);
    }

    function renderTreeNode(node, level) {
        if (!node) return '';

        const membercode = getFirstNonEmptyValue(node, ['ChildCode', 'childCode', 'Membercode', 'membercode'], '');
        const nodeMemberCode = getFirstNonEmptyValue(node, ['Membercode', 'membercode'], '');
        const membername = getNodeValue(node, ['Membername', 'membername', 'Idcardname', 'idcardname'], 'N/A');
        const memberposition = getNodeValue(node, ['Memberposition', 'memberposition'], '');
        const memberpositionName = getNodeValue(node, ['MemberpositionName', 'memberpositionName'], '');
        const memberthaiName = getNodeValue(node, ['MemberpositionRankingName', 'memberpositionRankingName', 'MemberpositionRanking', 'memberpositionRanking'], 'ไม่มีตำแหน่ง');
        const currentMonth1 = getNodeValue(node, ['currentMonth1', 'CurrentMonth1'], '');
        const lastmonthQualifyPV = getNodeValue(node, ['lastmonthQualifyPV', 'LastmonthQualifyPV', 'lastMonthQualifyPV', 'LastMonthQualifyPV'], 0);
        const positionLevel = (getNodeValue(node, ['PositionLevel', 'positionLevel'], '') || '').toString();

        const currentLeftPV = getNodeValue(node, ['CurrentLeftPV', 'currentLeftPV'], 0);
        const currentRightPV = getNodeValue(node, ['CurrentRightPV', 'currentRightPV'], 0);
        const newLeft = getNodeValue(node, ['NewLeft', 'newLeft'], 0);
        const newRight = getNodeValue(node, ['NewRight', 'newRight'], 0);
        const leftCountActive = getNodeValue(node, ['LeftCountActive', 'leftCountActive'], 0);
        const rightCountActive = getNodeValue(node, ['RightCountActive', 'rightCountActive'], 0);
        const totalLeftBalance = getNodeValue(node, ['TotalLeftBalance', 'totalLeftBalance'], 0);
        const totalRightBalance = getNodeValue(node, ['TotalRightBalance', 'totalRightBalance'], 0);

        const lastMonthQualifyStatus = (getNodeValue(node, ['LastMonthQualifyStatus', 'lastMonthQualifyStatus'], 'No') || 'No').toString();
        const cardColorClass = lastMonthQualifyStatus === 'Yes' ? 'card-green' : 'card-red';
        const memberPicture = getNodeValue(node, ['MemberPostionPicture', 'memberPostionPicture', 'MemberPositionPicture', 'memberPositionPicture'], '/images/1_Black1_40x40.gif');

        const children = getNodeChildren(node);
        const { leftChild, rightChild } = pickBinaryChildren(children);

        const hasLeftChild = !!leftChild;
        const hasRightChild = !!rightChild;
        const hasRealLeft = hasLeftChild && !isTreeEmptyNode(leftChild);
        const hasRealRight = hasRightChild && !isTreeEmptyNode(rightChild);

        const isLeft = positionLevel.toLowerCase().includes('left');
        const isRight = positionLevel.toLowerCase().includes('right');

        let gradientClass = 'gradient-center';
        if (memberposition === 'SS' || memberposition === 'Silver Star') {
            gradientClass = 'gradient-silver';
        } else if (memberposition === 'GS' || memberposition === 'Gold Star') {
            gradientClass = 'gradient-gold';
        } else if (memberposition === 'DGS' || memberposition === 'Double Gold Star') {
            gradientClass = 'gradient-diamond';
        } else if (isLeft) {
            gradientClass = 'gradient-left';
        } else if (isRight) {
            gradientClass = 'gradient-right';
        }

        const isEmpty = isTreeEmptyNode(node);
        const isLastLevel = children.length === 0;
        const safeMemberCode = (membercode || nodeMemberCode).replace(/'/g, "\\'");
        const registerBaseCodeRaw = nodeMemberCode || membercode || 'root';
        const registerBaseCode = registerBaseCodeRaw.replace(/'/g, "\\'");

        let html = `<div class="tree-node-wrapper" data-level="${level}">`;

        if (isEmpty) {
            html += `
                <div class="empty-node" onclick="registerTeam('${registerBaseCode}')">
                    <i class="ri-add-circle-line ri-2x"></i>
                    <span>ว่าง</span>
                </div>
            `;
        } else {
            html += `
                <div class="tree-node ${gradientClass} ${cardColorClass} ${isLastLevel ? 'level-last' : ''}" onclick="loadBinaryTeam('${safeMemberCode}')" title="คลิกเพื่อดูทีม">
                    <div class="node-main">
                        <div class="node-avatar">
                            <img src="${memberPicture}" alt="${membername}" class="member-picture">
                            <div class="member-thainame">${memberthaiName}</div>
                        </div>
                        <div class="node-details">
                            <div class="member-name">${membername}</div>
                            <div class="member-code">${membercode}</div>
                            <div class="member-position">${memberpositionName || memberposition}</div>
                            <div class="member-position-ranking">รักษายอด ${currentMonth1} - ${lastmonthQualifyPV}</div>
                        </div>
                    </div>
                    ${!isLastLevel ? `
                    <div class="node-stats">
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${currentLeftPV}]</div>
                                <div class="middle-text">คะแนน</div>
                                <div class="stat-value right-card">[R:${currentRightPV}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${newLeft}]</div>
                                <div class="middle-text">คะแนนมาใหม่</div>
                                <div class="stat-value right-card">[R:${newRight}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${leftCountActive}]</div>
                                <div class="middle-text">Active</div>
                                <div class="stat-value right-card">[R:${rightCountActive}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${totalLeftBalance}]</div>
                                <div class="middle-text">Balance</div>
                                <div class="stat-value right-card">[R:${totalRightBalance}]</div>
                            </div>
                        </div>
                    </div>
                    ` : ''}
                </div>
            `;
        }

        if (!isLastLevel) {
            html += `<div class="tree-children">`;
            html += `<div class="tree-connector"></div>`;
            const leftIsLast = !hasRealLeft || getNodeChildren(leftChild).length === 0;
            const rightIsLast = !hasRealRight || getNodeChildren(rightChild).length === 0;
            const childrenContainerClass = (leftIsLast && rightIsLast)
                ? `children-container children-container-last`
                : `children-container children-container-level-${level + 1}`;
            const leftIsEmpty = !hasRealLeft;
            const rightIsEmpty = !hasRealRight;
            const level1LeftEmptyClass = (level + 1 === 1 && leftIsEmpty)
                ? ' children-container-level-1-left-empty'
                : '';
            const level1NoEmptyClass = (level + 1 === 1 && !leftIsEmpty && !rightIsEmpty)
                ? ' children-container-level-1-no-empty'
                : '';
            const level1RightEmptyClass = (level + 1 === 1 && rightIsEmpty)
                ? ' children-container-level-1-right-empty'
                : '';
            const leftGrandChildren = getNodeChildren(leftChild);
            const leftGrandChildrenPicked = pickBinaryChildren(leftGrandChildren);
            const leftLevel2RightEmpty = !leftGrandChildrenPicked.rightChild || isTreeEmptyNode(leftGrandChildrenPicked.rightChild);
            const level1NoEmptyLeftLevel2RightEmptyClass = (level + 1 === 1 && !leftIsEmpty && !rightIsEmpty && leftLevel2RightEmpty)
                ? ' children-container-level-1-no-empty-left-level2-right-empty'
                : '';
            const rightGrandChildren = getNodeChildren(rightChild);
            const rightLevel2AllEmpty = rightGrandChildren.length >= 2 && rightGrandChildren.every(child => isTreeEmptyNode(child));
            const level1LeftEmptyRightLevel2AllEmptyClass = (level + 1 === 1 && leftIsEmpty && rightLevel2AllEmpty)
                ? ' children-container-level-1-left-empty-right-level2-all-empty'
                : '';
            const level1RightLevel2AllEmptyClass = (level + 1 === 1 && !leftIsEmpty && !rightIsEmpty && rightLevel2AllEmpty)
                ? ' children-container-level-1-right-level2-all-empty'
                : '';
            const level2RightEmptyClass = (level + 1 === 2 && rightIsEmpty)
                ? ' children-container-level-2-right-empty'
                : '';

            html += `<div class="${childrenContainerClass}${level1LeftEmptyClass}${level1NoEmptyClass}${level1RightEmptyClass}${level1NoEmptyLeftLevel2RightEmptyClass}${level1LeftEmptyRightLevel2AllEmptyClass}${level1RightLevel2AllEmptyClass}${level2RightEmptyClass}">`;

            if (hasRealLeft) {
                html += `<div class="child-branch left">${renderTreeNode(leftChild, level + 1)}</div>`;
            } else if (hasLeftChild) {
                html += `
                    <div class="child-branch left">
                        <div class="empty-node small" onclick="registerTeam('${registerBaseCode}L')">
                            <i class="ri-add-circle-line"></i>
                            <span>ว่าง</span>
                        </div>
                    </div>
                `;
            } else {
                html += `
                    <div class="child-branch left">
                        <div class="empty-node small" onclick="registerTeam('${registerBaseCode}L')">
                            <i class="ri-add-circle-line"></i>
                            <span>ว่าง</span>
                        </div>
                    </div>
                `;
            }

            if (hasRealRight) {
                html += `<div class="child-branch right">${renderTreeNode(rightChild, level + 1)}</div>`;
            } else if (hasRightChild) {
                html += `
                    <div class="child-branch right">
                        <div class="empty-node small" onclick="registerTeam('${registerBaseCode}R')">
                            <i class="ri-add-circle-line"></i>
                            <span>ว่าง</span>
                        </div>
                    </div>
                `;
            } else {
                html += `
                    <div class="child-branch right">
                        <div class="empty-node small" onclick="registerTeam('${registerBaseCode}R')">
                            <i class="ri-add-circle-line"></i>
                            <span>ว่าง</span>
                        </div>
                    </div>
                `;
            }

            html += `</div>`;
            html += `</div>`;
        }

        html += `</div>`;
        return html;
    }

    // สำหรับกรณีไม่มี BinaryTree (ใช้ข้อมูลเดิม)
    function renderOldStyle(data, centerCode) {
        const container = $('#binaryTreeContainer');
        
        const center = data.find(m => m.membercode === centerCode) || data[0];
        
        let html = `
            <div class="binary-tree">
                <div class="tree-level">
                    ${renderNode(center, 'center')}
                </div>
                <div class="tree-level mt-4">
                    <div class="row justify-content-center">
                        <div class="col-md-6">${renderNode(null, 'left')}</div>
                        <div class="col-md-6">${renderNode(null, 'right')}</div>
                    </div>
                </div>
            </div>
        `;
        
        container.html(html);
    }

    function renderNode(member, position) {
        if (!member) {
            return `
                <div class="node-card empty">
                    <div class="text-muted">
                        <i class="ri-user-add-line ri-3x mb-2"></i>
                        <p>ว่าง</p>
                    </div>
                </div>
            `;
        }

        const positionColor = position === 'left' ? 'success' : position === 'right' ? 'warning' : 'info';
        
        return `
            <div class="node-card ${positionColor}" onclick="loadBinaryTeam('${member.membercode}')">
                <div class="position-badge badge bg-${positionColor}">
                    ${position === 'left' ? 'ซ้าย' : position === 'right' ? 'ขวา' : 'ศูนย์กลาง'}
                </div>
                <img src="${member.profileImage || '/assets/images/users/avatar-1.jpg'}" 
                     class="node-avatar" alt="${member.idcardname}">
                <div class="node-info">
                    <h6 class="mb-1">${member.idcardname || 'N/A'}</h6>
                    <p class="text-muted mb-1 small">${member.membercode}</p>
                    <p class="text-${positionColor} mb-0"><strong>PV: ${member.personalpv || 0}</strong></p>
                </div>
            </div>
        `;
    }

    function searchMember() {
        const memberCode = $('#memberCodeSearch').val().trim();
        if (!memberCode) {
            showAlert('warning', 'กรุณากรอกรหัสสมาชิก');
            return;
        }
        loadBinaryTeam(memberCode, { resetHistory: true });
    }

    function goToParent() {
        if (!treeData) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const payload = Array.isArray(treeData) ? (treeData[0] || null) : treeData;
        if (!payload) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        console.log('Payload for goToParent:', payload);

        const binaryTree = getNodeValue(payload, ['BinaryTree', 'binaryTree'], null);
        const rootNodes = Array.isArray(binaryTree)
            ? binaryTree
            : (binaryTree ? [binaryTree] : []);

        const currentNode = rootNodes.length > 0
            ? (findNodeInTree(rootNodes, currentViewedMemberCode) || rootNodes[0])
            : payload;

        if (!currentNode) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const parentCode = getFirstNonEmptyValue(currentNode, ['ParentCode', 'parentCode'], '');
        if (parentCode && !parentCode.startsWith('EMPTY_')) {
            loadBinaryTeam(parentCode, { isBackNavigation: true });
            return;
        }

        const fallbackParentCode = navigationHistory.length > 0
            ? navigationHistory[navigationHistory.length - 1]
            : '';

        if (fallbackParentCode) {
            loadBinaryTeam(fallbackParentCode, { isBackNavigation: true });
            return;
        }

        showAlert('info', 'ไม่มีสายงานบนแล้ว');
    }

    function expandAll() {
        $('.tree-children').slideDown();
        $('.child-branch').removeClass('collapsed');
    }

    function collapseAll() {
        $('.tree-children').slideUp();
        $('.child-branch').addClass('collapsed');
    }

    function showLoading(show) {
        if (show) {
            $('#loadingIndicator').removeClass('d-none');
            $('#binaryTreeContainer').addClass('d-none');
        } else {
            $('#loadingIndicator').addClass('d-none');
            $('#binaryTreeContainer').removeClass('d-none');
        }
    }

    function showAlert(type, message) {
        const alertClass = `alert-${type}`;
        const alert = `
            <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;

        const alertContainer = $('#binaryTreeContainer').parent();
        alertContainer.prepend(alert);
        
        setTimeout(() => {
            $('.alert').alert('close');
        }, 3000);
    }
</script>

<style>
.binary-tree-container {
    padding: 20px;
