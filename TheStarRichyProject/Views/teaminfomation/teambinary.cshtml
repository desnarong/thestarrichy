@{
    ViewBag.Title = "ทีมไบนารี่";
    ViewBag.pTitle = "Team Binary";
    ViewBag.pageTitle = "ทีมไบนารี่";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <div class="input-group">
                            <input type="text" id="memberCodeSearch" class="form-control" 
                                   placeholder="ค้นหารหัสสมาชิก...">
                            <button class="btn btn-primary" onclick="searchMember()">
                                <i class="ri-search-line"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                    <div class="col-md-8 text-end">
                        <button class="btn btn-info" onclick="loadCurrentMember()">
                            <i class="ri-refresh-line"></i> รีเฟรช
                        </button>
                        <button class="btn btn-secondary" onclick="goToParent()">
                            <i class="ri-arrow-up-line"></i> สายงานบน
                        </button>
                        <button class="btn btn-success" onclick="expandAll()">
                            <i class="ri-arrow-down-line"></i> ขยายทั้งหมด
                        </button>
                        <button class="btn btn-warning" onclick="collapseAll()">
                            <i class="ri-collapse-line"></i> ย่อทั้งหมด
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div id="binaryTreeContainer" class="text-center"></div>
                <div id="loadingIndicator" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">กำลังโหลดข้อมูล...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let currentMemberCode = '';
    let parentMemberCode = '';
    let treeData = null;

    $(document).ready(function() {
        loadCurrentMember();
    });

    async function loadCurrentMember() {
        try {
            const response = await fetch('/home/GetMemberInfo');
            
            if (!response.ok) {
                throw new Error('Failed to load member info');
            }
            
            const data = await response.json();
            
            // Handle both string (JSON) and object response
            let memberInfo;
            if (typeof data === 'string') {
                memberInfo = JSON.parse(data);
            } else {
                memberInfo = data;
            }
            
            // Response is flat object with membercode directly, not memberInfo[0]
            if (memberInfo && memberInfo.membercode) {
                currentMemberCode = memberInfo.membercode;
                loadBinaryTeam(currentMemberCode);
            } else if (memberInfo && memberInfo.memberInfo && memberInfo.memberInfo.length > 0) {
                // Fallback for nested format
                currentMemberCode = memberInfo.memberInfo[0].membercode;
                loadBinaryTeam(currentMemberCode);
            } else {
                showAlert('warning', 'ไม่พบข้อมูลสมาชิก');
            }
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'ไม่สามารถโหลดข้อมูลสมาชิกได้: ' + error.message);
        }
    }

    async function registerTeam(memberCode) {
        let url = '/member/register';
        if (memberCode) {
            url += `?id=${memberCode}`;
        }
            window.location.href=url;
    }

    async function loadBinaryTeam(memberCode) {
        try {
            showLoading(true);
            
            // สร้าง URL - ถ้ามี memberCode ให้ส่งไปด้วย (สำหรับค้นหา/คลิกดูทีมคนอื่น)
            // ถ้าไม่มี จะดึงจาก JWT อัตโนมัติ
            let url = '/home/GetMemberBinaryTeam';
            if (memberCode) {
                url += `?membercode=${memberCode}`;
            }
            
            const response = await fetch(url);
            
            if (!response.ok) {
                throw new Error('Failed to load binary team');
            }
            
            const data = await response.json();
            
            // Handle both string (JSON) and object response
            let result;
            if (typeof data === 'string') {
                result = JSON.parse(data);
            } else {
                result = data;
            }
            
            treeData = result;
            renderBinaryTree(result, memberCode || (result[0]?.Membercode || ''));
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + error.message);
        } finally {
            showLoading(false);
        }
    }

        function renderBinaryTree(data, centerCode) {
            const container = $('#binaryTreeContainer');
            container.empty();

            if (!data || !Array.isArray(data) || data.length === 0) {
                container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
                return;
            }

            // ข้อมูลจาก API เป็น array ของ objects ทุกตำแหน่ง
            // BinaryTree อยู่ใน property BinaryTree ของ object แรก
            const mainData = data[0];
            
            if (!mainData) {
                container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
                return;
            }

            // ดึง BinaryTree จากข้อมูลหลัก
            const binaryTree = mainData.BinaryTree;
            
            if (binaryTree && Array.isArray(binaryTree) && binaryTree.length > 0) {
                // สร้าง dictionary จากข้อมูลทั้งหมดเพื่อค้นหา children
                const positionDict = {};
                data.forEach(item => {
                    if (item.PositionLevel) {
                        positionDict[item.PositionLevel] = item;
                    }
                });
                
                // ส่งข้อมูลทั้งหมดและ dictionary ไปให้ renderTreeNode
                let html = `<div class="binary-tree-container">`;
                binaryTree.forEach((rootNode, index) => {
                    html += renderTreeNode(rootNode, 0, index, data, positionDict);
                });
                html += `</div>`;
                container.html(html);
            } else if (binaryTree && binaryTree.Membercode) {
                // ถ้า BinaryTree เป็น single object
                const positionDict = {};
                data.forEach(item => {
                    if (item.PositionLevel) {
                        positionDict[item.PositionLevel] = item;
                    }
                });
                
                let html = `<div class="binary-tree-container">`;
                html += renderTreeNode(binaryTree, 0, 0, data, positionDict);
                html += `</div>`;
                container.html(html);
            } else {
                // Fallback ใช้ข้อมูลเดิม
                renderOldStyle(data, centerCode);
            }
        }

    function renderTreeNode(node, level, index = 0, allData = null, positionDict = null) {
        if (!node) return '';
        
        const membercode = node.ChildCode || '';
        const membername = node.Membername || node.Idcardname || 'N/A';
        const personalPV = node.PersonalPV || 0;
        const memberposition = node.Memberposition || '';
        const memberpositionName = node.MemberpositionName || '';
        const memberthaiName = node.thaiName || 'ไม่มีตำแหน่ง';
        const currentMonth1 = node.currentMonth1 || '';
        const lastmonthQualifyPV = node.lastmonthQualifyPV || 0;
        const memberpositionRanking = node.MemberpositionRankingName || node.MemberpositionRanking || '';
        const children = node.Children || [];
        const levelInfo = node.Level || 1;
        const positionLevel = node.PositionLevel || '';
        
        // หา left และ right จาก PositionLevel
        const isLeft = positionLevel && positionLevel.toString().includes('Left');
        const isRight = positionLevel && positionLevel.toString().includes('Right');
        
        // ข้อมูลสำหรับแสดงผล
        const currentLeftPV = node.CurrentLeftPV || 0;
        const currentRightPV = node.CurrentRightPV || 0;
        const newLeft = node.NewLeft || 0;
        const newRight = node.NewRight || 0;
        const leftCountActive = node.LeftCountActive || 0;
        const rightCountActive = node.RightCountActive || 0;
        const totalLeftBalance = node.TotalLeftBalance || 0;
        const totalRightBalance = node.TotalRightBalance || 0;
        
        // สถานะรักษายอด
        const lastMonthQualifyStatus = node.LastMonthQualifyStatus || 'No';
        const currentMonthQualifyStatus = node.CurrentMonthQualifyStatus || 'No';
        
        // สีการ์ดตามสถานะรักษายอด (ใช้สีพื้นหลังแทน badge)
        const cardColorClass = lastMonthQualifyStatus === 'Yes' ? 'card-green' : 'card-red';
        
        // รูปภาพสมาชิก
        const memberPicture = node.MemberPostionPicture || 'images/1_Black1_40x40.gif';
        
        // หา children จาก positionDict ถ้ามี
        let leftChild = null;
        let rightChild = null;
        
        if (positionDict && positionLevel) {
            // หา children ตามโครงสร้างไบนารี่จาก JSON
            // ใช้ ChildCode เพื่อค้นหา children ที่ถูกต้อง
            const childCode = node.ChildCode || '';
            
            if (positionLevel === 'Root' || positionLevel === 'Membercode') {
                // Root -> Leftcode1 และ Rightcode1
                leftChild = positionDict['Leftcode1'] || null;
                rightChild = positionDict['Rightcode1'] || null;
            } else if (positionLevel === 'Leftcode1') {
                // Leftcode1 -> Leftcode21 และ Rightcode22
                leftChild = positionDict['Leftcode21'] || null;
                rightChild = positionDict['Rightcode22'] || null;
            } else if (positionLevel === 'Rightcode1') {
                // Rightcode1 -> Leftcode23 และ Rightcode24
                leftChild = positionDict['Leftcode23'] || null;
                rightChild = positionDict['Rightcode24'] || null;
            } else if (positionLevel === 'Leftcode21') {
                // Leftcode21 -> Leftcode31 และ Rightcode32
                leftChild = positionDict['Leftcode31'] || null;
                rightChild = positionDict['Rightcode32'] || null;
            } else if (positionLevel === 'Rightcode22') {
                // Rightcode22 -> Leftcode33 และ Rightcode34
                leftChild = positionDict['Leftcode33'] || null;
                rightChild = positionDict['Rightcode34'] || null;
            } else if (positionLevel === 'Leftcode23') {
                // Leftcode23 -> Leftcode35 และ Rightcode36
                leftChild = positionDict['Leftcode35'] || null;
                rightChild = positionDict['Rightcode36'] || null;
            } else if (positionLevel === 'Rightcode24') {
                // Rightcode24 -> Leftcode37 และ Rightcode38
                leftChild = positionDict['Leftcode37'] || null;
                rightChild = positionDict['Rightcode38'] || null;
            }
            
            // ตรวจสอบว่า child มีข้อมูลจริงหรือไม่
            // ถ้า ChildCode เป็น "ว่าง/Empty" หรือไม่มี Membercode ให้ถือว่าเป็น empty
            if (leftChild && (leftChild.ChildCode === 'ว่าง/Empty' || !leftChild.Membercode || leftChild.Membercode === '')) {
                leftChild = null;
            }
            if (rightChild && (rightChild.ChildCode === 'ว่าง/Empty' || !rightChild.Membercode || rightChild.Membercode === '')) {
                rightChild = null;
            }
        }
        
        // ตรวจสอบว่าเป็น level สุดท้ายหรือไม่ (level 3)
        // ถ้าเป็น level 3 (Leftcode31-38) ไม่ต้องแสดง children container อีก
        const isLevel3 = positionLevel && (
            positionLevel === 'Leftcode31' || positionLevel === 'Rightcode32' ||
            positionLevel === 'Leftcode33' || positionLevel === 'Rightcode34' ||
            positionLevel === 'Leftcode35' || positionLevel === 'Rightcode36' ||
            positionLevel === 'Leftcode37' || positionLevel === 'Rightcode38'
        );
        
        // สีตาม position
        let gradientClass = 'gradient-center';
        if (memberposition === 'SS' || memberposition === 'Silver Star') {
            gradientClass = 'gradient-silver';
        } else if (memberposition === 'GS' || memberposition === 'Gold Star') {
            gradientClass = 'gradient-gold';
        } else if (memberposition === 'DGS' || memberposition === 'Double Gold Star') {
            gradientClass = 'gradient-diamond';
        } else if (isLeft) {
            gradientClass = 'gradient-left';
        } else if (isRight) {
            gradientClass = 'gradient-right';
        }
        
        // อ้างอิงจาก Membercode เป็นหลัก ถ้าไม่มีโค้ดแสดงว่าเป็นกล่องว่างจริงๆ
        const isEmpty = !membercode || membercode === '' || membercode === 'ว่าง/Empty';
        
        let html = `
            <div class="tree-node-wrapper" data-level="${level}">
        `;
        
        if (isEmpty) {
            // แสดง node ว่าง
            html += `
                <div class="empty-node" onclick="registerTeam('${membercode}')">
                    <i class="ri-add-circle-line ri-2x"></i>
                    <span>ว่าง</span>
                </div>
            `;
        } else {
            // แสดง node ปกติ
            html += `
                <div class="tree-node ${gradientClass} ${cardColorClass}" onclick="loadBinaryTeam('${membercode}')" title="คลิกเพื่อดูทีม">
                    <div class="node-main">
                        <div class="node-avatar">
                            <img src="${memberPicture}" alt="${membername}" class="member-picture">
                            <div class="member-thainame">${memberthaiName}</div>
                        </div>
                        <div class="node-details">
                            <div class="member-name">${membername}</div>
                            <div class="member-code">${membercode}</div>
                            <div class="member-position">${memberpositionName || memberposition}</div>
                            <div class="member-position-ranking">การรักษายอดเดือน ${currentMonth1} - ${lastmonthQualifyPV}</div>
                        </div>
                    </div>
                    <div class="node-stats">
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${currentLeftPV}]</div>
                                <div class="middle-text">คะแนน</div>
                                <div class="stat-value right-card">[R:${currentRightPV}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${newLeft}]</div>
                                <div class="middle-text">คะแนนมาใหม่</div>
                                <div class="stat-value right-card">[R:${newRight}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${leftCountActive}]</div>
                                <div class="middle-text">Active</div>
                                <div class="stat-value right-card">[R:${rightCountActive}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${totalLeftBalance}]</div>
                                <div class="middle-text">Balance</div>
                                <div class="stat-value right-card">[R:${totalRightBalance}]</div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
        }
        
        // แสดง children container เฉพาะถ้าไม่ใช่ level 3
        if (!isLevel3) {
            html += `<div class="tree-children">`;
            html += `<div class="tree-connector"></div>`;
            html += `<div class="children-container">`;
            
            // Left side - แสดงเสมอไม่ว่าจะมีข้อมูลหรือไม่
            if (leftChild && leftChild.Membercode && leftChild.Membercode !== 'ว่าง/Empty') {
                html += `<div class="child-branch left">`;
                html += renderTreeNode(leftChild, level + 1, 0, allData, positionDict);
                html += `</div>`;
            } else {
                // สร้าง empty node สำหรับ left side
                const parentCode = membercode || 'root';
                html += `<div class="child-branch left">
                        <div class="empty-node small" onclick="registerTeam('${parentCode}L')">
                        <i class="ri-add-circle-line"></i>
                        <span>ว่าง</span>
                    </div>
                </div>`;
            }
            
            // Right side - แสดงเสมอไม่ว่าจะมีข้อมูลหรือไม่
            if (rightChild && rightChild.Membercode && rightChild.Membercode !== 'ว่าง/Empty') {
                html += `<div class="child-branch right">`;
                html += renderTreeNode(rightChild, level + 1, 1, allData, positionDict);
                html += `</div>`;
            } else {
                // สร้าง empty node สำหรับ right side
                const parentCode = membercode || 'root';
                html += `<div class="child-branch right">
                        <div class="empty-node small" onclick="registerTeam('${parentCode}R')">
                        <i class="ri-add-circle-line"></i>
                        <span>ว่าง</span>
                    </div>
                </div>`;
            }
            
            html += `</div>`; // children-container
            html += `</div>`; // tree-children
        }
        
        html += `</div>`; // tree-node-wrapper
        
        return html;
    }

    // สำหรับกรณีไม่มี BinaryTree (ใช้ข้อมูลเดิม)
    function renderOldStyle(data, centerCode) {
        const container = $('#binaryTreeContainer');
        
        const center = data.find(m => m.membercode === centerCode) || data[0];
        
        let html = `
            <div class="binary-tree">
                <div class="tree-level">
                    ${renderNode(center, 'center')}
                </div>
                <div class="tree-level mt-4">
                    <div class="row justify-content-center">
                        <div class="col-md-6">${renderNode(null, 'left')}</div>
                        <div class="col-md-6">${renderNode(null, 'right')}</div>
                    </div>
                </div>
            </div>
        `;
        
        container.html(html);
    }

    function renderNode(member, position) {
        if (!member) {
            return `
                <div class="node-card empty">
                    <div class="text-muted">
                        <i class="ri-user-add-line ri-3x mb-2"></i>
                        <p>ว่าง</p>
                    </div>
                </div>
            `;
        }

        const positionColor = position === 'left' ? 'success' : position === 'right' ? 'warning' : 'info';
        
        return `
            <div class="node-card ${positionColor}" onclick="loadBinaryTeam('${member.membercode}')">
                <div class="position-badge badge bg-${positionColor}">
                    ${position === 'left' ? 'ซ้าย' : position === 'right' ? 'ขวา' : 'ศูนย์กลาง'}
                </div>
                <img src="${member.profileImage || '/assets/images/users/avatar-1.jpg'}" 
                     class="node-avatar" alt="${member.idcardname}">
                <div class="node-info">
                    <h6 class="mb-1">${member.idcardname || 'N/A'}</h6>
                    <p class="text-muted mb-1 small">${member.membercode}</p>
                    <p class="text-${positionColor} mb-0"><strong>PV: ${member.personalpv || 0}</strong></p>
                </div>
            </div>
        `;
    }

    function searchMember() {
        const memberCode = $('#memberCodeSearch').val().trim();
        if (!memberCode) {
            showAlert('warning', 'กรุณากรอกรหัสสมาชิก');
            return;
        }
        loadBinaryTeam(memberCode);
    }

    function goToParent() {
        const container = $('#binaryTreeContainer');
        if (!treeData || treeData.length === 0) return;
        
        const currentMember = treeData[0];
        const childCode = currentMember.ChildCode;
        
        if (!childCode) {
            showAlert('info', 'ไม่มีสายงานบนแล้ว');
            return;
        }
        
        loadBinaryTeam(childCode);
    }

    function expandAll() {
        $('.tree-children').slideDown();
        $('.child-branch').removeClass('collapsed');
    }

    function collapseAll() {
        $('.tree-children').slideUp();
        $('.child-branch').addClass('collapsed');
    }

    function showLoading(show) {
        if (show) {
            $('#loadingIndicator').removeClass('d-none');
            $('#binaryTreeContainer').addClass('d-none');
        } else {
            $('#loadingIndicator').addClass('d-none');
            $('#binaryTreeContainer').removeClass('d-none');
        }
    }

    function showAlert(type, message) {
        const alertClass = `alert-${type}`;
        const alert = `
            <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;

        const alertContainer = $('#binaryTreeContainer').parent();
        alertContainer.prepend(alert);
        
        setTimeout(() => {
            $('.alert').alert('close');
        }, 3000);
    }
</script>

<style>
.binary-tree-container {
    padding: 20px;
    overflow-x: auto;
    background: unset;
}

.tree-node-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.tree-node {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: 2px solid #fff;
    border-radius: 16px;
    padding: 15px 25px;
    color: white;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0,0,0,0.2);
    min-width: 200px;
    position: relative;
}

.tree-node:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 25px rgba(0,0,0,0.3);
}

/* Gradient ตามตำแหน่ง */
.tree-node.gradient-center {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.tree-node.gradient-left {
    background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
}

.tree-node.gradient-right {
    background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
}

.tree-node.gradient-silver {
    background: linear-gradient(135deg, #bdc3c7 0%, #2c3e50 100%);
}

.tree-node.gradient-gold {
    background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
    color: #333;
}

.tree-node.gradient-diamond {
    background: linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%);
    color: #333;
}

.tree-node .node-main {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 5px;
}

.tree-node .node-avatar {
    width: 55px;
    height: 55px;
    border-radius: 50%;
    background: rgba(255,255,255,0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(255,255,255,0.5);
    flex-direction: column;
    padding: 5px;
    box-sizing: border-box;
    flex-shrink: 0;
    position: relative;
    margin-left: 12px;
    margin: 1px 8px 15px 8px;
}

.tree-node .node-avatar img.member-picture {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
}

.tree-node .member-thainame {
    font-size: 9px;
    font-weight: 600;
    color: white;
    text-align: center;
    line-height: 1.2;
    max-width: 100%;
    position: absolute;
    bottom: -25px;
    left: 0;
    right: 0;
    padding: 2px 0;
    z-index: 1;
    white-space: normal;
    word-wrap: break-word;
    overflow: visible;
    min-height: 20px;
}

.tree-node .node-details {
    text-align: left;
    flex: 1;
}

.tree-node .member-name {
    font-weight: 600;
    font-size: 13px;
    margin-bottom: 1px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    width: 110px;
}

.tree-node .member-code {
    font-size: 11px;
    opacity: 0.9;
    font-family: monospace;
}

.tree-node .member-position {
    font-size: 10px;
    opacity: 0.8;
    margin-top: 1px;
    font-weight: 500;
}

.tree-node .member-position-ranking {
    font-size: 10px;
