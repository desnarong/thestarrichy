@{
    ViewBag.Title = "ทีมไบนารี่";
    ViewBag.pTitle = "Team Binary";
    ViewBag.pageTitle = "ทีมไบนารี่";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-lg-4 teambinary-search">
                        <div class="input-group">
                            <input type="text" id="memberCodeSearch" class="form-control"
                                   placeholder="ค้นหารหัสสมาชิก...">
                            <button class="btn btn-primary" onclick="searchMember()">
                                <i class="ri-search-line"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-lg-8 text-lg-end teambinary-actions">
                        <button class="btn btn-info" onclick="refreshCurrentMember()">
                            <i class="ri-refresh-line"></i> รีเฟรช
                        </button>
                        
                        <button class="btn btn-outline-primary" onclick="goToLeftLevel()">
                            <i class="ri-arrow-left-line"></i> ซ้ายสุด
                        </button>
                        <button class="btn btn-outline-primary" onclick="goToRightLevel()">
                            <i class="ri-arrow-right-line"></i> ขวาสุด
                        </button>
                        <button class="btn btn-outline-dark" onclick="goToParent()">
                            <i class="ri-arrow-up-double-line"></i> เลื่อนขึ้น
                        </button>
                        <button class="btn btn-secondary" onclick="refreshCurrentMember()">
                            <i class="ri-skip-up-line"></i> บนสุด
                        </button>
                        <button class="btn btn-success" onclick="expandAll()">
                            <i class="ri-arrow-down-line"></i> ขยายทั้งหมด
                        </button>
                        <button class="btn btn-warning" onclick="collapseAll()">
                            <i class="ri-collapse-line"></i> ย่อทั้งหมด
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div id="binaryTreeContainer" class="text-center"></div>
                <div id="loadingIndicator" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">กำลังโหลดข้อมูล...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="nodeInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div id="nodeInfoModalContent" class="modal-content tree-node node-preview-card gradient-center card-red">
            <div class="modal-header node-main">
                <div class="node-avatar">
                    <img id="nodeInfoMemberPicture" src="/images/1_Black1_40x40.gif" alt="Member" class="member-picture">
                    <div id="nodeInfoMemberThaiName" class="member-thainame">ไม่มีตำแหน่ง</div>
                </div>
                <div class="node-details">
                    <div id="nodeInfoMemberName" class="member-name">-</div>
                    <div id="nodeInfoMemberCode" class="member-code">-</div>
                    <div id="nodeInfoMemberPosition" class="member-position">-</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="nodeInfoStats" class="node-stats"></div>
            </div>
        </div>
    </div>
</div>

<script>
    const preferredBinaryCodeFromServer = '@((ViewBag.PreferredBinaryCode as string) ?? "")';
    let currentMemberCode = '';
    let parentMemberCode = '';
    let treeData = null;
    let currentViewedMemberCode = '';
    let rootViewedMemberCode = '';
    let navigationHistory = [];
    let nodeInfoDataMap = {};
    let nodeInfoSeq = 0;

    function isMobileTreeView() {
        return window.matchMedia('(max-width: 768px)').matches;
    }

    function formatNumber(value) {
        const num = Number(value || 0);
        return Number.isFinite(num) ? num.toLocaleString() : '0';
    }

    function escapeHtml(value) {
        return (value ?? '').toString()
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    function pickGradientClass(value) {
        const allowed = ['gradient-center', 'gradient-left', 'gradient-right', 'gradient-silver', 'gradient-gold', 'gradient-diamond'];
        return allowed.includes(value) ? value : 'gradient-center';
    }

    function pickCardColorClass(value) {
        return value === 'card-green' ? 'card-green' : 'card-red';
    }

    function isYesStatus(value) {
        return (value || '').toString().trim().toUpperCase() === 'YES';
    }

    function normalizeYesNoStatus(value) {
        return isYesStatus(value) ? 'Yes' : 'No';
    }

    function buildNodeInfoStatsHtml(modalData) {
        return `
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.currentLeftPV)}]</div>
                    <div class="middle-text">คะแนน</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.currentRightPV)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.newLeft)}]</div>
                    <div class="middle-text">คะแนนมาใหม่</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.newRight)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.leftCountActive)}]</div>
                    <div class="middle-text">Active</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.rightCountActive)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.totalLeftBalance)}]</div>
                    <div class="middle-text">Balance</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.totalRightBalance)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item keep-text">
                    <div class="middle-text">รักษายอด - ${modalData.nextCMonth} ${formatNumber(modalData.currentMonthQualifyPV)} PV - ${modalData.currentMonthQualifyStatus}</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item keep-text">
                    <div class="middle-text">รักษายอด - ${modalData.currentMonth} ${formatNumber(modalData.lastMonthQualifyPV)} PV - ${modalData.lastMonthQualifyStatus}</div>
                </div>
            </div>
        `;
    }

    function openNodeInfoModal(modalKey, event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
        }

        const modalData = nodeInfoDataMap[modalKey];
        if (!modalData) return false;

        const gradientClass = pickGradientClass(modalData.gradientClass);
        const cardColorClass = pickCardColorClass(modalData.cardColorClass);
        $('#nodeInfoModalContent')
            .removeClass('gradient-center gradient-left gradient-right gradient-silver gradient-gold gradient-diamond card-green card-red')
            .addClass(`${gradientClass} ${cardColorClass}`);

        $('#nodeInfoMemberPicture').attr('src', modalData.memberPicture || '/images/1_Black1_40x40.gif');
        $('#nodeInfoMemberPicture').attr('alt', modalData.membername || 'Member');
        $('#nodeInfoMemberThaiName').text(modalData.memberthaiName || 'ไม่มีตำแหน่ง');
        $('#nodeInfoMemberName').text(modalData.membername || 'N/A');
        $('#nodeInfoMemberCode').text(modalData.membercode || '-');
        $('#nodeInfoMemberPosition').text(modalData.memberposition || '-');
        $('#nodeInfoStats').html(buildNodeInfoStatsHtml(modalData));

        const modalEl = document.getElementById('nodeInfoModal');
        if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        } else if (typeof $.fn.modal === 'function') {
            $('#nodeInfoModal').modal('show');
        }

        return false;
    }

    $(document).ready(function() {
        const initialCode = (preferredBinaryCodeFromServer || '').toString().trim();
        setMemberCodeToUrl('');
        loadCurrentMember(initialCode);

        const mobileMediaQuery = window.matchMedia('(max-width: 768px)');
        const rerenderForViewport = function () {
            if (treeData) {
                renderBinaryTree(treeData, currentViewedMemberCode || currentMemberCode || '');
            }
        };

        if (typeof mobileMediaQuery.addEventListener === 'function') {
            mobileMediaQuery.addEventListener('change', rerenderForViewport);
        } else if (typeof mobileMediaQuery.addListener === 'function') {
            mobileMediaQuery.addListener(rerenderForViewport);
        }

        $(document).on('click', '.node-info-btn', function (e) {
            const modalKey = $(this).data('modalKey');
            return openNodeInfoModal(modalKey, e);
        });
    });

    function setMemberCodeToUrl(memberCode) {
        if (!window.history || typeof window.history.replaceState !== 'function') return;

        const params = new URLSearchParams(window.location.search || '');
        const code = (memberCode || '').toString().trim();

        if (code) {
            params.set('code', code);
        } else {
            params.delete('code');
        }

        const query = params.toString();
        const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash || ''}`;
        window.history.replaceState({}, '', nextUrl);
    }

    function refreshCurrentMember() {
        $('#memberCodeSearch').val('');
        setMemberCodeToUrl('');
        loadCurrentMember('', { forceCurrentMember: true });
    }

    async function loadCurrentMember(preferredCode = '', options = {}) {
        try {
            const response = await fetch('/home/GetMemberInfo');

            if (!response.ok) {
                throw new Error('Failed to load member info');
            }

            const data = await response.json();

            // Handle both string (JSON) and object response
            let memberInfo;
            if (typeof data === 'string') {
                memberInfo = JSON.parse(data);
            } else {
                memberInfo = data;
            }

            // Response is flat object with membercode directly, not memberInfo[0]
            if (memberInfo && memberInfo.membercode) {
                currentMemberCode = memberInfo.membercode;
            } else if (memberInfo && memberInfo.memberInfo && memberInfo.memberInfo.length > 0) {
                // Fallback for nested format
                currentMemberCode = memberInfo.memberInfo[0].membercode;
            } else {
                showAlert('warning', 'ไม่พบข้อมูลสมาชิก');
                return;
            }

            const forceCurrentMember = !!options.forceCurrentMember;
            const urlCode = forceCurrentMember
                ? ''
                : (preferredCode || '').toString().trim();
            const targetCode = urlCode || currentMemberCode;

            // if (forceCurrentMember) {
            //     $('#memberCodeSearch').val('');
            // } else {
            //     //$('#memberCodeSearch').val(targetCode || '');
            // }

            loadBinaryTeam(targetCode, {
                resetHistory: true,
                syncSearchInput: !forceCurrentMember,
                syncUrlCode: false
            });
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'ไม่สามารถโหลดข้อมูลสมาชิกได้: ' + error.message);
        }
    }

    async function registerTeam(memberCode) {
        let url = '/member/register';
        if (memberCode) {
            url += `?id=${memberCode}`;
        }
            window.location.href=url;
    }

    async function loadBinaryTeam(memberCode, options = {}) {
        try {
            showLoading(true);

            const isBackNavigation = !!options.isBackNavigation;
            const shouldResetHistory = !!options.resetHistory;
            const shouldSyncSearchInput = options.syncSearchInput !== false;
            const shouldSyncUrlCode = options.syncUrlCode === true;
            const requestedCode = (memberCode || '').toString().trim();

            if (shouldResetHistory) {
                navigationHistory = [];
                currentViewedMemberCode = '';
                rootViewedMemberCode = '';
            }

            if (requestedCode) {
                if (!isBackNavigation && currentViewedMemberCode && currentViewedMemberCode !== requestedCode) {
                    navigationHistory.push(currentViewedMemberCode);
                }

                if (isBackNavigation && navigationHistory.length > 0 && navigationHistory[navigationHistory.length - 1] === requestedCode) {
                    navigationHistory.pop();
                }
            }

            // สร้าง URL - ถ้ามี memberCode ให้ส่งไปด้วย (สำหรับค้นหา/คลิกดูทีมคนอื่น)
            // ถ้าไม่มี จะดึงจาก JWT อัตโนมัติ
            let url = '/home/GetMemberBinaryTeam';
            if (requestedCode) {
                url += `?membercode=${requestedCode}`;
            }

            const response = await fetch(url);

            if (!response.ok) {
                throw new Error('Failed to load binary team');
            }

            const data = await response.json();

            // Handle both string (JSON) and object response
            let result;
            if (typeof data === 'string') {
                result = JSON.parse(data);
            } else {
                result = data;
            }

            treeData = result;

            const payload = Array.isArray(result) ? (result[0] || null) : result;
            const binaryTree = payload ? getNodeValue(payload, ['BinaryTree', 'binaryTree'], null) : null;
            const currentNode = Array.isArray(binaryTree)
                ? (binaryTree[0] || null)
                : (binaryTree || payload);
            const resolvedCode = requestedCode || getFirstNonEmptyValue(currentNode, ['ChildCode', 'childCode', 'Membercode', 'membercode'], '');

            if (resolvedCode) {
                currentViewedMemberCode = resolvedCode;
                if (shouldResetHistory || !rootViewedMemberCode) {
                    rootViewedMemberCode = resolvedCode;
                }
                // if (shouldSyncSearchInput) {
                //     $('#memberCodeSearch').val(currentViewedMemberCode);
                // }
                if (shouldSyncUrlCode) {
                    setMemberCodeToUrl(currentViewedMemberCode);
                }
            }

            renderBinaryTree(result, resolvedCode || (Array.isArray(result) ? (result[0]?.Membercode || '') : ''));
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + error.message);
        } finally {
            showLoading(false);
        }
    }

    function getNodeValue(node, keys, fallback = null) {
        if (!node || !Array.isArray(keys)) return fallback;
        for (const key of keys) {
            if (node[key] !== undefined && node[key] !== null) {
                return node[key];
            }
        }
        return fallback;
    }

    function getNodeChildren(node) {
        const children = getNodeValue(node, ['Children', 'children'], []);
        return Array.isArray(children) ? children : [];
    }

    function findNodeInTree(nodes, targetCode) {
        if (!Array.isArray(nodes) || nodes.length === 0 || !targetCode) {
            return null;
        }

        const normalizedTarget = targetCode.toString().trim().toUpperCase();

        for (const node of nodes) {
            const memberCode = getFirstNonEmptyValue(node, ['Membercode', 'membercode'], '').toUpperCase();
            const childCode = getFirstNonEmptyValue(node, ['ChildCode', 'childCode'], '').toUpperCase();

            if (memberCode === normalizedTarget || childCode === normalizedTarget) {
                return node;
            }

            const foundInChildren = findNodeInTree(getNodeChildren(node), normalizedTarget);
            if (foundInChildren) {
                return foundInChildren;
            }
        }

        return null;
    }

    function getFirstNonEmptyValue(node, keys, fallback = '') {
        if (!node || !Array.isArray(keys)) return fallback;
        for (const key of keys) {
            const value = node[key];
            if (value !== undefined && value !== null && value.toString().trim() !== '') {
                return value.toString().trim();
            }
        }
        return fallback;
    }

    function isTreeEmptyNode(node) {
        if (!node) return true;
        const isEmptyFlag = !!getNodeValue(node, ['IsEmptyNode', 'isEmptyNode'], false);
        const membercode = (getNodeValue(node, ['Membercode', 'membercode'], '') || '').toString();
        const childCode = (getNodeValue(node, ['ChildCode', 'childCode'], '') || '').toString();
        const membername = (getNodeValue(node, ['Membername', 'membername'], '') || '').toString();
        return isEmptyFlag || membercode.startsWith('EMPTY_') || membername === '(ว่าง)' || (!membercode && !childCode);
    }

    function pickBinaryChildren(children) {
        if (!Array.isArray(children) || children.length === 0) {
            return { leftChild: null, rightChild: null };
        }

        const leftCandidates = [];
        const rightCandidates = [];
        const neutralCandidates = [];

        children.forEach((child) => {
            const level = (getNodeValue(child, ['PositionLevel', 'positionLevel'], '') || '').toString().toLowerCase();
            if (level.includes('left')) {
                leftCandidates.push(child);
            } else if (level.includes('right')) {
                rightCandidates.push(child);
            } else {
                neutralCandidates.push(child);
            }
        });

        const leftReal = leftCandidates.find(c => !isTreeEmptyNode(c));
        const rightReal = rightCandidates.find(c => !isTreeEmptyNode(c));
        const neutralReal = neutralCandidates.find(c => !isTreeEmptyNode(c));

        let leftChild = leftReal || leftCandidates[0] || neutralReal || neutralCandidates[0] || null;
        let rightChild = rightReal || rightCandidates.find(c => c !== leftChild) || neutralReal || neutralCandidates.find(c => c !== leftChild) || leftReal || leftCandidates.find(c => c !== leftChild) || null;

        if (leftChild && rightChild && leftChild === rightChild) {
            rightChild = children.find(c => c !== leftChild) || null;
        }

        return { leftChild, rightChild };
    }

    function getTreeDepth(node) {
        if (!node) {
            return 0;
        }

        const children = getNodeChildren(node);
        if (children.length === 0) {
            return 1;
        }

        const childDepths = children.map(child => getTreeDepth(child));
        const maxChildDepth = childDepths.length > 0 ? Math.max(...childDepths) : 0;
        return 1 + maxChildDepth;
    }

    function buildEmptyNodeHtml(cssClass, registerBaseCode, disabled = false) {
        const disabledClass = disabled ? ' disabled' : '';
        const onclickAttr = disabled ? '' : ` onclick="registerTeam('${registerBaseCode}')"`;

        return `
            <div class="${cssClass}${disabledClass}"${onclickAttr}>
                <i class="ri-add-circle-line"></i>
                <span>ว่าง</span>
            </div>
        `;
    }

    function renderEmptyBranch(level, targetDepth, registerBaseCode, hasEmptyAncestor = false) {
        const isMobileView = isMobileTreeView();
        const isLastLevel = level >= targetDepth - 1;
        const emptyNodeClass = (isMobileView && isLastLevel)
            ? 'empty-node small'
            : (level <= 2 ? 'empty-node tree-size' : 'empty-node small');
        const isDisabled = !!hasEmptyAncestor;

        let html = `<div class="tree-node-wrapper" data-level="${level}">`;
        html += buildEmptyNodeHtml(emptyNodeClass, registerBaseCode, isDisabled);

        if (!isLastLevel) {
            html += `<div class="tree-children">`;
            html += `<div class="tree-connector"></div>`;
            html += `<div class="children-container children-container-level-${level + 1}">`;
            html += `<div class="child-branch left">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}L`, true)}</div>`;
            html += `<div class="child-branch right">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}R`, true)}</div>`;
            html += `</div>`;
            html += `</div>`;
        }

        html += `</div>`;
        return html;
    }

    function renderBinaryTree(data, centerCode) {
        const container = $('#binaryTreeContainer');
        container.empty();
        nodeInfoDataMap = {};
        nodeInfoSeq = 0;

        if (!data) {
            container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
            return;
        }

        const payload = Array.isArray(data) ? (data[0] || null) : data;
        if (!payload) {
            container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
            return;
        }

        const binaryTree = getNodeValue(payload, ['BinaryTree', 'binaryTree'], null);
        if (!binaryTree) {
            renderOldStyle(Array.isArray(data) ? data : [data], centerCode);
            return;
        }
       
        const rootNodes = Array.isArray(binaryTree) ? binaryTree : [binaryTree];
        if (rootNodes.length === 0) {
            container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
            return;
        }
        
        const maxTreeDepth = Math.max(1, ...rootNodes.map(node => getTreeDepth(node)));
        const isMobileView = window.matchMedia('(max-width: 768px)').matches;
        // Mobile: show only root, level 1 and level 2.
        const targetDepth = isMobileView ? Math.min(3, maxTreeDepth) : maxTreeDepth;

        let html = `<div class="binary-tree-container">`;
        rootNodes.forEach((rootNode) => {
            html += renderTreeNode(rootNode, 0, targetDepth, false);
        });
        html += `</div>`;
        container.html(html);
    }

    function renderTreeNode(node, level, targetDepth, hasEmptyAncestor = false) {
        if (!node) return '';

        const membercode = getFirstNonEmptyValue(node, ['ChildCode', 'childCode', 'Membercode', 'membercode'], '');
        const nodeMemberCode = getFirstNonEmptyValue(node, ['Membercode', 'membercode'], '');
        const membername = getNodeValue(node, ['Membername', 'membername', 'Idcardname', 'idcardname'], 'N/A');
        const memberposition = getNodeValue(node, ['Memberposition', 'memberposition'], '');
        const memberpositionName = getNodeValue(node, ['MemberpositionName', 'memberpositionName'], '');
        const memberthaiName = getNodeValue(node, ['MemberpositionRankingName', 'memberpositionRankingName', 'MemberpositionRanking', 'memberpositionRanking'], 'ไม่มีตำแหน่ง');
        const currentMonth1 = getNodeValue(node, ['currentMonth1', 'CurrentMonth1'], '');
        const currentMonth = getNodeValue(node, ['currentMonth', 'CurrentMonth'], '');
        const nextCMonth = getNodeValue(node, ['nextCMonth', 'NextCMonth'], '');
        const currentMonthQualifyPV = getNodeValue(node, ['currentMonthQualifyPV', 'CurrentMonthQualifyPV'], 0);
        const currentMonthQualifyStatusRaw = getNodeValue(node, ['CurrentMonthQualifyStatus', 'currentMonthQualifyStatus'], 'No');
        const currentMonthQualifyStatus = normalizeYesNoStatus(currentMonthQualifyStatusRaw);
        const lastCMonth = getNodeValue(node, ['lastCMonth', 'LastCMonth'], '');
        const lastmonthQualifyPV = getNodeValue(node, ['lastmonthQualifyPV', 'LastmonthQualifyPV', 'lastMonthQualifyPV', 'LastMonthQualifyPV'], 0);
        const positionLevel = (getNodeValue(node, ['PositionLevel', 'positionLevel'], '') || '').toString();

        const currentLeftPV = getNodeValue(node, ['CurrentLeftPV', 'currentLeftPV'], 0);
        const currentRightPV = getNodeValue(node, ['CurrentRightPV', 'currentRightPV'], 0);
        const newLeft = getNodeValue(node, ['NewLeft', 'newLeft'], 0);
        const newRight = getNodeValue(node, ['NewRight', 'newRight'], 0);
        const leftCountActive = getNodeValue(node, ['LeftCountActive', 'leftCountActive'], 0);
        const rightCountActive = getNodeValue(node, ['RightCountActive', 'rightCountActive'], 0);
        const totalLeftBalance = getNodeValue(node, ['TotalLeftBalance', 'totalLeftBalance'], 0);
        const totalRightBalance = getNodeValue(node, ['TotalRightBalance', 'totalRightBalance'], 0);

        const lastMonthQualifyStatusRaw = (getNodeValue(node, ['LastMonthQualifyStatus', 'lastMonthQualifyStatus'], 'No') || 'No').toString();
        const lastMonthQualifyStatus = normalizeYesNoStatus(lastMonthQualifyStatusRaw);
        const cardColorClass = isYesStatus(currentMonthQualifyStatusRaw) ? 'card-green' : 'card-red';
        const memberPicture = getNodeValue(node, ['MemberPositionPicture', 'MemberPositionPicture', 'MemberPositionPicture', 'memberPositionPicture'], '/images/1_Black1_40x40.gif');

        const children = getNodeChildren(node);
        const { leftChild, rightChild } = pickBinaryChildren(children);
        
        const hasLeftChild = !!leftChild;
        const hasRightChild = !!rightChild;
        const hasRealLeft = hasLeftChild && !isTreeEmptyNode(leftChild);
        const hasRealRight = hasRightChild && !isTreeEmptyNode(rightChild);

        const isLeft = positionLevel.toLowerCase().includes('left');
        const isRight = positionLevel.toLowerCase().includes('right');

        let gradientClass = 'gradient-center';
        if (memberposition === 'SS' || memberposition === 'Silver Star') {
            gradientClass = 'gradient-silver';
        } else if (memberposition === 'GS' || memberposition === 'Gold Star') {
            gradientClass = 'gradient-gold';
        } else if (memberposition === 'DGS' || memberposition === 'Double Gold Star') {
            gradientClass = 'gradient-diamond';
        } else if (isLeft) {
            gradientClass = 'gradient-left';
        } else if (isRight) {
            gradientClass = 'gradient-right';
        }

        const isEmpty = isTreeEmptyNode(node);
        const isMobileView = isMobileTreeView();
        const isLastLevel = level >= targetDepth - 1;
        const useCompactCard = isLastLevel && (level > 2 || (isMobileView && level >= 2));
        const emptyNodeClass = (isMobileView && isLastLevel)
            ? 'empty-node small'
            : (level <= 2 ? 'empty-node tree-size' : 'empty-node small');
        const safeMemberCode = (membercode || nodeMemberCode).replace(/'/g, "\\'");
        const registerBaseCodeRaw = nodeMemberCode || membercode || 'root';
        const registerBaseCode = registerBaseCodeRaw.replace(/'/g, "\\'");
        const infoModalKey = `node_${++nodeInfoSeq}`;

        nodeInfoDataMap[infoModalKey] = {
            membername: membername,
            membercode: membercode || nodeMemberCode,
            memberposition: memberpositionName || memberposition,
            memberthaiName: memberthaiName,
            memberPicture: memberPicture,
            gradientClass: gradientClass,
            cardColorClass: cardColorClass,
            currentMonth: currentMonth,
            nextCMonth: nextCMonth,
            currentMonth1: currentMonth1,
            currentMonthQualifyPV: currentMonthQualifyPV,
            currentMonthQualifyStatus: currentMonthQualifyStatus,
            lastCMonth: lastCMonth,
            lastmonthQualifyPV: lastmonthQualifyPV,
            lastMonthQualifyPV: lastmonthQualifyPV,
            lastMonthQualifyStatus: lastMonthQualifyStatus,
            currentLeftPV: currentLeftPV,
            currentRightPV: currentRightPV,
            newLeft: newLeft,
            newRight: newRight,
            leftCountActive: leftCountActive,
            rightCountActive: rightCountActive,
            totalLeftBalance: totalLeftBalance,
            totalRightBalance: totalRightBalance
        };

        let html = `<div class="tree-node-wrapper" data-level="${level}">`;

        if (isEmpty) {
            html += buildEmptyNodeHtml(emptyNodeClass, registerBaseCode, hasEmptyAncestor);
        } else {
            html += `
                <div class="tree-node ${gradientClass} ${cardColorClass} ${useCompactCard ? 'level-last' : ''}" onclick="loadBinaryTeam('${safeMemberCode}')" title="คลิกเพื่อดูทีม">
                    <button type="button" class="btn btn-light btn-sm node-info-btn" data-modal-key="${infoModalKey}" title="ดูรายละเอียด" onclick="return openNodeInfoModal('${infoModalKey}', event);">
                        <i class="ri-search-line"></i>
                    </button>
                    <div class="node-main">
                        <div class="node-avatar">
                            <img src="${memberPicture}" alt="${membername}" class="member-picture">
                            <div class="member-thainame">${memberthaiName}</div>
                        </div>
                        <div class="node-details">
                            <div class="member-name">${membername}</div>
                            <div class="member-code">${membercode}</div>
                            <div class="member-position">${memberpositionName || memberposition}</div>
                            <div class="member-position-ranking">รักษายอด ${currentMonth1} - ${lastmonthQualifyPV}</div>
                        </div>
                    </div>
                    ${!isLastLevel ? `
                    <div class="node-stats">
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${currentLeftPV.toLocaleString()}]</div>
                                <div class="middle-text">คะแนน</div>
                                <div class="stat-value right-card">[R:${currentRightPV.toLocaleString()}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${newLeft.toLocaleString()}]</div>
                                <div class="middle-text">คะแนนมาใหม่</div>
                                <div class="stat-value right-card">[R:${newRight.toLocaleString()}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${leftCountActive.toLocaleString()}]</div>
                                <div class="middle-text">Active</div>
                                <div class="stat-value right-card">[R:${rightCountActive.toLocaleString()}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${totalLeftBalance.toLocaleString()}]</div>
                                <div class="middle-text">Balance</div>
                                <div class="stat-value right-card">[R:${totalRightBalance.toLocaleString()}]</div>
                            </div>
                        </div>
                    </div>
                    ` : ''}
                </div>
            `;
        }

        if (!isLastLevel) {
            html += `<div class="tree-children">`;
            html += `<div class="tree-connector"></div>`;
            const nextLevelIsVisualLast = (level + 1) >= (targetDepth - 1);
            const leftIsLast = nextLevelIsVisualLast || !hasRealLeft || getNodeChildren(leftChild).length === 0;
            const rightIsLast = nextLevelIsVisualLast || !hasRealRight || getNodeChildren(rightChild).length === 0;
            const forceLevel2ContainerClass = !isMobileView && (level + 1 === 2 && leftIsLast && rightIsLast);
            const childrenContainerClass = forceLevel2ContainerClass
                ? `children-container children-container-level-2`
                : (leftIsLast && rightIsLast)
                    ? `children-container children-container-last`
                    : `children-container children-container-level-${level + 1}`;
            const leftIsEmpty = !hasRealLeft;
            const rightIsEmpty = !hasRealRight;
            const level1LeftEmptyClass = (level + 1 === 1 && leftIsEmpty)
                ? ' children-container-level-1-left-empty'
                : '';
            const leftGrandChildren = getNodeChildren(leftChild);
            const leftGrandChildrenPicked = pickBinaryChildren(leftGrandChildren);
            const leftLevel2RightEmpty = !leftGrandChildrenPicked.rightChild || isTreeEmptyNode(leftGrandChildrenPicked.rightChild);
            const level1NoEmptyLeftLevel2RightEmptyClass = (level + 1 === 1 && !leftIsEmpty && !rightIsEmpty && leftLevel2RightEmpty)
                ? ' children-container-level-1-no-empty-left-level2-right-empty'
                : '';
            const rightGrandChildren = getNodeChildren(rightChild);
            const rightLevel2AllEmpty = rightGrandChildren.length >= 2 && rightGrandChildren.every(child => isTreeEmptyNode(child));
            const level1LeftEmptyRightLevel2AllEmptyClass = (level + 1 === 1 && leftIsEmpty && rightLevel2AllEmpty)
                ? ' children-container-level-1-left-empty-right-level2-all-empty'
                : '';
            const level1RightLevel2AllEmptyClass = (level + 1 === 1 && !leftIsEmpty && !rightIsEmpty && rightLevel2AllEmpty)
                ? ' children-container-level-1-right-level2-all-empty'
                : '';

            html += `<div class="${childrenContainerClass}${level1LeftEmptyClass}${level1NoEmptyLeftLevel2RightEmptyClass}${level1LeftEmptyRightLevel2AllEmptyClass}${level1RightLevel2AllEmptyClass}">`;

            if (hasLeftChild) {
                html += `<div class="child-branch left">${renderTreeNode(leftChild, level + 1, targetDepth, hasEmptyAncestor || isEmpty)}</div>`;
            } else {
                html += `<div class="child-branch left">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}L`, hasEmptyAncestor || isEmpty)}</div>`;
            }

            if (hasRightChild) {
                html += `<div class="child-branch right">${renderTreeNode(rightChild, level + 1, targetDepth, hasEmptyAncestor || isEmpty)}</div>`;
            } else {
                html += `<div class="child-branch right">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}R`, hasEmptyAncestor || isEmpty)}</div>`;
            }

            html += `</div>`;
            html += `</div>`;
        }

        html += `</div>`;
        
        return html;
    }

    // สำหรับกรณีไม่มี BinaryTree (ใช้ข้อมูลเดิม)
    function renderOldStyle(data, centerCode) {
        const container = $('#binaryTreeContainer');

        const center = data.find(m => m.membercode === centerCode) || data[0];

        let html = `
            <div class="binary-tree">
                <div class="tree-level">
                    ${renderNode(center, 'center')}
                </div>
                <div class="tree-level mt-4">
                    <div class="row justify-content-center">
                        <div class="col-md-6">${renderNode(null, 'left')}</div>
                        <div class="col-md-6">${renderNode(null, 'right')}</div>
                    </div>
                </div>
            </div>
        `;

        container.html(html);
    }

    function renderNode(member, position) {
        if (!member) {
            return `
                <div class="node-card empty">
                    <div class="text-muted">
                        <i class="ri-user-add-line ri-3x mb-2"></i>
                        <p>ว่าง</p>
                    </div>
                </div>
            `;
        }

        const positionColor = position === 'left' ? 'success' : position === 'right' ? 'warning' : 'info';

        return `
            <div class="node-card ${positionColor}" onclick="loadBinaryTeam('${member.membercode}')">
                <div class="position-badge badge bg-${positionColor}">
                    ${position === 'left' ? 'ซ้าย' : position === 'right' ? 'ขวา' : 'ศูนย์กลาง'}
                </div>
                <img src="${member.profileImage || '/assets/images/users/avatar-1.jpg'}"
                     class="node-avatar" alt="${member.idcardname}">
                <div class="node-info">
                    <h6 class="mb-1">${member.idcardname || 'N/A'}</h6>
                    <p class="text-muted mb-1 small">${member.membercode}</p>
                    <p class="text-${positionColor} mb-0"><strong>PV: ${member.personalpv || 0}</strong></p>
                </div>
            </div>
        `;
    }

    function searchMember() {
        const memberCode = $('#memberCodeSearch').val().trim();
        if (!memberCode) {
            showAlert('warning', 'กรุณากรอกรหัสสมาชิก');
            return;
        }
        $('#memberCodeSearch').val('');
        loadBinaryTeam(memberCode, {
            resetHistory: true,
            syncSearchInput: false,
            syncUrlCode: false
        });
    }

    function goToParent() {
        if (!treeData) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const payload = Array.isArray(treeData) ? (treeData[0] || null) : treeData;
        if (!payload) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        console.log('Payload for goToParent:', payload);

        const binaryTree = getNodeValue(payload, ['BinaryTree', 'binaryTree'], null);
        const rootNodes = Array.isArray(binaryTree)
            ? binaryTree
            : (binaryTree ? [binaryTree] : []);

        const currentNode = rootNodes.length > 0
            ? (findNodeInTree(rootNodes, currentViewedMemberCode) || rootNodes[0])
            : payload;

        if (!currentNode) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const parentCode = getFirstNonEmptyValue(currentNode, ['ParentCode', 'parentCode'], '');
        if (parentCode && !parentCode.startsWith('EMPTY_')) {
            loadBinaryTeam(parentCode, { isBackNavigation: true });
            return;
        }

        const fallbackParentCode = navigationHistory.length > 0
            ? navigationHistory[navigationHistory.length - 1]
            : '';

        if (fallbackParentCode) {
            loadBinaryTeam(fallbackParentCode, { isBackNavigation: true });
            return;
        }

        showAlert('info', 'รหัสนี้อยู่สายงานบนสุดแล้ว');
    }

    function goToTop() {
        if (rootViewedMemberCode) {
            loadBinaryTeam(rootViewedMemberCode, { resetHistory: true });
            return;
        }

        if (currentMemberCode) {
            loadBinaryTeam(currentMemberCode, { resetHistory: true });
            return;
        }

        refreshCurrentMember();
    }

    function getTreeScrollElement() {
        const container = document.getElementById('binaryTreeContainer');
        if (!container) return null;

        const innerScrollable = container.querySelector('.binary-tree-container');
        if (innerScrollable && innerScrollable.scrollWidth > innerScrollable.clientWidth) {
            return innerScrollable;
        }

        return container;
    }

    function scrollTreeToLeft() {
        const el = getTreeScrollElement();
        if (!el) return;
        el.scrollTo({ left: 0, behavior: 'smooth' });
    }

    function goToLeftLevel() {
        if (!treeData) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const payload = Array.isArray(treeData) ? (treeData[0] || null) : treeData;
        if (!payload) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const binaryTree = getNodeValue(payload, ['BinaryTree', 'binaryTree'], null);
        const rootNodes = Array.isArray(binaryTree)
            ? binaryTree
            : (binaryTree ? [binaryTree] : []);

        if (rootNodes.length === 0) {
            showAlert('info', 'ไม่พบสายงานฝั่งซ้าย');
            return;
        }

        const currentNode = findNodeInTree(rootNodes, currentViewedMemberCode) || rootNodes[0];
        const children = getNodeChildren(currentNode);
        const { leftChild } = pickBinaryChildren(children);

        if (!leftChild || isTreeEmptyNode(leftChild)) {
            showAlert('info', 'ไม่พบสมาชิกฝั่งซ้าย');
            return;
        }

        const leftCode = getFirstNonEmptyValue(leftChild, ['ChildCode', 'childCode', 'Membercode', 'membercode'], '');
        if (!leftCode) {
            showAlert('info', 'ไม่พบรหัสสมาชิกฝั่งซ้าย');
            return;
        }

        // Keep behavior aligned with clicking a tree node card.
        loadBinaryTeam(leftCode);
    }

    function scrollTreeToRight() {
        const el = getTreeScrollElement();
        if (!el) return;
        el.scrollTo({ left: el.scrollWidth, behavior: 'smooth' });
    }

    function goToRightLevel() {
        if (!treeData) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const payload = Array.isArray(treeData) ? (treeData[0] || null) : treeData;
        if (!payload) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        const binaryTree = getNodeValue(payload, ['BinaryTree', 'binaryTree'], null);
        const rootNodes = Array.isArray(binaryTree)
            ? binaryTree
            : (binaryTree ? [binaryTree] : []);

        if (rootNodes.length === 0) {
            showAlert('info', 'ไม่พบสายงานฝั่งขวา');
            return;
        }

        const currentNode = findNodeInTree(rootNodes, currentViewedMemberCode) || rootNodes[0];
        const children = getNodeChildren(currentNode);
        const { rightChild } = pickBinaryChildren(children);

        if (!rightChild || isTreeEmptyNode(rightChild)) {
            showAlert('info', 'ไม่พบสมาชิกฝั่งขวา');
            return;
        }

        const rightCode = getFirstNonEmptyValue(rightChild, ['ChildCode', 'childCode', 'Membercode', 'membercode'], '');
        if (!rightCode) {
            showAlert('info', 'ไม่พบรหัสสมาชิกฝั่งขวา');
            return;
        }

        // Keep behavior aligned with clicking a tree node card.
        loadBinaryTeam(rightCode);
    }

    function scrollPageToTop() {
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    function expandAll() {
        $('.tree-children').slideDown();
        $('.child-branch').removeClass('collapsed');
    }

    function collapseAll() {
        $('.tree-children').slideUp();
        $('.child-branch').addClass('collapsed');
    }

    function showLoading(show) {
        if (show) {
            $('#loadingIndicator').removeClass('d-none');
            $('#binaryTreeContainer').addClass('d-none');
        } else {
            $('#loadingIndicator').addClass('d-none');
            $('#binaryTreeContainer').removeClass('d-none');
        }
    }

    function showAlert(type, message) {
        const alertClass = `alert-${type}`;
        const alert = `
            <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;

        const alertContainer = $('#binaryTreeContainer').parent();
        alertContainer.prepend(alert);

        setTimeout(() => {
            $('.alert').alert('close');
        }, 3000);
    }
</script>

