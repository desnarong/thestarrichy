@{
    ViewBag.Title = "ทีมไบนารี่";
    ViewBag.pTitle = "Team Binary";
    ViewBag.pageTitle = "ทีมไบนารี่";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-12 col-lg-4 teambinary-search">
                        <div class="input-group">
                            <input type="text" id="memberCodeSearch" class="form-control"
                                   placeholder="ค้นหารหัสสมาชิก...">
                            <button class="btn btn-primary" onclick="searchMember()">
                                <i class="ri-search-line"></i> ค้นหา
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-lg-8 text-lg-end teambinary-actions">
                        <button class="btn btn-info" onclick="refreshCurrentMember()">
                            <i class="ri-refresh-line"></i> รีเฟรช
                        </button>

                        <button class="btn btn-primary" onclick="goToLeftLevel()">
                            <i class="ri-arrow-left-line"></i> ซ้ายสุด
                        </button>
                        <button class="btn btn-primary" onclick="goToRightLevel()">
                            <i class="ri-arrow-right-line"></i> ขวาสุด
                        </button>
                        <button class="btn btn-dark" onclick="goToParent()">
                            <i class="ri-arrow-up-double-line"></i> เลื่อนขึ้น
                        </button>
                        <button class="btn btn-secondary" onclick="refreshCurrentMember()">
                            <i class="ri-skip-up-line"></i> บนสุด
                        </button>
                        <button class="btn btn-success" onclick="expandAll()">
                            <i class="ri-arrow-down-line"></i> ขยายทั้งหมด
                        </button>
                        <button class="btn btn-warning" onclick="collapseAll()">
                            <i class="ri-collapse-line"></i> ย่อทั้งหมด
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card">
            <div class="card-body">
                <div id="binaryTreeContainer" class="text-center"></div>
                <div id="loadingIndicator" class="text-center py-5 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                    <p class="mt-2 text-muted">กำลังโหลดข้อมูล...</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="nodeInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div id="nodeInfoModalContent" class="modal-content tree-node node-preview-card gradient-center card-red">
            <div class="modal-header node-main">
                <div class="node-avatar">
                    <img id="nodeInfoMemberPicture" src="/images/1_Black1_40x40.gif" alt="Member" class="member-picture">
                    <div id="nodeInfoMemberThaiName" class="member-thainame">ไม่มีตำแหน่ง</div>
                </div>
                <div class="node-details">
                    <div id="nodeInfoMemberName" class="member-name">-</div>
                    <div id="nodeInfoMemberCode" class="member-code">-</div>
                    <div id="nodeInfoMemberPosition" class="member-position">-</div>
                    <div id="nodeInfoMemberSponsername" class="member-position">-</div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="nodeInfoStats" class="node-stats"></div>
            </div>
        </div>
    </div>
</div>

<script>
    const preferredBinaryCodeFromServer = '@((ViewBag.PreferredBinaryCode as string) ?? "")';
    let currentMemberCode = '';
    let treeDataRoot = null;
    let currentViewedMemberCode = '';
    let rootViewedMemberCode = '';
    let navigationHistory = [];
    let nodeInfoDataMap = {};
    let nodeInfoSeq = 0;

    function isMobileTreeView() {
        return window.matchMedia('(max-width: 768px)').matches;
    }

    function formatNumber(value) {
        const num = Number(value || 0);
        return Number.isFinite(num) ? num.toLocaleString() : '0';
    }

    function pickGradientClass(value) {
        const allowed = ['gradient-center', 'gradient-left', 'gradient-right', 'gradient-silver', 'gradient-gold', 'gradient-diamond'];
        return allowed.includes(value) ? value : 'gradient-center';
    }

    function pickCardColorClass(value) {
        return value === 'card-green' ? 'card-green' : 'card-red';
    }

    function isYesStatus(value) {
        return (value || '').toString().trim().toLowerCase().includes('yes');
    }

    function normalizeYesNoStatus(value) {
        return isYesStatus(value) ? 'Yes' : 'No';
    }

    function buildNodeInfoStatsHtml(modalData) {
        return `
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.currentLeftPV)}]</div>
                    <div class="middle-text">คะแนน</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.currentRightPV)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.newLeft)}]</div>
                    <div class="middle-text">คะแนนมาใหม่</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.newRight)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.leftCountActive)}]</div>
                    <div class="middle-text">Active</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.rightCountActive)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.totalLeftBalance)}]</div>
                    <div class="middle-text">Balance</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.totalRightBalance)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item">
                    <div class="stat-value left-card">[L:${formatNumber(modalData.nextPosaddLeftBalance)}]</div>
                    <div class="middle-text">ทำเพิ่ม</div>
                    <div class="stat-value right-card">[R:${formatNumber(modalData.nextPosaddRightBalance)}]</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item keep-text">
                    <div class="middle-text">รักษายอด - ${modalData.lastCMonth} รับ ${formatNumber(modalData.nextCMonth)} - ${modalData.currentMonthQualifyStatus}</div>
                </div>
            </div>
            <div class="stats-row">
                <div class="stat-item keep-text">
                    <div class="middle-text">รักษายอด - ${modalData.currentMonth1} รับ ${formatNumber(modalData.currentMonth)} - ${modalData.lastMonthQualifyStatus}</div>
                </div>
            </div>
        `;
    }

    function openNodeInfoModal(modalKey, event) {
        if (event) {
            event.preventDefault();
            event.stopPropagation();
            event.stopImmediatePropagation();
        }

        const modalData = nodeInfoDataMap[modalKey];
        if (!modalData) return false;

        const gradientClass = pickGradientClass(modalData.gradientClass);
        const cardColorClass = pickCardColorClass(modalData.cardColorClass);
        $('#nodeInfoModalContent')
            .removeClass('gradient-center gradient-left gradient-right gradient-silver gradient-gold gradient-diamond card-green card-red')
            .addClass(`${gradientClass} ${cardColorClass}`);

        $('#nodeInfoMemberPicture').attr('src', modalData.memberPicture || '/images/1_Black1_40x40.gif');
        $('#nodeInfoMemberPicture').attr('alt', modalData.membername || 'Member');
        $('#nodeInfoMemberThaiName').text(modalData.memberthaiName || 'ไม่มีตำแหน่ง');
        $('#nodeInfoMemberName').text(modalData.membername || 'N/A');
        $('#nodeInfoMemberCode').text(modalData.membercode || '-');
        $('#nodeInfoMemberPosition').text(modalData.memberposition || '-');
        $('#nodeInfoMemberSponsername').text("ชื่อผู้แนะนำ : " + (modalData.sponsername || '-'));
        $('#nodeInfoStats').html(buildNodeInfoStatsHtml(modalData));

        const modalEl = document.getElementById('nodeInfoModal');
        if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        } else if (typeof $.fn.modal === 'function') {
            $('#nodeInfoModal').modal('show');
        }

        return false;
    }

    $(document).ready(function() {
        const initialCode = (preferredBinaryCodeFromServer || '').toString().trim();
        setMemberCodeToUrl('');
        loadCurrentMember(initialCode);

        const mobileMediaQuery = window.matchMedia('(max-width: 768px)');
        const rerenderForViewport = function () {
            if (treeDataRoot) {
                renderBinaryTree(treeDataRoot, currentViewedMemberCode || currentMemberCode || '');
            }
        };

        if (typeof mobileMediaQuery.addEventListener === 'function') {
            mobileMediaQuery.addEventListener('change', rerenderForViewport);
        } else if (typeof mobileMediaQuery.addListener === 'function') {
            mobileMediaQuery.addListener(rerenderForViewport);
        }

        $(document).on('click', '.node-info-btn', function (e) {
            const modalKey = $(this).data('modalKey');
            return openNodeInfoModal(modalKey, e);
        });
    });

    function setMemberCodeToUrl(memberCode) {
        if (!window.history || typeof window.history.replaceState !== 'function') return;

        const params = new URLSearchParams(window.location.search || '');
        const code = (memberCode || '').toString().trim();

        if (code) {
            params.set('code', code);
        } else {
            params.delete('code');
        }

        const query = params.toString();
        const nextUrl = `${window.location.pathname}${query ? `?${query}` : ''}${window.location.hash || ''}`;
        window.history.replaceState({}, '', nextUrl);
    }

    function refreshCurrentMember() {
        $('#memberCodeSearch').val('');
        setMemberCodeToUrl('');
        loadCurrentMember('', { forceCurrentMember: true });
    }

    async function loadCurrentMember(preferredCode = '', options = {}) {
        try {
            const response = await fetch('/home/GetMemberInfo');

            if (!response.ok) {
                throw new Error('Failed to load member info');
            }

            const data = await response.json();
            let memberInfo = typeof data === 'string' ? JSON.parse(data) : data;

            if (memberInfo && memberInfo.membercode) {
                currentMemberCode = memberInfo.membercode;
            } else if (memberInfo && memberInfo.memberInfo && memberInfo.memberInfo.length > 0) {
                currentMemberCode = memberInfo.memberInfo[0].membercode;
            } else {
                showAlert('warning', 'ไม่พบข้อมูลสมาชิก');
                return;
            }

            const forceCurrentMember = !!options.forceCurrentMember;
            const urlCode = forceCurrentMember ? '' : (preferredCode || '').toString().trim();
            const targetCode = urlCode || currentMemberCode;

            loadBinaryTeam(targetCode, {
                resetHistory: true,
                syncSearchInput: !forceCurrentMember,
                syncUrlCode: false
            });
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'ไม่สามารถโหลดข้อมูลสมาชิกได้: ' + error.message);
        }
    }

    async function registerTeam(memberCode) {
        let url = '/member/register';
        if (memberCode) {
            url += `?id=${memberCode}`;
        }
        window.location.href=url;
    }

    function getIndexFromPositionLevel(level) {
        if (!level) return -1;
        const l = level.toLowerCase();
        if (l === 'membercode') return 1;
        if (l === 'leftcode1') return 2;
        if (l === 'rightcode1') return 3;
        if (l === 'leftcode21') return 4;
        if (l === 'rightcode22') return 5;
        if (l === 'leftcode23') return 6;
        if (l === 'rightcode24') return 7;
        if (l === 'leftcode31') return 8;
        if (l === 'rightcode32') return 9;
        if (l === 'leftcode33') return 10;
        if (l === 'rightcode34') return 11;
        if (l === 'leftcode35') return 12;
        if (l === 'rightcode36') return 13;
        if (l === 'leftcode37') return 14;
        if (l === 'rightcode38') return 15;
        return -1;
    }

    function buildTreeFromFlatArray(flatArray) {
        const nodeMap = {};
        // 1. นำข้อมูลใส่ Map ตาม Index ตำแหน่ง
        flatArray.forEach(node => {
            const idx = getIndexFromPositionLevel(node.positionLevel);
            if (idx !== -1) {
                nodeMap[idx] = { ...node, children: [null, null] }; // [Left, Right]
            }
        });

        // 2. เชื่อมความสัมพันธ์แบบ Binary Tree Array (Left = 2i, Right = 2i + 1)
        for (let i = 1; i <= 7; i++) {
            if (nodeMap[i]) {
                nodeMap[i].children[0] = nodeMap[2 * i] || null;     // Left Child
                nodeMap[i].children[1] = nodeMap[2 * i + 1] || null; // Right Child
            }
        }
        return nodeMap[1] || null; // คืนค่า Root Node กลับไป
    }

    async function loadBinaryTeam(memberCode, options = {}) {
        try {
            showLoading(true);

            const isBackNavigation = !!options.isBackNavigation;
            const shouldResetHistory = !!options.resetHistory;
            const shouldSyncUrlCode = options.syncUrlCode === true;
            const requestedCode = (memberCode || '').toString().trim();

            // 1. รับค่า direction จาก options (ถ้าไม่มีให้เป็นค่าว่าง)
            const direction = options.direction || '';

            if (shouldResetHistory) {
                navigationHistory = [];
                currentViewedMemberCode = '';
                rootViewedMemberCode = '';
            }

            // 2. จัดการ URL และแนบ Parameter (รวมถึง direction)
            let url = '/home/GetMemberBinaryTeam'; // (หรือถ้าคุณสร้าง Action ใหม่ ให้เช็ค if(direction) url = '/home/...'; ตรงนี้ได้เลย)

            const urlParams = new URLSearchParams();
            if (requestedCode) urlParams.append('membercode', requestedCode);
            if (direction) urlParams.append('direction', direction); // แนบ direction ท้าย URL

            const queryString = urlParams.toString();
            if (queryString) url += `?${queryString}`;

            const response = await fetch(url);

            if (!response.ok) {
                throw new Error('Failed to load binary team');
            }

            const data = await response.json();
            let result = typeof data === 'string' ? JSON.parse(data) : data;

            // แปลง Flat Array JSON ให้กลายเป็น Tree Structure
            const payload = Array.isArray(result) ? (result[0] || null) : result;
            let binaryTreeFlat = (payload && payload.binaryTree) ? payload.binaryTree : [];
            if (!Array.isArray(binaryTreeFlat)) binaryTreeFlat = [binaryTreeFlat];

            treeDataRoot = buildTreeFromFlatArray(binaryTreeFlat);

            // ให้ความสำคัญกับรหัส Root ตัวใหม่ที่ได้จาก API ก่อนเสมอ
            const actualApiCode = treeDataRoot ? treeDataRoot.childCode : '';
            const resolvedCode = actualApiCode || requestedCode;

            if (resolvedCode) {
                // เช็คว่าถ้าเป็นการกระโดด (รหัสเปลี่ยน) ต้องบันทึกตัวเก่าลง History ก่อน
                if (!isBackNavigation && currentViewedMemberCode && currentViewedMemberCode !== resolvedCode) {
                    navigationHistory.push(currentViewedMemberCode);
                }

                currentViewedMemberCode = resolvedCode;

                if (shouldResetHistory || !rootViewedMemberCode) {
                    rootViewedMemberCode = resolvedCode;
                }
                if (shouldSyncUrlCode) {
                    setMemberCodeToUrl(currentViewedMemberCode);
                }
            }

            renderBinaryTree(treeDataRoot, resolvedCode);
        } catch (error) {
            console.error('Error:', error);
            showAlert('danger', 'เกิดข้อผิดพลาดในการโหลดข้อมูล: ' + error.message);
        } finally {
            showLoading(false);
        }
    }

    function isTreeEmptyNode(node) {
        if (!node) return true;
        return node.childCode === 'ว่าง/Empty' || !node.childCode;
    }

    function getTreeDepth(node) {
        if (!node || isTreeEmptyNode(node)) return 0;
        const leftDepth = node.children && node.children[0] ? getTreeDepth(node.children[0]) : 0;
        const rightDepth = node.children && node.children[1] ? getTreeDepth(node.children[1]) : 0;
        return 1 + Math.max(leftDepth, rightDepth);
    }

    function buildEmptyNodeHtml(cssClass, registerBaseCode, disabled = false) {
        const disabledClass = disabled ? ' disabled' : '';
        const onclickAttr = disabled ? '' : ` onclick="registerTeam('${registerBaseCode}')"`;

        return `
            <div class="${cssClass}${disabledClass}"${onclickAttr}>
                <i class="ri-add-circle-line"></i>
                <span>ว่าง</span>
            </div>
        `;
    }

    function renderEmptyBranch(level, targetDepth, registerBaseCode, hasEmptyAncestor = false) {
        const isMobileView = isMobileTreeView();
        const isLastLevel = level >= targetDepth - 1;
        const emptyNodeClass = (isMobileView && isLastLevel)
            ? 'empty-node small'
            : (level <= 2 ? 'empty-node tree-size' : 'empty-node small');
        const isDisabled = !!hasEmptyAncestor;

        let html = `<div class="tree-node-wrapper" data-level="${level}">`;
        html += buildEmptyNodeHtml(emptyNodeClass, registerBaseCode, isDisabled);

        if (!isLastLevel) {
            html += `<div class="tree-children">`;
            html += `<div class="tree-connector"></div>`;
            html += `<div class="children-container children-container-level-${level + 1}">`;
            html += `<div class="child-branch left">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}L`, true)}</div>`;
            html += `<div class="child-branch right">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}R`, true)}</div>`;
            html += `</div>`;
            html += `</div>`;
        }

        html += `</div>`;
        return html;
    }

    function renderBinaryTree(rootNode, centerCode) {
        const container = $('#binaryTreeContainer');
        container.empty();
        nodeInfoDataMap = {};
        nodeInfoSeq = 0;

        if (!rootNode) {
            container.html('<p class="text-muted py-5">ไม่พบข้อมูลทีม</p>');
            return;
        }

        const isMobileView = window.matchMedia('(max-width: 768px)').matches;
        const targetDepth = isMobileView ? 3 : 4; // มือถือวาด 3 ชั้น, คอมพิวเตอร์วาด 4 ชั้น (ตามขนาด JSON)

        let html = `<div class="binary-tree-container">`;
        html += renderTreeNode(rootNode, 0, targetDepth, false, 'root');
        html += `</div>`;

        container.html(html);
    }

    function renderTreeNode(node, level, targetDepth, hasEmptyAncestor = false, parentRegisterCode = '') {
        if (!node) return '';

        const isEmpty = isTreeEmptyNode(node);
        const childCode = node.childCode || '';
        const registerBaseCode = isEmpty ? parentRegisterCode : childCode.replace(/'/g, "\\'");

        const isMobileView = isMobileTreeView();
        const isLastLevel = level >= targetDepth - 1;
        const useCompactCard = isLastLevel && (level > 2 || (isMobileView && level >= 2));
        const emptyNodeClass = (isMobileView && isLastLevel)
            ? 'empty-node small'
            : (level <= 2 ? 'empty-node tree-size' : 'empty-node small');

        let html = `<div class="tree-node-wrapper" data-level="${level}">`;

        if (isEmpty) {
            html += buildEmptyNodeHtml(emptyNodeClass, registerBaseCode, hasEmptyAncestor);
        } else {
            const membername = node.membername || 'N/A';
            const memberpositionName = node.memberpositionName || '';
            const memberthaiName = node.memberpositionRankingName || 'ไม่มีตำแหน่ง';
            const sponsername = node.sponsername || '-';
            const currentMonth1 = node.currentMonth1 || '';
            const currentMonth = node.currentMonth || '';
            const nextCMonth = node.nextCMonth || '';
            const currentMonthQualifyPV = node.currentMonthQualifyPV || 0;
            const currentMonthQualifyStatus = normalizeYesNoStatus(node.currentMonthQualifyStatus);
            const lastCMonth = node.lastCMonth || '';
            const lastMonthQualifyPV = node.lastMonthQualifyPV || 0;
            const lastMonthQualifyStatus = normalizeYesNoStatus(node.lastMonthQualifyStatus);
            const positionLevel = node.positionLevel || '';

            const currentLeftPV = node.currentLeftPV || 0;
            const currentRightPV = node.currentRightPV || 0;
            const newLeft = node.newLeft || 0;
            const newRight = node.newRight || 0;
            const leftCountActive = node.leftCountActive || 0;
            const rightCountActive = node.rightCountActive || 0;
            const totalLeftBalance = node.totalLeftBalance || 0;
            const totalRightBalance = node.totalRightBalance || 0;
            const nextPosaddLeftBalance = node.nextPosaddLeftBalance || 0;
            const nextPosaddRightBalance = node.nextPosaddRightBalance || 0;

            const cardColorClass = isYesStatus(node.lastMonthQualifyStatus) ? 'card-green' : 'card-red';
            const memberPicture = node.memberPositionPicture || '/images/1_Black1_40x40.gif';

            const isLeft = positionLevel.toLowerCase().includes('left');
            const isRight = positionLevel.toLowerCase().includes('right');

            let gradientClass = 'gradient-center';
            if (isLeft) gradientClass = 'gradient-left';
            else if (isRight) gradientClass = 'gradient-right';

            const infoModalKey = `node_${++nodeInfoSeq}`;

            nodeInfoDataMap[infoModalKey] = {
                membername: membername,
                membercode: childCode,
                memberposition: memberpositionName,
                memberthaiName: memberthaiName,
                memberPicture: memberPicture,
                sponsername: sponsername,
                gradientClass: gradientClass,
                cardColorClass: cardColorClass,
                currentMonth: currentMonth,
                nextCMonth: nextCMonth,
                currentMonth1: currentMonth1,
                currentMonthQualifyPV: currentMonthQualifyPV,
                currentMonthQualifyStatus: currentMonthQualifyStatus,
                lastCMonth: lastCMonth,
                lastMonthQualifyPV: lastMonthQualifyPV,
                lastMonthQualifyStatus: lastMonthQualifyStatus,
                currentLeftPV: currentLeftPV,
                currentRightPV: currentRightPV,
                newLeft: newLeft,
                newRight: newRight,
                nextPosaddLeftBalance: nextPosaddLeftBalance,
                nextPosaddRightBalance: nextPosaddRightBalance,
                leftCountActive: leftCountActive,
                rightCountActive: rightCountActive,
                totalLeftBalance: totalLeftBalance,
                totalRightBalance: totalRightBalance
            };

            html += `
                <div class="tree-node ${gradientClass} ${cardColorClass} ${useCompactCard ? 'level-last' : ''}" onclick="loadBinaryTeam('${childCode.replace(/'/g, "\\'")}')" title="คลิกเพื่อดูทีม">
                    <button type="button" class="btn btn-light btn-sm node-info-btn" data-modal-key="${infoModalKey}" title="ดูรายละเอียด" onclick="return openNodeInfoModal('${infoModalKey}', event);">
                        <i class="ri-search-line"></i>
                    </button>
                    <div class="node-main">
                        <div class="node-avatar">
                            <img src="${memberPicture}" alt="${membername}" class="member-picture">
                            <div class="member-thainame">${memberthaiName}</div>
                        </div>
                        <div class="node-details">
                            <div class="member-name">${membername}</div>
                            <div class="member-code">${childCode}</div>
                            <div class="member-position">${memberpositionName}</div>
                            <div class="member-position-ranking">รักษายอด ${currentMonth1} - ${lastMonthQualifyPV} PV</div>
                        </div>
                    </div>
                    ${!isLastLevel ? `
                    <div class="node-stats">
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${currentLeftPV.toLocaleString()}]</div>
                                <div class="middle-text">คะแนน</div>
                                <div class="stat-value right-card">[R:${currentRightPV.toLocaleString()}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${newLeft.toLocaleString()}]</div>
                                <div class="middle-text">คะแนนมาใหม่</div>
                                <div class="stat-value right-card">[R:${newRight.toLocaleString()}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${leftCountActive.toLocaleString()}]</div>
                                <div class="middle-text">Active</div>
                                <div class="stat-value right-card">[R:${rightCountActive.toLocaleString()}]</div>
                            </div>
                        </div>
                        <div class="stats-row">
                            <div class="stat-item">
                                <div class="stat-value left-card">[L:${totalLeftBalance.toLocaleString()}]</div>
                                <div class="middle-text">Balance</div>
                                <div class="stat-value right-card">[R:${totalRightBalance.toLocaleString()}]</div>
                            </div>
                        </div>
                    </div>
                    ` : ''}
                </div>
            `;
        }

        if (!isLastLevel) {
            const leftChild = (node.children && node.children.length > 0) ? node.children[0] : null;
            const rightChild = (node.children && node.children.length > 1) ? node.children[1] : null;

            const hasRealLeft = leftChild && !isTreeEmptyNode(leftChild);
            const hasRealRight = rightChild && !isTreeEmptyNode(rightChild);
            const leftIsEmpty = !hasRealLeft;
            const rightIsEmpty = !hasRealRight;

            html += `<div class="tree-children">`;
            html += `<div class="tree-connector"></div>`;

            const nextLevelIsVisualLast = (level + 1) >= (targetDepth - 1);
            const leftIsLast = nextLevelIsVisualLast || !hasRealLeft || (leftChild && !leftChild.children);
            const rightIsLast = nextLevelIsVisualLast || !hasRealRight || (rightChild && !rightChild.children);

            const forceLevel2ContainerClass = !isMobileView && (level + 1 === 2 && leftIsLast && rightIsLast);
            const childrenContainerClass = forceLevel2ContainerClass
                ? `children-container children-container-level-2`
                : (leftIsLast && rightIsLast)
                    ? `children-container children-container-last`
                    : `children-container children-container-level-${level + 1}`;

 
            html += `<div class="${childrenContainerClass}">`;

            if (leftChild) {
                html += `<div class="child-branch left">${renderTreeNode(leftChild, level + 1, targetDepth, hasEmptyAncestor || isEmpty, `${registerBaseCode}L`)}</div>`;
            } else {
                html += `<div class="child-branch left">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}L`, hasEmptyAncestor || isEmpty)}</div>`;
            }

            if (rightChild) {
                html += `<div class="child-branch right">${renderTreeNode(rightChild, level + 1, targetDepth, hasEmptyAncestor || isEmpty, `${registerBaseCode}R`)}</div>`;
            } else {
                html += `<div class="child-branch right">${renderEmptyBranch(level + 1, targetDepth, `${registerBaseCode}R`, hasEmptyAncestor || isEmpty)}</div>`;
            }

            html += `</div>`;
            html += `</div>`;
        }

        html += `</div>`;
        return html;
    }

    function searchMember() {
        const memberCode = $('#memberCodeSearch').val().trim();
        if (!memberCode) {
            showAlert('warning', 'กรุณากรอกรหัสสมาชิก');
            return;
        }
        $('#memberCodeSearch').val('');
        loadBinaryTeam(memberCode, {
            resetHistory: true,
            syncSearchInput: false,
            syncUrlCode: false
        });
    }

    function goToParent() {
        if (!treeDataRoot) {
            showAlert('info', 'ไม่พบข้อมูลทีม');
            return;
        }

        // 1. ใช้ parentCode จาก API (รองรับทั้งตัวพิมพ์เล็กและใหญ่)
        const parentCode = treeDataRoot.parentCode || treeDataRoot.ParentCode;

        if (parentCode && parentCode !== '0' && parentCode !== '') {
            // โหลดข้อมูล parent โดยตรง
            loadBinaryTeam(parentCode, { isBackNavigation: true });
            return;
        }

        // 2. Fallback: ถ้า API ไม่ส่ง parentCode มา ให้ถอยกลับด้วย History
        const fallbackParentCode = navigationHistory.length > 0
            ? navigationHistory[navigationHistory.length - 1]
            : '';

        if (fallbackParentCode) {
            loadBinaryTeam(fallbackParentCode, { isBackNavigation: true });
            return;
        }

        showAlert('info', 'รหัสนี้อยู่สายงานบนสุดแล้ว (หรือไม่มีรหัสผู้แนะนำ)');
    }

    function goToLeftLevel() {
        if (!currentViewedMemberCode) {
            showAlert('info', 'ไม่พบรหัสอ้างอิง');
            return;
        }
        // ส่งรหัสปัจจุบัน พร้อมแนบ direction ว่าไปทาง 'left'
        loadBinaryTeam(currentViewedMemberCode, { direction: 'left' });
    }

    function goToRightLevel() {
        if (!currentViewedMemberCode) {
            showAlert('info', 'ไม่พบรหัสอ้างอิง');
            return;
        }
        // ส่งรหัสปัจจุบัน พร้อมแนบ direction ว่าไปทาง 'right'
        loadBinaryTeam(currentViewedMemberCode, { direction: 'right' });
    }

    function expandAll() {
        $('.tree-children').slideDown();
        $('.child-branch').removeClass('collapsed');
    }

    function collapseAll() {
        $('.tree-children').slideUp();
        $('.child-branch').addClass('collapsed');
    }

    function showLoading(show) {
        if (show) {
            $('#loadingIndicator').removeClass('d-none');
            $('#binaryTreeContainer').addClass('d-none');
        } else {
            $('#loadingIndicator').addClass('d-none');
            $('#binaryTreeContainer').removeClass('d-none');
        }
    }

    function showAlert(type, message) {
        const alertClass = `alert-${type}`;
        const alert = `
            <div class="alert ${alertClass} alert-dismissible fade show" role="alert">
                ${message}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        `;
        const alertContainer = $('#binaryTreeContainer').parent();
        alertContainer.prepend(alert);
        setTimeout(() => { $('.alert').alert('close'); }, 3000);
    }
</script>

