@{
    ViewData["Title"] = "ลงทะเบียนใบสมัคร";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-register-application">ลงทะเบียนใบสมัคร</h4>
            </div>
            <div class="card-block p-3">
                <!-- ข้อมูลใบสมัคร -->
                <div class="mb-4">
                    <h5 data-key="t-application-info">ข้อมูลใบสมัคร</h5>
                    <div class="form-group row mb-3">
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-application-code">รหัสใบสมัคร :</label>
                        <div class="col-lg-4 col-md-6">
                            <input type="text" class="form-control" id="applicationCode" value="" />
                        </div>
                        <div class="col-md-2">
                            <button class="btn btn-primary" id="btnSearchApplication" type="button" data-key="t-search">ค้นหา</button>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-name">ชื่อ :</label>
                        <div class="col-lg-4 col-md-6">
                            <input type="text" class="form-control" id="applicationName" value="" disabled />
                        </div>
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-application-date">วันที่สมัคร :</label>
                        <div class="col-lg-4 col-md-6">
                            <input type="text" class="form-control" id="applicationDate" value="" disabled />
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-application-type">ประเภทใบสมัคร :</label>
                        <div class="col-lg-10 col-md-6">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="application_type" id="individual" value="individual" checked>
                                <label class="form-check-label" for="individual" data-key="t-individual">บุคคล</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="application_type" id="legal_entity" value="legal_entity">
                                <label class="form-check-label" for="legal_entity" data-key="t-legal-entity">นิติบุคคล</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3 text-end">
                        <div class="col-lg-12">
                            <button class="btn btn-light me-2" id="btnResetApplication" type="button" data-key="t-cancel">รีเซ็ต</button>
                        </div>
                    </div>
                </div>

                <!-- ประวัติใบสมัคร -->
                <div>
                    <h5 data-key="t-application-history">ประวัติใบสมัคร</h5>
                    <div class="table-responsive mt-3">
                        <table id="data-table-responsive" class="table table-striped table-bordered"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        function pick(obj, keys, defaultValue = '') {
            for (const key of keys) {
                if (obj && obj[key] !== undefined && obj[key] !== null) {
                    return obj[key];
                }
            }
            return defaultValue;
        }

        function normalizeRows(payload) {
            let data = payload;

            if (typeof data === 'string') {
                try {
                    data = JSON.parse(data);
                } catch (e) {
                    data = [];
                }
            }

            if (data && Array.isArray(data.data)) {
                data = data.data;
            }

            return Array.isArray(data) ? data : [];
        }

        const table = $("#data-table-responsive").DataTable({
            "responsive": true,
            "processing": true,
            "serverSide": false,
            "filter": false,
            "orderMulti": false,
            "ordering": true,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
            "pageLength": 25,
            "destroy": true,
            "searching": false,
            "contentType": "application/json; charset=utf-8",
            "ajax": {
                "url": '@Url.Action("GetRegisterApplicationData", "reports")',
                "type": 'GET',
                "dataSrc": function (json) {
                    const codeFilter = ($('#applicationCode').val() || '').trim().toLowerCase();
                    const selectedType = $('input[name="application_type"]:checked').val();

                    const rows = normalizeRows(json).map(function (item, index) {
                        const memberCode = pick(item, ['Membercode', 'memberCode']);
                        const ranking = pick(item, ['Ranking', 'ranking']);
                        const position = pick(item, ['Position', 'position']);
                        const leftCount = parseFloat(pick(item, ['LeftCount', 'leftCount'], 0)) || 0;
                        const rightCount = parseFloat(pick(item, ['RightCount', 'rightCount'], 0)) || 0;
                        const applicationType = (leftCount + rightCount) > 0 ? 'individual' : 'legal_entity';

                        return {
                            index: index + 1,
                            applicationCode: memberCode,
                            applicationDate: pick(item, ['Baldate1', 'baldate1', 'Baldate', 'baldate']),
                            name: ranking || '-',
                            applicationType: applicationType,
                            status: position || '-',
                            viewDetails: memberCode
                        };
                    }).filter(function (row) {
                        const matchCode = !codeFilter || (row.applicationCode || '').toLowerCase().includes(codeFilter);
                        const matchType = !selectedType || row.applicationType === selectedType;
                        return matchCode && matchType;
                    });

                    if (rows.length > 0) {
                        const firstRow = rows[0];
                        $('#applicationName').val(firstRow.name || '-');
                        $('#applicationDate').val(firstRow.applicationDate || '-');
                    } else {
                        $('#applicationName').val('');
                        $('#applicationDate').val('');
                    }

                    return rows;
                }
            },
            "columns": [
                { title: "รหัสใบสมัคร", "data": 'applicationCode', "targets": 0, "orderable": true, "data-key": "t-application-code" },
                { title: "วันที่สมัคร", "data": 'applicationDate', "data-key": "t-application-date" },
                { title: "ชื่อ", "data": 'name', "data-key": "t-name" },
                { title: "ประเภทใบสมัคร", "data": 'applicationType', "data-key": "t-application-type", "render": function(v){ return v === 'legal_entity' ? 'นิติบุคคล' : 'บุคคล'; } },
                { title: "สถานะ", "data": 'status', "data-key": "t-status" },
                { title: "ดูรายละเอียด", "data": 'viewDetails', "data-key": "t-view-details", "render": function(v){ return v ? `<span class='text-primary'>${v}</span>` : '-'; } }
            ],
        });

        $('#btnSearchApplication').on('click', function () {
            table.ajax.reload();
        });

        $('#btnResetApplication').on('click', function () {
            $('#applicationCode').val('');
            $('#individual').prop('checked', true);
            $('#applicationName').val('');
            $('#applicationDate').val('');
            table.ajax.reload();
        });

        $('input[name="application_type"]').on('change', function () {
            table.ajax.reload();
        });
    });
</script>

@section scripts{
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
}