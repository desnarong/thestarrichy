@{
    ViewData["Title"] = "รายงานประวัติการขึ้นตำแหน่ง";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#880e4f,#e91e63);">
        <i class="bx bx-trending-up fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">รายงานประวัติการขึ้นตำแหน่ง</h5>
      </div>
      <div class="card-body py-3">
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">จากวันที่</label>
            <input type="date" class="form-control form-control-sm" id="fromDate">
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ถึงวันที่</label>
            <input type="date" class="form-control form-control-sm" id="toDate">
          </div>
          <div class="col-auto align-self-end">
            <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
            <button class="btn btn-sm" id="btnSearch" style="background:#e91e63;border-color:#e91e63;color:#fff;"><i class="bx bx-search me-1"></i>ค้นหา</button>
          </div>
        </div>
        <small class="text-muted mt-1 d-block"><i class="bx bx-info-circle me-1"></i>ค่าเริ่มต้นคือแสดงข้อมูลทั้งหมด</small>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header" style="background:#fce4ec;border-bottom:2px solid #e91e63;">
        <h5 class="mb-0 fw-semibold" style="color:#880e4f;"><i class="bx bx-table me-2"></i>ประวัติการขึ้นตำแหน่ง &nbsp;<span class="badge" style="background:#e91e63;" id="rowCount">0</span></h5>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="msg">กำลังโหลดข้อมูล...</div>
        <div class="table-responsive">
          <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.82rem;white-space:nowrap;">
            <style>
              /* Hover effect - สีเข้มขึ้น */
              #mainTable tbody tr:hover {
                background-color: #f8bbd0 !important;
                transition: background-color 0.2s ease;
              }
              /* ตารางทั้งหมด - hover สีเทาเข้ม */
              table.table-hover tbody tr:hover {
                background-color: #e0e0e0 !important;
                transition: background-color 0.2s ease;
              }
            </style>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
  var tbl=null;
  function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
  function p(o,k,d){d=d===undefined?'':d;for(var i=0;i<k.length;i++){if(o&&o[k[i]]!=null)return o[k[i]];}return d;}
  function num(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt0(v){return Math.round(num(v)).toLocaleString('th-TH');}
  function fmtDate(v){if(!v)return'';var d=new Date(v);if(isNaN(d.getTime()))return String(v);var day=String(d.getDate()).padStart(2,'0');var month=String(d.getMonth()+1).padStart(2,'0');var year=d.getFullYear();return day+'/'+month+'/'+year;}
  function isoDate(v){if(!v)return'';var d=new Date(v);if(isNaN(d.getTime()))return'';return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
  function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

  function buildTable(rows){
    if(tbl){tbl.destroy();tbl=null;}$('#mainTable').empty();
    var cols=['#','วันที่เริ่มต้น','วันที่สิ้นสุด','คะแนนบาลานซ์','แอคทีพซ้าย','แอคทีพขวา','ตำแหน่งแพ็คเกจ','ตำแหน่งคุณวุฒิ','PS ซ้าย','PS ขวา'];
    var thead='<thead class="text-center" style="background:linear-gradient(135deg,#fce4ec,#f8bbd0);font-size:.78rem;"><tr>'+cols.map(function(c){return'<th>'+c+'</th>';}).join('')+'</tr></thead>';
    var tbody='<tbody>';
    rows.forEach(function(r,i){
      var rankingVal=p(r,['Ranking','ranking']);
      var rankingDisplay=(rankingVal===''||rankingVal===null||rankingVal===undefined||rankingVal==='0'||rankingVal==='-1')?'No Position':rankingVal;
      tbody+='<tr>'+
        '<td class="text-center">'+(i+1)+'</td>'+
        '<td class="text-center" data-order="'+isoDate(p(r,['Baldate','baldate','BalDate']))+'">'+fmtDate(p(r,['Baldate','baldate','BalDate']))+'</td>'+
        '<td class="text-center" data-order="'+isoDate(p(r,['Baldate1','baldate1','BalDate1']))+'">'+fmtDate(p(r,['Baldate1','baldate1','BalDate1']))+'</td>'+
        '<td class="text-end fw-semibold">'+fmt0(p(r,['Balance','balance'],0))+'</td>'+
        '<td class="text-end">'+fmt0(p(r,['LeftCount','leftCount'],0))+'</td>'+
        '<td class="text-end">'+fmt0(p(r,['RightCount','rightCount'],0))+'</td>'+
        '<td class="text-center fw-bold" style="color:#880e4f;">'+esc(p(r,['Position','position']))+'</td>'+
        '<td class="text-center fw-bold" style="color:#ad1457;">'+esc(rankingDisplay)+'</td>'+
        '<td class="text-end">'+fmt0(p(r,['LeftPS','leftPS'],0))+'</td>'+
        '<td class="text-end">'+fmt0(p(r,['RightPS','rightPS'],0))+'</td>'+
        '</tr>';
    });
    tbody+='</tbody>';
    $('#mainTable').html(thead+tbody);
    tbl=$('#mainTable').DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],ordering:true,searching:true,
      language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
    $('#rowCount').text(rows.length);
    $('#msg').removeClass('alert-secondary alert-danger').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
  }

  function filterRows(rows){
    var f=$('#fromDate').val(),t=$('#toDate').val();if(!f&&!t)return rows;
    var from=f?new Date(f):null,to=t?new Date(t+'T23:59:59'):null;
    return rows.filter(function(r){var d=new Date(p(r,['Baldate','baldate']));if(isNaN(d.getTime()))return true;if(from&&d<from)return false;if(to&&d>to)return false;return true;});
  }

  function loadData(){
    $('#msg').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();
    var f=$('#fromDate').val(),t=$('#toDate').val();
    $.get('@Url.Action("GetPositionHistoryData","reports")',{fromDate:f,toDate:t},function(json){
      var rows=norm(json); buildTable(filterRows(rows));
    }).fail(function(){$('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');});
  }

  $('#btnSearch').on('click',loadData);
  $('#btnReset').on('click',function(){$('#fromDate').val('');$('#toDate').val('');loadData();});
  loadData();
});
</script>
@section scripts {
    <script src="~/assets/js/app.js"></script>
}