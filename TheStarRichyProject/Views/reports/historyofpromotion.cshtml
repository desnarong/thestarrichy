@{
    ViewData["Title"] = "ประวัติการส่งเสริมการขาย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-historyofpromotion">ประวัติการส่งเสริมการขาย</h4>
            </div>
            <div class="card-block p-3">
                <!-- Filter Section -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label data-key="t-from-date">จากวันที่:</label>
                            <input type="date" class="form-control" id="fromDate">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label data-key="t-to-date">ถึงวันที่:</label>
                            <input type="date" class="form-control" id="toDate">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label data-key="t-promotion-type">ประเภทส่งเสริม:</label>
                            <select class="form-control" id="promotionType">
                                <option value="">ทั้งหมด</option>
                                <option value="discount">ส่วนลด</option>
                                <option value="bonus">โบนัส</option>
                                <option value="gift">ของแถม</option>
                                <option value="point">คะแนน</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button class="btn btn-primary btn-block" id="btnSearch" data-key="t-search">ค้นหา</button>
                        </div>
                    </div>
                </div>

                <!-- Report Table -->
                <div class="table-responsive">
                    <table id="promotionHistoryTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th width="5%">#</th>
                                <th width="15%">วันที่</th>
                                <th width="20%">รหัสโปรโมชั่น</th>
                                <th width="25%">ชื่อโปรโมชั่น</th>
                                <th width="15%">ประเภท</th>
                                <th width="10%">มูลค่า</th>
                                <th width="10%">สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data will be loaded via AJAX -->
                        </tbody>
                    </table>
                </div>

                <!-- Summary Section -->
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 data-key="t-summary">สรุป</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-promotions">โปรโมชั่นทั้งหมด</h6>
                                                <h3 id="totalPromotions" class="text-primary">0</h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-discount">ส่วนลดทั้งหมด</h6>
                                                <h3 id="totalDiscount" class="text-success">0.00</h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-bonus">โบนัสทั้งหมด</h6>
                                                <h3 id="totalBonus" class="text-warning">0.00</h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-points">คะแนนทั้งหมด</h6>
                                                <h3 id="totalPoints" class="text-info">0</h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Initialize DataTable
        var table = $('#promotionHistoryTable').DataTable({
            "pageLength": 25,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Thai.json"
            },
            "ajax": {
                "url": "/api/reports/promotionhistory",
                "type": "GET",
                "data": function (d) {
                    d.fromDate = $('#fromDate').val();
                    d.toDate = $('#toDate').val();
                    d.promotionType = $('#promotionType').val();
                }
            },
            "columns": [
                { "data": "index" },
                { "data": "date" },
                { "data": "promotionCode" },
                { "data": "promotionName" },
                { "data": "type" },
                { 
                    "data": "value",
                    "render": function(data, type, row) {
                        if (row.type === 'point') {
                            return data + ' คะแนน';
                        } else {
                            return '฿' + parseFloat(data).toFixed(2);
                        }
                    }
                },
                { 
                    "data": "status",
                    "render": function(data) {
                        if (data === 'active') {
                            return '<span class="badge bg-success">ใช้งาน</span>';
                        } else if (data === 'expired') {
                            return '<span class="badge bg-danger">หมดอายุ</span>';
                        } else {
                            return '<span class="badge bg-secondary">' + data + '</span>';
                        }
                    }
                }
            ],
            "drawCallback": function(settings) {
                // Update summary after data loads
                updateSummary(settings.json);
            }
        });

        // Search button click
        $('#btnSearch').click(function() {
            table.ajax.reload();
        });

        // Update summary function
        function updateSummary(data) {
            if (!data || !data.data) return;
            
            var totalPromotions = data.data.length;
            var totalDiscount = 0;
            var totalBonus = 0;
            var totalPoints = 0;

            data.data.forEach(function(item) {
                if (item.type === 'discount') {
                    totalDiscount += parseFloat(item.value);
                } else if (item.type === 'bonus') {
                    totalBonus += parseFloat(item.value);
                } else if (item.type === 'point') {
                    totalPoints += parseInt(item.value);
                }
            });

            $('#totalPromotions').text(totalPromotions);
            $('#totalDiscount').text('฿' + totalDiscount.toFixed(2));
            $('#totalBonus').text('฿' + totalBonus.toFixed(2));
            $('#totalPoints').text(totalPoints);
        }

        // Set default dates (last 30 days)
        var today = new Date();
        var lastMonth = new Date();
        lastMonth.setDate(today.getDate() - 30);
        
        $('#fromDate').val(lastMonth.toISOString().split('T')[0]);
        $('#toDate').val(today.toISOString().split('T')[0]);

        // Load initial data
        table.ajax.reload();
    });
</script>

@section scripts{
    <!-- DataTables -->
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap5.min.css">
    <script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap5.min.js"></script>
}