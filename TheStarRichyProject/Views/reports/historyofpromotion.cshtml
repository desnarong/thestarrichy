@{
    ViewData["Title"] = "ประวัติการส่งเสริมการขาย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-historyofpromotion">ประวัติการส่งเสริมการขาย</h4>
            </div>
            <div class="card-block p-3">
                <!-- Filter Section -->
                <div class="row mb-4">
                    <div class="col-md-3">
                        <div class="form-group">
                            <label data-key="t-from-date">จากวันที่:</label>
                            <input type="date" class="form-control" id="fromDate">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label data-key="t-to-date">ถึงวันที่:</label>
                            <input type="date" class="form-control" id="toDate">
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label data-key="t-promotion-type">ประเภทส่งเสริม:</label>
                            <select class="form-control" id="promotionType">
                                <option value="">ทั้งหมด</option>
                                <option value="discount">ส่วนลด</option>
                                <option value="bonus">โบนัส</option>
                                <option value="gift">ของแถม</option>
                                <option value="point">คะแนน</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-group">
                            <label>&nbsp;</label>
                            <button class="btn btn-primary btn-block" id="btnSearch" data-key="t-search">ค้นหา</button>
                        </div>
                    </div>
                </div>

                <!-- Report Table -->
                <div class="table-responsive">
                    <table id="promotionHistoryTable" class="table table-striped table-bordered">
                        <thead>
                            <tr>
                                <th width="5%">#</th>
                                <th width="15%">วันที่</th>
                                <th width="20%">รหัสโปรโมชั่น</th>
                                <th width="25%">ชื่อโปรโมชั่น</th>
                                <th width="15%">ประเภท</th>
                                <th width="10%">มูลค่า</th>
                                <th width="10%">สถานะ</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- Data will be loaded via AJAX -->
                        </tbody>
                    </table>
                </div>

                <!-- Summary Section -->
                <div class="row mt-4">
                    <div class="col-md-12">
                        <div class="card">
                            <div class="card-header">
                                <h5 data-key="t-summary">สรุป</h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-promotions">โปรโมชั่นทั้งหมด</h6>
                                                <h3 id="totalPromotions" class="text-primary">0</h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-discount">ส่วนลดทั้งหมด</h6>
                                                <h3 id="totalDiscount" class="text-success">0.00</h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-bonus">โบนัสทั้งหมด</h6>
                                                <h3 id="totalBonus" class="text-warning">0.00</h3>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-3">
                                        <div class="card bg-light">
                                            <div class="card-body text-center">
                                                <h6 data-key="t-total-points">คะแนนทั้งหมด</h6>
                                                <h3 id="totalPoints" class="text-info">0</h3>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        let currentRows = [];

        function normalizeRows(payload) {
            let data = payload;
            if (typeof data === 'string') {
                try { data = JSON.parse(data); } catch (e) { data = []; }
            }
            if (data && Array.isArray(data.data)) {
                data = data.data;
            }
            return Array.isArray(data) ? data : [];
        }

        // Initialize DataTable
        var table = $('#promotionHistoryTable').DataTable({
            "pageLength": 25,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Thai.json"
            },
            "ajax": {
                "url": "@Url.Action("GetPromotionHistoryData", "reports")",
                "type": "GET",
                "dataSrc": function (json) {
                    const data = normalizeRows(json);

                    const fromDate = $('#fromDate').val();
                    const toDate = $('#toDate').val();
                    const promotionType = $('#promotionType').val();

                    const rows = data
                        .map(function (item, index) {
                            const rawType = (item.TypeofBonus || item.typeofBonus || 'bonus').toString().toLowerCase();
                            const type = rawType.includes('discount') ? 'discount'
                                : rawType.includes('point') ? 'point'
                                : rawType.includes('gift') ? 'gift'
                                : 'bonus';
                            const paymentDate = item.PaymentDate || item.paymentDate || item.Startdate || item.startdate || '';
                            const totalBonus = parseFloat(item.TotalBonus || item.totalBonus || item.NetBonus || item.netBonus || 0) || 0;
                            return {
                                index: index + 1,
                                date: paymentDate,
                                promotionCode: item.PeriodName || item.periodName || '-',
                                promotionName: item.Remark || item.remark || 'โบนัสตามรอบ',
                                type: type,
                                value: totalBonus,
                                status: 'active'
                            };
                        })
                        .filter(function (row) {
                            if (!fromDate && !toDate) return true;
                            if (!row.date) return false;
                            const rowDate = new Date(row.date);
                            if (fromDate && rowDate < new Date(fromDate)) return false;
                            if (toDate && rowDate > new Date(toDate)) return false;
                                if (promotionType && row.type !== promotionType) return false;
                            return true;
                        });

                            currentRows = rows;
                            updateSummary(currentRows);
                            return rows;
                }
            },
            "columns": [
                { "data": "index" },
                { "data": "date" },
                { "data": "promotionCode" },
                { "data": "promotionName" },
                { "data": "type" },
                { 
                    "data": "value",
                    "render": function(data, type, row) {
                        if (row.type === 'point') {
                            return data + ' คะแนน';
                        } else {
                            return '฿' + parseFloat(data).toFixed(2);
                        }
                    }
                },
                { 
                    "data": "status",
                    "render": function(data) {
                        if (data === 'active') {
                            return '<span class="badge bg-success">ใช้งาน</span>';
                        } else if (data === 'expired') {
                            return '<span class="badge bg-danger">หมดอายุ</span>';
                        } else {
                            return '<span class="badge bg-secondary">' + data + '</span>';
                        }
                    }
                }
            ],
            "drawCallback": function() {}
        });

        // Search button click
        $('#btnSearch').click(function() {
            table.ajax.reload();
        });

        // Update summary function
        function updateSummary(rows) {
            rows = Array.isArray(rows) ? rows : [];

            var totalPromotions = rows.length;
            var totalDiscount = 0;
            var totalBonus = 0;
            var totalPoints = 0;

            rows.forEach(function(item) {
                if (item.type === 'discount') {
                    totalDiscount += parseFloat(item.value);
                } else if (item.type === 'bonus') {
                    totalBonus += parseFloat(item.value);
                } else if (item.type === 'point') {
                    totalPoints += parseInt(item.value);
                }
            });

            $('#totalPromotions').text(totalPromotions);
            $('#totalDiscount').text('฿' + totalDiscount.toFixed(2));
            $('#totalBonus').text('฿' + totalBonus.toFixed(2));
            $('#totalPoints').text(totalPoints);
        }

        // Set default dates (last 30 days)
        var today = new Date();
        var lastMonth = new Date();
        lastMonth.setDate(today.getDate() - 30);
        
        $('#fromDate').val(lastMonth.toISOString().split('T')[0]);
        $('#toDate').val(today.toISOString().split('T')[0]);

        // Load initial data
        table.ajax.reload();
    });
</script>

<!-- DataTables -->
<link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.10.25/css/dataTables.bootstrap5.min.css">
<script src="https://cdn.datatables.net/1.10.25/js/jquery.dataTables.min.js"></script>
<script src="https://cdn.datatables.net/1.10.25/js/dataTables.bootstrap5.min.js"></script>

@section scripts {
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
}