@{
    ViewData["Title"] = "รายงานโบนัสรายวัน";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#bf360c,#ef6c00);">
        <i class="bx bx-gift fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">รายงานโบนัสรายวัน</h5>
      </div>
      <div class="card-body py-3">
        <div class="row g-3 mb-3">
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#fbe9e7;border:2px solid #ef6c00 !important;">
              <div class="text-muted small">โบนัสรวมทั้งหมด</div>
              <div class="fs-4 fw-bold" style="color:#bf360c;" id="sumTotal">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#fff3e0;border:2px solid #ffa726 !important;">
              <div class="text-muted small">ค่าแนะนำรวม</div>
              <div class="fs-4 fw-bold" style="color:#e65100;" id="sumSponser">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e0f7fa;border:2px solid #00acc1 !important;">
              <div class="text-muted small">TMB/จับคู่รวม</div>
              <div class="fs-4 fw-bold" style="color:#006064;" id="sumWeak">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">จากวันที่</label>
            <input type="date" class="form-control form-control-sm" id="fromDate">
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ถึงวันที่</label>
            <input type="date" class="form-control form-control-sm" id="toDate">
          </div>
          <div class="col-auto align-self-end">
            <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
            <button class="btn btn-sm" id="btnSearch" style="background:#ef6c00;border-color:#ef6c00;color:#fff;"><i class="bx bx-search me-1"></i>ค้นหา</button>
          </div>
        </div>
        <small class="text-muted mt-1 d-block"><i class="bx bx-info-circle me-1"></i>ถ้าไม่ระบุวันที่ จะแสดงข้อมูลทั้งหมด</small>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header" style="background:#fbe9e7;border-bottom:2px solid #ef6c00;">
        <h5 class="mb-0 fw-semibold" style="color:#bf360c;"><i class="bx bx-table me-2"></i>รายการโบนัสรายวัน &nbsp;<span class="badge" style="background:#ef6c00;" id="rowCount">0</span></h5>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="msg">กำลังโหลดข้อมูล...</div>
        <div class="table-responsive">
          <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.78rem;white-space:nowrap;"></table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
  var tbl=null;
  function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
  function pick(o,k,d){if(d===undefined)d='';for(var i=0;i<k.length;i++){if(o!=null&&o[k[i]]!==undefined&&o[k[i]]!==null)return o[k[i]];}return d;}
  function num(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt0(v){return Math.round(num(v)).toLocaleString('th-TH');}
  function fmtDate(v){if(!v)return'-';var d=new Date(v);if(isNaN(d.getTime()))return String(v);var day=String(d.getDate()).padStart(2,'0');var month=String(d.getMonth()+1).padStart(2,'0');var year=d.getFullYear();return day+'/'+month+'/'+year;}

  function filterRows(rows){
    var f=$('#fromDate').val(),t=$('#toDate').val();
    if(!f&&!t)return rows;
    var from=f?new Date(f):null,to=t?new Date(t+'T23:59:59'):null;
    return rows.filter(function(r){
      var d=new Date(pick(r,['FromDate','fromDate']));if(isNaN(d.getTime()))return true;
      if(from&&d<from)return false;if(to&&d>to)return false;return true;
    });
  }

  function buildTable(rows){
    if(tbl){tbl.destroy();tbl=null;}$('#mainTable').empty();
    var cols=['#','จากวันที่','ถึงวันที่','ค่าแนะนำ','ส่วนตัว','TMB/จับคู่','แมทชิ่ง','แจงยอด','พิเศษ','รวม'];
    var thead='<thead class="text-center" style="background:linear-gradient(135deg,#fbe9e7,#ffccbc);font-size:.73rem;"><tr>'+cols.map(function(c){return'<th>'+c+'</th>';}).join('')+'</tr></thead>';
    var tbody='<tbody>';
    rows.forEach(function(r,i){
      tbody+='<tr>'+
        '<td class="text-center">'+(i+1)+'</td>'+
        '<td class="text-center">'+fmtDate(pick(r,['FromDate','fromDate']))+'</td>'+
        '<td class="text-center">'+fmtDate(pick(r,['ToDate','toDate']))+'</td>'+
        '<td class="text-end">'+fmt0(pick(r,['SponserBonus','sponserBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt0(pick(r,['RebateBonus','rebateBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt0(pick(r,['WeakBonus','weakBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt0(pick(r,['MatchingBonus','matchingBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt0(pick(r,['MobileBonus','mobileBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt0(pick(r,['SpecialBonus','specialBonus'],0))+'</td>'+
        '<td class="text-end fw-bold text-success">'+fmt0(pick(r,['TotalBonus','totalBonus'],0))+'</td>'+
        '</tr>';
    });
    tbody+='</tbody>';
    $('#mainTable').html(thead+tbody);
    tbl=$('#mainTable').DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],ordering:true,searching:true,
      language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
    var sumTot=rows.reduce(function(s,r){return s+num(pick(r,['TotalBonus','totalBonus'],0));},0);
    var sumSp=rows.reduce(function(s,r){return s+num(pick(r,['SponserBonus','sponserBonus'],0));},0);
    var sumWk=rows.reduce(function(s,r){return s+num(pick(r,['WeakBonus','weakBonus'],0));},0);
    $('#sumTotal').text(fmt0(sumTot));$('#sumSponser').text(fmt0(sumSp));$('#sumWeak').text(fmt0(sumWk));$('#rowCount').text(rows.length);
    $('#msg').removeClass('alert-secondary alert-danger').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
  }

  function loadData(){
    $('#msg').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();
    var f=$('#fromDate').val(),t=$('#toDate').val();
    $.get('@Url.Action("GetPromotionHistoryData","reports")',{fromDate:f,toDate:t},function(json){
      buildTable(filterRows(norm(json)));
    }).fail(function(){$('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');});
  }

  $('#btnSearch').on('click',loadData);
  $('#btnReset').on('click',function(){$('#fromDate').val('');$('#toDate').val('');loadData();});
  loadData();
});
</script>
@section scripts{
    <script src="~/assets/js/app.js"></script>
}