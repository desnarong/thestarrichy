<table id="table-tab3" class="table table-striped table-bordered"></table>

<script>
    $(document).ready(function () {
        function pick(obj, keys, defaultValue = '') {
            for (const key of keys) {
                if (obj && obj[key] !== undefined && obj[key] !== null) {
                    return obj[key];
                }
            }
            return defaultValue;
        }

        function normalizeRows(payload) {
            let data = payload;
            if (typeof data === 'string') {
                try { data = JSON.parse(data); } catch (e) { data = []; }
            }
            if (data && Array.isArray(data.data)) {
                data = data.data;
            }
            return Array.isArray(data) ? data : [];
        }

        $("#table-tab3").DataTable({
            "responsive": true,
            "processing": true,
            "serverSide": false,
            "filter": false,
            "orderMulti": false,
            "ordering": true,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
            "pageLength": 25,
            "destroy": true,
            "searching": false,
            "contentType": "application/json; charset=utf-8",
            "ajax": {
                "url": '@Url.Action("GetOrderHistoryData", "reports")',
                "type": 'GET',
                "data": { orderType: 'hold' },
                "dataSrc": function (json) {
                    return normalizeRows(json).map(function (item) {
                        return {
                            billNo: pick(item, ['BillNo', 'billNo']),
                            billDate: pick(item, ['BillDate', 'billDate']),
                            referenceNo: pick(item, ['ReferenceNo', 'referenceNo']),
                            pvSaleOut: pick(item, ['PVSaleout', 'pvSaleOut', 'PV', 'pv'], 0),
                            totalPrice: pick(item, ['TotalPrice', 'totalPrice'], 0),
                            unit: pick(item, ['Unit', 'unit'], 0),
                            adjustedAmount: pick(item, ['PVSaleout', 'pvSaleOut'], 0),
                            remain: pick(item, ['Remain', 'remain'], 0),
                            expireDate: pick(item, ['ExpireDate', 'expireDate']),
                            billConfirmType: pick(item, ['BillConfirmType', 'billConfirmType']),
                            holdOrderId: pick(item, ['HOLDORDERID', 'holdOrderId']),
                            createBy: pick(item, ['Createby', 'createBy']),
                            trackingUrl: pick(item, ['TrackingURL', 'trackingUrl']),
                            slip1: pick(item, ['Slip1', 'slip1']),
                            slip2: pick(item, ['Slip2', 'slip2']),
                            slip3: pick(item, ['Slip3', 'slip3']),
                            slip4: pick(item, ['Slip4', 'slip4']),
                            slip5: pick(item, ['Slip5', 'slip5'])
                        };
                    });
                }
            },
            "columns": [
                { title: "เลขที่ใบเสร็จ", "data": 'billNo', "targets": 0, "orderable": true, "data-key": "t-receipt-number" },
                { title: "วันที่", "data": 'billDate', "data-key": "t-date" },
                { title: "เลขที่อ้างอิง", "data": 'referenceNo', "data-key": "t-reference-number" },
                { title: "PV", "data": 'pvSaleOut', "data-key": "t-pv" },
                { title: "ยอดรวม", "data": 'totalPrice', "data-key": "t-amount" },
                { title: "จำนวนที่สั่งซื้อ", "data": 'unit', "data-key": "t-quantity-purchased" },
                { title: "ยอดที่ปรับ", "data": 'adjustedAmount', "data-key": "t-adjusted-amount" },
                { title: "ยอดคงเหลือ", "data": 'remain', "data-key": "t-remaining" },
                { title: "วันหมดอายุ", "data": 'expireDate', "data-key": "t-expiry-date" },
                { title: "สถานะ", "data": 'billConfirmType', "data-key": "t-status" },
                { title: "ปรับจากใบสั่งถือครอง", "data": 'holdOrderId', "data-key": "t-adjusted-from-hold-bill" },
                { title: "ผู้ปรับ", "data": 'createBy', "data-key": "t-adjuster" },
                { title: "เลขติดตาม Flash", "data": 'trackingUrl', "data-key": "t-flash-tracking-number" },
                { title: "เลขติดตาม Kerry", "data": 'trackingUrl', "data-key": "t-kerry-tracking-number" },
                { title: "เลขติดตาม J&T", "data": 'trackingUrl', "data-key": "t-jt-tracking-number" },
                { title: "เลขติดตาม Thaipost", "data": 'trackingUrl', "data-key": "t-thaipost-tracking-number" },
                { title: "สลิปโอน 1", "data": 'slip1', "data-key": "t-transfer-slip-1" },
                { title: "สลิปโอน 2", "data": 'slip2', "data-key": "t-transfer-slip-2" },
                { title: "สลิปโอน 3", "data": 'slip3', "data-key": "t-transfer-slip-3" },
                { title: "สลิปโอน 4", "data": 'slip4', "data-key": "t-transfer-slip-4" },
                { title: "สลิปโอน 5", "data": 'slip5', "data-key": "t-transfer-slip-5" },
                { title: "ดูรายละเอียด", "data": 'billNo', "data-key": "t-view-details" }
            ],
        });
    });
</script>
