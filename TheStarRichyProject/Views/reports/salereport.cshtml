@{
    ViewData["Title"] = "รายงานการขาย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
.slip-thumb { width:32px;height:32px;object-fit:cover;border-radius:4px;cursor:pointer;border:1px solid #ddd; }
.slip-icon  { font-size:1.4rem;cursor:pointer;color:#1976d2; }
</style>

<!-- Modal: Detail (Bill Layout) -->
<div class="modal fade" id="detailModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header p-0 border-0">
        <div style="background:#00c853;width:100%;padding:.5rem 1rem;" class="d-flex align-items-center justify-content-between">
          <div class="d-flex align-items-center gap-2">
            <span class="fw-bold text-white fs-5" id="modalBillTitle">ใบส่งของ</span>
            <span class="text-white" style="font-size:.78rem;">ถ้าขึ้นต้นด้วย BKKO ใช้คำว่า ใบส่งของ / ถ้าขึ้นต้นด้วย R - ใบแจงยอด</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-light" id="btnCapture" onclick="captureBill()"><i class="bx bx-camera me-1"></i>บันทึกบิลเป็นรูป</button>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
        </div>
      </div>
      <div class="modal-body p-0" id="detailModalBody"></div>
    </div>
  </div>
</div>
<!-- Modal: Image -->
<div class="modal fade" id="imgModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-body text-center p-2">
        <img id="imgModalSrc" src="" class="img-fluid rounded" style="max-height:80vh;" />
      </div>
    </div>
  </div>
</div>

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#0d47a1,#1976d2);">
        <i class="bx bx-store fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">รายงานการขาย</h5>
      </div>
      <div class="card-body py-3">
        <div class="row g-3 mb-3">
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e3f2fd;border:2px solid #1976d2 !important;">
              <div class="text-muted small">ยอดรวม</div>
              <div class="fs-4 fw-bold text-primary" id="sumAmount">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-4 col-lg-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e0f7fa;border:2px solid #00acc1 !important;">
              <div class="text-muted small">จำนวน PV</div>
              <div class="fs-4 fw-bold" style="color:#00838f;" id="sumPV">-</div>
              <div class="text-muted" style="font-size:.7rem;">PV</div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">จากวันที่</label>
            <input type="date" class="form-control form-control-sm" id="fromDate">
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ถึงวันที่</label>
            <input type="date" class="form-control form-control-sm" id="toDate">
          </div>
          <div class="col-auto align-self-end">
            <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
            <button class="btn btn-sm btn-primary" id="btnSearch"><i class="bx bx-search me-1"></i>ค้นหา</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header" style="background:#e3f2fd;border-bottom:2px solid #1976d2;">
        <h5 class="mb-0 fw-semibold text-primary"><i class="bx bx-table me-2"></i>รายการขาย &nbsp;<span class="badge bg-primary" id="rowCount">0</span></h5>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="msg">กำลังโหลดข้อมูล...</div>
        <div class="table-responsive">
          <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.78rem;white-space:nowrap;">
            <style>
              table.table-hover tbody tr:hover {
                background-color: #e0e0e0 !important;
                transition: background-color 0.2s ease;
              }
            </style>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
  var allRows=[], buyRows=[], tbl=null;

  function p(o,k,d){d=d===undefined?'':d;for(var i=0;i<k.length;i++){if(o&&o[k[i]]!=null)return o[k[i]];}return d;}
  function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
  function num(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt0(v){return Math.round(num(v)).toLocaleString('th-TH');}
  function fmt2(v){return num(v).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
  function fmtDate(v){if(!v||typeof v==='object')return'';var d=new Date(v);if(isNaN(d.getTime()))return String(v);var day=String(d.getDate()).padStart(2,'0');var month=String(d.getMonth()+1).padStart(2,'0');var year=d.getFullYear();return day+'/'+month+'/'+(year+543);}
  function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

  function slipHtml(v){
    if(!v||String(v).trim()==='')return'';
    var s=String(v).trim();
    return'<img class="slip-thumb" src="'+esc(s)+'" onerror="this.style.display=\'none\'" onclick="showImg(\''+esc(s)+'\')" title="ดูสลิป">';
  }

  window.showImg=function(src){ $('#imgModalSrc').attr('src',src); new bootstrap.Modal(document.getElementById('imgModal')).show(); };

  // Pre-fetch buyorder data once for product lines
  $.get('@Url.Action("GetBuyOrderData","reports")', function(json){ buyRows=norm(json); });

  function field(label, val, colClass){
    colClass = colClass||'col-6 col-md-4';
    return '<div class="'+colClass+' mb-1">'+
      '<div style="font-size:.7rem;color:#1565c0;text-align:right;padding-right:4px;">'+label+' :</div>'+
      '<div class="border border-secondary ps-2" style="min-height:1.6rem;font-size:.8rem;background:#fff;padding:.15rem .4rem;">'+esc(String(val||''))+'</div>'+
      '</div>';
  }

  window.showDetail=function(idx){
    var r=allRows[idx]; if(!r)return;
    var billNo = p(r,['BillNo','billNo']);

    // Determine bill type label
    var billNoStr = String(billNo).toUpperCase();
    var billTypeLabel = billNoStr.startsWith('BKKO')||billNoStr.startsWith('BKK') ? 'ใบส่งของ' : 'ใบแจงยอด';
    $('#modalBillTitle').text(billTypeLabel);
    
    // Product lines for this bill (from buyRows)
    var lines = buyRows.filter(function(br){ return p(br,['BillNo','billNo'])===billNo; });

    // Build bill document HTML
    var docHtml = '<div id="billDoc" style="padding:1rem;font-family:\'Sarabun\',Arial,sans-serif;max-width:860px;margin:0 auto;">';

    // ─── Info Grid ───────────────────────────────────────────────────────────
    docHtml += '<div class="row g-1 mb-1" style="border:1px solid #bbb;">';
    // Row 1: เลขที่ใบเสร็จ | วันที่ | (spacer) | รหัส Hybrid gold
    docHtml += '<div class="col-12" style="background:#f5f5f5;">';
    docHtml += '<div class="row g-0">';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom">';
    docHtml +=     '<div style="font-size:.68rem;color:#1565c0;text-align:center;">เลขที่ใบเสร็จ :</div>';
    docHtml +=     '<div class="text-center fw-bold" style="font-size:.82rem;">'+esc(billNo)+'</div>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">วันที่:</span>';
    docHtml +=     '<span class="border-bottom border-dark flex-fill ps-1" style="font-size:.8rem;">'+fmtDate(p(r,['BillDate','billDate']))+'</span>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom"></div>';
    docHtml +=   '<div class="col-md-3 p-1 border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">รหัส Hybrid gold :</span>';
    docHtml +=     '<span style="font-size:.8rem;">'+esc(p(r,['HybridGOLDID','hybridGOLDID']))+'</span>';
    docHtml +=   '</div>';
    docHtml += '</div>';

    // Row 2: รหัสสมาชิก | ชื่อสมาชิก
    docHtml += '<div class="row g-0">';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom">';
    docHtml +=     '<div style="font-size:.68rem;color:#1565c0;text-align:center;">รหัสสมาชิก :</div>';
    docHtml +=     '<div class="text-center fw-bold" style="font-size:.82rem;">'+esc(p(r,['Membercode','membercode']))+'</div>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-9 p-1 border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">ชื่อสมาชิก :</span>';
    docHtml +=     '<span class="flex-fill border-bottom border-dark ps-1" style="font-size:.8rem;">'+esc(p(r,['Membername','membername']))+'</span>';
    docHtml +=   '</div>';
    docHtml += '</div>';

    // Row 3: จำนวน PV | จำนวนเงิน | ประเภท
    var totalPV   = num(p(r,['TotalPV','totalPV','TotalPv'],0));
    var totalAmt  = num(p(r,['TotalAmount','totalAmount'],0));
    var billType  = p(r,['BillConfirmType','billConfirmType'])||p(r,['Billtype','billtype']);
    docHtml += '<div class="row g-0">';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">จำนวน PV :</span>';
    docHtml +=     '<span class="border-bottom border-dark flex-fill ps-1" style="font-size:.8rem;">'+fmt2(totalPV)+'</span>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">จำนวนเงิน :</span>';
    docHtml +=     '<span class="border-bottom border-dark flex-fill ps-1" style="font-size:.8rem;">'+fmt2(totalAmt)+'</span>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom"></div>';
    docHtml +=   '<div class="col-md-3 p-1 border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">ประเภท :</span>';
    docHtml +=     '<span class="border border-secondary px-1" style="font-size:.8rem;min-width:80px;">'+esc(billType)+'</span>';
    docHtml +=   '</div>';
    docHtml += '</div>';

    // Row 4: ประเภทซื้อ | สถานที่จัดส่ง (textarea-style)
    var buyTypeLabel = p(r,['Billtype','billtype'])||'';
    var delivAddr    = p(r,['DeliveryAddress','deliveryAddress'])||'';
    docHtml += '<div class="row g-0">';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom">';
    docHtml +=     '<div style="font-size:.68rem;color:#666;">ประเภทซื้อ :</div>';
    docHtml +=     '<div class="border border-secondary px-1" style="font-size:.8rem;min-height:1.5rem;">'+esc(buyTypeLabel)+'</div>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-9 p-1 border-bottom">';
    docHtml +=     '<div class="border border-secondary p-1" style="font-size:.8rem;min-height:5rem;white-space:pre-wrap;">'+esc(delivAddr)+'</div>';
    docHtml +=     '<div style="font-size:.68rem;color:#666;" class="mt-1">สถานที่จัดส่ง :</div>';
    docHtml +=   '</div>';
    docHtml += '</div>';

    // Row 5: วันหมดอาย | สถานะ | Tracking number
    var expire   = p(r,['ExpireDate','expireDate'])||'';
    var status   = p(r,['Receive','receive'])||'';
    var tracking = p(r,['TrackingURL','trackingURL'])||'';
    docHtml += '<div class="row g-0">';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">วันหมดอาย :</span>';
    docHtml +=     '<span class="border-bottom border-dark flex-fill ps-1" style="font-size:.8rem;">'+esc(expire?fmtDate(expire):'')+'</span>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-3 p-1 border-end border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span style="font-size:.73rem;">สถานะ :</span>';
    docHtml +=     '<span class="fw-semibold text-success" style="font-size:.8rem;">'+esc(status)+'</span>';
    docHtml +=   '</div>';
    docHtml +=   '<div class="col-md-6 p-1 border-bottom d-flex align-items-center gap-2">';
    docHtml +=     '<span class="fw-bold" style="font-size:.73rem;">Tracking number :</span>';
    docHtml +=     (tracking ? '<a href="'+esc(tracking)+'" target="_blank" style="font-size:.8rem;">'+esc(tracking)+'</a>' : '<span style="font-size:.8rem;"></span>');
    docHtml +=   '</div>';
    docHtml += '</div>';

    docHtml += '</div>'; // close f5f5f5 bg
    docHtml += '</div>'; // close info grid

    // ─── Product Lines Table ─────────────────────────────────────────────────
    docHtml += '<div class="table-responsive mt-2">';
    docHtml += '<table class="table table-bordered table-sm mb-0" style="font-size:.75rem;">';
    docHtml += '<thead><tr class="text-center" style="background:#e3f2fd;">';

    // Outer header row — grouped
    var totalLines = lines.length||1;
    docHtml += '<th rowspan="2" style="vertical-align:middle;width:2.2rem;">ลำดับ</th>';
    docHtml += '<th colspan="'+totalLines+'" style="text-align:center;">'+totalLines+'</th>';
    docHtml += '</tr><tr class="text-center" style="background:#e3f2fd;">';
    docHtml += '<th colspan="'+totalLines+'">&nbsp;</th>';
    docHtml += '</tr>';

    // Product column headers
    docHtml += '<tr class="text-center" style="background:#e3f2fd;">';
    docHtml += '<th></th>';
    ['รหัสสินค้า','ชื่อสินค้า','จำนวน','หน่วยนับ','ราคา/หน่วย','ราคารวม','PV รวม','รหัสโปรโมชั่น'].forEach(function(h){
      docHtml += '<th>'+h+'</th>';
    });
    docHtml += '</tr></thead>';

    docHtml += '<tbody>';
    if(lines.length===0){
      // fallback — show header data as single line
      docHtml += '<tr>';
      docHtml += '<td class="text-center">1</td>';
      docHtml += '<td>'+esc(p(r,['ProductID','productID'],''))+'</td>';
      docHtml += '<td>'+esc(p(r,['ProductName','productName'],''))+'</td>';
      docHtml += '<td class="text-center">'+fmt0(p(r,['Unit','unit'],1))+'</td>';
      docHtml += '<td class="text-center">'+esc(p(r,['UnitName','unitName'],''))+'</td>';
      docHtml += '<td class="text-end">'+fmt2(num(p(r,['TotalAmount','totalAmount'],0))/Math.max(1,num(p(r,['Unit','unit'],1))))+'</td>';
      docHtml += '<td class="text-end fw-bold">'+fmt2(totalAmt)+'</td>';
      docHtml += '<td class="text-end text-primary">'+fmt2(totalPV)+'</td>';
      docHtml += '<td>'+esc(p(r,['ProductSet','productSet'],''))+'</td>';
      docHtml += '</tr>';
    } else {
      lines.forEach(function(ln,i){
        var lineAmt = num(p(ln,['TotalPrice','TotalAmount','UnitPrice'],0));
        var linePV  = num(p(ln,['PV','pv','TotalPV','totalPV'],0));
        var lineQty = num(p(ln,['Unit','unit'],1));
        var unitPr  = num(p(ln,['UnitPrice','unitprice'],0));
        if(unitPr===0 && lineQty>0) unitPr = lineAmt/lineQty;
        docHtml += '<tr>';
        docHtml += '<td class="text-center">'+(i+1)+'</td>';
        docHtml += '<td>'+esc(p(ln,['ProductID','productID','productId'],''))+'</td>';
        docHtml += '<td>'+esc(p(ln,['ProductName','productName'],''))+'</td>';
        docHtml += '<td class="text-center">'+fmt0(lineQty)+'</td>';
        docHtml += '<td class="text-center">'+esc(p(ln,['Unit','unit','UnitName','unitName'],''))+'</td>';
        docHtml += '<td class="text-end">'+fmt2(unitPr)+'</td>';
        docHtml += '<td class="text-end fw-bold text-success">'+fmt2(lineAmt)+'</td>';
        docHtml += '<td class="text-end text-primary">'+fmt0(linePV)+'</td>';
        docHtml += '<td>'+esc(p(ln,['ProductSet','productSet'],''))+'</td>';
        docHtml += '</tr>';
      });
    }
    // Footer totals row
    var sumLineAmt = lines.reduce(function(s,ln){return s+num(p(ln,['TotalPrice','TotalAmount'],0));},0)||totalAmt;
    var sumLinePV  = lines.reduce(function(s,ln){return s+num(p(ln,['PV','pv','TotalPV','totalPV'],0));},0)||totalPV;
    docHtml += '<tr class="table-light fw-bold"><td colspan="6" class="text-end">รวม</td>';
    docHtml += '<td class="text-end text-success">'+fmt2(sumLineAmt)+'</td>';
    docHtml += '<td class="text-end text-primary">'+fmt0(sumLinePV)+'</td><td></td></tr>';

    // Page number footer row
    docHtml += '<tr><td colspan="9" class="text-center" style="font-size:.7rem;background:#f5f5f5;">1</td></tr>';
    docHtml += '</tbody></table></div>';

    // Slip images
    var slips=''; for(var i=1;i<=5;i++){var sv=p(r,['Slip'+i,'slip'+i],'');if(sv)slips+=slipHtml(sv)+' ';}
    if(slips) docHtml += '<div class="mt-2 p-2"><strong>สลิป:</strong><br>'+slips+'</div>';

    docHtml += '</div>'; // close billDoc

    $('#detailModalBody').html(docHtml);
    new bootstrap.Modal(document.getElementById('detailModal')).show();
  };

  window.captureBill = function(){
    var el = document.getElementById('billDoc');
    if(!el){alert('ไม่พบข้อมูลใบเสร็จ');return;}
    if(typeof html2canvas==='undefined'){alert('html2canvas ไม่พร้อมใช้งาน');return;}
    html2canvas(el,{scale:2,useCORS:true,background:'#fff'}).then(function(canvas){
      var link=document.createElement('a');
      link.download='bill.png';
      link.href=canvas.toDataURL('image/png');
      link.click();
    });
  };

  function filterRows(rows){
    var f=$('#fromDate').val(), t=$('#toDate').val();
    if(!f&&!t)return rows;
    var from=f?new Date(f):null, to=t?new Date(t+'T23:59:59'):null;
    return rows.filter(function(r){
      var d=new Date(p(r,['BillDate','billDate']));
      if(isNaN(d.getTime()))return true;
      if(from&&d<from)return false;
      if(to&&d>to)return false;
      return true;
    });
  }

  function buildTable(rows){
    if(tbl){tbl.destroy();tbl=null;} $('#mainTable').empty();
    var thead='<thead class="text-center" style="background:linear-gradient(135deg,#e3f2fd,#bbdefb);font-size:.73rem;"><tr>'+
      '<th>#</th><th>เลขที่ใบเสร็จ</th><th>วันที่</th><th>รหัส Hybrid Gold</th>'+
      '<th>รหัสนักธุรกิจ</th><th>ชื่อนักธุรกิจ</th><th>ประเภทซื้อ</th>'+
      '<th>ยอดเงิน</th><th>PV</th><th>สถานะการรับ</th><th>วันที่รับ/ส่ง</th>'+
      '<th>ผู้ทำรายการ</th><th>การจ่ายเงิน</th><th>Tracking</th><th>ที่อยู่จัดส่ง</th>'+
      '<th>รายละเอียด</th><th>Slip 1</th><th>Slip 2</th><th>Slip 3</th><th>Slip 4</th><th>Slip 5</th>'+
      '</tr></thead>';
    var tbody='<tbody>';
    rows.forEach(function(r,i){
      var tracking=p(r,['TrackingURL','trackingURL','trackingUrl'],'');
      var trackHtml=tracking?'<a href="'+esc(tracking)+'" target="_blank" class="btn btn-outline-secondary btn-sm py-0"><i class="bx bx-link-external"></i></a>':'';
      tbody+='<tr>'+
        '<td class="text-center">'+(i+1)+'</td>'+
        '<td>'+esc(p(r,['BillNo','billNo']))+'</td>'+
        '<td class="text-center">'+fmtDate(p(r,['BillDate','billDate']))+'</td>'+
        '<td>'+esc(p(r,['HybridGOLDID','hybridGoldId','hybridGOLDID']))+'</td>'+
        '<td>'+esc(p(r,['Membercode','memberCode','membercode']))+'</td>'+
        '<td>'+esc(p(r,['Membername','memberName','membername']))+'</td>'+
        '<td>'+esc(p(r,['Billtype','billType','billtype']))+'</td>'+
        '<td class="text-end fw-bold text-success">'+fmt2(p(r,['TotalAmount','totalAmount'],0))+'</td>'+
        '<td class="text-end text-info fw-semibold">'+fmt0(p(r,['TotalPV','totalPV','TotalPv'],0))+'</td>'+
        '<td class="text-center">'+esc(p(r,['Receive','receive']))+'</td>'+
        '<td class="text-center">'+fmtDate(p(r,['ReceiveDate','receiveDate']))+'</td>'+
        '<td>'+esc(p(r,['Createby','createBy','createby']))+'</td>'+
        '<td>'+esc(p(r,['PaymentType','paymentType']))+'</td>'+
        '<td class="text-center">'+trackHtml+'</td>'+
        '<td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;">'+esc(p(r,['DeliveryAddress','deliveryAddress']))+'</td>'+
        '<td class="text-center"><button class="btn btn-sm btn-outline-primary py-0 px-2" onclick="showDetail('+i+')"><i class="bx bx-file me-1"></i>ใบส่งของ</button></td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip1','slip1']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip2','slip2']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip3','slip3']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip4','slip4']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip5','slip5']))+'</td>'+
        '</tr>';
    });
    tbody+='</tbody>';
    $('#mainTable').html(thead+tbody);
    tbl=$('#mainTable').DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],
      ordering:true,searching:true,responsive:false,
      language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}
    });
    var totalAmt=rows.reduce(function(s,r){return s+num(p(r,['TotalAmount','totalAmount'],0));},0);
    var totalPV=rows.reduce(function(s,r){return s+num(p(r,['TotalPV','totalPV','TotalPv'],0));},0);
    $('#sumAmount').text(fmt2(totalAmt)); $('#sumPV').text(fmt0(totalPV));
    $('#rowCount').text(rows.length);
    $('#msg').removeClass('alert-secondary alert-danger').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
  }

  function loadData(){
    $('#msg').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();
    var f=$('#fromDate').val(), t=$('#toDate').val();
    $.get('@Url.Action("GetSaleReportDataV2","reports")',{fromDate:f,toDate:t},function(json){
      allRows=norm(json);
      buildTable(filterRows(allRows));
    }).fail(function(){ $('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล'); });
  }

  $('#btnSearch').on('click',loadData);
  $('#btnReset').on('click',function(){ $('#fromDate').val(''); $('#toDate').val(''); loadData(); });
  loadData();
});
</script>
