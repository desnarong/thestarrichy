@{
    ViewData["Title"] = "รายงานการขาย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- ส่วนที่ 1: เงื่อนไขการค้นหา -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bx bx-store text-primary fs-4"></i>
                <h4 class="mb-0">รายงานการขาย</h4>
            </div>
            <div class="card-body pb-2">
                <!-- สรุปยอด -->
                <div class="row mb-3 align-items-center">
                    <label class="col-lg-2 col-md-3 col-form-label fw-semibold">ยอดรวม :</label>
                    <div class="col-lg-3 col-md-4">
                        <div class="input-group">
                            <input type="text" id="totalAmountDisplay" class="form-control bg-light fw-bold text-success text-end" readonly value="-">
                            <span class="input-group-text">บาท</span>
                        </div>
                    </div>
                    <label class="col-lg-2 col-md-3 col-form-label fw-semibold">PV รวม :</label>
                    <div class="col-lg-3 col-md-4">
                        <div class="input-group">
                            <input type="text" id="totalPvDisplay" class="form-control bg-light fw-bold text-info text-end" readonly value="-">
                            <span class="input-group-text">PV</span>
                        </div>
                    </div>
                </div>
                <!-- ช่วงเวลา -->
                <div class="row mb-2 align-items-end">
                    <div class="col-lg-2 col-md-3 mb-2">
                        <label class="form-label fw-semibold mb-1">จากวันที่ :</label>
                        <input type="date" class="form-control" id="fromDate">
                    </div>
                    <div class="col-lg-2 col-md-3 mb-2">
                        <label class="form-label fw-semibold mb-1">ถึงวันที่ :</label>
                        <input type="date" class="form-control" id="toDate">
                    </div>
                    <div class="col-lg-3 col-md-3 mb-2">
                        <div class="d-flex gap-2">
                            <button class="btn btn-light" id="btnReset" type="button"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
                            <button class="btn btn-primary" id="btnSearch" type="button"><i class="bx bx-search me-1"></i>ค้นหา</button>
                        </div>
                    </div>
                </div>
                <small class="text-muted d-block mt-1 mb-1"><i class="bx bx-info-circle me-1"></i>ถ้าไม่ได้ระบุวันที่ จะแสดงข้อมูลทั้งหมด</small>
            </div>
        </div>
    </div>
</div>

<!-- ส่วนที่ 2: ตารางผลลัพธ์ -->
<div class="row mt-3">
    <div class="col-12">
        <div class="card">
            <div class="card-header" style="background-color:#e3f2fd; border-bottom:2px solid #1976d2;">
                <div class="d-flex align-items-center justify-content-between">
                    <h5 class="mb-0"><i class="bx bx-table me-2 text-primary"></i>รายการขาย</h5>
                </div>
            </div>
            <div class="card-body">
                <div class="alert alert-secondary py-2 mb-3" id="mainMessage">กำลังโหลดข้อมูล...</div>
                <div class="table-responsive">
                    <table id="saleTable" class="table table-striped table-bordered table-hover nowrap w-100"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(document).ready(function () {
    var saleTable = null;

    function pick(obj, keys, def) {
        if (def === undefined) def = '';
        for (var i = 0; i < keys.length; i++) {
            if (obj != null && obj[keys[i]] !== undefined && obj[keys[i]] !== null)
                return obj[keys[i]];
        }
        return def;
    }

    function normalizeRows(payload) {
        var d = payload;
        if (typeof d === 'string') { try { d = JSON.parse(d); } catch(e) { return []; } }
        if (d && Array.isArray(d.data)) d = d.data;
        return Array.isArray(d) ? d : [];
    }

    function toNum(v) { var n = parseFloat(v); return isNaN(n) ? 0 : n; }

    function fmtNum(v) {
        return toNum(v).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function fmtDate(v) {
        if (!v) return '-';
        var d = new Date(v);
        return isNaN(d.getTime()) ? String(v) : d.toLocaleDateString('th-TH');
    }

    function filterByDate(rows) {
        var fromDate = $('#fromDate').val();
        var toDate   = $('#toDate').val();
        if (!fromDate && !toDate) return rows;
        var from = fromDate ? new Date(fromDate) : null;
        var to   = toDate   ? new Date(toDate + 'T23:59:59') : null;
        return rows.filter(function (row) {
            var raw = pick(row, ['BillDate','billDate']);
            if (!raw) return true;
            var d = new Date(raw);
            if (isNaN(d.getTime())) return true;
            if (from && d < from) return false;
            if (to   && d > to)   return false;
            return true;
        });
    }

    var COLUMNS = [
        { title: 'เลขที่บิล',      data: null, render: function(d){ return pick(d,['BillNo','billNo']); } },
        { title: 'วันที่บิล',      data: null, render: function(d){ return fmtDate(pick(d,['BillDate','billDate'])); } },
        { title: 'รหัสสมาชิก',    data: null, render: function(d){ return pick(d,['Membercode','memberCode','membercode']); } },
        { title: 'ชื่อสมาชิก',    data: null, render: function(d){ return pick(d,['Membername','memberName','membername']); } },
        { title: 'รหัสศูนย์',      data: null, render: function(d){ return pick(d,['HybridGOLDID','hybridGoldId','hybridGOLDID']); } },
        { title: 'PV',             data: null, render: function(d){ return '<span class="text-info fw-semibold">' + fmtNum(pick(d,['TotalPV','totalPV','TotalPv'],0)) + '</span>'; } },
        { title: 'ยอดรวม',        data: null, render: function(d){ return '<span class="fw-bold text-success">' + fmtNum(pick(d,['TotalAmount','totalAmount'],0)) + '</span>'; } },
        { title: 'ประเภทชำระ',    data: null, render: function(d){ return pick(d,['PaymentType','paymentType']); } },
        { title: 'สถานะ',         data: null, render: function(d){ return pick(d,['BillConfirmType','billConfirmType']); } },
        { title: 'เลขอ้างอิง',    data: null, render: function(d){ return pick(d,['ReferenceNo','referenceNo']); } },
    ];

    function loadData() {
        $('#mainMessage').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...');

        $.ajax({
            url: '@Url.Action("GetSaleReportData", "reports")',
            type: 'GET',
            success: function (json) {
                var rows = filterByDate(normalizeRows(json));

                var totalAmt = rows.reduce(function(s, r){ return s + toNum(pick(r,['TotalAmount','totalAmount'],0)); }, 0);
                var totalPV  = rows.reduce(function(s, r){ return s + toNum(pick(r,['TotalPV','totalPV','TotalPv'],0)); }, 0);
                $('#totalAmountDisplay').val(fmtNum(totalAmt));
                $('#totalPvDisplay').val(fmtNum(totalPV));

                if (saleTable) { saleTable.destroy(); }
                $('#saleTable').empty();
                saleTable = $('#saleTable').DataTable({
                    data: rows,
                    columns: COLUMNS,
                    responsive: true,
                    ordering: true,
                    searching: false,
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'ทั้งหมด']],
                    language: { emptyTable: 'ไม่พบข้อมูล', zeroRecords: 'ไม่พบข้อมูล' }
                });

                $('#mainMessage').removeClass('alert-secondary').addClass('alert-success')
                    .text('พบข้อมูล ' + rows.length + ' รายการ');
            },
            error: function () {
                $('#mainMessage').removeClass('alert-secondary').addClass('alert-danger')
                    .text('เกิดข้อผิดพลาดในการดึงข้อมูล');
            }
        });
    }

    $('#btnSearch').on('click', function () { loadData(); });

    $('#btnReset').on('click', function () {
        $('#fromDate').val('');
        $('#toDate').val('');
        loadData();
    });

    loadData();
});
</script>

@section scripts {
    <script src="~/assets/js/app.js"></script>
}

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-daily-sales-report">รายงานยอดขายรายวันสำหรับสมาชิก</h4>
            </div>
            <div class="card-block p-3">
                <!-- ข้อมูลทั่วไป -->
                <div class="mb-4">
                    <h5 data-key="t-general-info">ข้อมูลทั่วไป</h5>
                    <div class="form-group row mb-3">
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-center-mobile-code">รหัสศูนย์/โมบาย :</label>
                        <div class="col-lg-4 col-md-6">
                            <input type="text" class="form-control" id="centerCodeDisplay" value="-" disabled />
                        </div>
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-amount">ยอดรวม :</label>
                        <div class="col-lg-4 col-md-6">
                            <input type="text" class="form-control" id="totalAmountDisplay" value="0.00" disabled />
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-quantity-of-pv">จำนวน PV :</label>
                        <div class="col-lg-4 col-md-6">
                            <input type="text" class="form-control" id="totalPvDisplay" value="0.00" disabled />
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-report-type">ประเภทรายงาน :</label>
                        <div class="col-lg-10 col-md-6">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="report_type" id="view_all" value="all" checked>
                                <label class="form-check-label" for="view_all" data-key="t-view-all">ดูทั้งหมด</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="report_type" id="daily" value="daily">
                                <label class="form-check-label" for="daily" data-key="t-daily">รายวัน</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="report_type" id="weekly" value="weekly">
                                <label class="form-check-label" for="weekly" data-key="t-weekly">รายสัปดาห์</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="report_type" id="monthly" value="monthly">
                                <label class="form-check-label" for="monthly" data-key="t-monthly">รายเดือน</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group row mb-3">
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-from-date">จากวันที่ :</label>
                        <div class="col-lg-3 col-md-6">
                            <input type="date" class="form-control" id="fromDate" value="" />
                        </div>
                        <label class="col-lg-2 col-md-4 col-form-label" data-key="t-to-date">ถึงวันที่ :</label>
                        <div class="col-lg-3 col-md-6">
                            <input type="date" class="form-control" id="toDate" value="" />
                        </div>
                        <div class="col-md-2">
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-light" id="btnResetSale" type="button">รีเซ็ต</button>
                                <button class="btn btn-primary" id="btnSearchSale" type="button" data-key="t-search">ค้นหา</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- รายงาน -->
                <div>
                    <h5 data-key="t-report">รายงาน</h5>
                    <div class="table-responsive mt-3">
                        <table id="data-table-responsive" class="table table-striped table-bordered"></table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        function pick(obj, keys, defaultValue = '') {
            for (const key of keys) {
                if (obj && obj[key] !== undefined && obj[key] !== null) {
                    return obj[key];
                }
            }
            return defaultValue;
        }

        function normalizeRows(payload) {
            let data = payload;

            if (typeof data === 'string') {
                try {
                    data = JSON.parse(data);
                } catch (e) {
                    data = [];
                }
            }

            if (data && Array.isArray(data.data)) {
                data = data.data;
            }

            return Array.isArray(data) ? data : [];
        }

        function toDate(value) {
            if (!value) return null;
            const date = new Date(value);
            return isNaN(date.getTime()) ? null : date;
        }

        function getWeekStartDate(date) {
            const weekDate = new Date(date);
            const day = weekDate.getDay();
            const diff = weekDate.getDate() - day + (day === 0 ? -6 : 1);
            weekDate.setDate(diff);
            weekDate.setHours(0, 0, 0, 0);
            return weekDate;
        }

        function applyReportFormat(rows, reportType) {
            if (reportType === 'all' || reportType === 'daily') {
                return rows;
            }

            const grouped = {};
            rows.forEach(function (row) {
                const rowDate = toDate(row.billDate);
                if (!rowDate) return;

                let key = '';
                let label = '';
                if (reportType === 'weekly') {
                    const weekStart = getWeekStartDate(rowDate);
                    key = `week-${weekStart.toISOString().split('T')[0]}`;
                    label = `สัปดาห์ของ ${weekStart.toLocaleDateString('th-TH')}`;
                } else {
                    key = `month-${rowDate.getFullYear()}-${rowDate.getMonth() + 1}`;
                    label = rowDate.toLocaleDateString('th-TH', { year: 'numeric', month: 'long' });
                }

                if (!grouped[key]) {
                    grouped[key] = {
                        billNo: key,
                        billDate: label,
                        hybridGoldId: '-',
                        memberCode: '-',
                        memberName: reportType === 'weekly' ? 'รวมรายสัปดาห์' : 'รวมรายเดือน',
                        billType: '-',
                        totalAmount: 0,
                        totalPV: 0,
                        billConfirmType: '-',
                        referenceNo: '-'
                    };
                }

                grouped[key].totalAmount += row.totalAmount || 0;
                grouped[key].totalPV += row.totalPV || 0;
            });

            return Object.values(grouped);
        }

        const table = $("#data-table-responsive").DataTable({
            responsive: true,
            processing: true,
            serverSide: false,
            filter: false,
            orderMulti: false,
            ordering: true,
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
            pageLength: 25,
            destroy: true,
            searching: false,
            contentType: "application/json; charset=utf-8",
            ajax: {
                url: '@Url.Action("GetSaleReportData", "reports")',
                type: 'GET',
                dataSrc: function (json) {
                    const fromDate = $('#fromDate').val();
                    const toDate = $('#toDate').val();
                    const reportType = $('input[name="report_type"]:checked').val() || 'all';

                    const rows = normalizeRows(json).map(function (item) {
                        return {
                            billNo: pick(item, ['BillNo', 'billNo']),
                            billDate: pick(item, ['BillDate', 'billDate']),
                            hybridGoldId: pick(item, ['HybridGOLDID', 'hybridGoldId']),
                            memberCode: pick(item, ['Membercode', 'memberCode']),
                            memberName: pick(item, ['Membername', 'memberName']),
                            billType: pick(item, ['Billtype', 'billType']),
                            totalAmount: parseFloat(pick(item, ['TotalAmount', 'totalAmount'], 0)) || 0,
                            totalPV: parseFloat(pick(item, ['TotalPV', 'totalPV'], 0)) || 0,
                            billConfirmType: pick(item, ['BillConfirmType', 'billConfirmType']),
                            referenceNo: pick(item, ['ReferenceNo', 'referenceNo'])
                        };
                    });

                    const dateFilteredRows = rows.filter(function (row) {
                        if (!fromDate && !toDate) return true;
                        const rowDate = toDate(row.billDate);
                        if (!rowDate) return false;
                        if (fromDate && rowDate < new Date(fromDate)) return false;
                        if (toDate) {
                            const endDate = new Date(toDate);
                            endDate.setHours(23, 59, 59, 999);
                            if (rowDate > endDate) return false;
                        }
                        return true;
                    });

                    const finalRows = applyReportFormat(dateFilteredRows, reportType);

                    const amountSum = finalRows.reduce((sum, row) => sum + row.totalAmount, 0);
                    const pvSum = finalRows.reduce((sum, row) => sum + row.totalPV, 0);
                    const firstCenter = finalRows.length > 0 ? finalRows[0].hybridGoldId : '-';

                    $('#centerCodeDisplay').val(firstCenter || '-');
                    $('#totalAmountDisplay').val(amountSum.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                    $('#totalPvDisplay').val(pvSum.toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));

                    return finalRows;
                }
            },
            columns: [
                { title: "เลขที่ใบเสร็จ", data: 'billNo', orderable: true },
                { title: "วันที่ใบเสร็จ", data: 'billDate' },
                { title: "รหัสศูนย์", data: 'hybridGoldId' },
                { title: "รหัสสมาชิก", data: 'memberCode' },
                { title: "ชื่อสมาชิก", data: 'memberName' },
                { title: "ประเภทการสั่งซื้อ", data: 'billType' },
                { title: "ยอดรวม", data: 'totalAmount', render: function (d) { return (d || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } },
                { title: "PV", data: 'totalPV', render: function (d) { return (d || 0).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); } },
                { title: "สถานะใบเสร็จ", data: 'billConfirmType' },
                { title: "เลขอ้างอิง", data: 'referenceNo' }
            ]
        });

        $('#btnSearchSale').on('click', function () {
            table.ajax.reload();
        });

        $('#btnResetSale').on('click', function () {
            $('#view_all').prop('checked', true);
            $('#fromDate').val('');
            $('#toDate').val('');
            table.ajax.reload();
        });
    });
</script>

@section scripts{
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
}