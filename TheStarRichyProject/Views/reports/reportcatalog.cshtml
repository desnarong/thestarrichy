            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function () {
        // Initialize DataTable
        var table = $('#reportsTable').DataTable({
            "pageLength": 25,
            "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "ทั้งหมด"]],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Thai.json"
            }
        });

        // Search filter
        $('#searchReport').on('keyup', function () {
            table.search(this.value).draw();
        });

        // Controller filter
        $('#filterController').on('change', function () {
            var controller = $(this).val();
            if (controller) {
                table.column(1).search(controller, true, false).draw();
            } else {
                table.column(1).search('').draw();
            }
        });

        // Auth filter
        $('#filterAuth').on('change', function () {
            var auth = $(this).val();
            if (auth) {
                table.column(4).search(auth === 'true' ? '✓' : '✗', true, false).draw();
            } else {
                table.column(4).search('').draw();
            }
        });

        // Add click event to copy endpoint
        $('#reportsTable tbody').on('click', 'td:nth-child(3)', function () {
            var endpoint = $(this).text().trim();
            navigator.clipboard.writeText(endpoint).then(function() {
                toastr.success('คัดลอก Endpoint เรียบร้อยแล้ว: ' + endpoint);
            });
        });
    });
</script>

