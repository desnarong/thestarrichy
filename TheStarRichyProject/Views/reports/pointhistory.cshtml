@{
    ViewData["Title"] = "รายงานโบนัสสมาชิก";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1a237e,#7986cb);">
        <i class="bx bx-bar-chart-alt-2 fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">รายงานโบนัสสมาชิก</h5>
      </div>
      <div class="card-body py-3">
        <div class="row g-3 mb-3">
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e8eaf6;border:2px solid #5c6bc0 !important;">
              <div class="text-muted small">โบนัสสะสม</div>
              <div class="fs-4 fw-bold" style="color:#283593;" id="totalAccumBonus">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2 mb-1">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ประเภทรายงาน</label>
            <div class="d-flex gap-3">
              <div class="form-check"><input class="form-check-input" type="radio" name="report_type" id="rpt_daily" value="daily" checked><label class="form-check-label" for="rpt_daily">รายวัน&nbsp;<span class="badge" style="background:#5c6bc0;" id="reportTypeLabel">รายวัน</span></label></div>
              <div class="form-check"><input class="form-check-input" type="radio" name="report_type" id="rpt_monthly" value="monthly"><label class="form-check-label" for="rpt_monthly">รายเดือน</label></div>
              <div class="form-check"><input class="form-check-input" type="radio" name="report_type" id="rpt_period" value="period"><label class="form-check-label" for="rpt_period">รอบการจ่าย</label></div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">จากวันที่</label>
            <input type="date" class="form-control form-control-sm" id="fromDate">
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ถึงวันที่</label>
            <input type="date" class="form-control form-control-sm" id="toDate">
          </div>
          <div class="col-auto align-self-end">
            <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
            <button class="btn btn-sm" id="btnSearch" style="background:#5c6bc0;border-color:#5c6bc0;color:#fff;"><i class="bx bx-search me-1"></i>ค้นหา</button>
          </div>
        </div>
        <small class="text-muted mt-1 d-block"><i class="bx bx-info-circle me-1"></i>ถ้าไม่ได้ระบุวันที่ จะแสดงข้อมูลทั้งหมด</small>
      </div>
    </div>
  </div>
</div>

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center justify-content-between" style="background:#fffde7;border-bottom:2px solid #fbc02d;">
        <h5 class="mb-0 fw-semibold" style="color:#f57f17;"><i class="bx bx-table me-2"></i>สรุปรายงานโบนัส</h5>
        <span class="badge" style="background:#fbc02d;" id="rowCount">0</span>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="mainMessage">กำลังโหลดข้อมูล...</div>
        <div class="table-responsive">
          <table id="mainBonusTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.78rem;white-space:nowrap;"></table>
        </div>
        <div id="periodSummarySection" style="display:none;" class="mt-3 border-top pt-3">
          <h6 class="fw-bold mb-2"><i class="bx bx-receipt me-1"></i>สรุปยอดหักค่าใช้จ่าย</h6>
          <table class="table table-bordered table-sm" style="max-width:480px;">
            <tbody>
              <tr><td class="text-muted">ค่าธรรมเนียมดำเนินการ</td><td class="text-end" id="sum_ServicePrice">-</td></tr>
              <tr><td class="text-muted">ยอดหลังหักค่าดำเนินการ</td><td class="text-end" id="sum_TotalBonusAfterExpense">-</td></tr>
              <tr><td class="text-muted">ภาษี</td><td class="text-end" id="sum_Tax">-</td></tr>
              <tr><td class="text-muted">โบนัสรวมภาษี</td><td class="text-end" id="sum_TotalBonusIncudeTax">-</td></tr>
              <tr><td class="text-muted">ภาษีหัก ณ ที่จ่าย</td><td class="text-end" id="sum_WithHoldingTax">-</td></tr>
              <tr class="table-success fw-bold"><td>โบนัสสุทธิ (NetBonus)</td><td class="text-end text-success" id="sum_NetBonus">-</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row" id="detailSection" style="display:none;">
  <div class="col-12">
    <div class="card shadow-sm border-0" style="border:1px solid #4caf50 !important;">
      <div class="card-header d-flex align-items-center justify-content-between" style="background:#e8f5e9;border-bottom:2px solid #4caf50;">
        <h5 class="mb-0 fw-semibold text-success"><i class="bx bx-zoom-in me-2"></i>ที่มารายได้: <span id="detailTitle">-</span></h5>
        <button class="btn btn-sm btn-outline-secondary" id="btnCloseDetail"><i class="bx bx-x me-1"></i>ปิด</button>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="detailMessage">กำลังโหลดรายละเอียด...</div>
        <div class="table-responsive">
          <table id="detailBonusTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.78rem;white-space:nowrap;"></table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
  var mainTbl=null,detailTbl=null,allDetailData={};

  function pick(o,k,d){if(d===undefined)d='';for(var i=0;i<k.length;i++){if(o!=null&&o[k[i]]!==undefined&&o[k[i]]!==null)return o[k[i]];}return d;}
  function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
  function toNum(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt0(v){return Math.round(toNum(v)).toLocaleString('th-TH');}
  function fmtDate(v){if(!v)return'-';var d=new Date(v);if(isNaN(d.getTime()))return String(v);var day=String(d.getDate()).padStart(2,'0');var month=String(d.getMonth()+1).padStart(2,'0');var year=d.getFullYear();return day+'/'+month+'/'+year;}
  function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

  function parseRowDate(v){
    if(!v)return null;
    if(/^\d{2}\/\d{4}$/.test(String(v))){var p=v.split('/');return new Date(parseInt(p[1]),parseInt(p[0])-1,1);}
    var d=new Date(v);return isNaN(d.getTime())?null:d;
  }
  function filterByDate(rows,dateKeys,from,to){
    if(!from&&!to)return rows;
    var f=from?new Date(from):null,t=to?new Date(to+'T23:59:59'):null;
    return rows.filter(function(r){var raw=pick(r,dateKeys);var d=parseRowDate(raw);if(!d)return true;if(f&&d<f)return false;if(t&&d>t)return false;return true;});
  }

  var BONUS_TYPES=[
    {key:'SponserBonus',label:'ค่าแนะนำ',detail:'sponser'},
    {key:'RebateBonus',label:'ส่วนตัว',detail:'rebate'},
    {key:'WeakBonus',label:'TMB/จับคู่',detail:'binary'},
    {key:'MatchingBonus',label:'แมทชิ่ง',detail:'matching'},
    {key:'MobileBonus',label:'แจงยอด',detail:'mobile'},
    {key:'SpecialBonus',label:'พิเศษ',detail:null},
    {key:'TotalBonus',label:'รวม',detail:null}
  ];

  function bonusTh(bt,rows){
    var val=toNum(pick(rows,[bt.key,bt.key.toLowerCase()],0));
    var dtKey=pick(rows,['FromDate','fromDate','CalcMonth','calcMonth','PaymentDate','paymentDate']);
    var num=fmt0(val);
    if(bt.detail&&val!==0){
      return '<span class="text-primary fw-bold bonus-link" style="cursor:pointer;text-decoration:underline;" data-detail="'+bt.detail+'" data-date="'+esc(dtKey)+'">'+num+'</span>';
    }
    return num;
  }

  function getMainCols(rtype){
    var bonusCols=BONUS_TYPES.map(function(bt){
      return{title:bt.label,data:null,render:function(d){return bonusTh(bt,d);}};
    });
    if(rtype==='monthly'){
      return [{title:'เดือน',data:null,render:function(d){return esc(pick(d,['CalcMonth','calcMonth','Calcmonth'])||'-');}}].concat(bonusCols);
    }
    return [
      {title:'จากวันที่',data:null,render:function(d){return fmtDate(pick(d,['FromDate','fromDate']));}},
      {title:'ถึงวันที่',data:null,render:function(d){return fmtDate(pick(d,['ToDate','toDate']));}},
      {title:'รอบการจ่าย',data:null,render:function(d){return fmtDate(pick(d,['PaymentDate','paymentDate']));}}
    ].concat(bonusCols);
  }

  function loadMain(){
    var rtype=$('input[name="report_type"]:checked').val()||'daily';
    var from=$('#fromDate').val(),to=$('#toDate').val();
    var labels={daily:'รายวัน',monthly:'รายเดือน',period:'รอบการจ่าย'};
    $('#reportTypeLabel').text(labels[rtype]||rtype);
    $('#mainMessage').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...');
    $('#periodSummarySection').hide();$('#detailSection').hide();allDetailData={};
    $.ajax({url:'@Url.Action("GetBonusReport","reports")',type:'GET',data:{reportType:rtype},success:function(json){
      var rows=norm(json);
      var dateKeys=rtype==='monthly'?['CalcMonth','calcMonth','Calcmonth']:['FromDate','fromDate'];
      rows=filterByDate(rows,dateKeys,from,to);
      var accum=rows.reduce(function(s,r){return s+toNum(pick(r,['NetBonus','netBonus','TotalBonus','totalBonus'],0));},0);
      $('#totalAccumBonus').text(fmt0(accum));
      if(rtype==='period'){
        var sf=[['sum_ServicePrice',['ServicePrice','servicePrice']],['sum_TotalBonusAfterExpense',['TotalBonusAfterExpense','totalBonusAfterExpense']],['sum_Tax',['Tax','tax']],['sum_TotalBonusIncudeTax',['TotalBonusIncudeTax','totalBonusIncudeTax']],['sum_WithHoldingTax',['WithHoldingTax','withHoldingTax']],['sum_NetBonus',['NetBonus','netBonus']]];
        sf.forEach(function(p){var tot=rows.reduce(function(s,r){return s+toNum(pick(r,p[1],0));},0);$('#'+p[0]).text(fmt0(tot)+' บาท');});
        if(rows.length>0)$('#periodSummarySection').slideDown(200);
      }
      if(mainTbl){mainTbl.destroy();}$('#mainBonusTable').empty();
      mainTbl=$('#mainBonusTable').DataTable({data:rows,columns:getMainCols(rtype),ordering:true,searching:false,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],
        language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
      $('#rowCount').text(rows.length);
      $('#mainMessage').removeClass('alert-secondary').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
    },error:function(){$('#mainMessage').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');}});
  }

  var DETAIL_URL_MAP={sponser:'sponser',rebate:'rebate',binary:'binary',matching:'matching',mobile:'mobile'};
  var DETAIL_COLS={
    sponser:[{title:'ระดับ',k:['DLLevel','dlLevel']},{title:'รหัส',k:['DLCode','dlCode']},{title:'ชื่อ',k:['DLName','dlName']},{title:'รหัสนักธุรกิจ',k:['Membercode','memberCode']},{title:'ชื่อนักธุรกิจ',k:['MemberName','memberName']},{title:'โบนัส',k:['SponserBonus','sponserBonus'],num:true}],
    rebate:[{title:'วันที่',k:['BillDate','billDate'],dt:true},{title:'เลขที่บิล',k:['BillNo','billNo']},{title:'รหัสสินค้า',k:['ProductID','productId']},{title:'ชื่อสินค้า',k:['ProductName','productName']},{title:'PV',k:['PV','pv'],num:true},{title:'โบนัส',k:['RebateBonus','rebateBonus'],num:true}],
    binary:[{title:'วันที่คำนวณ',k:['CalcDate','calcDate'],dt:true},{title:'ตำแหน่ง',k:['Memberposition','memberposition']},{title:'PV ซ้าย',k:['LeftPV','leftPV'],num:true},{title:'PV ขวา',k:['RightPV','rightPV'],num:true},{title:'โบนัส',k:['WeakBonus','weakBonus'],num:true}],
    matching:[{title:'ระดับ',k:['DLLevel','dlLevel']},{title:'รหัส',k:['DLCode','dlCode']},{title:'ชื่อ',k:['DLName','dlName']},{title:'SponserBonus',k:['SponserBonus','sponserBonus'],num:true},{title:'%',k:['MatchingPercent','matchingPercent']},{title:'Matching',k:['MatchingBonus','matchingBonus'],num:true}],
    mobile:[{title:'รหัสนักธุรกิจ',k:['Membercode','memberCode']},{title:'ชื่อ',k:['MemberName','memberName']},{title:'ประเภท',k:['BillType','billType']},{title:'PV',k:['PV','pv'],num:true},{title:'โบนัส',k:['MobileBonus','mobileBonus'],num:true}]
  };

  function loadDetail(dtype,dateRaw){
    allDetailData={};
    $('#detailTitle').text((dtype==='sponser'?'ค่าแนะนำ':dtype==='rebate'?'ส่วนตัว':dtype==='binary'?'TMB/จับคู่':dtype==='matching'?'แมทชิ่ง':'แจงยอด')+' ('+fmtDate(dateRaw)+')');
    $('#detailSection').show();
    $('#detailMessage').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดรายละเอียด...');
    $.ajax({url:'@Url.Action("GetBonusDetail","reports")',type:'GET',data:{detailType:dtype},success:function(json){
      var rows=norm(json);
      var cfg=DETAIL_COLS[dtype]||[];
      if(detailTbl){detailTbl.destroy();}$('#detailBonusTable').empty();
      var theadHtml='<thead class="text-center" style="background:#e8f5e9;font-size:.78rem;"><tr>'+['#'].concat(cfg.map(function(c){return c.title;})).map(function(c){return'<th>'+c+'</th>';}).join('')+'</tr></thead>';
      var tbody='<tbody>';
      rows.forEach(function(r,i){
        tbody+='<tr><td class="text-center">'+(i+1)+'</td>';
        cfg.forEach(function(c){
          var v=pick(r,c.k,'');
          if(c.dt)tbody+='<td class="text-center">'+fmtDate(v)+'</td>';
          else if(c.num)tbody+='<td class="text-end">'+fmt0(v)+'</td>';
          else tbody+='<td>'+esc(String(v))+'</td>';
        });
        tbody+='</tr>';
      });
      tbody+='</tbody>';
      $('#detailBonusTable').html(theadHtml+tbody);
      detailTbl=$('#detailBonusTable').DataTable({paging:true,pageLength:25,ordering:true,searching:true,language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
      $('#detailMessage').removeClass('alert-secondary').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
    },error:function(){$('#detailMessage').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงรายละเอียด');}});
  }

  $(document).on('click','.bonus-link',function(){
    loadDetail($(this).data('detail'),$(this).data('date'));
  });
  $('#btnCloseDetail').on('click',function(){$('#detailSection').hide();});
  $('#btnSearch').on('click',loadMain);
  $('#btnReset').on('click',function(){$('#rpt_daily').prop('checked',true);$('#fromDate').val('');$('#toDate').val('');loadMain();});
  $('input[name="report_type"]').on('change',function(){$('#reportTypeLabel').text({'daily':'รายวัน','monthly':'รายเดือน','period':'รอบการจ่าย'}[$(this).val()]||$(this).val());});
  loadMain();
});
</script>
@section scripts{
    <script src="~/assets/js/app.js"></script>
}