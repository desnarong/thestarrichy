      function loadDetail(dtype,fromDate,toDate,calcMonth){
        var cfg = MODAL_CONFIG[dtype] || MODAL_CONFIG.sponser;
        var titleText = cfg.title;
        if(calcMonth){
          titleText += ' (' + esc(calcMonth) + ')';
        } else if (fromDate && toDate) {
          titleText += ' (' + fmtDate(fromDate) + ' - ' + fmtDate(toDate) + ')';
        }
        
        // Update modal title
        $(cfg.modalId + ' .modal-title').text(titleText);
        
        // Show modal
        var bsModal = new bootstrap.Modal(document.querySelector(cfg.modalId));
        $(cfg.msgId).removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลด...');
        bsModal.show();

        // สำหรับ period ไม่ต้องเรียก API เพราะใช้ข้อมูลจาก main table
        if(dtype==='period'){
          var rows = allDetailData.periodRows || [];
          renderModalTable(cfg, rows, DETAIL_COLS.period);
          $(cfg.msgId).removeClass('alert-secondary').addClass('alert-success').text('พบข้อมูล ' + rows.length + ' รายการ');
          return;
        }

        // If calcMonth is provided, convert it to date range
        var apiFromDate = fromDate, apiToDate = toDate;
        if(calcMonth){
          var dateRange=parseCalcMonthToDates(calcMonth);
          if(dateRange){
            apiFromDate=dateRange.from.split('T')[0];
            apiToDate=dateRange.to.split('T')[0];
          }
        }

        $.ajax({
          url: '@Url.Action("GetBonusDetail", "reports")',
          type: 'GET',
          data: { detailType: dtype, fromDate: apiFromDate, toDate: apiToDate },
          success: function(json) {
            var rows = norm(json);
            var cols = DETAIL_COLS[dtype] || [];
            renderModalTable(cfg, rows, cols);
            $(cfg.msgId).removeClass('alert-secondary').addClass('alert-success').text('พบข้อมูล ' + rows.length + ' รายการ');
          },
          error: function() {
            $(cfg.msgId).removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงรายละเอียด');
          }
        });
      }

      $(document).on('click','.bonus-link',function(){
        var dtype=$(this).data('detail');
        var from=$(this).data('fromdate');
        var to=$(this).data('todate');
        var calcMonth=$(this).data('calcmonth');
        if(dtype==='period'){
