                <h5 class="modal-title text-dark" id="matchingModalLabel"><i class="bx bx-handicap me-2"></i>แมทชิ่ง</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary py-2 mb-2" id="matchingMessage">กำลังโหลด...</div>
                <div class="table-responsive">
                    <table id="matchingTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.8rem;"></table>
                </div>
