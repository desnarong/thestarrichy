                <div class="alert alert-secondary py-2 mb-2" id="rebateMessage">กำลังโหลด...</div>
                <div class="table-responsive">
                    <table id="rebateTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.8rem;"></table>
