<!-- Period Modal -->
<div class="modal fade" id="periodModal" tabindex="-1" aria-labelledby="periodModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title text-dark" id="periodModalLabel"><i class="bx bx-calendar-check me-2"></i>รอบการจ่าย</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary py-2 mb-2" id="periodMessage">กำลังโหลด...</div>
                <div class="table-responsive">
                    <table id="periodTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.8rem;"></table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(function(){
      var mainTbl=null,detailTbl=null,allDetailData={};

      function pick(o,k,d){if(d===undefined)d='';for(var i=0;i<k.length;i++){if(o!=null&&o[k[i]]!==undefined&&o[k[i]]!==null)return o[k[i]];}return d;}
      function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
      function toNum(v){var n=parseFloat(v);return isNaN(n)?0:n;}
      function fmt2(v){return toNum(v).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
      function fmt0(v){var n=Math.round(toNum(v));return n.toLocaleString('th-TH');}
      function fmtDate(v){if(!v)return'-';var d=new Date(v);if(isNaN(d.getTime()))return String(v);var day=String(d.getDate()).padStart(2,'0');var month=String(d.getMonth()+1).padStart(2,'0');var year=d.getFullYear();return day+'/'+month+'/'+year;}
      function isoDate(v){if(!v)return'';var d=new Date(v);if(isNaN(d.getTime()))return'';return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
      function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}

      function parseRowDate(v){
        if(!v)return null;
        if(/^\d{2}\/\d{4}$/.test(String(v))){var p=v.split('/');return new Date(parseInt(p[1]),parseInt(p[0])-1,1);}
        var d=new Date(v);return isNaN(d.getTime())?null:d;
      }
      function filterByDate(rows,dateKeys,from,to){
        if(!from&&!to)return rows;
        var f=from?new Date(from):null,t=to?new Date(to+'T23:59:59'):null;
        return rows.filter(function(r){var raw=pick(r,dateKeys);var d=parseRowDate(raw);if(!d)return true;if(f&&d<f)return false;if(t&&d>t)return false;return true;});
      }

      var BONUS_TYPES=[
        {key:'SponserBonus',label:'ค่าแนะนำ',detail:'sponser'},
        {key:'RebateBonus',label:'ส่วนตัว',detail:'rebate'},
        {key:'WeakBonus',label:'TMB/จับคู่',detail:'binary'},
        {key:'MatchingBonus',label:'แมทชิ่ง',detail:'matching'},
        {key:'MobileBonus',label:'แจงยอด',detail:'mobile'},
        {key:'SpecialBonus',label:'พิเศษ',detail:null},
        {key:'TotalBonus',label:'รวม',detail:null}
      ];

      function bonusTh(bt,rows,rtype){
        var val=toNum(pick(rows,[bt.key,bt.key.toLowerCase()],0));
        var fromDate=pick(rows,['FromDate','fromDate']);
        var toDate=pick(rows,['ToDate','toDate']);
        var calcMonth=pick(rows,['CalcMonth1','calcMonth1','CalcMonth','calcMonth']);
        var num=fmt2(val);
        // SpecialBonus และ TotalBonus - ไม่มีลิงค์
        if(bt.key==='SpecialBonus'||bt.key==='TotalBonus'){
          return num;
        }
        // Period - มีลิงค์ดูรายละเอียด
        if(bt.key==='TotalBonus'){
          return num;
        }
        if(bt.detail&&val!==0){
          if(rtype==='monthly'){
            return '<span class="text-primary fw-bold bonus-link" style="cursor:pointer;text-decoration:underline;" data-detail="'+bt.detail+'" data-calcmonth="'+esc(calcMonth)+'">'+num+'</span>';
          }
          return '<span class="text-primary fw-bold bonus-link" style="cursor:pointer;text-decoration:underline;" data-detail="'+bt.detail+'" data-fromdate="'+esc(fromDate)+'" data-todate="'+esc(toDate)+'">'+num+'</span>';
        }
        return num;
      }

      function getMainCols(rtype) {
          var bonusCols = BONUS_TYPES.map(function(bt) {
            return {
              title: bt.label,
              data: null,
              className: 'text-end',
              render: function(d) { return bonusTh(bt, d, rtype); }
            };
          });

          // ฟังก์ชันตัวช่วยสำหรับ Render วันที่ให้รองรับการ Sort
      function renderDateSortable(fields) {
          return function(d, type) {
            var rawDate = pick(d, fields);

            // ตรวจสอบว่าถ้า rawDate เป็น object (เช่น {}) ให้ถือว่าเป็นค่าว่าง
            if (typeof rawDate === 'object' && rawDate !== null) {
              rawDate = '';
            }
            
            // รองรับ DataTables ทั้ง v1.x (sort) และ v2.x (order)
            if (type === 'sort' || type === 'order' || type === 'type') {
              if (!rawDate) return 0;
              var dateObj = new Date(rawDate);
              return isNaN(dateObj.getTime()) ? 0 : dateObj.getTime();
            }

            // ถ้า rawDate เป็น null/undefined จากการดักข้างบน fmtDate จะแสดงเป็นค่าว่างให้เอง
            return fmtDate(rawDate);
          };
        }

          if (rtype === 'monthly') {
            return [
              { 
                title: 'เดือน', 
                data: null, 
                className: 'text-center', 
                render: function(d, type) {
                  var calcMonth = pick(d, ['CalcMonth1', 'calcMonth1']);
                  if (!calcMonth) return '-';
                  
                  // รองรับ DataTables ทั้ง v1.x (sort) และ v2.x (order)
                  if (type === 'sort' || type === 'order' || type === 'type') {
                    // รองรับ format: MM/YYYY, MM-YYYY, YYYY-MM, YYYYMM
                    var m = String(calcMonth);
                    var month, year;
                    
                    if (m.includes('/')) {
                      var p = m.split('/');
                      if (p[0].length <= 2) { month = parseInt(p[0]); year = parseInt(p[1]); }
                      else { year = parseInt(p[0]); month = parseInt(p[1]); }
                    } else if (m.includes('-')) {
                      var p = m.split('-');
                      if (p[0].length <= 2) { month = parseInt(p[0]); year = parseInt(p[1]); }
                      else { year = parseInt(p[0]); month = parseInt(p[1]); }
                    } else if (/^\d{6}$/.test(m)) {
                      year = parseInt(m.substring(0, 4));
                      month = parseInt(m.substring(4, 6));
                    }
                    
                    if (month && year && month >= 1 && month <= 12) {
                      return year * 100 + month; // YYYYMM integer - เรียงได้ถูกต้องแน่นอน
                    }
                    return 0;
                  }
                  
                  return esc(calcMonth);
                }
              }
            ].concat(bonusCols);
          }

          // สำหรับรายวันและรอบการจ่าย - เพิ่มคอลัมน์ "ประเภท"
          if (rtype === 'period') {
            return [
              { title: 'จากวันที่', data: null, className: 'text-center', render: renderDateSortable(['FromDate', 'fromDate']) },
              { title: 'ถึงวันที่', data: null, className: 'text-center', render: renderDateSortable(['ToDate', 'toDate']) },
              { title: 'รอบการจ่าย', data: null, className: 'text-center', render: renderDateSortable(['PaymentDate', 'paymentDate']) },
              { title: 'ประเภท', data: null, className: 'text-center', render: function(d) { return esc(pick(d, ['TypeofBonus', 'typeofBonus', 'BonusType', 'bonusType']) || '-'); } }
            ].concat(bonusCols).concat([
