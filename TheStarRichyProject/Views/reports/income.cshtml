    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-light">
                <h5 class="modal-title text-dark" id="mobileModalLabel"><i class="bx bx-mobile me-2"></i>แจงยอด</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-secondary py-2 mb-2" id="mobileMessage">กำลังโหลด...</div>
                <div class="table-responsive">
                    <table id="mobileTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.8rem;"></table>
                </div>
