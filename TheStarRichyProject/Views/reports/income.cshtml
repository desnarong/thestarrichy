@{
    ViewData["Title"] = "รายงานรายได้";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#e65100,#ff9800);">
        <i class="bx bx-money fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">รายงานรายได้สำหรับสมาชิก</h5>
      </div>
      <div class="card-body py-3">
        <div class="row g-3 mb-3">
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#fff3e0;border:2px solid #ff9800 !important;">
              <div class="text-muted small">โบนัสสะสม</div>
              <div class="fs-4 fw-bold" style="color:#e65100;" id="sumBonusText">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e8f5e9;border:2px solid #43a047 !important;">
              <div class="text-muted small">จำนวนรายการ</div>
              <div class="fs-4 fw-bold" style="color:#2e7d32;" id="sumRows">-</div>
              <div class="text-muted" style="font-size:.7rem;">รายการ</div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-3 mb-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ประเภทข้อมูล</label>
            <div class="d-flex gap-3">
              <div class="form-check"><input class="form-check-input" type="radio" name="report_type" id="daily_points" value="daily_points" checked><label class="form-check-label" for="daily_points">บันทึกคะแนนรายวัน</label></div>
              <div class="form-check"><input class="form-check-input" type="radio" name="report_type" id="points_deduction" value="points_deduction"><label class="form-check-label" for="points_deduction">ประวัติการหักคะแนน</label></div>
            </div>
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ประเภทรายงาน</label>
            <div class="d-flex gap-3">
              <div class="form-check"><input class="form-check-input" type="radio" name="report_format" id="fmt_daily" value="daily" checked><label class="form-check-label" for="fmt_daily">รายวัน</label></div>
              <div class="form-check"><input class="form-check-input" type="radio" name="report_format" id="fmt_weekly" value="weekly"><label class="form-check-label" for="fmt_weekly">รายสัปดาห์</label></div>
              <div class="form-check"><input class="form-check-input" type="radio" name="report_format" id="fmt_monthly" value="monthly"><label class="form-check-label" for="fmt_monthly">รายเดือน</label></div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">จากวันที่</label>
            <input type="date" class="form-control form-control-sm" id="fromDate">
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ถึงวันที่</label>
            <input type="date" class="form-control form-control-sm" id="toDate">
          </div>
          <div class="col-auto align-self-end">
            <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
            <button class="btn btn-sm" id="btnSearch" style="background:#ff9800;border-color:#ff9800;color:#fff;"><i class="bx bx-search me-1"></i>ค้นหา</button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header" style="background:#fff3e0;border-bottom:2px solid #ff9800;">
        <h5 class="mb-0 fw-semibold" style="color:#e65100;"><i class="bx bx-list-ul me-2"></i>รายการรายได้ &nbsp;<span class="badge" style="background:#ff9800;" id="rowCount">0</span></h5>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="msg">กำลังโหลดข้อมูลรายได้...</div>
        <div class="table-responsive">
          <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.84rem;"></table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
  var tbl=null;
  function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
  function num(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt2(v){return num(v).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}

  function mapPeriodLabel(period){
    var m={'1_months':'1 เดือน','2_months':'2 เดือน','3_months':'3 เดือน','4_months':'4 เดือน','5_months':'5 เดือน','6_months':'6 เดือน','7_months':'7 เดือน','8_months':'8 เดือน','9_months':'9 เดือน','10_months':'10 เดือน','11_months':'11 เดือน','1_year':'1 ปี','2_year':'2 ปี'};
    return m[period]||period||'-';
  }

  function buildTable(rows){
    if(tbl){tbl.destroy();tbl=null;}$('#mainTable').empty();
    var thead='<thead class="text-center" style="background:linear-gradient(135deg,#fff3e0,#ffe0b2);font-size:.78rem;"><tr><th>#</th><th>รอบการรับโบนัส</th><th>รายได้ (บาท)</th></tr></thead>';
    var tbody='<tbody>';
    rows.forEach(function(r,i){
      tbody+='<tr><td class="text-center">'+(i+1)+'</td><td>'+mapPeriodLabel(r.periodRaw)+'</td><td class="text-end fw-bold text-success">'+r.bonusDisplay+'</td></tr>';
    });
    tbody+='</tbody>';
    $('#mainTable').html(thead+tbody);
    tbl=$('#mainTable').DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],ordering:true,searching:true,
      language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
    var total=rows.reduce(function(s,r){return s+r.bonusValue;},0);
    $('#sumBonusText').text(fmt2(total));$('#sumRows').text(rows.length);$('#rowCount').text(rows.length);
    $('#msg').removeClass('alert-secondary alert-danger').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
  }

  function loadData(){
    $('#msg').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();
    var rtype=$('input[name="report_type"]:checked').val()||'daily_points';
    var rfmt=$('input[name="report_format"]:checked').val()||'daily';
    var f=$('#fromDate').val(),t=$('#toDate').val();
    $.ajax({
      url:'@Url.Action("GetIncomeByPeriod","home")',type:'GET',
      data:{reportType:rtype,reportFormat:rfmt,fromDate:f,toDate:t},
      success:function(json){
        var payload=norm(json);
        var rows=payload.map(function(item){
          var rawBonus=parseFloat(item.TotalBonusPeriod??item.totalBonusPeriod??item.totalBonus??0);
          var bonus=isNaN(rawBonus)?0:rawBonus;
          var srcDate=item.PaymentDate??item.paymentDate??item.Startdate??item.startdate??item.Enddate??item.enddate??'';
          var periodRaw=(item.period??item.Period??'').toString();
          var typeOfBonusRaw=(item.TypeofBonus??item.typeofBonus??'').toString().toLowerCase();
          return{sourceDate:srcDate,periodRaw:periodRaw,typeOfBonusRaw:typeOfBonusRaw,bonusValue:bonus,bonusDisplay:bonus.toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2})};
        });
        rows=rows.filter(function(row){
          if(rtype==='points_deduction'){var isDed=row.typeOfBonusRaw.includes('cut')||row.typeOfBonusRaw.includes('deduct')||row.typeOfBonusRaw.includes('หัก');var isDedVal=row.bonusValue<0;if(!isDed&&!isDedVal)return false;}
          if(rtype==='daily_points'){var isDed=row.typeOfBonusRaw.includes('cut')||row.typeOfBonusRaw.includes('deduct')||row.typeOfBonusRaw.includes('หัก');if(isDed||row.bonusValue<0)return false;}
          if(rfmt==='monthly'&&!row.periodRaw.toLowerCase().includes('month'))return false;
          if(rfmt==='weekly'&&!row.periodRaw.toLowerCase().includes('week'))return false;
          if(!f&&!t)return true;
          if(!row.sourceDate)return false;
          var rd=new Date(row.sourceDate);if(isNaN(rd.getTime()))return false;
          if(f&&rd<new Date(f))return false;if(t&&rd>new Date(t))return false;
          return true;
        });
        buildTable(rows);
      },
      error:function(){$('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');}
    });
  }

  $('#btnSearch').on('click',loadData);
  $('#btnReset').on('click',function(){
    $('#daily_points').prop('checked',true);$('#fmt_daily').prop('checked',true);
    $('#fromDate').val('');$('#toDate').val('');loadData();
  });
  loadData();
});
</script>
@section scripts{
    <script src="~/assets/js/app.js"></script>
}