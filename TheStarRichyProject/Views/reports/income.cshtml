      function parseCalcMonthToDates(calcMonth){
        if(!calcMonth) return null;
        var m = String(calcMonth);

        // Support formats: 01/2025, 1/2025, 2025-01, 2025-1, 202501 (YYYYMM)
        var parts = null;
        
        // จัดการให้อยู่ในรูปแบบ [MM, YYYY] เสมอ
        if(m.includes('/')) {
            parts = m.split('/'); 
        } else if(m.includes('-')) {
            parts = m.split('-'); 
        } else if(/^\d{6}$/.test(m)) {
            parts = [m.substring(4,6), m.substring(0,4)];
        }

        if(!parts || parts.length !== 2) return null;

        var month = parseInt(parts[0]);
        var year = parseInt(parts[1]);

        if(isNaN(month) || isNaN(year) || month < 1 || month > 12) return null;

        // ใช้ Date.UTC ป้องกันเวลาเคลื่อนจากการแปลง Timezone ตอนเรียก toISOString()
        // วันที่ 1 ของเดือน (JS เดือนเริ่มที่ 0 เลยต้องเอา month - 1)
        var firstDay = new Date(Date.UTC(year, month - 1, 1));
        
        // วันสิ้นเดือน (ใช้วันที่ 0 ของเดือนถัดไป จะได้วันสุดท้ายของเดือนปัจจุบันพอดี)
        // เพิ่ม 23, 59, 59, 999 เพื่อให้เป็นเวลาสิ้นสุดของวันนั้นจริงๆ (23:59:59)
        var lastDay = new Date(Date.UTC(year, month, 0, 23, 59, 59, 999));

        return {
            from: firstDay.toISOString(),
            to: lastDay.toISOString()
        };
      }

      // Helper function to render modal table
      function renderModalTable(cfg, rows, columns) {
        var tableId = cfg.tableId;
        var detailTblVar = tableId + 'Tbl';
        
        // Destroy existing DataTable
        if ($.fn.DataTable.isDataTable(tableId)) {
          $(tableId).DataTable().destroy();
        }
        $(tableId).empty();
        
        // Build table HTML
        var theadHtml = '<thead class="text-center" style="background:#f5f5f5;font-size:.75rem;"><tr>';
        theadHtml += '<th class="text-center" style="width:40px;">#</th>';
        columns.forEach(function(c) {
          theadHtml += '<th class="text-center">' + c.title + '</th>';
        });
        theadHtml += '</tr></thead>';
        
        var tbody = '<tbody>';
        rows.forEach(function(r, i) {
          tbody += '<tr>';
          tbody += '<td class="text-center">' + (i + 1) + '</td>';
          columns.forEach(function(c) {
            var v = pick(r, c.k, '');
            if (c.dt) {
              tbody += '<td class="text-center" data-order="' + isoDate(v) + '">' + fmtDate(v) + '</td>';
            } else if (c.num) {
              tbody += '<td class="text-end">' + (c.fmt === 'fmt0' ? fmt0(v) : fmt2(v)) + '</td>';
            } else if (c.renderPrefix) {
              tbody += '<td class="text-center">' + c.renderPrefix + esc(String(v)) + '</td>';
            } else {
              tbody += '<td class="text-center">' + esc(String(v)) + '</td>';
            }
          });
          tbody += '</tr>';
        });
        tbody += '</tbody>';
        
        $(tableId).html(theadHtml + tbody);
        
        // Initialize DataTable
        $(tableId).DataTable({
          paging: true,
          pageLength: 25,
          ordering: true,
          searching: true,
          language: {
            emptyTable: 'ไม่พบข้อมูล',
            zeroRecords: 'ไม่พบข้อมูล',
            search: 'ค้นหา:',
            lengthMenu: 'แสดง _MENU_ รายการ',
            info: '_START_-_END_ จาก _TOTAL_',
            paginate: { first: '«', last: '»', next: '›', previous: '‹' }
          },
          drawCallback: function() {
            $(tableId + ' thead th').addClass('text-center');
          }
        });
      }

