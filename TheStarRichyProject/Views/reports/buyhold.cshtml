@{
    ViewData["Title"] = "รายงานบิล HOLD";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
.slip-thumb{width:32px;height:32px;object-fit:cover;border-radius:4px;cursor:pointer;border:1px solid #ddd;}

/* Document styles */
.doc-wrap{font-family:'Cordia New','CordiaUPC','TH Sarabun New','Sarabun',Arial,sans-serif;font-size:14pt;background:#fff;color:#000;padding:.8rem 1rem;max-width:860px;margin:0 auto;}
.doc-wrap table{border-collapse:collapse;width:100%;}
.doc-wrap table td,.doc-wrap table th{padding:2px 5px;vertical-align:top;}
.doc-wrap .doc-title{font-size:1.05rem;font-weight:700;text-align:center;}
.doc-wrap .amt-col{text-align:right;min-width:90px;}
@@media print{
  body *{visibility:hidden;}
  #billDoc,#billDoc *{visibility:visible;}
  #billDoc{position:fixed;top:0;left:0;width:100%;}
  #billDoc table,#billDoc td,#billDoc th{border:none !important;}
  #billDoc .product-table,#billDoc .product-table td,#billDoc .product-table th,#billDoc .product-table thead tr,#billDoc .product-table tbody tr{border:1px solid #aaa !important;}
}
</style>

<div class="modal fade" id="imgModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content"><div class="modal-body text-center p-2">
      <img id="imgModalSrc" src="" class="img-fluid rounded" style="max-height:80vh;" />
    </div></div>
  </div>
</div>

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#311b92,#7e57c2);">
        <i class="bx bx-pause-circle fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">รายงานบิล HOLD</h5>
      </div>
      <div class="card-body py-3">
        <div class="row g-3 mb-3">
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#ede7f6;border:2px solid #7e57c2 !important;">
              <div class="text-muted small">ยอดรวม</div>
              <div class="fs-4 fw-bold" style="color:#5e35b1;" id="sumAmount">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e0f7fa;border:2px solid #00acc1 !important;">
              <div class="text-muted small">จำนวน PV</div>
              <div class="fs-4 fw-bold" style="color:#00838f;" id="sumPV">-</div>
              <div class="text-muted" style="font-size:.7rem;">PV</div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2 mb-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ประเภทรายงาน</label>
            <div class="d-flex gap-3">
              <div class="form-check"><input class="form-check-input" type="radio" name="checktype" id="ctAll" value="all" checked><label class="form-check-label" for="ctAll">ดูทั้งหมด</label></div>
              <div class="form-check"><input class="form-check-input" type="radio" name="checktype" id="ctRemain" value="remain"><label class="form-check-label" for="ctRemain">ดูเฉพาะยอดคงเหลือ</label></div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">จากวันที่</label>
            <input type="date" class="form-control form-control-sm" id="fromDate">
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ถึงวันที่</label>
            <input type="date" class="form-control form-control-sm" id="toDate">
          </div>
          <div class="col-auto align-self-end">
            <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
            <button class="btn btn-sm btn-primary" id="btnSearch" style="background:#7e57c2;border-color:#7e57c2;"><i class="bx bx-search me-1"></i>ค้นหา</button>
          </div>
        </div>
        <small class="text-muted"><i class="bx bx-info-circle me-1"></i>ค่าเริ่มต้นคือแสดงข้อมูลทั้งหมด</small>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header" style="background:#ede7f6;border-bottom:2px solid #7e57c2;">
        <h5 class="mb-0 fw-semibold" style="color:#4527a0;"><i class="bx bx-table me-2"></i>รายการบิล HOLD &nbsp;<span class="badge" style="background:#7e57c2;" id="rowCount">0</span></h5>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="msg">กำลังโหลดข้อมูล...</div>
        <div class="table-responsive">
          <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.78rem;white-space:nowrap;">
            <style>
              table.table-hover tbody tr:hover {
                background-color: #e0e0e0 !important;
                transition: background-color 0.2s ease;
              }
            </style>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<div class="modal fade" id="detailModal" tabindex="-1">
  <div class="modal-dialog modal-xl modal-dialog-scrollable">
    <div class="modal-content">
      <div class="modal-header p-0 border-0">
        <div id="modalHeaderBand" style="width:100%;padding:.45rem 1rem;background:#7e57c2;" class="d-flex align-items-center justify-content-between flex-wrap gap-1">
          <div class="d-flex align-items-center gap-3 flex-wrap">
            <span class="fw-bold text-white fs-5" id="modalBillTitle">ใบเสร็จรับเงิน/ใบส่งของ</span>
          </div>
          <div class="d-flex align-items-center gap-2">
            <button class="btn btn-sm btn-outline-light" id="btnCaptureTax" onclick="captureTaxBill()"><i class="bx bx-camera me-1"></i>บันทึกรูป</button>
            <button class="btn btn-sm btn-outline-light" id="btnPrint"><i class="bx bx-printer me-1"></i>พิมพ์/PDF</button>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
          </div>
        </div>
      </div>
      <div class="modal-body p-2" id="detailModalBody">
        <div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-primary"></i></div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
  var allRows=[], tbl=null;

  function p(o,k,d){d=d===undefined?'':d;for(var i=0;i<k.length;i++){if(o&&o[k[i]]!=null)return o[k[i]];}return d;}
  function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
  function num(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt0(v){return Math.round(num(v)).toLocaleString('th-TH');}
  function fmt2(v){return num(v).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
  function fmtDate(v){if(!v||typeof v==='object')return'';var d=new Date(v);if(isNaN(d.getTime()))return String(v);var day=String(d.getDate()).padStart(2,'0');var month=String(d.getMonth()+1).padStart(2,'0');var year=d.getFullYear();return day+'/'+month+'/'+year;}
  function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
  function findPV(r){
    var keys=['PV','pv','Pv','pV'];
    for(var i=0;i<keys.length;i++){if(r[keys[i]]!=null)return num(r[keys[i]]);}
    for(var k in r){if(k.toLowerCase()==='pv')return num(r[k]);}
    return 0;
  }
  function slipHtml(v){if(!v||String(v).trim()==='')return'';var s=String(v).trim();return'<img class="slip-thumb" src="'+esc(s)+'" onerror="this.style.display=\'none\'" onclick="showImg(\''+esc(s)+'\')">';}

  window.showImg=function(src){$('#imgModalSrc').attr('src',src);new bootstrap.Modal(document.getElementById('imgModal')).show();};

  window.showDetail=function(idx){
    var r = allRows[idx]; if(!r) return;
    var billNo = p(r,['BillNo','billNo']);
    if(!billNo) return;
    
    $('#modalBillTitle').text('กำลังโหลดข้อมูล...');
    $('#detailModalBody').html('<div class="text-center py-5"><i class="bx bx-loader bx-spin fs-2 text-primary"></i></div>');
    new bootstrap.Modal(document.getElementById('detailModal')).show();
    
    $.get('@Url.Action("GetInvoiceDetail","reports")',{billNo:billNo},function(response){
      if(!response || !response.success){
        alert('ไม่พบข้อมูลใบเสร็จ');
        return;
      }
      
      var header = response.header;
      var billRows = response.details || [];
      
      var billMemberType = p(header,['Billmembertype','billmembertype','BillMemberType','billMemberType'],'');
      var billTypeLabel = 'ใบเสร็จรับเงิน/ใบส่งของ';
      var headerBgColor = '#7e57c2';
      var headerTextColor = '#1565c0';
      
      if(billMemberType === 'ใบเสร็จแจงยอด') {
        billTypeLabel = 'ใบเสร็จแจงยอด';
        headerBgColor = '#ff9800';
        headerTextColor = '#1565c0';
      } else {
        billTypeLabel = 'ใบเสร็จรับเงิน/ใบส่งของ';
        headerBgColor = '#4caf50';
        headerTextColor = '#1565c0';
      }
      
      $('#modalBillTitle').text(billTypeLabel);
      $('#modalHeaderBand').css({
        'background': headerBgColor,
        'color': headerTextColor
      });

      var totalAmount = num(p(header,['TotalAmount','totalAmount'],0));
      var totalPV = num(p(header,['TotalPV','totalPV'],0));

    var billHtml = '<div id="billDoc" class="doc-wrap">';
    
    billHtml += '<table style="width:100%;border-collapse:collapse;margin-bottom:6px;"><tr>';
    billHtml += '<td style="vertical-align:top;padding-right:12px;">';
    billHtml += '<div class="d-flex align-items-center gap-2 mb-1">';
    billHtml += '<img src="/assets/images/logo_sm2.png" alt="Logo" style="height:50px;width:auto;" onerror="this.style.display=\'none\'">';
    billHtml += '<div style="font-size:15pt;font-weight:700;color:#1a237e;line-height:1.2;">'+esc(p(header,['Companyname','companyname']))+' (สำนักงานใหญ่)</div>';
    billHtml += '</div>';
    billHtml += '<div style="font-size:12pt;">'+esc(p(header,['Companyaddress','companyaddress']))+'</div>';
    billHtml += '<div style="font-size:12pt;">โทร: '+esc(p(header,['Companytelephone','companytelephone']))+'</div>';
    billHtml += '</td>';
    billHtml += '<td style="vertical-align:top;text-align:right;white-space:nowrap;">';
    billHtml += '<table style="margin-left:auto;border-collapse:collapse;font-size:12pt;">';
    billHtml += '<tr><td style="text-align:right;padding:3px 8px;color:#555;border-bottom:1px solid #eee;white-space:nowrap;">เลขที่</td><td style="padding:3px 10px;font-weight:700;color:#1a237e;border-bottom:1px solid #eee;white-space:nowrap;">'+esc(billNo)+'</td></tr>';
    billHtml += '<tr><td style="text-align:right;padding:3px 8px;color:#555;border-bottom:1px solid #eee;white-space:nowrap;">วันที่</td><td style="padding:3px 10px;border-bottom:1px solid #eee;white-space:nowrap;">'+fmtDate(p(header,['BillDate','billDate']))+'</td></tr>';
    billHtml += '<tr><td style="text-align:right;padding:3px 8px;color:#555;white-space:nowrap;">อ้างอิง</td><td style="padding:3px 10px;white-space:nowrap;">'+esc(p(header,['ReferenceNo','referenceNo']))+'</td></tr>';
    billHtml += '</table></td>';
    billHtml += '</tr></table>';
    billHtml += '<hr style="margin:4px 0;border:0;border-top:1px solid #bbb;">';

    billHtml += '<table style="width:100%;border-collapse:collapse;margin-bottom:6px;"><tr>';
    billHtml += '<td style="vertical-align:top;width:52%;padding-right:12px;border-right:1px solid #ddd;">';
    billHtml += '<div style="margin-bottom:3px;font-size:13pt;"><span style="color:#555;">ผู้ซื้อ :</span> <b>'+esc(p(header,['CustomerName','customerName']))+'</b></div>';
    billHtml += '<div style="margin-bottom:3px;font-size:13pt;"><span style="color:#555;">รหัสสมาชิก :</span> '+esc(p(header,['Membercode','memberCode']))+'</div>';
    billHtml += '<div style="margin-bottom:3px;font-size:13pt;"><span style="color:#555;">โทร :</span> '+esc(p(header,['CustomerTelephone','customerTelephone']))+'</div>';
    billHtml += '</td>';
    billHtml += '<td style="vertical-align:top;padding-left:12px;">';
    billHtml += '<div style="margin-bottom:3px;font-size:12pt;"><span style="color:#555;">ที่อยู่จัดส่ง :</span> '+esc(p(header,['DeliveryAddress','deliveryAddress']))+'</div>';
    billHtml += '<div style="margin-bottom:3px;font-size:12pt;"><span style="color:#555;">ประเภทชำระ :</span> <span style="border:1px solid #888;padding:0 6px;display:inline-block;">'+esc(p(header,['PaymentType','paymentType']))+'</span></div>';
    billHtml += '<div style="margin-bottom:3px;font-size:12pt;"><span style="color:#555;">ประเภทการสั่ง :</span> '+esc(p(header,['Billtype','billType','billtype']))+'</div>';
    billHtml += '</td></tr></table>';

    billHtml += '<table class="product-table" style="width:100%;border-collapse:collapse;font-size:13pt;border:1px solid #aaa;">';
    billHtml += '<thead><tr style="background:#e8e8e8;">';
    var ths=[['ลำดับ','32px','center'],['รหัสสินค้า','90px','left'],['ชื่อสินค้า','','left'],['จำนวน','60px','center'],['หน่วย','60px','center'],['ราคา/หน่วย','95px','right'],['รวม','95px','right'],['PV','75px','right']];
    ths.forEach(function(h){billHtml+='<th style="border:1px solid #aaa;padding:3px 5px;text-align:'+h[2]+';'+(h[1]?'width:'+h[1]+';':'')+'">'+h[0]+'</th>';});
    billHtml += '</tr></thead><tbody>';
    
    if(billRows.length > 0){
      billRows.forEach(function(item,i){
        var qty = num(p(item,['Quantity','quantity','Unit','unit'],1));
        var unitPrice = num(p(item,['PriceperUnit','priceperUnit','UnitPrice','unitPrice','unitprice'],0));
        var amount = num(p(item,['TotalAmount','totalAmount','TotalPrice','totalPrice','Amount','amount'],qty*unitPrice));
        var pv = num(p(item,['PV','pv','TotalPV','totalPV'],0));
        billHtml += '<tr>';
        billHtml += '<td style="text-align:center;border:1px solid #ccc;padding:3px 4px;">'+(i+1)+'</td>';
        billHtml += '<td style="border:1px solid #ccc;padding:3px 5px;">'+esc(p(item,['ProductCode','productCode','ProductID','productID','productId']))+'</td>';
        billHtml += '<td style="border:1px solid #ccc;padding:3px 5px;">'+esc(p(item,['ProductName','productName']))+'</td>';
        billHtml += '<td style="text-align:center;border:1px solid #ccc;padding:3px 4px;">'+esc(String(qty))+'</td>';
        billHtml += '<td style="text-align:center;border:1px solid #ccc;padding:3px 4px;">'+esc(p(item,['Unitname','unitName','UnitName']))+'</td>';
        billHtml += '<td style="text-align:right;border:1px solid #ccc;padding:3px 5px;">'+fmt2(unitPrice)+'</td>';
        billHtml += '<td style="text-align:right;border:1px solid #ccc;padding:3px 5px;font-weight:600;color:#c00;">'+fmt2(amount)+'</td>';
        billHtml += '<td style="text-align:right;border:1px solid #ccc;padding:3px 5px;">'+fmt0(pv)+'</td>';
        billHtml += '</tr>';
      });
    }
    
    billHtml += '</tbody></table>';

    billHtml += '<table style="width:100%;border-collapse:collapse;margin-top:6px;font-size:13pt;"><tr>';
    billHtml += '<td style="vertical-align:top;width:55%;padding-right:10px;border-right:1px solid #ddd;">';
    billHtml += '<div><span style="color:#555;">รูปแบบ :</span> '+esc(p(header,['Sendbill','sendbill']))+'</div>';

    var tracking = p(header,['TrackingURL','trackingURL']) || '';
    billHtml += '<div style="margin-top:3px;"><span style="color:#555;">Tracking number :</span> <span style="border-bottom:1px solid #aaa;display:inline-block;min-width:180px;padding-bottom:1px;">'+(tracking?'<a href="'+esc(tracking)+'" target="_blank" style="color:#1565c0;">'+esc(tracking)+'</a>':'-')+'</span></div>';

    billHtml += '<div style="margin-top:3px;"><span style="color:#555;">หมายเหตุ :</span> '+esc(p(header,['Receive','receive']))+' &nbsp;&nbsp; <span style="color:#555;">วันที่รับ :</span> '+fmtDate(p(header,['Receivedate','receiveDate']))+'</div>';
    billHtml += '<div style="margin-top:3px;"><span style="color:#555;">ผู้ทำรายการ :</span> '+esc(p(header,['Createby','createby']))+'</div>';
    billHtml += '<div style="margin-top:3px;"><span style="color:#555;">สถานะ :</span> '+esc(p(header,['BillConfirmType','billConfirmType']))+'</div>';
    billHtml += '</td>';
    billHtml += '<td style="vertical-align:top;padding-left:10px;">';
    billHtml += '<table style="width:100%;border-collapse:collapse;font-size:13pt;">';
    billHtml += '<tr><td style="padding:4px 8px;">ค่าส่ง</td><td style="text-align:right;padding:4px 8px;">'+fmt2(p(header,['ShippingFee','shippingFee'],0))+'</td></tr>';
    billHtml += '<tr style="background:#e0f7f4;"><td style="padding:5px 8px;font-weight:700;">ยอดรวมทั้งสิ้น</td><td style="text-align:right;padding:5px 10px;font-weight:700;color:#00796b;font-size:15pt;">'+fmt2(totalAmount)+'</td></tr>';
    billHtml += '<tr style="background:#e0f7f4;margin-top:2px;"><td style="padding:5px 8px;font-weight:700;">PV</td><td style="text-align:right;padding:5px 10px;font-weight:700;color:#00796b;font-size:15pt;">'+fmt0(totalPV)+'</td></tr>';
    billHtml += '</table></td>';
    billHtml += '</tr></table>';
    
    billHtml += '</div>';

    var slips = '';
    for(var i=1;i<=5;i++){
      var sv = p(header,['Slip'+i,'slip'+i],'');
      if(sv) slips += slipHtml(sv)+' ';
    }
    if(slips) billHtml += '<div class="mt-3"><div class="fw-semibold">สลิป</div>'+slips+'</div>';
    billHtml += '</div>';

    $('#detailModalBody').html(billHtml);
    });
  };

  function filterRows(rows){
    var f=$('#fromDate').val(),t=$('#toDate').val(),ct=$('input[name="checktype"]:checked').val()||'all';
    // Filter by remain = 0 if checktype is "remain"
    if(ct==='remain'){
      rows=rows.filter(function(r){
        var remain=num(p(r,['Remain','remain'],0));
        return remain>0;
      });
    }
    if(!f&&!t)return rows;
    var from=f?new Date(f):null,to=t?new Date(t+'T23:59:59'):null;
    return rows.filter(function(r){
      var d=new Date(p(r,['BillDate','billDate']));
      if(isNaN(d.getTime()))return true;
      if(from&&d<from)return false;
      if(to&&d>to)return false;
      return true;
    });
  }

  function buildTable(rows){
    if(tbl){tbl.destroy();tbl=null;}$('#mainTable').empty();
    var cols=['#','เลขที่ใบเสร็จ','วันที่','เลขที่อ้างอิง','รหัส Hybrid Gold','เลขที่บิล HOLD',
      'รหัสสินค้า','ชื่อสินค้า','รหัสสินค้าชุด','ประเภทซื้อ','จำนวน','ราคา/หน่วย',
      'ยอดเงิน','PV','สถานะบิล','สถานะการรับ','วันที่รับ/ส่ง',
      'วันหมดอายุบิล','ยอดแจง','คงเหลือ',
      'ผู้ทำรายการ','การจ่ายเงิน','Tracking','ที่อยู่จัดส่ง','รายละเอียด',
      'Slip 1','Slip 2','Slip 3','Slip 4','Slip 5'];
    var thead='<thead class="text-center" style="background:linear-gradient(135deg,#ede7f6,#d1c4e9);font-size:.73rem;"><tr>'+cols.map(function(c){return'<th>'+c+'</th>';}).join('')+'</tr></thead>';
    var tbody='<tbody>';
    rows.forEach(function(r,i){
      var tracking=p(r,['TrackingURL','trackingURL','trackingUrl'],'');
      var trackHtml=tracking?'<a href="'+esc(tracking)+'" target="_blank" class="btn btn-outline-secondary btn-sm py-0"><i class="bx bx-link-external"></i></a>':'';
      tbody+='<tr>'+
        '<td class="text-center">'+(i+1)+'</td>'+
        '<td>'+esc(p(r,['BillNo','billNo']))+'</td>'+
        '<td class="text-center">'+fmtDate(p(r,['BillDate','billDate']))+'</td>'+
        '<td>'+esc(p(r,['ReferenceNo','referenceNo']))+'</td>'+
        '<td>'+esc(p(r,['HybridGOLDID','hybridGoldId','hybridGOLDID']))+'</td>'+
        '<td>'+esc(p(r,['HOLDORDERID','holdOrderId','holdOrderID']))+'</td>'+
        '<td>'+esc(p(r,['ProductID','productID','productId']))+'</td>'+
        '<td>'+esc(p(r,['ProductName','productName']))+'</td>'+
        '<td>'+esc(p(r,['ProductSet','productSet']))+'</td>'+
        '<td>'+esc(p(r,['Billtype','billType','billtype']))+'</td>'+
        '<td class="text-end">'+fmt0(p(r,['Unit','unit'],0))+'</td>'+
        '<td class="text-end">'+fmt2(p(r,['UnitPrice','unitPrice','unitprice','Unitprice'],0))+'</td>'+
        '<td class="text-end fw-bold text-success">'+fmt2(p(r,['TotalPrice','totalPrice','totalprice','Totalprice','TotalAmount','totalAmount','Amount','amount'],0))+'</td>'+
        '<td class="text-end text-info fw-semibold">'+fmt0(findPV(r))+'</td>'+
        '<td class="text-center">'+esc(p(r,['BillConfirmType','billConfirmType']))+'</td>'+
        '<td class="text-center">'+esc(p(r,['Receive','receive']))+'</td>'+
        '<td class="text-center">'+fmtDate(p(r,['ReceiveDate','receiveDate']))+'</td>'+
        '<td class="text-center text-danger fw-semibold">'+fmtDate(p(r,['ExpireDate','expireDate']))+'</td>'+
        '<td class="text-end">'+fmt0(p(r,['PVSaleout','pvSaleout','pVSaleout'],0))+'</td>'+
        '<td class="text-end fw-bold" style="color:#5e35b1;">'+fmt0(p(r,['Remain','remain'],0))+'</td>'+
        '<td>'+esc(p(r,['Createby','createBy','createby']))+'</td>'+
        '<td>'+esc(p(r,['PaymentType','paymentType']))+'</td>'+
        '<td class="text-center">'+trackHtml+'</td>'+
        '<td style="max-width:150px;overflow:hidden;text-overflow:ellipsis;">'+esc(p(r,['DeliveryAddress','deliveryAddress']))+'</td>'+
        '<td class="text-center"><button class="btn btn-sm py-0 px-2" style="border:1px solid #7e57c2;color:#7e57c2;" onclick="showDetail('+i+')"><i class="bx bx-file me-1"></i>ดูรายละเอียด</button></td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip1','slip1']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip2','slip2']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip3','slip3']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip4','slip4']))+'</td>'+
        '<td class="text-center">'+slipHtml(p(r,['Slip5','slip5']))+'</td>'+
        '</tr>';
    });
    tbody+='</tbody>';
    $('#mainTable').html(thead+tbody);
    tbl=$('#mainTable').DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],ordering:true,searching:true,responsive:false,
      language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
    var totalAmt=rows.reduce(function(s,r){return s+num(p(r,['TotalPrice','totalPrice','totalprice','Totalprice','TotalAmount','totalAmount','Amount','amount'],0));},0);
    var totalPV=rows.reduce(function(s,r){return s+findPV(r);},0);
    $('#sumAmount').text(fmt2(totalAmt));$('#sumPV').text(fmt0(totalPV));$('#rowCount').text(rows.length);
    $('#msg').removeClass('alert-secondary alert-danger').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
  }

  function loadData(){
    $('#msg').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();
    var f=$('#fromDate').val(),t=$('#toDate').val(),ct=$('input[name="checktype"]:checked').val()||'all';
    $.get('@Url.Action("GetBuyHoldData","reports")',{fromDate:f,toDate:t,checktype:ct},function(json){
      allRows=norm(json); buildTable(filterRows(allRows));
    }).fail(function(){$('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');});
  }

  $('#btnSearch').on('click',loadData);
  $('#btnReset').on('click',function(){$('#fromDate').val('');$('#toDate').val('');$('#ctAll').prop('checked',true);loadData();});
  $('input[name="checktype"]').on('change',function(){buildTable(filterRows(allRows));});
  loadData();

  // Print function
  window.printDoc = function(elementId){
    var el = document.getElementById(elementId);
    if(!el){alert('ไม่พบเอกสาร');return;}
    
    var win = window.open('','_blank','width=950,height=750');
    if(!win){alert('กรุณาอนุญาตให้เปิด Popup จาก Browser เพื่อพิมพ์/บันทึก PDF');return;}
    
    win.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>เอกสาร</title>');
    win.document.write('<style>');
    win.document.write('body{font-family:"Cordia New","CordiaUPC","TH Sarabun New","Sarabun",Arial,sans-serif;font-size:14pt;margin:0;padding:10px;}');
    win.document.write('table{border-collapse:collapse;width:100%;}td,th{border:none;padding:2px 5px;vertical-align:top;}');
    win.document.write('.product-table,.product-table td,.product-table th,.product-table thead tr,.product-table tbody tr{border:1px solid #888 !important;}');
    win.document.write('@@page{margin:10mm;size:A4;}');
    win.document.write('<\/style><\/head><body>');
    win.document.write(el.outerHTML);
    win.document.write('<\/body><\/html>');
    win.document.close();
    
    setTimeout(function(){win.focus();win.print();},500);
  };

  $('#btnPrint').on('click',function(){
    printDoc('billDoc');
  });

  // Capture image function
  window.captureTaxBill = function(){
    var el = document.getElementById('billDoc');
    if(!el){alert('ไม่พบเอกสาร');return;}
    
    if(typeof html2canvas !== 'undefined'){
      html2canvas(el).then(function(canvas){
        var link = document.createElement('a');
        link.download = 'receipt_' + $('#modalBillTitle').text() + '_' + new Date().getTime() + '.png';
        link.href = canvas.toDataURL('image/png');
        link.click();
      });
    } else {
      var win = window.open('','_blank','width=950,height=750');
      if(!win) return;
      win.document.write('<!DOCTYPE html><html><head><meta charset="utf-8"><title>บันทึกรูป</title></head><body>');
      win.document.write(el.outerHTML);
      win.document.write('<script>setTimeout(function(){alert("กรุณาใช้เครื่องมือจับภาพหน้าจอของ Browser หรือติดตั้ง extension html2canvas")},500);<\/script>');
      win.document.write('<\/body><\/html>');
      win.document.close();
    }
  };
});
</script>
@section scripts {
    <script src="~/assets/js/app.js"></script>
