@{
    ViewData["Title"] = "รายงานโบนัสรอบการจ่าย";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#006064,#00acc1);">
        <i class="bx bx-wallet-alt fs-4 text-white"></i>
        <h5 class="mb-0 text-white fw-semibold">รายงานโบนัสรอบการจ่าย</h5>
      </div>
      <div class="card-body py-3">
        <div class="row g-3 mb-3">
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e0f7fa;border:2px solid #00acc1 !important;">
              <div class="text-muted small">โบนัสรวม (ก่อนหัก)</div>
              <div class="fs-4 fw-bold" style="color:#006064;" id="sumTotalBonus">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#e8f5e9;border:2px solid #43a047 !important;">
              <div class="text-muted small">โบนัสสุทธิ (NetBonus)</div>
              <div class="fs-4 fw-bold" style="color:#1b5e20;" id="sumNetBonus">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
          <div class="col-sm-6 col-md-3">
            <div class="card border-0 text-center py-2 px-3" style="background:#fff3e0;border:2px solid #ffa726 !important;">
              <div class="text-muted small">ค่าธรรมเนียมรวม</div>
              <div class="fs-4 fw-bold" style="color:#e65100;" id="sumService">-</div>
              <div class="text-muted" style="font-size:.7rem;">บาท</div>
            </div>
          </div>
        </div>
        <div class="row align-items-end g-2">
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">จากวันที่</label>
            <input type="date" class="form-control form-control-sm" id="fromDate">
          </div>
          <div class="col-auto">
            <label class="form-label mb-1 small fw-semibold">ถึงวันที่</label>
            <input type="date" class="form-control form-control-sm" id="toDate">
          </div>
          <div class="col-auto align-self-end">
            <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
            <button class="btn btn-sm" id="btnSearch" style="background:#00acc1;border-color:#00acc1;color:#fff;"><i class="bx bx-search me-1"></i>ค้นหา</button>
          </div>
        </div>
        <small class="text-muted mt-1 d-block"><i class="bx bx-info-circle me-1"></i>ถ้าไม่ระบุวันที่ จะแสดงข้อมูลทั้งหมด</small>
      </div>
    </div>
  </div>
</div>

<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header" style="background:#e0f7fa;border-bottom:2px solid #00acc1;">
        <h5 class="mb-0 fw-semibold" style="color:#006064;"><i class="bx bx-table me-2"></i>รายการโบนัสรอบการจ่าย &nbsp;<span class="badge" style="background:#00acc1;" id="rowCount">0</span></h5>
      </div>
      <div class="card-body">
        <div class="alert alert-secondary py-2 mb-2" id="msg">กำลังโหลดข้อมูล...</div>
        <div class="table-responsive">
          <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.76rem;white-space:nowrap;"></table>
        </div>
        <div id="periodSummary" class="mt-3 pt-3 border-top" style="display:none;">
          <h6 class="fw-bold mb-2"><i class="bx bx-receipt me-1"></i>สรุปยอดหักค่าใช้จ่าย</h6>
          <table class="table table-bordered table-sm" style="max-width:480px;">
            <tbody>
              <tr><td class="text-muted">ค่าธรรมเนียมดำเนินการ</td><td class="text-end fw-semibold" id="psService">-</td></tr>
              <tr><td class="text-muted">ยอดหลังหักค่าดำเนินการ</td><td class="text-end fw-semibold" id="psAfterFee">-</td></tr>
              <tr><td class="text-muted">ภาษี</td><td class="text-end fw-semibold" id="psTax">-</td></tr>
              <tr><td class="text-muted">โบนัสรวมภาษี</td><td class="text-end fw-semibold" id="psTaxBonus">-</td></tr>
              <tr><td class="text-muted">ภาษีหัก ณ ที่จ่าย</td><td class="text-end fw-semibold" id="psWithHold">-</td></tr>
              <tr class="table-success fw-bold"><td>โบนัสสุทธิ (NetBonus)</td><td class="text-end text-success" id="psNet">-</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
$(function(){
  var tbl=null;
  function norm(raw){var d=raw;if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}if(d&&Array.isArray(d.data))return d.data;if(d&&Array.isArray(d.result))return d.result;return Array.isArray(d)?d:[];}
  function pick(o,k,d){if(d===undefined)d='';for(var i=0;i<k.length;i++){if(o!=null&&o[k[i]]!==undefined&&o[k[i]]!==null)return o[k[i]];}return d;}
  function num(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt2(v){return num(v).toLocaleString('th-TH',{minimumFractionDigits:2,maximumFractionDigits:2});}
  function fmtDate(v){if(!v)return'-';var d=new Date(v);return isNaN(d.getTime())?String(v):d.toLocaleDateString('th-TH');}

  function filterRows(rows){
    var f=$('#fromDate').val(),t=$('#toDate').val();
    if(!f&&!t)return rows;
    var from=f?new Date(f):null,to=t?new Date(t+'T23:59:59'):null;
    return rows.filter(function(r){
      var d=new Date(pick(r,['FromDate','fromDate']));if(isNaN(d.getTime()))return true;
      if(from&&d<from)return false;if(to&&d>to)return false;return true;
    });
  }

  function buildTable(rows){
    if(tbl){tbl.destroy();tbl=null;}$('#mainTable').empty();
    var cols=['#','จากวันที่','ถึงวันที่','วันที่จ่าย','ค่าแนะนำ','ส่วนตัว','TMB/จับคู่','แมทชิ่ง','แจงยอด','พิเศษ','รวม','ค่าดำเนินการ','หลังหักค่าดำเนินการ','ภาษี','รวมภาษี','หัก ณ ที่จ่าย','สุทธิ (Net)'];
    var thead='<thead class="text-center" style="background:linear-gradient(135deg,#e0f7fa,#b2ebf2);font-size:.72rem;"><tr>'+cols.map(function(c){return'<th>'+c+'</th>';}).join('')+'</tr></thead>';
    var tbody='<tbody>';
    rows.forEach(function(r,i){
      var net=num(pick(r,['NetBonus','netBonus'],0));
      tbody+='<tr>'+
        '<td class="text-center">'+(i+1)+'</td>'+
        '<td class="text-center">'+fmtDate(pick(r,['FromDate','fromDate']))+'</td>'+
        '<td class="text-center">'+fmtDate(pick(r,['ToDate','toDate']))+'</td>'+
        '<td class="text-center">'+fmtDate(pick(r,['PaymentDate','paymentDate']))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['SponserBonus','sponserBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['RebateBonus','rebateBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['WeakBonus','weakBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['MatchingBonus','matchingBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['MobileBonus','mobileBonus'],0))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['SpecialBonus','specialBonus'],0))+'</td>'+
        '<td class="text-end fw-bold">'+fmt2(pick(r,['TotalBonus','totalBonus'],0))+'</td>'+
        '<td class="text-end text-danger">'+fmt2(pick(r,['ServicePrice','servicePrice'],0))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['TotalBonusAfterExpense','totalBonusAfterExpense'],0))+'</td>'+
        '<td class="text-end text-warning">'+fmt2(pick(r,['Tax','tax'],0))+'</td>'+
        '<td class="text-end">'+fmt2(pick(r,['TotalBonusIncudeTax','totalBonusIncudeTax'],0))+'</td>'+
        '<td class="text-end text-warning">'+fmt2(pick(r,['WithHoldingTax','withHoldingTax'],0))+'</td>'+
        '<td class="text-end fw-bold '+(net>=0?'text-success':'text-danger')+'">'+fmt2(net)+'</td>'+
        '</tr>';
    });
    tbody+='</tbody>';
    $('#mainTable').html(thead+tbody);
    tbl=$('#mainTable').DataTable({paging:true,pageLength:25,lengthMenu:[[10,25,50,-1],[10,25,50,'ทั้งหมด']],ordering:true,searching:true,
      language:{emptyTable:'ไม่พบข้อมูล',zeroRecords:'ไม่พบข้อมูล',search:'ค้นหา:',lengthMenu:'แสดง _MENU_ รายการ',info:'_START_-_END_ จาก _TOTAL_',paginate:{first:'«',last:'»',next:'›',previous:'‹'}}});
    var sTot=rows.reduce(function(s,r){return s+num(pick(r,['TotalBonus','totalBonus'],0));},0);
    var sNet=rows.reduce(function(s,r){return s+num(pick(r,['NetBonus','netBonus'],0));},0);
    var sSvc=rows.reduce(function(s,r){return s+num(pick(r,['ServicePrice','servicePrice'],0));},0);
    $('#sumTotalBonus').text(fmt2(sTot));$('#sumNetBonus').text(fmt2(sNet));$('#sumService').text(fmt2(sSvc));$('#rowCount').text(rows.length);
    var sAfter=rows.reduce(function(s,r){return s+num(pick(r,['TotalBonusAfterExpense','totalBonusAfterExpense'],0));},0);
    var sTax=rows.reduce(function(s,r){return s+num(pick(r,['Tax','tax'],0));},0);
    var sTaxB=rows.reduce(function(s,r){return s+num(pick(r,['TotalBonusIncudeTax','totalBonusIncudeTax'],0));},0);
    var sWH=rows.reduce(function(s,r){return s+num(pick(r,['WithHoldingTax','withHoldingTax'],0));},0);
    $('#psService').text(fmt2(sSvc)+' บาท');$('#psAfterFee').text(fmt2(sAfter)+' บาท');$('#psTax').text(fmt2(sTax)+' บาท');
    $('#psTaxBonus').text(fmt2(sTaxB)+' บาท');$('#psWithHold').text(fmt2(sWH)+' บาท');$('#psNet').text(fmt2(sNet)+' บาท');
    if(rows.length>0)$('#periodSummary').show();else$('#periodSummary').hide();
    $('#msg').removeClass('alert-secondary alert-danger').addClass('alert-success').text('พบข้อมูล '+rows.length+' รายการ');
  }

  function loadData(){
    $('#msg').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();
    var f=$('#fromDate').val(),t=$('#toDate').val();
    $.get('@Url.Action("GetTravelPointsData","reports")',{fromDate:f,toDate:t},function(json){
      buildTable(filterRows(norm(json)));
    }).fail(function(){$('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');});
  }

  $('#btnSearch').on('click',loadData);
  $('#btnReset').on('click',function(){$('#fromDate').val('');$('#toDate').val('');loadData();});
  loadData();
});
</script>
@section scripts{
    <script src="~/assets/js/app.js"></script>
}