@{
    ViewData["Title"] = "รายงานคะแนนท่องเที่ยว";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Main Data Table -->
<div class="row">
  <div class="col-12">
    <div class="card shadow-sm border-0">
      <div class="card-header d-flex align-items-center" style="background:#e1f5fe;border-bottom:2px solid #039be5;">
        <h5 class="mb-0 fw-semibold" style="color:#01579b;font-size:.9rem;">
          <i class="bx bx-table me-2"></i>ตารางคะแนนท่องเที่ยวรายเดือน
          <span class="badge ms-1" style="background:#039be5;" id="rowCount">0</span>
        </h5>
        <span class="ms-auto text-muted" style="font-size:.73rem;" id="msgStatus"></span>
      </div>
      <div class="card-body p-2">
        <div class="table-responsive" style="max-height:72vh;overflow-y:auto;">
          <table class="table table-bordered table-sm table-hover align-middle mb-0" style="font-size:.72rem;white-space:nowrap;min-width:1600px;">
            <thead class="text-center" style="position:sticky;top:0;z-index:2;">
              <tr style="font-size:.68rem;">
                <th rowspan="2" style="vertical-align:middle;background:#b3e5fc;color:#01579b;min-width:80px;">เดือน</th>
                <th rowspan="2" style="vertical-align:middle;background:#b3e5fc;color:#01579b;min-width:120px;">ชื่อโปร</th>
                <th rowspan="2" style="vertical-align:middle;background:#b3e5fc;color:#01579b;min-width:90px;">วันที่เริ่ม</th>
                <th rowspan="2" style="vertical-align:middle;background:#b3e5fc;color:#01579b;min-width:90px;">วันที่สิ้นสุด</th>
                <th colspan="2" style="background:#c8e6c9;color:#2e7d32;">คะแนนมาใหม่</th>
                <th colspan="2" style="background:#ffe0b2;color:#bf360c;">คะแนนทีมงานแนะนำตรง</th>
                <th rowspan="2" style="vertical-align:middle;background:#f8bbd0;color:#880e4f;min-width:80px;">คะแนนบาลานซ์</th>
                <th colspan="2" style="background:#e1bee7;color:#4a148c;">Active</th>
                <th rowspan="2" style="vertical-align:middle;background:#b2dfdb;color:#004d40;min-width:90px;">ตำแหน่งคุณวุฒิ<br>ที่ Qualify</th>
                <th rowspan="2" style="vertical-align:middle;background:#fff9c4;color:#f57f17;min-width:80px;">คะแนนทีมงาน<br>แนะนำตรง</th>
                <th rowspan="2" style="vertical-align:middle;background:#dcedc8;color:#33691e;min-width:80px;">การรักษายอด</th>
              </tr>
              <tr style="font-size:.67rem;">
                <th style="background:#e8f5e9;color:#388e3c;">ซ้าย</th>
                <th style="background:#e8f5e9;color:#1b5e20;">ขวา</th>
                <th style="background:#fff3e0;color:#e65100;">ซ้าย</th>
                <th style="background:#fff3e0;color:#bf360c;">ขวา</th>
                <th style="background:#f3e5f5;color:#7b1fa2;">ซ้าย</th>
                <th style="background:#f3e5f5;color:#4a148c;">ขวา</th>
              </tr>
            </thead>
            <tbody id="tableBody">
              <tr><td colspan="15" class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm me-2"></span>กำลังโหลดข้อมูล...</td></tr>
            </tbody>
            <tfoot id="tableFoot" class="fw-bold" style="position:sticky;bottom:0;z-index:2;display:none;">
              <tr style="background:#fff3e0;font-size:.72rem;">
                <td class="text-center" style="background:#fff8e1;color:#e65100;">รวม</td>
                <td style="background:#fff8e1;color:#e65100;" colspan="3"></td>
                <td class="text-end" style="background:#e8f5e9;color:#1b5e20;" id="sumNewLeft">0</td>
                <td class="text-end" style="background:#e8f5e9;color:#1b5e20;" id="sumNewRight">0</td>
                <td class="text-end" style="background:#fff3e0;color:#e65100;" id="sumDirectLeft">0</td>
                <td class="text-end" style="background:#fff3e0;color:#bf360c;" id="sumDirectRight">0</td>
                <td class="text-end" style="background:#fce4ec;color:#c2185b;" id="sumBalance">0</td>
                <td class="text-end" style="background:#fff8e1;color:#e65100;" colspan="2"></td>
                <td style="background:#b2dfdb;color:#004d40;"></td>
                <td class="text-end" style="background:#fff9c4;color:#f57f17;" id="sumTeamPV">0</td>
                <td class="text-end" style="background:#dcedc8;color:#33691e;" id="sumMaintain">0</td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  #tableBody tr:hover td { background-color:#e3f8ff !important; transition:background-color .2s ease; }
  .rank-badge { display:inline-block;padding:.15em .4em;border-radius:.25rem;font-size:.68rem;font-weight:600;color:#fff; }
</style>

<script>
$(function(){
  var travelData=[];

  function norm(raw){
    var d=raw;
    if(typeof d==='string'){try{d=JSON.parse(d);}catch(e){return[];}}
    if(d&&Array.isArray(d.data))return d.data;
    if(d&&Array.isArray(d.result))return d.result;
    return Array.isArray(d)?d:[];
  }
  function g(o,ks,def){
    if(def===undefined)def='';
    for(var i=0;i<ks.length;i++){if(o&&o[ks[i]]!==undefined&&o[ks[i]]!==null)return o[ks[i]];}
    return def;
  }
  function num(v){var n=parseFloat(v);return isNaN(n)?0:n;}
  function fmt0(v){return Math.round(num(v)).toLocaleString('th-TH');}
  function esc(s){return s==null?'':String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
  function parseD(v){if(!v)return null;var d=new Date(v);return isNaN(d.getTime())?null:d;}
  function mKey(v){var d=parseD(v);if(!d)return null;return d.getFullYear()+'-'+(String(d.getMonth()+1).padStart(2,'0'));}
  var MONTH_TH=['ม.ค.','ก.พ.','มี.ค.','เม.ย.','พ.ค.','มิ.ย.','ก.ค.','ส.ค.','ก.ย.','ต.ค.','พ.ย.','ธ.ค.'];
  function fmtMon(v){var d=parseD(v);if(!d)return String(v||'-');return MONTH_TH[d.getMonth()]+' '+(d.getFullYear()+543);}
  function fmtDate(v){var d=parseD(v);if(!d)return String(v||'-');return d.getDate()+' '+MONTH_TH[d.getMonth()]+' '+(d.getFullYear()+543);}

  function rankColor(pos){
    if(!pos||pos==='-'||pos==='0'||pos==='-1') return '#9e9e9e';
    pos=String(pos).toLowerCase();
    if(pos.indexOf('crown')>=0)  return '#b71c1c';
    if(pos.indexOf('triple d')>=0) return '#880e4f';
    if(pos.indexOf('double d')>=0) return '#4a148c';
    if(pos.indexOf('executive')>=0) return '#1a237e';
    if(pos.indexOf('diamond')>=0) return '#1565c0';
    if(pos.indexOf('emerald')>=0) return '#1b5e20';
    if(pos.indexOf('sapphire')>=0) return '#006064';
    if(pos.indexOf('ruby')>=0)   return '#bf360c';
    if(pos.indexOf('pearl')>=0)  return '#37474f';
    if(pos.indexOf('platinum')>=0) return '#546e7a';
    if(pos.indexOf('triple g')>=0) return '#6a1b9a';
    if(pos.indexOf('double g')>=0) return '#0277bd';
    if(pos.indexOf('super')>=0)  return '#2e7d32';
    if(pos.indexOf('gold')>=0)   return '#f9a825';
    if(pos.indexOf('star')>=0)   return '#1976d2';
    return '#039be5';
  }

  function buildTable(){
    var rows = travelData;
    var html='';

    if(rows.length===0){
      html='<tr><td colspan="15" class="text-center text-muted py-4">ไม่พบข้อมูลในช่วงวันที่ที่เลือก</td></tr>';
      $('#tableFoot').hide();
    } else {
      // Accumulators for sums
      var sumNL=0, sumNR=0, sumDL=0, sumDR=0, sumBal=0, sumTPV=0, sumMP=0;

      rows.forEach(function(r,idx){
        var reportMonth = g(r,['ReportMonth','reportMonth'],'');
        var promoCode   = g(r,['PromoCode','promoCode'],'');
        var promoName   = g(r,['PromoName','promoName'],'');
        var promoStart  = g(r,['PromoStartDate','promoStartDate'],'');
        var promoEnd    = g(r,['PromoEndDate','promoEndDate'],'');

        var newLeft     = num(g(r,['NewPointLeft','newPointLeft'],0));
        var newRight    = num(g(r,['NewPointRight','newPointRight'],0));
        var directLeft  = num(g(r,['DirectLeft','directLeft'],0));
        var directRight = num(g(r,['DirectRight','directRight'],0));
        var balance     = num(g(r,['BalancePoint','balancePoint'],0));
        var activeLeft  = num(g(r,['ActiveLeft','activeLeft'],0));
        var activeRight = num(g(r,['ActiveRight','activeRight'],0));
        var qualifyPos  = g(r,['QualifyPosition','qualifyPosition'],'');
        var teamPV      = num(g(r,['TeamPV','teamPV'],0));
        var maintain    = num(g(r,['MaintainPoint','maintainPoint'],0));

        // Accumulate
        sumNL += newLeft; sumNR += newRight;
        sumDL += directLeft; sumDR += directRight;
        sumBal += balance;
        sumTPV += teamPV; sumMP += maintain;

        // Format date label
        var dateLabel = reportMonth || '-';

        // Rank badge
        var validRanking = qualifyPos && qualifyPos!=='' && qualifyPos!=='0' && qualifyPos!=='-1' && qualifyPos!=='-';
        var rankBadge = validRanking
          ? '<span class="rank-badge" style="background:'+rankColor(qualifyPos)+';">'+esc(qualifyPos)+'</span>'
          : '<span class="text-muted" style="font-size:.68rem;">-</span>';

        var maintHtml = maintain>0
          ? '<span class="badge" style="background:#43a047;font-size:.68rem;">'+fmt0(maintain)+'</span>'
          : '<span class="text-muted">-</span>';

        html+='<tr>'+
          '<td class="text-center fw-semibold" style="color:#01579b;">'+esc(dateLabel)+'</td>'+
          '<td>'+esc(promoName)+'</td>'+
          '<td class="text-center">'+fmtDate(promoStart)+'</td>'+
          '<td class="text-center">'+fmtDate(promoEnd)+'</td>'+
          '<td class="text-end" style="color:#388e3c;">'+fmt0(newLeft)+'</td>'+
          '<td class="text-end" style="color:#1b5e20;">'+fmt0(newRight)+'</td>'+
          '<td class="text-end" style="color:#e65100;">'+fmt0(directLeft)+'</td>'+
          '<td class="text-end" style="color:#bf360c;">'+fmt0(directRight)+'</td>'+
          '<td class="text-end" style="color:#c2185b;">'+fmt0(balance)+'</td>'+
          '<td class="text-end" style="color:#7b1fa2;">'+fmt0(activeLeft)+'</td>'+
          '<td class="text-end" style="color:#4a148c;">'+fmt0(activeRight)+'</td>'+
          '<td class="text-center">'+rankBadge+'</td>'+
          '<td class="text-end fw-semibold" style="color:#f57f17;">'+fmt0(teamPV)+'</td>'+
          '<td class="text-center">'+maintHtml+'</td>'+
          '</tr>';
      });

      // Update sum footer
      $('#sumNewLeft').text(fmt0(sumNL));
      $('#sumNewRight').text(fmt0(sumNR));
      $('#sumDirectLeft').text(fmt0(sumDL));
      $('#sumDirectRight').text(fmt0(sumDR));
      $('#sumBalance').text(fmt0(sumBal));
      $('#sumTeamPV').text(fmt0(sumTPV));
      $('#sumMaintain').text(fmt0(sumMP));
      $('#tableFoot').show();
    }

    $('#tableBody').html(html);
    $('#rowCount').text(rows.length);
  }

  $.get('@Url.Action("GetTravelPointsData","reports")', function(json){
    travelData=norm(json); buildTable();
  }).fail(function(){ travelData=[]; buildTable(); });
});
</script>
@section scripts{
    <script src="~/assets/js/app.js"></script>
}