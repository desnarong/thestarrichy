                });

                if (!birthDay || !birthMonth || !birthYear) {
                    toastr.error('กรุณาเลือกวันเกิดให้ครบถ้วน');
                    isValid = false;
                } else if (!validateBirthAge()) {
                    $('#birthYear').addClass('is-invalid');
                    isValid = false;
                }
                
                // ==========================================
                // 5. แสดงผลลัพธ์และส่งข้อมูล
                // ==========================================
                if (!validateIdCardName()) { isValid = false; }
                if (!validateBusinessName()) { isValid = false; }
                if (!validateEmail()) { isValid = false; }
                if (!validateMobile()) { isValid = false; }
                if (!validateLineId()) { isValid = false; }

                if (isValid) {
                    performValidationAndRegister(); // ย้ายการทำงานไปที่ฟังก์ชันนี้เพื่อความสะอาด
                } else {
                    const firstError = $('.is-invalid, .validation-error').first();
                    if (firstError.length > 0) {
                        $('html, body').animate({ scrollTop: firstError.closest('.form-group').offset().top - 100 }, 500);
                        firstError.focus();
                    }
                    toastr.error('กรุณากรอกข้อมูลที่จำเป็นให้ครบถ้วนและถูกต้อง');
                }
            });

            // 6. Reset Form
            $('#btnResetSimple').click(function () {
                const selectedRegDay = $('#regDay').val();
                const selectedRegMonth = $('#regMonth').val();
                const selectedRegYear = $('#regYear').val();

                $('#simpleRegistrationForm')[0].reset();
                $('#referrerName').val('');

                // คงค่าวันที่สมัครเดิมไว้แม้กดล้างข้อมูล
                $('#regDay').val(selectedRegDay);
                $('#regMonth').val(selectedRegMonth);
                $('#regYear').val(selectedRegYear);

                resetAddressDropdowns();
                $('.text-danger:not(.required .text-danger), .text-success, .validation-error').text('').css('color', ''); 
                $('input, select, textarea').removeClass('is-invalid');
                
                $('#idCardPreview, #bankCardPreview, #businessPhotoPreview').hide().attr('src', '');
                $('#idCardCopy, #bankCardCopy, #businessPhoto').val('');
                
                toastr.info('ล้างข้อมูลเรียบร้อยแล้ว');
                $('html, body').animate({ scrollTop: 0 }, 500);
            });

            // --- Helper Functions ---
            function collectFormData() {
                // Combine birth day, month, year into birthDate (format: dd-MM-yyyy for Thai/BE)
                var birthDay = $('#birthDay').val();
                var birthMonth = $('#birthMonth').val();
                var birthYearBE = $('#birthYear').val();
                
                // Format as dd-MM-yyyy (CE year — แปลงจาก พ.ศ. → ค.ศ. ก่อนส่ง API)
                var birthDate = '';
                if (birthDay && birthMonth && birthYearBE) {
                    var dayStr = String(birthDay).padStart(2, '0');
                    var monthStr = String(birthMonth).padStart(2, '0');
                    var birthYearCE = parseInt(birthYearBE) - 543; // พ.ศ. → ค.ศ.
                    birthDate = `${birthYearCE}-${monthStr}-${dayStr}`;
                }

                return {
                    country: $('#country').val(),
                    countryBusiness: $('#countryBusiness').val(),
                    referrerCode: $('#referrerCode').val(),
                    position: $('input[name="position"]:checked').val(),
                    birthDate: birthDate,
                    title: $('#title').val(),
                    idCardName: $('#idCardName').val(),
                    businessName: $('#businessName').val(),
                    documentNumber: ($('#documentNumber').val() || "").replace(/[- ]/g, ''),
                    mobile: $('#mobile').val(),
                    homePhone: $('#homePhone').val(),
                    email: $('#email').val(),
                    lineId: $('#lineId').val(),

                    addressIdCard: [$('#simpleHouseNumber').val(), $('#simpleMoo').val() ? 'หมู่ ' + $('#simpleMoo').val() : '', $('#simpleAlley').val() ? 'ซ.' + $('#simpleAlley').val() : '', $('#simpleRoad').val() ? 'ถ.' + $('#simpleRoad').val() : '', $('#simpleBuilding').val(), $('#simpleFloor').val() ? 'ชั้น ' + $('#simpleFloor').val() : ''].filter(Boolean).join(' '),
                    houseNumber: $('#simpleHouseNumber').val(),
                    moo: $('#simpleMoo').val(),
                    alley: $('#simpleAlley').val(),
                    road: $('#simpleRoad').val(),
                    building: $('#simpleBuilding').val(),
                    floor: $('#simpleFloor').val(),
                    postcode: $('#simplePostcode').val(),
                    provinceCode: $('#simpleProvince').val(),
                    districtCode: $('#simpleDistrict').val(),
                    subdistrictCode: $('#simpleSubdistrict').val(),
                    tambonId: parseInt($('#simpleTambonId').val()) || null,
                    ipAddress: clientIpAddress
                };
            }

            async function performValidationAndRegister() {
                try {
                    Swal.fire({ title: 'กำลังตรวจสอบข้อมูล...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                    const formData = collectFormData();

                    const checks = [
                        checkDuplicateIDCard(formData.documentNumber),
                        checkDuplicateTelephone(formData.mobile),
                        checkDuplicateEmail(formData.email),
                        checkDuplicateIDCardName(formData.idCardName),
                        checkDuplicateBusinessName(formData.businessName)
                    ];

                    const results = await Promise.all(checks);
                    const failed = results.find(r => r && r.success === false);
                    if (failed) {
                        Swal.fire('ไม่สามารถสมัครได้', failed.message || 'พบข้อมูลซ้ำในระบบ', 'error');
                        return;
                    }

                    await sendOTPAndShowInput(formData);

                } catch (error) {
                    console.error(error);
                    const errMsg = (error.responseJSON && error.responseJSON.message) || error.responseText || error.message || 'เกิดข้อผิดพลาดในการตรวจสอบข้อมูล';
                    Swal.fire('เกิดข้อผิดพลาด', errMsg, 'error');
                }
            }

            // --- OTP Logic ---
            let countdownInterval;
            window.currentFormData = null;
            window.currentReferenceId = null;

            async function sendOTPAndShowInput(formData) {
                try {
                    // ตรวจสอบ SendOTPRegister จาก /Static/system
                    // '0' = เปิดส่ง OTP, '1' = ปิด ข้ามไป register เลย
                    let skipOTP = false;
                    try {
                        const sysData = await $.get('/Static/system');
                        const sys = Array.isArray(sysData) ? sysData[0] : sysData;
                        if (sys && String(sys.SendOTPRegister) === '1') {
                            skipOTP = true;
                        }
                    } catch (sysErr) {
                        console.warn('ไม่สามารถดึงค่า SendOTPRegister ได้, ใช้ค่า default (ส่ง OTP):', sysErr);
                    }

                    if (skipOTP) {
                        // ปิด OTP — register เลยโดยไม่ต้องยืนยัน
                        window.currentFormData = formData;
                        window.currentReferenceId = null;
                        Swal.close();
                        await finalRegistration(formData, '');
                        return;
                    }

                    const sendOTPResponse = await $.ajax({
                        url: '/ExternalRegistration/SendOTP',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({ phone: formData.mobile, method: 'sms' })
                    });

                    if (sendOTPResponse.success) {
                        window.currentFormData = formData;
                        window.currentReferenceId = sendOTPResponse.referenceId;

                        $('#otpPhoneNumber').text(formData.mobile);
                        $('#otpInput').val('').removeClass('is-invalid');
                        $('#otpError').text('');

                        const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                        otpModal.show();
                        startResendCountdown();
                        Swal.close();
                    } else {
                        Swal.fire('ส่ง OTP ไม่สำเร็จ', sendOTPResponse.message, 'error');
                    }
                } catch (e) {
                    console.error('SendOTP error:', e);
                    const errMsg = (e.responseJSON && e.responseJSON.message) || e.responseText || e.message || 'ไม่สามารถส่ง OTP ได้';
                    Swal.fire('ส่ง OTP ไม่สำเร็จ', errMsg, 'error');
                }
            }

            function startResendCountdown() {
                let countdown = 30;
                const btn = $('#resendOTPBtn');
                btn.prop('disabled', true);
                clearInterval(countdownInterval);

                countdownInterval = setInterval(() => {
                    btn.find('small').text(`ส่งรหัสใหม่ (${countdown})`);
                    countdown--;
                    if (countdown < 0) {
                        clearInterval(countdownInterval);
                        btn.prop('disabled', false).find('small').text('ส่งรหัสใหม่');
                    }
                }, 1000);
            }

            $('#otpInput').on('input', function() {
                this.value = this.value.replace(/\D/g, '');
                $('#verifyOTPBtn').prop('disabled', this.value.length < 6);
            });

            $('#verifyOTPBtn').click(async function() {
                const otp = $('#otpInput').val();
                $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

                try {
                    const verifyResponse = await $.ajax({
                        url: '/ExternalRegistration/VerifyOTP',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify({
                            phone: window.currentFormData.mobile,
                            otp: otp,
                            referenceId: window.currentReferenceId
                        })
                    });

                    if (verifyResponse.isValid) {
                        bootstrap.Modal.getInstance(document.getElementById('otpModal')).hide();
                        await finalRegistration(window.currentFormData, otp);
                    } else {
                        $('#otpInput').addClass('is-invalid');
                        $('#otpError').text('รหัส OTP ไม่ถูกต้อง');
                        $(this).prop('disabled', false).html('ยืนยัน');
                    }
                } catch (e) {
                     bootstrap.Modal.getInstance(document.getElementById('otpModal')).hide();
                     await finalRegistration(window.currentFormData, otp);
                }
            });

            async function finalRegistration(formData, otp) {
                Swal.fire({ title: 'กำลังบันทึกข้อมูล...', didOpen: () => Swal.showLoading() });

                const memberpics = await readFilesAsBase64(['#idCardCopy', '#bankCardCopy', '#businessPhoto']);

                const registrationData = {
                    ...formData,
                    verificationMethod: 'otp',
                    otp: otp,
                    referenceId: window.currentReferenceId,
                    memberpic: memberpics
                };

                try {
                    const response = await $.ajax({
                        url: 'FinalizeRegistration',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(registrationData)
                    });
                    
                    var data = (typeof response === 'string') ? JSON.parse(response) : response;
                    if (data.success) {
                        Swal.fire('สำเร็จ', `ลงทะเบียนเรียบร้อย Member Code: ${data.memberCode}`, 'success')
                            .then(() => location.reload());
                    } else {
                        Swal.fire('ไม่สำเร็จ', data.message, 'error');
                    }
                } catch(e) {
                    console.error(e);
                    const errMsg = (e.responseJSON && e.responseJSON.message) || e.responseText || e.message || 'ไม่สามารถบันทึกข้อมูลได้';
                    Swal.fire('เกิดข้อผิดพลาด', errMsg, 'error');
                }
            }

            function normalizeDuplicateResult(response, defaultMessage) {
                const parsed = (typeof response === 'string') ? JSON.parse(response) : response;

                if (!parsed || typeof parsed !== 'object') {
                    return { success: true, message: '' };
                }

                // API ชุดใหม่
                if (typeof parsed.success === 'boolean') {
                    return {
                        success: parsed.success,
                        message: parsed.message || (parsed.success ? '' : defaultMessage)
                    };
                }

                // API บางชุดตอบเป็น isDuplicate
                if (typeof parsed.isDuplicate === 'boolean') {
                    return {
                        success: !parsed.isDuplicate,
                        message: parsed.isDuplicate ? (parsed.message || defaultMessage) : ''
                    };
                }

                // API บางชุดตอบเป็น exists
                if (typeof parsed.exists === 'boolean') {
                    return {
                        success: !parsed.exists,
                        message: parsed.exists ? (parsed.message || defaultMessage) : ''
                    };
                }

                return { success: true, message: '' };
            }

            // Duplicate checks
            async function checkDuplicateIDCard(id) {
                try {
                    const response = await $.get('/ExternalRegistration/CheckDupIDcard?id=' + encodeURIComponent(id));
                    return normalizeDuplicateResult(response, 'เลขบัตรประชาชนนี้มีในระบบแล้ว');
                } catch (error) {
                    console.error('Error checking duplicate ID card:', error);
                    return { success: true };
                }
            }
            async function checkDuplicateTelephone(phone) {
                try {
                    const response = await $.get('/ExternalRegistration/CheckDupTelephone?phone=' + encodeURIComponent(phone));
                    return normalizeDuplicateResult(response, 'เบอร์โทรศัพท์มือถือมีในระบบแล้ว');
                } catch (error) {
                    console.error('Error checking duplicate telephone:', error);
                    return { success: true };
                }
            }

            async function checkDuplicateEmail(email) {
                if (!email) return {success: true, message: ''};
                try {
                    const response = await $.get('/ExternalRegistration/CheckDupEmail?email=' + encodeURIComponent(email));
                    return normalizeDuplicateResult(response, 'อีเมลนี้มีในระบบแล้ว');
                } catch (error) {
                    console.error('Error checking duplicate email:', error);
                    return { success: true }; 
                }
            }

            async function checkDuplicateIDCardName(name) {
                try {
                    const response = await $.get('/ExternalRegistration/CheckDupIDcardname?name=' + encodeURIComponent(name));
                    return normalizeDuplicateResult(response, 'ชื่อตามบัตรนี้มีในระบบแล้ว');
                } catch (error) {
                    console.error('Error checking duplicate ID card name:', error);
                    return { success: true };
                }
            }

            async function checkDuplicateBusinessName(name) {
                try {
                    const response = await $.get('/ExternalRegistration/CheckDupBusinessname?name=' + encodeURIComponent(name));
                    return normalizeDuplicateResult(response, 'ชื่อธุรกิจนี้มีในระบบแล้ว');
                } catch (error) {
                    console.error('Error checking duplicate business name:', error);
                    return { success: true };
                }
            }

            // --- Loaders ---
            function loadCountries() {
                $.get('/ExternalRegistration/GetCountries').done(res => {
                     let data = (typeof res === 'string') ? JSON.parse(res) : res;
                     data = Array.isArray(data) ? data : (data.data || []);
                     $('#country').empty().append('<option value="" data-key="t-select">-- เลือก --</option>');
                     data.forEach(item => {
                         $('#country').append(`<option value="${item.M35_PX1}">${item.Thainame || item.EngName}</option>`);
                     });
                 }).fail(() => {});
            }
            function loadCountryBusinesses() {
                 $.get('/ExternalRegistration/GetCountryBusinesses').done(res => {
                     let data = (typeof res === 'string') ? JSON.parse(res) : res;
                     data = Array.isArray(data) ? data : (data.data || []);
                     $('#countryBusiness').empty().append('<option value="" data-key="t-select">-- เลือก --</option>');
                     data.forEach(item => {
                         $('#countryBusiness').append(`<option value="${item.M35_PX1}">${item.Thainame || item.EngName}</option>`);
                     });
                 }).fail(() => {});
            }
            function loadTitles() {
                 $.get('/orders/GetTitlename').done(res => {
                     let data = (typeof res === 'string') ? JSON.parse(res) : res;
                     data = Array.isArray(data) ? data : (data.data || []);
                     $('#title').empty().append('<option value="" data-key="t-select-title">-- เลือกคำนำหน้า --</option>');
                     data.forEach(item => {
                         $('#title').append(`<option value="${item.M15_PX1}">${item.Thainame || item.THAINAME}</option>`);
                     });
                 }).fail(() => {
                     $('#title').append('<option value="MR">นาย</option><option value="MRS">นาง</option>');
                 });
            }
            
            function setRegistrationDate() {
                const d = new Date();
                const day = d.getDate();
                const month = d.getMonth() + 1;
                const yearBE = d.getFullYear() + 543; // Convert to พ.ศ.

                // Set values for dropdowns
                $('#regDay').val(day);
                $('#regMonth').val(month);
                $('#regYear').val(yearBE);
                
                // Also update hidden field for form submission
                const formattedDateBE = `${String(day).padStart(2, '0')}-${String(month).padStart(2, '0')}-${yearBE}`;
                $('#registrationDate').val(formattedDateBE);
            }
            
            // Update registration date hidden field when dropdowns change
            $('#regDay, #regMonth, #regYear').on('change', function() {
                var regDay = $('#regDay').val();
                var regMonth = $('#regMonth').val();
                var regYear = $('#regYear').val();
                
                if (regDay && regMonth && regYear) {
                    var formattedDateBE = `${String(regDay).padStart(2, '0')}-${String(regMonth).padStart(2, '0')}-${regYear}`;
                    $('#registrationDate').val(formattedDateBE);
                }
            });
            function loadMasterAddresses() {
                 $.get('/orders/GetMasterAddress').done(res => {
                     masterData = (typeof res === 'string') ? JSON.parse(res) : (res.data || res);
                 });
            }
            function resetAddressDropdowns() {
                resetDropdown('#simpleProvince', '-- รอผลจากรหัสไปรษณีย์ --');
                resetDropdown('#simpleDistrict', '-- เลือกอำเภอ --');
                resetDropdown('#simpleSubdistrict', '-- เลือกตำบล --');
            }
            function resetDropdown(sel, txt) {
                $(sel).empty().append(`<option value="">${txt}</option>`).prop('disabled', true);
            }
            function getUniqueList(data, key, label) {
                const map = new Map();
                data.forEach(item => map.set(item[key], item));
                return Array.from(map.values()).sort((a,b) => a[label].localeCompare(b[label]));
            }
            function readFilesAsBase64(selectors) {
                const promises = selectors.map(selector => {
                    return new Promise((resolve, reject) => {
                        const element = document.querySelector(selector);

                        // Check if the input element exists and a file was selected
                        if (element && element.files && element.files[0]) {
                            const file = element.files[0];
                            const reader = new FileReader();

                            // When file is successfully read, resolve the promise with the Base64 string
                            reader.onload = (e) => resolve(e.target.result);
                            reader.onerror = (error) => reject(error);

                            reader.readAsDataURL(file);
                        } else {
                            // If the file is optional and wasn't uploaded, return null safely
                            resolve(null);
                        }
                    });
                });

                // Wait for all files to be read and return the array of results
                return Promise.all(promises);
            }
        });
    </script>
