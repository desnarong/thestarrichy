            async function finalRegistration(formData, otp) {
                Swal.fire({ title: 'กำลังบันทึกข้อมูล...', didOpen: () => Swal.showLoading() });

                // Read selected files (if any) and include as memberpic array (base64 strings)
                const memberpics = await readFilesAsBase64(['#idCardCopy', '#bankCardCopy', '#businessPhoto']);

                // Note: For file uploads, you normally need FormData object and processData: false
                // We send JSON with `memberpic` (array of base64 strings) — service will persist files and store paths
                const registrationData = {
                    ...formData,
                    verificationMethod: 'otp',
                    otp: otp,
                    referenceId: window.currentReferenceId,
                    memberpic: memberpics
                };

                try {
                    const response = await $.ajax({
                        url: 'FinalizeRegistration', // Check this URL
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(registrationData)
                    });
                    var data = JSON.parse(response);
                    if (data.success) {
                        Swal.fire('สำเร็จ', `ลงทะเบียนเรียบร้อย Member Code: ${data.memberCode}`, 'success')
                            .then(() => location.reload());
                    } else {
                        Swal.fire('ไม่สำเร็จ', data.message, 'error');
                    }
                } catch(e) {
                    Swal.fire('Error', 'Simulated: Registration would happen here.', 'info');
                }
            }

            // Read selected file inputs and convert to base64 strings. Returns array of base64 strings (omit empty slots).
            function readFilesAsBase64(selectors) {
                return Promise.all(selectors.map(sel => {
                    return new Promise(resolve => {
                        const input = $(sel)[0];
                        if (!input || !input.files || input.files.length === 0) return resolve(null);
                        const file = input.files[0];
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            // strip data:<mime>;base64, prefix
                            const s = (e.target.result || '').toString();
                            const parts = s.split(',');
                            resolve(parts.length > 1 ? parts[1] : parts[0]);
                        };
                        reader.onerror = function () { resolve(null); };
                        reader.readAsDataURL(file);
                    });
                })).then(results => results.filter(r => r));
            }

            // --- Validators (Simplified for Demo) ---
            // You should implement actual API calls here
            function validateIdCardName() {
                const nameInput = $('#idCardName').val();
                const name = nameInput ? nameInput.trim() : ''; // ตัดช่องว่างหน้าหลัง
                const validationEl = $('#idCardNameValidation');

                if (!name) {
                    validationEl.text('กรุณากรอกชื่อบนบัตร').addClass('validation-error');;
                    return false;
                }

                // ตรวจสอบภาษาไทย ช่องว่าง และจุด (เผื่อกรณีเช่น น.ส.)
                // หากต้องการอนุญาตภาษาอังกฤษด้วย ให้แก้ Regex เป็น /^[a-zA-Z\u0E00-\u0E7F\s.]+$/
                if (!/^[\u0E00-\u0E7F\s.]+$/.test(name)) {
                    validationEl.text('กรุณากรอกชื่อเป็นภาษาไทยเท่านั้น').addClass('validation-error');;
                    return false;
                }

                // ตรวจสอบความยาว
                if (name.length < 2 || name.length > 100) {
                    validationEl.text('ชื่อต้องมีความยาว 2-100 ตัวอักษร').addClass('validation-error');;
                    return false;
                }

                validationEl.text('').css('color', '');
                return true;
            }

            function validateBusinessName() {
                const nameInput = $('#businessName').val();
                const name = nameInput ? nameInput.trim() : '';
                const validationEl = $('#businessNameValidation');

                if (!name) {
                    validationEl.text('กรุณากรอกชื่อธุรกิจ').addClass('validation-error');;
                    return false;
                }

                // แก้ไข: เพิ่มให้รองรับ - & ( ) , เพราะชื่อบริษัทมักจะมีสัญลักษณ์เหล่านี้
                if (!/^[\u0E00-\u0E7Fa-zA-Z0-9\s.\-\&\(\)\,]+$/.test(name)) {
                    validationEl.text('ชื่อธุรกิจมีอักขระที่ไม่ได้รับอนุญาต').addClass('validation-error');;
                    return false;
                }

                if (name.length < 2 || name.length > 100) {
                    validationEl.text('ชื่อธุรกิจต้องมีความยาว 2-100 ตัวอักษร').addClass('validation-error');;
                    return false;
                }

                validationEl.text('').css('color', '');
                return true;
            }

            function validateDocumentNumber() {
                const docInput = $('#documentNumber').val();
                const docNum = docInput ? docInput.trim() : '';
                const validationEl = $('#documentValidation');

                if (!docNum) {
                    validationEl.text('กรุณากรอกเลขที่เอกสาร').addClass('validation-error');;
                    return false;
                }

                // ลบขีดและช่องว่างออกก่อนตรวจสอบ
                const cleanDocNum = docNum.replace(/[\s-]/g, '');

                // กรณีเป็นบัตรประชาชนไทย (ต้องเป็นตัวเลข 13 หลัก)
                if (/^\d{13}$/.test(cleanDocNum)) {
                    let sum = 0;
                    for (let i = 0; i < 12; i++) {
                        sum += parseFloat(cleanDocNum.charAt(i)) * (13 - i);
                    }
                    const checkDigit = (11 - (sum % 11)) % 10;
                    
                    if (checkDigit !== parseFloat(cleanDocNum.charAt(12))) {
                        validationEl.text('เลขบัตรประชาชนไม่ถูกต้อง').addClass('validation-error');;
                        return false;
                    }
                } 
                // กรณีเป็นพาสปอร์ต หรือเอกสารอื่นๆ (อนุญาตตัวเลขและตัวอักษรภาษาอังกฤษ)
                else {
                    if (cleanDocNum.length < 5 || cleanDocNum.length > 20) {
                        validationEl.text('เลขเอกสารต้องมีความยาว 5-20 ตัวอักษร').addClass('validation-error');;
                        return false;
                    }
                    if (!/^[A-Za-z0-9]+$/.test(cleanDocNum)) {
                        validationEl.text('เลขเอกสารต้องเป็นตัวอักษรภาษาอังกฤษและตัวเลขเท่านั้น').addClass('validation-error');;
                        return false;
                    }
                }

                validationEl.text('').css('color', '');
                return true;
            }

            function validateMobile() {
                const mobileInput = $('#mobile').val();
                const mobile = mobileInput ? mobileInput.trim() : '';
                const validationEl = $('#mobileValidation');

                if (!mobile) {
                    validationEl.text('กรุณากรอกเบอร์โทรศัพท์มือถือ').addClass('validation-error');;
                    return false;
