@{
    Layout = null;
    ViewBag.Title = "External Registration";
}
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>External Registration</title>
    <link href="~/assets/css/bootstrap.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/icons.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/app.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/css/team-pages-velzon.css" rel="stylesheet" />
    <link href="~/assets/css/custom.min.css" rel="stylesheet" type="text/css" />
    <link href="~/assets/libs/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/assets/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/assets/libs/sweetalert2/sweetalert2.min.js"></script>

    <style>
        div:where(.swal2-container) button:where(.swal2-styled).swal2-confirm {
            background-color: rgba(var(--vz-link-color-rgb),var(--vz-link-opacity,1)) !important
        }

        .h1, .h2, .h3, .h4, .h5, .h6, h1, h2, h3, h4, h5, h6 {
            margin-bottom: 0;
        }

        .validation-error {
            color: red !important;
        }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-12">
                <div class="card shadow-lg">
                    <div class="card-header bg-primary text-white">
                        <h4 class="text-white mb-0">ลงทะเบียนสมาชิก</h4>
                        <p class="mb-0 opacity-75">กรอกข้อมูลพื้นฐานที่จำเป็น</p>
                    </div>
                    <div class="card-body">
                        <form id="simpleRegistrationForm">
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0">ข้อมูลพื้นฐาน</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ประเทศ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <select name="country" id="country" class="form-control" required>
                                                        <option value="">-- เลือกประเทศ --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ประเทศที่ดำเนินธุรกิจ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <select name="countryBusiness" id="countryBusiness" class="form-control" required>
                                                        <option value="">-- เลือกประเทศที่ดำเนินธุรกิจ --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">รหัสผู้แนะนำ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="referrerCode" placeholder="กรอกรหัสผู้แนะนำ" required />
                                                        <button type="button" class="btn btn-primary" id="btnSearchReferrer">ค้นหา</button>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ตำแหน่ง <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="position" id="positionLeft" value="left" checked />
                                                        <label class="form-check-label" for="positionLeft">ซ้ายสุด</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="position" id="positionRight" value="right" />
                                                        <label class="form-check-label" for="positionRight">ขวาสุด</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">ชื่อผู้แนะนำ</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="referrerName" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly disabled />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">วันที่สมัคร <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="registrationDate" readonly required disabled />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">วันเกิด <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="date" class="form-control" id="birthDate" required />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">คำนำหน้า <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <select name="title" id="title" class="form-control" required>
                                                        <option value="">-- เลือกคำนำหน้า --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ชื่อบนบัตร <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="idCardName" placeholder="กรอกชื่อบนบัตร" required />
                                                    <small class="text-muted mt-1" id="idCardNameValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ชื่อธุรกิจ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="businessName" placeholder="กรอกชื่อธุรกิจ" required />
                                                    <small class="text-muted mt-1" id="businessNameValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">เลขบัตรปชช./พาสปอร์ต <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="documentNumber" placeholder="กรอกเลขที่เอกสาร" required />
                                                    <small class="text-muted mt-1" id="documentValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">โทรศัพท์มือถือ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="tel" class="form-control" id="mobile" placeholder="กรอกเบอร์โทรศัพท์มือถือ" required />
                                                    <small class="text-muted mt-1" id="mobileValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">โทรศัพท์บ้าน</label>
                                                <div class="col-md-8">
                                                    <input type="tel" class="form-control" id="homePhone" placeholder="กรอกเบอร์โทรศัพท์บ้าน" />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">อีเมล</label>
                                                <div class="col-md-8">
                                                    <input type="email" class="form-control" id="email" placeholder="กรอกอีเมล" />
                                                    <small class="text-muted mt-1" id="emailValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">Line ID</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="lineId" placeholder="กรอก Line ID" />
                                                    <small class="text-muted mt-1" id="lineIdValidation"></small>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0">อัปโหลดเอกสาร <small class="text-muted">(ไม่บังคับ)</small></h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-12 mb-3">
                                                    <label class="form-label">สำเนาบัตรประชาชน/พาสปอร์ต</label>
                                                    <input type="file" class="form-control" id="idCardCopy" accept="image/*" />
                                                    <img id="idCardPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview ID card" />
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <label class="form-label">สำเนาหน้าสมุดบัญชีธนาคาร</label>
                                                    <input type="file" class="form-control" id="bankCardCopy" accept="image/*" />
                                                    <img id="bankCardPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview bank book" />
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <label class="form-label">รูปถ่ายนักธุรกิจ</label>
                                                    <input type="file" class="form-control" id="businessPhoto" accept="image/*" />
                                                    <img id="businessPhotoPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview business photo" />
                                                </div>
                                            </div>
                                            <div class="alert alert-info py-2">
                                                <i class="fas fa-info-circle me-2"></i> รองรับไฟล์ JPG, PNG ขนาดไม่เกิน 5MB
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0">ข้อมูลที่อยู่ <small class="text-muted">(สำหรับการจัดส่ง)</small></h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">ที่อยู่ตามบัตรฯ</label>
                                                <div class="col-md-8">
                                                    <textarea class="form-control" rows="3" id="simpleAddressIdCard" placeholder="บ้านเลขที่, หมู่, ถนน"></textarea>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">รหัสไปรษณีย์</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simplePostcode" maxlength="5" placeholder="กรอกรหัสไปรษณีย์ 5 หลัก" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">จังหวัด</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleProvince" disabled>
                                                        <option value="">-- รอผลจากรหัสไปรษณีย์ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">เขต/อำเภอ</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleDistrict" disabled>
                                                        <option value="">-- เลือกอำเภอ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">แขวง/ตำบล</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleSubdistrict" disabled>
                                                        <option value="">-- เลือกตำบล --</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="d-flex flex-column flex-md-row justify-content-end gap-3">
                                        <a href="/" class="btn btn-outline-secondary w-100 w-md-auto"style="align-content: center;">
                                            <i class="fas fa-home me-2"></i>กลับหน้าแรก
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary w-100 w-md-auto" id="btnResetSimple">
                                            <i class="fas fa-redo me-2"></i>ล้างข้อมูล
                                        </button>
                                        <button type="submit" class="btn btn-primary btn-lg w-100 w-md-auto" id="btnSubmitSimple">
                                            <i class="fas fa-user-plus me-2"></i>ลงทะเบียนทันที
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="otpModal" tabindex="-1" aria-labelledby="otpModalLabel" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="otpModalLabel">
                        <i class="fas fa-mobile-alt me-2"></i>ยืนยันรหัส OTP
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-sms display-4 text-primary mb-3"></i>
                        <p class="mb-2">เราได้ส่งรหัส OTP ไปยังเบอร์โทรศัพท์</p>
                        <h5 class="text-primary fw-bold" id="otpPhoneNumber"></h5>
                        <small class="text-muted">กรุณาใส่รหัส OTP 6 หลักที่ได้รับ</small>
                    </div>

                    <form id="otpForm">
                        <div class="mb-3">
                            <input type="text" class="form-control form-control-lg text-center"
                                   id="otpInput" maxlength="6" placeholder="000000"
                                   style="font-size: 1.5rem; letter-spacing: 0.5rem;" autocomplete="off" required>
                            <div class="invalid-feedback text-center" id="otpError"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">รหัส OTP จะหมดอายุใน 5 นาที</small>
                            <button type="button" class="btn btn-link btn-sm p-0" id="resendOTPBtn" disabled>
                                <small>ส่งรหัสใหม่ (30)</small>
                            </button>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">ยกเลิก</button>
                    <button type="button" class="btn btn-primary" id="verifyOTPBtn" disabled>
                        <i class="fas fa-check me-2"></i>ยืนยัน
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            let masterData = [];

            // 1. Initial Data Loading
            loadCountries();
            loadCountryBusinesses();
            loadTitles();
            loadMasterAddresses(); // Load address data into memory
            setRegistrationDate();

            // 2. Event Listeners - Basic Inputs
            // Copy idCardName to businessName
            $('#idCardName').on('input', function() {
                if (!$('#businessName').val()) {
                    $('#businessName').val($(this).val());
                    validateBusinessName(); // Validate immediately after set
                }
                validateIdCardName();
            });

            $('#businessName').on('input', validateBusinessName);
            $('#documentNumber').on('input', validateDocumentNumber);
            $('#mobile').on('input', validateMobile);
            $('#email').on('input', validateEmail);
            $('#lineId').on('input', validateLineId);

            // 3. Search Referrer
            $('#btnSearchReferrer').click(function () {
                const referrerCode = $('#referrerCode').val();
                if (referrerCode) {
                    $.get('/ExternalRegistration/FindReferrer?referrerCode=' + encodeURIComponent(referrerCode))
                        .done(function(response) {
                            if (response.success) {
                                $('#referrerName').val(response.memberName);
                            } else {
                                $('#referrerName').val('');
                                Swal.fire('ไม่พบข้อมูล', response.message || 'ไม่พบรหัสผู้แนะนำ', 'warning');
                            }
                        })
                        .fail(function() {
                            Swal.fire('Error', 'ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้', 'error');
                        });
                } else {
                    Swal.fire('แจ้งเตือน', 'กรุณากรอกรหัสผู้แนะนำ', 'warning');
                }
            });

            // --- Image preview handlers for uploads (max 5MB, images only)
            function handleImagePreview(inputSelector, previewSelector) {
                $(inputSelector).on('change', function () {
                    const file = this.files && this.files[0];
                    const preview = $(previewSelector);
                    if (!file) {
                        preview.hide().attr('src', '');
                        return;
                    }

                    // validate type
                    if (!file.type.startsWith('image/')) {
                        Swal.fire('รูปไม่ถูกต้อง', 'รองรับเฉพาะไฟล์รูปเท่านั้น (jpg, png, gif)', 'error');
                        $(this).val('');
                        preview.hide().attr('src', '');
                        return;
                    }

                    // validate size (<= 5MB)
                    const maxBytes = 5 * 1024 * 1024;
                    if (file.size > maxBytes) {
                        Swal.fire('ไฟล์ใหญ่เกินไป', 'ขนาดไฟล์ต้องไม่เกิน 5MB', 'error');
                        $(this).val('');
                        preview.hide().attr('src', '');
                        return;
                    }

                    const url = URL.createObjectURL(file);
                    preview.attr('src', url).show();

                    // revoke object URL after image loads to free memory
                    preview.on('load', function () { URL.revokeObjectURL(url); });
                });
            }

            handleImagePreview('#idCardCopy', '#idCardPreview');
            handleImagePreview('#bankCardCopy', '#bankCardPreview');
            handleImagePreview('#businessPhoto', '#businessPhotoPreview');

            // 4. Address Logic (Zipcode -> Province -> District -> Subdistrict)
            $('#simplePostcode').on('input', function() {
                var selectedZip = $(this).val();
                resetAddressDropdowns();

                if (selectedZip.length === 5) {
                    var filteredData = masterData.filter(item => item.zipcode === selectedZip);
                    if (filteredData.length > 0) {
                        var uniqueProvinces = getUniqueList(filteredData, 'province_code', 'province');
                        $('#simpleProvince').empty().append('<option value="">-- เลือกจังหวัด --</option>');
                        $.each(uniqueProvinces, function(index, item) {
                            $('#simpleProvince').append(`<option value="${item.province_code}">${item.province}</option>`);
                        });
                        $('#simpleProvince').prop('disabled', false);
                        if (uniqueProvinces.length === 1) {
                            $('#simpleProvince').val(uniqueProvinces[0].province_code).trigger('change');
                        }
                    }
                }
            });

            $('#simpleProvince').change(function() {
                var selectedZip = $('#simplePostcode').val();
                var selectedProvCode = $(this).val();
                resetDropdown('#simpleDistrict', '-- เลือกอำเภอ --');
                resetDropdown('#simpleSubdistrict', '-- เลือกตำบล --');

                if (selectedProvCode) {
                    var filteredData = masterData.filter(item => item.zipcode === selectedZip && item.province_code == selectedProvCode);
                    if (filteredData.length > 0) {
                        var uniqueDistricts = getUniqueList(filteredData, 'amphoe_code', 'amphoe');
                        $('#simpleDistrict').empty().append('<option value="">-- เลือกอำเภอ --</option>');
                        $.each(uniqueDistricts, function(index, item) {
                            $('#simpleDistrict').append(`<option value="${item.amphoe_code}">${item.amphoe}</option>`);
                        });
                        $('#simpleDistrict').prop('disabled', false);
                        if (uniqueDistricts.length === 1) {
                            $('#simpleDistrict').val(uniqueDistricts[0].amphoe_code).trigger('change');
                        }
                    }
                }
            });

            $('#simpleDistrict').change(function() {
                var selectedZip = $('#simplePostcode').val();
                var selectedProvCode = $('#simpleProvince').val();
                var selectedDistCode = $(this).val();
                resetDropdown('#simpleSubdistrict', '-- เลือกตำบล --');

                if (selectedDistCode) {
                    var filteredData = masterData.filter(item =>
                        item.zipcode === selectedZip &&
                        item.province_code == selectedProvCode &&
                        item.amphoe_code == selectedDistCode
                    );
                    if (filteredData.length > 0) {
                        var uniqueSubdistricts = getUniqueList(filteredData, 'tambon_code', 'tambon');
                        $('#simpleSubdistrict').empty().append('<option value="">-- เลือกตำบล --</option>');
                        $.each(uniqueSubdistricts, function(index, item) {
                            $('#simpleSubdistrict').append(`<option value="${item.tambon_code}">${item.tambon}</option>`);
                        });
                        $('#simpleSubdistrict').prop('disabled', false);
                    }
                }
            });

            // 5. Form Submission
            $('#simpleRegistrationForm').on('submit', function(e) {
                e.preventDefault();
                if (validateForm()) {
                    Swal.fire({
                        title: 'ยืนยันการลงทะเบียน',
                        text: 'คุณต้องการลงทะเบียนสมาชิกด้วยข้อมูลนี้หรือไม่?',
                        icon: 'question',
                        showCancelButton: true,
                        confirmButtonText: 'ยืนยัน',
                        cancelButtonText: 'ยกเลิก'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            performValidationAndRegister();
                        }
                    });
                } else {
                    Swal.fire('ข้อมูลไม่ครบถ้วน', 'กรุณากรอกข้อมูลที่จำเป็นให้ครบถ้วน', 'warning');
                }
            });

            // 6. Reset Form
            $('#btnResetSimple').click(function () {
                $('#simpleRegistrationForm')[0].reset();
                $('#referrerName').val('');
                setRegistrationDate();
