                    // ตรวจสอบว่า response เป็นก้อน Object อยู่แล้วหรือยัง (jQuery มักจะ Parse ให้เอง)
                    const data = (typeof response === 'string') ? JSON.parse(response) : response;

                    return data;
                } catch (error) {
                    console.error('Error checking duplicate email:', error);
                    // กรณีเกิด Error ทาง Network ให้คืนค่า true เพื่อให้ Process อื่นไปต่อได้
