                                    </div>
                                </div>
                            </div>
                            <div id="EstimatePositionContainer" class="row">

                            </div>
                        </div><!-- end card body -->
                    </div>
                </div>
                <div class="col-xxl-3">
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
