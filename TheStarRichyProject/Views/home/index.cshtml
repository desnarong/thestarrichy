        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="messageModal" tabindex="-1" role="dialog" aria-labelledby="messageModalLabel" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title text-white mx-auto" id="messageModalLabel"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="message-type-label d-none" id="messageTypeLabel"></div>
                <div class="message-content" id="messageContent">
                    <!-- ข้อความจะแสดงที่นี่ -->
                </div>
            </div>
            <div class="modal-footer message-navigation">
                <span class="message-counter" id="messageCounter">1 / 1</span>
                <div>
                    <button type="button" class="btn btn-secondary btn-nav" id="prevBtn" onclick="showPreviousMessage()">
                        ก่อนหน้า
                    </button>
                    <button type="button" class="btn btn-primary btn-nav ms-2" id="nextBtn" onclick="showNextMessage()">
                        ถัดไป
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="~/assets/js/pages/home-index.js"></script>
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
    <script>
        (function () {
            window.kycStatus = '@(kyc)';
            if (window.kycStatus === 'N') {
                var kycModal = new bootstrap.Modal(document.getElementById('kycModal'), { backdrop: 'static', keyboard: false });
                kycModal.show();
            }

            var kycBody = document.getElementById('kycModalBody');
            if (kycBody) {
                kycBody.addEventListener('scroll', function () {
                    if (this.scrollTop + this.clientHeight >= this.scrollHeight - 10) {
                        document.getElementById('kycActionButtons').style.display = 'flex';
                    }
                });
            }
        })();

        function acceptKYC() {
            var btn = document.getElementById('btnAcceptKYC');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>กำลังบันทึก...';
            fetch('/home/AcceptKYC', {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value ?? '' }
            })
            .then(function (res) {
                if (res.ok) {
                    location.reload();
                } else {
                    alert('เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง');
                    btn.disabled = false;
                    btn.innerHTML = 'ยอมรับและยืนยัน';
                }
            })
            .catch(function () {
                alert('เกิดข้อผิดพลาด กรุณาลองใหม่อีกครั้ง');
                btn.disabled = false;
                btn.innerHTML = 'ยอมรับและยืนยัน';
            });
        }

        function rejectKYC() {
            window.location.href = '/Auth/Logout';
        }
    </script>
}