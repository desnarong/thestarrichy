<script>
    $(document).ready(function () {
        let textmaxlength = 65;

        // ⭐ โหลด Cart ใน Header
        function loadHeaderCart() {
            $.ajax({
                url: '/Orders/GetCart',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        updateHeaderCart(response);
                    }
                },
                error: function () {
                    console.log('Failed to load header cart');
                }
            });
        }

        // ⭐ Update Header Cart Display
        function updateHeaderCart(data) {
            const items = data.items || [];
            const itemCount = data.itemCount || 0;
            const totalPrice = data.totalPrice || 0;

            // Update badge
            $('#headerCartBadge').text(itemCount);
            $('#headerCartItemCount').text(itemCount);
            $('#headerCartTotal').text('฿ ' + totalPrice.toFixed(2));

            // Render items
            const $container = $('#headerCartItemsContainer');

            if (items.length === 0) {
                $container.html(`
                    <div class="text-center empty-cart">
                        <div class="avatar-md mx-auto my-3">
                            <div class="avatar-title bg-info-subtle text-info fs-36 rounded-circle">
                                <i class='bx bx-cart'></i>
                            </div>
                        </div>
                        <h5 class="mb-3">ตะกร้าว่างเปล่า!</h5>
                    </div>
                `);
                $('#headerCartCheckout').hide();
            } else {
                let html = '';
                items.forEach(item => {
                    const imageUrl = item.productImage ? item.productImage : '/assets/images/products/no-image.png';
                    html += `
                        <div class="d-block dropdown-item dropdown-item-cart text-wrap px-3 py-2">
                            <div class="d-flex align-items-center">
                                <img src="${imageUrl}"
                                     class="me-3 rounded-circle avatar-sm p-2 bg-light"
                                     alt="${item.productName}"
                                     onerror="this.src='/assets/images/products/no-image.png'">
                                <div class="flex-grow-1">
                                    <h6 class="mt-0 mb-1 fs-14">
                                        <a href="#" class="text-body">${item.productName}</a>
                                    </h6>
                                    <p class="mb-0 fs-12 text-muted">
                                        ${item.quantity} x ฿${item.price.toFixed(2)}
                                    </p>
                                </div>
                                <div class="px-2">
                                    <h5 class="m-0 fw-normal">฿${item.subTotal.toFixed(2)}</h5>
                                </div>
                                <div class="ps-2">
                                    <button type="button"
                                            class="btn btn-icon btn-sm btn-ghost-secondary header-remove-item-btn"
                                            data-product-id="${item.productID}">
                                        <i class="ri-close-fill fs-16"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    `;
                });
                $container.html(html);
                $('#headerCartCheckout').show();

                // Bind remove button
                $('.header-remove-item-btn').click(function () {
                    const productId = $(this).data('product-id');
                    removeHeaderCartItem(productId);
                });
            }
        }

        // ⭐ ลบสินค้าจาก Header Cart
        function removeHeaderCartItem(productId) {
            if (confirm('ต้องการลบสินค้านี้ออกจากตะกร้าใช่หรือไม่?')) {
                $.ajax({
                    url: '/Orders/RemoveFromCart',
                    type: 'POST',
                    data: { productId: productId },
                    success: function (response) {
                        if (response.success) {
                            loadHeaderCart(); // Reload cart

                            // Show notification
                            Swal.fire({
                                icon: 'success',
                                title: 'สำเร็จ',
                                text: 'ลบสินค้าออกจากตะกร้าแล้ว',
                                timer: 1500,
                                showConfirmButton: false
                            });
                        }
                    }
                });
            }
        }

        function notifyGlobalCartUpdated() {
            loadHeaderCart();
            $(document).trigger('global-cart-updated');
        }

        function renderGlobalCartItems(items) {
            let html = '';

            if (!items || items.length === 0) {
                html = '<div class="alert alert-info">ตะกร้าว่างเปล่า</div>';
            } else {
                html = '<div class="cart-list">';

                items.forEach(item => {
                    const productId = item.productID || item.productId;
                    const imageUrl = item.productImage || item.imageUrl || '/assets/images/products/no-image.png';
                    const total = (item.price * item.quantity).toFixed(2);
                    html += `
                        <div class="cart-item">
                            <div class="cart-item-main">
                                <img src="${imageUrl}" class="cart-item-image" alt="${item.productName || 'Product'}" onerror="this.src='/assets/images/products/no-image.png'">
                                <div class="cart-item-content">
                                    <div class="cart-item-top">
                                        <div>
                                            <div class="cart-item-name">${item.productName}</div>
                                            <div class="cart-item-code">${item.productCode || productId}</div>
                                        </div>
                                        <button class="btn btn-danger btn-sm btn-remove-item" data-product-id="${productId}" title="ลบสินค้า">
                                            <i class="bx bx-trash"></i>
                                        </button>
                                    </div>

                                    <div class="cart-item-body">
                                        <div class="cart-meta">
                                            <div class="cart-meta-row">
                                                <span class="cart-meta-label">ราคา</span>
                                                <span class="cart-meta-value">฿${item.price.toFixed(2)}</span>
                                            </div>
                                            <div class="cart-meta-row">
                                                <span class="cart-meta-label">รวม</span>
                                                <span class="cart-meta-value text-success">฿${total}</span>
                                            </div>
                                        </div>

                                        <div class="cart-qty-wrap">
                                            <span class="cart-qty-label">จำนวน</span>
                                            <div class="cart-qty-control">
                                                <button type="button" class="btn btn-light btn-sm cart-qty-btn cart-qty-decrease" data-product-id="${productId}" aria-label="ลดจำนวน">
                                                    <i class="bx bx-minus"></i>
                                                </button>
                                                <input type="text" class="form-control form-control-sm cart-item-quantity" value="${item.quantity}" readonly data-product-id="${productId}">
                                                <button type="button" class="btn btn-light btn-sm cart-qty-btn cart-qty-increase" data-product-id="${productId}" aria-label="เพิ่มจำนวน">
                                                    <i class="bx bx-plus"></i>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });

                html += '</div>';
            }

            $('#globalCartItemsContainer').html(html);

            $('#globalCartItemsContainer .cart-qty-decrease').click(function () {
                const productId = $(this).data('product-id');
                const qtyInput = $(`#globalCartItemsContainer .cart-item-quantity[data-product-id="${productId}"]`);
                const currentQty = parseInt(qtyInput.val(), 10) || 1;

                if (currentQty > 1) {
                    updateGlobalCartQuantity(productId, currentQty - 1);
                }
            });

            $('#globalCartItemsContainer .cart-qty-increase').click(function () {
                const productId = $(this).data('product-id');
                const qtyInput = $(`#globalCartItemsContainer .cart-item-quantity[data-product-id="${productId}"]`);
                const currentQty = parseInt(qtyInput.val(), 10) || 1;

                updateGlobalCartQuantity(productId, currentQty + 1);
            });

            $('#globalCartItemsContainer .btn-remove-item').click(function () {
                removeGlobalCartItem($(this).data('product-id'));
            });
        }

        function loadGlobalCartItems() {
            $.ajax({
                url: '/Orders/GetCart',
                type: 'GET',
                success: function (response) {
                    if (response.success) {
                        renderGlobalCartItems(response.items || []);
                        $('#globalCartModalTotal').text('฿ ' + (response.totalPrice || 0).toFixed(2));
                        $('#globalCartModalPV').text((response.totalPV || 0).toFixed(0));
                    }
                }
            });
        }

        function updateGlobalCartQuantity(productId, quantity) {
            $.ajax({
                url: '/Orders/UpdateCart',
                type: 'POST',
                data: { productId: productId, quantity: quantity },
                success: function (response) {
                    if (response.success) {
                        loadGlobalCartItems();
                        notifyGlobalCartUpdated();
                    }
                }
            });
        }

        function removeGlobalCartItem(productId) {
            if (!confirm('ต้องการลบสินค้านี้ออกจากตะกร้าใช่หรือไม่?')) {
                return;
            }

            $.ajax({
                url: '/Orders/RemoveFromCart',
                type: 'POST',
                data: { productId: productId },
                success: function (response) {
                    if (response.success) {
                        loadGlobalCartItems();
                        notifyGlobalCartUpdated();
                    }
                }
            });
        }

        function openGlobalCartModal() {
            loadGlobalCartItems();

            const modalEl = document.getElementById('globalCartModal');
            if (modalEl && typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(modalEl).show();
                return;
            }

            if (typeof $.fn.modal === 'function') {
                $('#globalCartModal').modal('show');
            }
        }

        // ⭐ เมื่อเปิด Cart Dropdown
        $('#page-header-cart-dropdown').on('click', function () {
            loadHeaderCart();
        });

        // ⭐ ปุ่ม "ไปที่ตะกร้า" ที่ header: เปิด cartModal แทนการ redirect
        $('#headerGoToCartBtn').on('click', function (e) {
            e.preventDefault();
            openGlobalCartModal();
        });

        $('#globalCartConfirmOrder').on('click', function () {
            $.ajax({
                url: '/Orders/GetCart',
                type: 'GET',
                success: function (response) {
                    if (response.success && response.items && response.items.length > 0) {
                        window.location.href = '/Orders/CheckoutInfo';
                    } else if (typeof Swal !== 'undefined') {
                        Swal.fire({
                            icon: 'warning',
                            title: 'ไม่พบสินค้า',
                            text: 'กรุณาเลือกสินค้าก่อนดำเนินการต่อ',
                            timer: 1800,
                            showConfirmButton: false
                        });
                    }
                }
            });
        });

        // ⭐ โหลด Cart ครั้งแรกเมื่อเปิดหน้า
        loadHeaderCart();

        // ⭐ Global function สำหรับ update จากหน้าอื่น
        window.updateHeaderCartBadge = function() {
            loadHeaderCart();
        };

        window.openGlobalCartModal = openGlobalCartModal;

        // ฟังก์ชันตัดข้อความไม่เกิน maxLength ตัวอักษร
        function truncateText(text, maxLength) {
            if (!text) return '';
            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        async function loadMemberMessages() {
            try {
                const response = await fetch('/home/GetMemberMessages', {
                    method: 'GET',
                    credentials: 'include'
                });
                const data = await response.json();
                if (data) {
                    const $positionContainer = $('#notificationItemsTabContent');

                    let tableHtml = `<div class="tab-pane fade show active py-2 ps-2" id="all-noti-tab" role="tabpanel">
                        <div id="notification-item" style="max-height: 300px;" class="pe-2">`;
                    let noticount = 0;
                    $.each(data.slice(0, 10), function (index, item) {
                        if (item.LastMonthStatusMessage != '') {
                            let message = truncateText(item.LastMonthStatusMessage, textmaxlength);
                            tableHtml += `
                                <div class="text-reset notification-item d-block dropdown-item position-relative">
                                    <div class="d-flex">
                                        <div class="avatar-xs me-3 flex-shrink-0">
                                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-16">
                                                <i class="bx bx-badge-check"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <a href="#!" class="stretched-link notification-item-content" onclick="notificationitem('${item.LastMonthStatusMessage}')">
                                                <h6 class="mt-0 mb-2 lh-base">${message}</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>`;
                            noticount++;
                        }
                        if (item.CurrentMonthStatusMessage != '') {
                            let message = truncateText(item.CurrentMonthStatusMessage, textmaxlength);
                            tableHtml += `
                                <div class="text-reset notification-item d-block dropdown-item position-relative">
                                    <div class="d-flex">
                                        <div class="avatar-xs me-3 flex-shrink-0">
                                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-16">
                                                <i class="bx bx-badge-check"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <a href="#!" class="stretched-link notification-item-content" onclick="notificationitem('${item.CurrentMonthStatusMessage}')">
                                                <h6 class="mt-0 mb-2 lh-base">${message}</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>`;
                            noticount++;
                        }
                        if (item.SendIDcardMessage != '') {
                            let message = truncateText(item.SendIDcardMessage, textmaxlength);
                            tableHtml += `
                                <div class="text-reset notification-item d-block dropdown-item position-relative">
                                    <div class="d-flex">
                                        <div class="avatar-xs me-3 flex-shrink-0">
                                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-16">
                                                <i class="bx bx-badge-check"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <a href="#!" class="stretched-link notification-item-content" onclick="notificationitem('${item.SendIDcardMessage}')">
                                                <h6 class="mt-0 mb-2 lh-base">${message}</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>`;
                            noticount++;
                        }
                        if (item.SendBankMessage != '') {
                            let message = truncateText(item.SendBankMessage, textmaxlength);
                            tableHtml += `
                                <div class="text-reset notification-item d-block dropdown-item position-relative">
                                    <div class="d-flex">
                                        <div class="avatar-xs me-3 flex-shrink-0">
                                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-16">
                                                <i class="bx bx-badge-check"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <a href="#!" class="stretched-link notification-item-content" onclick="notificationitem('${item.SendBankMessage}')">
                                                <h6 class="mt-0 mb-2 lh-base">${message}</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>`;
                            noticount++;
                        }
                        if (item.SendKYCMessage != '') {
                            let message = truncateText(item.SendKYCMessage, textmaxlength);
                            tableHtml += `
                                <div class="text-reset notification-item d-block dropdown-item position-relative">
                                    <div class="d-flex">
                                        <div class="avatar-xs me-3 flex-shrink-0">
                                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-16">
                                                <i class="bx bx-badge-check"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <a href="#!" class="stretched-link notification-item-content" onclick="notificationitem('${item.SendKYCMessage}')">
                                                <h6 class="mt-0 mb-2 lh-base">${message}</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>`;
                            noticount++;
                        }
                        if (item.SendHoldExpireMessage != '') {
                            let message = truncateText(item.SendHoldExpireMessage, textmaxlength);
                            tableHtml += `
                                <div class="text-reset notification-item d-block dropdown-item position-relative">
                                    <div class="d-flex">
                                        <div class="avatar-xs me-3 flex-shrink-0">
                                            <span class="avatar-title bg-info-subtle text-info rounded-circle fs-16">
                                                <i class="bx bx-badge-check"></i>
                                            </span>
                                        </div>
                                        <div class="flex-grow-1">
                                            <a href="#!" class="stretched-link notification-item-content" onclick="notificationitem('${item.SendHoldExpireMessage}')">
                                                <h6 class="mt-0 mb-2 lh-base">${message}</h6>
                                            </a>
                                        </div>
                                    </div>
                                </div>`;
                            noticount++;
                        }
                    });
                    tableHtml += `
                        </div>
                    </div>`;
                    $('.notificationscount').html(noticount);
                    $positionContainer.append(tableHtml);
                } else {
                    console.error('No token found');
                    return null;
                }
            } catch (error) {
                console.error('Error fetching token:', error);
                return null;
            }
        }

        (async () => {
            await loadMemberMessages();
        })();

        window.testSwal = function () {
            Swal.fire({
                title: 'Test',
                text: 'This is a test alert!',
                icon: 'info',
                confirmButtonText: 'OK'
            });
        };
    });

    function notificationitem(msg) {
        Swal.fire({
            title: 'Notification Message',
            icon: 'info',
            html: msg || 'No message provided',
            showCloseButton: true,
            showCancelButton: false,
            buttonsStyling: true,
            confirmButtonText: 'ปิดหน้าต่าง'
        });
    }
</script>
