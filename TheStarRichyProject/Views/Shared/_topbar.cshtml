@using TheStarRichyProject.Helper
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@{
    var cookieValue = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.UserInfoKey);
    var memberinfo = JsonConvert.DeserializeObject<dynamic>(cookieValue);
    var userinfo = JsonConvert.DeserializeObject<dynamic>(cookieValue)["memberInfo"][0];
    var runmessage = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.MessageInfoKey);
    var systemname = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.SystemInfoKey);
    var positionpicture = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.MemberPositionPictureKey);
}
<style>
    .left-group {
        display: flex;
        gap: 8px;
    }

    .text-start {
        align-items: center;
    }

    .navbar-header-marquee {
        display: -webkit-box;
        display: -ms-flexbox;
        display: flex;
        -ms-flex-pack: justify;
        -webkit-box-pack: justify;
        justify-content: space-between;
        -webkit-box-align: center;
        -ms-flex-align: center;
        align-items: center;
        margin: 0 auto;
        height: 20px;
        padding: 0 1.5rem 0 calc(1.5rem * .5);
        color: white !important;
    }

    .navbar-header-marquee .marquee-container {
        overflow: hidden;
        position: relative;
        /* Fade out near the left edge so text disappears smoothly */
        -webkit-mask-image: linear-gradient(to right, transparent 0, #000 42px, #000 100%);
        mask-image: linear-gradient(to right, transparent 0, #000 42px, #000 100%);
    }

    .navbar-header-marquee .marquee-text {
        will-change: transform;
    }

    #globalCartModal .modal-dialog {
        margin: 1rem auto;
    }

    #globalCartModal .modal-content {
        max-height: calc(100dvh - 2rem);
        overflow: hidden;
        border-radius: 12px;
        background-color: #ffffff;
        color: #212529;
    }

    #globalCartModal .modal-body {
        overflow-x: auto;
        overflow-y: auto;
        -webkit-overflow-scrolling: touch;
        background-color: #ffffff;
    }

    #globalCartModal .modal-header,
    #globalCartModal .modal-footer {
        background-color: #ffffff;
    }

    #globalCartItemsContainer .cart-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    #globalCartItemsContainer .cart-item {
        border: 1px solid #e9ecef;
        border-radius: 10px;
        padding: 12px;
        background: #fff;
    }

    #globalCartItemsContainer .cart-item-main {
        display: flex;
        gap: 12px;
        align-items: flex-start;
    }

    #globalCartItemsContainer .cart-item-image {
        width: 64px;
        height: 64px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #e9ecef;
        background: #f8f9fa;
        flex-shrink: 0;
    }

    #globalCartItemsContainer .cart-item-content {
        flex: 1;
        min-width: 0;
    }

    #globalCartItemsContainer .cart-item-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 10px;
        margin-bottom: 8px;
    }

    #globalCartItemsContainer .cart-item-name {
        font-size: 0.95rem;
        font-weight: 600;
        color: #2c3e50;
        line-height: 1.35;
    }

    #globalCartItemsContainer .cart-item-code {
        font-size: 0.78rem;
        color: #6c757d;
    }

    #globalCartItemsContainer .btn-remove-item {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 0;
    }

    #globalCartItemsContainer .cart-item-body {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 10px;
        align-items: end;
    }

    #globalCartItemsContainer .cart-meta {
        display: grid;
        gap: 4px;
    }

    #globalCartItemsContainer .cart-meta-row {
        display: flex;
        gap: 8px;
        align-items: center;
        font-size: 0.88rem;
    }

    #globalCartItemsContainer .cart-meta-label {
        color: #6c757d;
        min-width: 62px;
    }

    #globalCartItemsContainer .cart-meta-value {
        font-weight: 600;
        color: #2c3e50;
    }

    #globalCartItemsContainer .cart-qty-wrap {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }

    #globalCartItemsContainer .cart-qty-label {
        color: #6c757d;
        font-size: 0.78rem;
    }

    #globalCartItemsContainer .cart-item-quantity {
        width: 56px;
        height: 34px;
        text-align: center;
        font-weight: 600;
        background: #f8f9fa;
        border-left: 0;
        border-right: 0;
        border-radius: 0;
    }

    #globalCartItemsContainer .cart-qty-control {
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    #globalCartItemsContainer .cart-qty-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0;
        border-radius: 0;
        border-color: #ced4da;
    }

    #globalCartItemsContainer .cart-qty-decrease {
        border-top-left-radius: 6px;
        border-bottom-left-radius: 6px;
    }

    #globalCartItemsContainer .cart-qty-increase {
        border-top-right-radius: 6px;
        border-bottom-right-radius: 6px;
    }

    #globalCartModal .modal-footer {
        gap: 10px;
    }

    @@media (max-width: 767.98px) {
        #globalCartModal .modal-dialog {
            width: calc(100vw - 1rem);
            margin: 0.5rem auto;
        }

        #globalCartModal .modal-content {
            max-height: calc(100dvh - 1rem);
            border-radius: 10px;
        }

        #globalCartModal .modal-header {
            padding: 0.75rem 0.85rem;
        }

        #globalCartModal .modal-title {
            font-size: 1rem;
            line-height: 1.3;
        }

        #globalCartModal .modal-body {
            padding: 0.75rem;
        }

        #globalCartItemsContainer .cart-item {
            padding: 10px;
        }

        #globalCartItemsContainer .cart-item-image {
            width: 56px;
            height: 56px;
        }

        #globalCartItemsContainer .cart-item-body {
            grid-template-columns: 1fr;
            gap: 8px;
        }

        #globalCartItemsContainer .cart-qty-wrap {
            align-items: stretch;
        }

        #globalCartItemsContainer .cart-item-quantity {
            width: 48px;
            min-width: 48px;
        }

        #globalCartItemsContainer .cart-qty-control {
            justify-content: flex-end;
        }

        #globalCartModal .modal-footer {
            flex-direction: column;
            align-items: stretch !important;
            padding: 0.75rem;
        }

        #globalCartModal .modal-footer > div {
            width: 100%;
        }

        #globalCartModal .modal-footer > div:last-child {
            display: flex;
            gap: 8px;
        }

        #globalCartModal .modal-footer button {
            flex: 1 1 auto;
            min-height: 40px;
        }
    }
</style>
