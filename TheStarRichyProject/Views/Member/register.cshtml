    <script>
        $(document).ready(function () {
            let masterData = [];

            // Load master address data
            loadMasterAddresses();

            // --- Load data for simple registration (from ExternalRegistration example) ---
            loadSimpleCountries();
            loadSimpleCountryBusinesses();
            loadSimpleTitles();
            setSimpleRegistrationDate();

            // Load full-registration lists (same APIs as simple)
            loadFullCountries();
            loadFullCountryBusinesses();
            loadFullTitles();
            setFullRegistrationDate();
            loadFullBanks();

            // Copy name-on-card into business name if business name is empty
            $('#simpleFullName').on('input', function() {
                if (!$('#simpleBusinessName').val()) {
                    $('#simpleBusinessName').val($(this).val());
                }
            });

            // Switch to full registration tab
            $('#btnSwitchToFull').click(function () {
                $('#full-tab').tab('show');
            });

            // Reset simple form
            $('#btnResetSimple').click(function () {
                $('#simpleRegistrationForm')[0].reset();
