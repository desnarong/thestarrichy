    function validateThaiID(id) {
        if (!id || id.length !== 13) return false;
        let sum = 0;
        for (let i = 0; i < 12; i++) {
            sum += parseInt(id.charAt(i)) * (13 - i);
        }
        let checkDigit = (11 - (sum % 11)) % 10;
        return checkDigit === parseInt(id.charAt(12));
    }

    // ==========================================
    // IP ADDRESS FUNCTIONS
    // ==========================================
    let clientIpAddress = '0'; // Default value

    async function getClientIP() {
        try {
            // First try to get IP from server-side endpoint (most accurate)
            try {
                const response = await fetch('/ExternalRegistration/GetClientIP');
                if (response.ok) {
                    const data = await response.json();
                    if (data.success && data.ip) {
                        clientIpAddress = data.ip;
                        console.log('Client IP detected from server:', clientIpAddress);
                        return clientIpAddress;
                    }
                }
            } catch (e) {
                console.log('Server-side IP detection failed:', e.message);
            }

            // Fallback: Try public IP detection services
            const services = [
                'https://api.ipify.org?format=json',
                'https://api64.ipify.org?format=json',
                'https://ipinfo.io/json'
            ];

            for (const service of services) {
                try {
                    const response = await fetch(service, { timeout: 3000 });
                    if (response.ok) {
                        const data = await response.json();
                        if (data.ip) {
                            clientIpAddress = data.ip;
                            console.log('Client IP detected from public service:', clientIpAddress);
                            return clientIpAddress;
                        }
                    }
                } catch (e) {
                    console.log(`IP service ${service} failed:`, e.message);
                    continue;
                }
            }

            console.warn('Could not detect client IP, using default');
            return '0';
        } catch (error) {
            console.error('Error getting client IP:', error);
            return '0';
        }
    }

