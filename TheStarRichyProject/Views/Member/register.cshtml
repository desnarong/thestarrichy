            // Image preview handlers (simple + full)
            function handleImagePreview(inputSelector, previewSelector) {
                $(inputSelector).on('change', function () {
                    const file = this.files && this.files[0];
                    const preview = $(previewSelector);
                    if (!file) {
                        preview.hide().attr('src', '');
                        return;
                    }

                    if (!file.type.startsWith('image/')) {
                        toastr.error('รองรับเฉพาะไฟล์รูปเท่านั้น (jpg, png, gif)');
                        $(this).val('');
                        preview.hide().attr('src', '');
                        return;
                    }

                    const maxBytes = 5 * 1024 * 1024; // 5MB
                    if (file.size > maxBytes) {
                        toastr.error('ขนาดไฟล์ต้องไม่เกิน 5MB');
                        $(this).val('');
                        preview.hide().attr('src', '');
                        return;
                    }

                    const url = URL.createObjectURL(file);
                    preview.attr('src', url).show();
                    preview.on('load', function () { URL.revokeObjectURL(url); });
                });
            }

