    // Simple form submission
    $('#simpleRegistrationForm').submit(async function (e) {
        e.preventDefault();
        let isValid = true;

        const requiredFields = $(this).find('input[required], select[required], textarea[required]');
        requiredFields.each(function () {
            const field = $(this);
            if (field.is(':radio') || field.is(':checkbox')) {
                const name = field.attr('name');
                if ($('input[name="' + name + '"]:checked').length === 0) {
                    $('input[name="' + name + '"]').addClass('is-invalid');
                    isValid = false;
                } else {
                    $('input[name="' + name + '"]').removeClass('is-invalid');
                }
            }
            else {
                const val = $.trim(field.val());
                if (!val) {
                    field.addClass('is-invalid');
                    isValid = false;
                } else {
                    field.removeClass('is-invalid');
                }
            }
        });

        const docNumber = ($('#simpleDocumentNumber').val() || "").replace(/[- ]/g, '');
        if (/^[0-9]{13}$/.test(docNumber) && !validateThaiID(docNumber)) {
            $('#simpleDocumentNumber').addClass('is-invalid');
            $('#documentValidationMessage').html('<span class="text-danger"><i class="fas fa-exclamation-circle"></i> เลขบัตรประชาชนไม่ถูกต้อง</span>');
            isValid = false;
            toastr.error('เลขบัตรประชาชนไม่ถูกต้อง');
        }

        const addressFields = ['#simpleHouseNumber', '#simplePostcode', '#simpleProvince', '#simpleDistrict', '#simpleSubdistrict'];
        let addressComplete = true;
        addressFields.forEach(fieldId => {
            if (!$.trim($(fieldId).val())) {
                $(fieldId).addClass('is-invalid');
                addressComplete = false;
            } else {
                $(fieldId).removeClass('is-invalid');
            }
        });

        if (!addressComplete) {
            toastr.error('กรุณากรอกข้อมูลที่อยู่ตามบัตรให้ครบถ้วน');
            isValid = false;
        }

        ['#simpleBirthDay', '#simpleBirthMonth', '#simpleBirthYear'].forEach(sel => {
            if (!$(sel).val()) $(sel).addClass('is-invalid');
            else $(sel).removeClass('is-invalid');
        });

        const sBirthDay = $('#simpleBirthDay').val();
        const sBirthMonth = $('#simpleBirthMonth').val();
        const sBirthYear = $('#simpleBirthYear').val();

