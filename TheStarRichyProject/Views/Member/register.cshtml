        $('#simpleDocumentNumber, #fullDocumentNumber').on('input', function() {
            // โค้ดด้านในเหมือนเดิมทุกอย่างครับ
            // เปลี่ยนแค่ตอนอ้างอิงไอดี error message ให้เช็คว่ากำลังพิมพ์ช่องไหนอยู่

            const isSimple = $(this).attr('id') === 'simpleDocumentNumber';
            const errorTarget = isSimple ? '#documentValidationMessage' : '#fullDocumentValidationMessage';
            const countryVal = isSimple ? $('#simpleCountry').val() : $('#fullCountry').val();

            if (countryVal === '66') {
                let docNumber = $(this).val().replace(/[^0-9]/g, '');

                if (docNumber.length > 13) docNumber = docNumber.substring(0, 13);
                $(this).val(docNumber);

                $(this).removeClass('is-invalid is-valid');
                $(errorTarget).html('');
                $(this).next('.invalid-feedback-custom').remove(); // เผื่อของฟอร์มเต็มที่ Generate ขึ้นมา

                if (!docNumber) return;

                if (docNumber.length < 13 || (docNumber.length === 13 && !validateThaiID(docNumber))) {
                    $(this).addClass('is-invalid');
                    $(errorTarget).html('<span class="text-danger"><i class="fas fa-exclamation-circle"></i> เลขบัตรประชาชนไม่ถูกต้อง</span>');
                }
                else if (docNumber.length === 13 && validateThaiID(docNumber)) {
