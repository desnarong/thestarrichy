                                                </div>
                                                <div class="col-6 col-md-4">
                                                    <label class="form-label">ถนน</label>
                                                    <input type="text" class="form-control" id="simpleRoad" placeholder="ชื่อถนน" />
                                                </div>
                                                <div class="col-8 col-md-5">
                                                    <label class="form-label">อาคาร / หมู่บ้าน</label>
                                                    <input type="text" class="form-control" id="simpleBuilding" placeholder="ชื่ออาคาร" />
                                                </div>
                                                <div class="col-4 col-md-2">
                                                    <label class="form-label">ชั้น</label>
                                                    <input type="text" class="form-control" id="simpleFloor" placeholder="ชั้น" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required">รหัสไปรษณีย์ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <input type="text" class="form-control" id="simplePostcode" maxlength="5" placeholder="กรอกรหัสไปรษณีย์ 5 หลัก" required />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required">จังหวัด <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select class="form-control" id="simpleProvince" required disabled>
                                                        <option value="">-- รอผลจากรหัสไปรษณีย์ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required">เขต/อำเภอ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select class="form-control" id="simpleDistrict" required disabled>
                                                        <option value="">-- เลือกอำเภอ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required">แขวง/ตำบล <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select class="form-control" id="simpleSubdistrict" required disabled>
                                                        <option value="">-- เลือกตำบล --</option>
                                                    </select>
                                                    <input type="hidden" id="simpleTambonId" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="d-flex flex-column flex-md-row justify-content-end gap-3">
                                        <a href="/" class="btn btn-outline-secondary w-100 w-md-auto" style="align-content: center;">
                                            <i class="fas fa-home me-2"></i>กลับหน้าแรก
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary w-100 w-md-auto" id="btnResetSimple">
                                            <i class="fas fa-redo me-2"></i>ล้างข้อมูล
                                        </button>
                                        <button type="submit" class="btn btn-primary btn-lg w-100 w-md-auto" id="btnSubmitSimple">
                                            <i class="fas fa-user-plus me-2"></i>ลงทะเบียนทันที
                                        </button>
