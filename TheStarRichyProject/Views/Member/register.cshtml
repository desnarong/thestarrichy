                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="full-tab-pane" role="tabpanel" aria-labelledby="full-tab" tabindex="0">
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>ลงทะเบียนแบบเต็ม:</strong> กรอกข้อมูลทั้งหมดครบถ้วนสำหรับสมาชิกที่ต้องการบันทึกข้อมูลทั้งหมดในครั้งเดียว
                        </div>

                        <form id="fullRegistrationForm" method="post" novalidate>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="card">
                                        <div class="card-header bg-light">
                                            <h5 data-key="t-general-information">ข้อมูลทั่วไป</h5>
                                        </div>
                                        <div class="card-block p-3">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label" data-key="t-country">ประเทศ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select id="fullCountry" name="country" class="form-control" required>
                                                        <option value="">-- เลือก --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label" data-key="t-countries-conducting-business">ประเทศที่ดำเนินธุรกิจ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select id="fullCountryBusiness" name="business_country" class="form-control" required>
                                                        <option value="">-- เลือก --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label" data-key="t-referrer-code">รหัสผู้แนะนำ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <div class="input-group">
                                                        <input type="text" id="fullReferrerCode" class="form-control" placeholder="กรอกรหัสผู้แนะนำ" value="@userinfo.membercode" required />
                                                        <button type="button" class="btn btn-primary" data-key="t-search" id="btnFullSearchReferrer">
                                                            <i class="fas fa-search"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label"><span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="referrer_side" id="referrer_left" checked required />
                                                        <label class="form-check-label" for="referrer_left" data-key="t-referrer-left">ด้านซ้าย</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="referrer_side" id="referrer_right" required />
                                                        <label class="form-check-label" for="referrer_right" data-key="t-referrer-right">ด้านขวา</label>
                                                    </div>
