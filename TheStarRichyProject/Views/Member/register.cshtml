    // ✅ ปรับแก้ฟังก์ชัน Preview รูปให้ใช้ FileReader รองรับ Vivo เสถียร 100%
    function handleImagePreview(inputSelector, previewSelector) {
        $(inputSelector).off('change').on('change', function () {
            const file = this.files && this.files[0];
            const preview = $(previewSelector);

            if (!file) {
                preview.hide().attr('src', '');
                return;
            }

            if (!file.type.startsWith('image/')) {
                toastr.error('รองรับเฉพาะไฟล์รูปเท่านั้น (jpg, png, gif)');
                $(this).val('');
                preview.hide().attr('src', '');
                return;
            }

            const maxBytes = 5 * 1024 * 1024; // 5MB
            if (file.size > maxBytes) {
                toastr.error('ขนาดไฟล์ต้องไม่เกิน 5MB');
                $(this).val('');
                preview.hide().attr('src', '');
                return;
            }

            // บีบอัดหน่วยความจำระดับเบราเซอร์และเขียนสตรีม Base64 ลงตรงๆ ทันที
            const reader = new FileReader();
            reader.onload = function (e) {
                preview.attr('src', e.target.result);
                // หน่วงเวลาเล็กน้อยเพื่อให้ระบบ WebView ของแอนดรอยด์จัดสรรขนาด Layout กางออกทัน
                setTimeout(() => {
                    preview.show();
                }, 50);
            };
            reader.onerror = function() {
                toastr.error('ไม่สามารถอ่านไฟล์รูปภาพได้');
                preview.hide().attr('src', '');
            };
            reader.readAsDataURL(file);
        });
    }

    // Initialize image preview handlers
    handleImagePreview('#simpleIdCardCopy', '#simpleIdCardPreview');
    handleImagePreview('#simpleBankCardCopy', '#simpleBankCardPreview');
    handleImagePreview('#simpleBusinessPhoto', '#simpleBusinessPhotoPreview');

    handleImagePreview('#fullIdCardCopy', '#fullIdCardPreview');
    handleImagePreview('#fullBankCardCopy', '#fullBankCardPreview');
    handleImagePreview('#fullBusinessPhoto', '#fullBusinessPhotoPreview');
    handleImagePreview('#fullApplicationForm', '#fullApplicationFormPreview');

