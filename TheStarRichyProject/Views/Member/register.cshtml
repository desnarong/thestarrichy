@using TheStarRichyProject.Helper
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "สมาชิก";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cookieValue = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.UserInfoKey);
    var userinfo = JsonConvert.DeserializeObject<dynamic>(cookieValue)["memberInfo"][0];
}

<style>
    /* Full registration — improved spacing and sticky action bar */
    .full-card .card-body { padding: 1.25rem; }
    .full-card .form-group .form-control { padding: .65rem .75rem; }

    .full-action-bar {
        position: sticky;
        bottom: 0;
        background: #ffffff;
        padding: .75rem 1rem;
        box-shadow: 0 -6px 18px rgba(2,6,23,0.06);
        border-top: 1px solid #eef2f6;
        z-index: 1050;
    }

    .full-action-bar .btn { min-width: 140px; }

    /* Make the action bar slightly transparent on small screens to avoid covering inputs */
    @@media (max-width: 576px) {
        .full-action-bar { padding: .5rem; }
        .full-action-bar .btn { min-width: 120px; }
    }
</style>

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-member-register">ลงทะเบียนสมาชิก</h4>
                <p class="text-muted mb-0">เลือกประเภทการลงทะเบียนที่ต้องการ</p>
            </div>
            <div class="card-block p-3">
                <!-- Registration Type Tabs -->
                <ul class="nav nav-tabs mb-4" id="registrationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="simple-tab" data-bs-toggle="tab" data-bs-target="#simple-tab-pane" type="button" role="tab" aria-controls="simple-tab-pane" aria-selected="true">
                            <i class="fas fa-bolt me-2"></i>ลงทะเบียนแบบง่าย
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="full-tab" data-bs-toggle="tab" data-bs-target="#full-tab-pane" type="button" role="tab" aria-controls="full-tab-pane" aria-selected="false">
                            <i class="fas fa-file-alt me-2"></i>ลงทะเบียนแบบเต็ม
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="registrationTabsContent">
                    <!-- Simple Registration Tab -->
                    <div class="tab-pane fade show active" id="simple-tab-pane" role="tabpanel" aria-labelledby="simple-tab" tabindex="0">
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>ลงทะเบียนแบบง่าย:</strong> กรอกข้อมูลพื้นฐานที่จำเป็นเท่านั้น สามารถกรอกข้อมูลเพิ่มเติมได้ภายหลัง
                        </div>

                        <form id="simpleRegistrationForm" method="post" novalidate>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0">ข้อมูลพื้นฐาน</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ประเทศ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <select name="country" id="simpleCountry" class="form-control" required>
                                                        <option value="">-- เลือกประเทศ --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ประเทศที่ดำเนินธุรกิจ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <select name="countryBusiness" id="simpleCountryBusiness" class="form-control" required>
                                                        <option value="">-- เลือกประเทศที่ดำเนินธุรกิจ --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">รหัสผู้แนะนำ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="simpleReferrerCode" value="@userinfo.membercode" placeholder="กรอกรหัสผู้แนะนำ" required />
                                                        <button type="button" class="btn btn-primary" id="btnSearchReferrer">ค้นหา</button>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ตำแหน่ง <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="position" id="positionLeft" value="left" checked />
                                                        <label class="form-check-label" for="positionLeft">ซ้ายสุด</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="position" id="positionRight" value="right" />
                                                        <label class="form-check-label" for="positionRight">ขวาสุด</label>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">ชื่อผู้แนะนำ</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleReferrerName" value="@userinfo.idcardname" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly disabled />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">วันที่สมัคร <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleRegistrationDate" readonly required disabled />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">วันเกิด <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="date" class="form-control" id="simpleBirthDate" required />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">คำนำหน้า <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <select name="simpleTitle" id="simpleTitle" class="form-control" required>
                                                        <option value="">-- เลือกคำนำหน้า --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ชื่อบนบัตร <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleFullName" placeholder="กรอกชื่อบนบัตร" required />
                                                    <small class="text-muted mt-1" id="simpleIdCardNameValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">ชื่อธุรกิจ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleBusinessName" placeholder="กรอกชื่อธุรกิจ" required />
                                                    <small class="text-muted mt-1" id="simpleBusinessNameValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">เลขบัตรปชช./พาสปอร์ต <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleDocumentNumber" placeholder="กรอกเลขที่เอกสาร" required />
                                                    <small class="text-muted mt-1" id="documentValidationMessage"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required">โทรศัพท์มือถือ <span class="text-danger">*</span></label>
                                                <div class="col-md-8">
                                                    <input type="tel" class="form-control" id="simpleMobile" placeholder="กรอกเบอร์โทรศัพท์มือถือ" required />
                                                    <small class="text-muted mt-1" id="mobileValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">โทรศัพท์บ้าน</label>
                                                <div class="col-md-8">
                                                    <input type="tel" class="form-control" id="simpleHomePhone" placeholder="กรอกเบอร์โทรศัพท์บ้าน" />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">อีเมล</label>
                                                <div class="col-md-8">
                                                    <input type="email" class="form-control" id="simpleEmail" placeholder="กรอกอีเมล" />
                                                    <small class="text-muted mt-1" id="emailValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">Line ID</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleLineId" placeholder="กรอก Line ID" />
                                                    <small class="text-muted mt-1" id="lineIdValidation"></small>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0">อัปโหลดเอกสาร <small class="text-muted">(ไม่บังคับ)</small></h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-12 mb-3">
                                                    <label class="form-label">สำเนาบัตรประชาชน/พาสปอร์ต</label>
                                                    <input type="file" class="form-control" id="simpleIdCardCopy" accept="image/*" />
                                                    <img id="simpleIdCardPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview ID card" />
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <label class="form-label">สำเนาหน้าสมุดบัญชีธนาคาร</label>
                                                    <input type="file" class="form-control" id="simpleBankCardCopy" accept="image/*" />
                                                    <img id="simpleBankCardPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview bank book" />
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <label class="form-label">รูปถ่ายนักธุรกิจ</label>
                                                    <input type="file" class="form-control" id="simpleBusinessPhoto" accept="image/*" />
                                                    <img id="simpleBusinessPhotoPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview business photo" />
                                                </div>
                                            </div>
                                            <div class="alert alert-info py-2">
                                                <i class="fas fa-info-circle me-2"></i> รองรับไฟล์ JPG, PNG ขนาดไม่เกิน 5MB
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0">ข้อมูลที่อยู่ <small class="text-muted">(สำหรับการจัดส่ง)</small></h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">ที่อยู่ตามบัตรฯ</label>
                                                <div class="col-md-8">
                                                    <textarea class="form-control" rows="3" id="simpleAddressIdCard" placeholder="บ้านเลขที่, หมู่, ถนน"></textarea>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">รหัสไปรษณีย์</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simplePostcode" maxlength="5" placeholder="กรอกรหัสไปรษณีย์ 5 หลัก" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">จังหวัด</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleProvince" disabled>
                                                        <option value="">-- รอผลจากรหัสไปรษณีย์ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">เขต/อำเภอ</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleDistrict" disabled>
                                                        <option value="">-- เลือกอำเภอ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label">แขวง/ตำบล</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleSubdistrict" disabled>
                                                        <option value="">-- เลือกตำบล --</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="d-flex flex-column flex-md-row justify-content-end gap-3">
                                        <a href="/" class="btn btn-outline-secondary w-100 w-md-auto"style="align-content: center;">
                                            <i class="fas fa-home me-2"></i>กลับหน้าแรก
                                        </a>
                                        <button type="button" class="btn btn-outline-secondary w-100 w-md-auto" id="btnResetSimple">
                                            <i class="fas fa-redo me-2"></i>ล้างข้อมูล
                                        </button>
                                        <button type="submit" class="btn btn-primary btn-lg w-100 w-md-auto" id="btnSubmitSimple">
                                            <i class="fas fa-user-plus me-2"></i>ลงทะเบียนทันที
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Full Registration Tab -->
                    <div class="tab-pane fade" id="full-tab-pane" role="tabpanel" aria-labelledby="full-tab" tabindex="0">
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>ลงทะเบียนแบบเต็ม:</strong> กรอกข้อมูลทั้งหมดครบถ้วนสำหรับสมาชิกที่ต้องการบันทึกข้อมูลทั้งหมดในครั้งเดียว
                        </div>
                        
                        <form id="fullRegistrationForm" method="post" novalidate>
                            <!-- Mobile-Friendly Action Buttons -->
                            <div class="row mb-2">
                                <div class="col-12">
                                    <div class="text-center text-md-start">
                                        <label class="col-form-label text-danger mb-0" data-key="t-member-register-warn">
                                            <i class="fas fa-exclamation-triangle me-2"></i>คำเตือนการลงทะเบียนสมาชิก
                                        </label>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <!-- Left Column - General Information -->
                                <div class="col-12 col-lg-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 data-key="t-general-information">ข้อมูลทั่วไป</h5>
                                        </div>
                                        <div class="card-block p-3">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-country">ประเทศ</label>
                                                <div class="col-md-8">
                                                    <select id="fullCountry" name="country" class="form-control">
                                                        <option value="">-- เลือก --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-countries-conducting-business">ประเทศที่ดำเนินธุรกิจ</label>
                                                <div class="col-md-8">
                                                    <select id="fullCountryBusiness" name="business_country" class="form-control">
                                                        <option value="">-- เลือก --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-referrer-code">รหัสผู้แนะนำ</label>
                                                <div class="col-md-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" placeholder="กรอกรหัสผู้แนะนำ" value="@userinfo.membercode" />
                                                        <button type="button" class="btn btn-primary" data-key="t-search">
                                                            <i class="fas fa-search"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label"></label>
                                                <div class="col-md-8">
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="referrer_side" id="referrer_left" checked />
                                                        <label class="form-check-label" for="referrer_left" data-key="t-referrer-left">ด้านซ้าย</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="referrer_side" id="referrer_right" />
                                                        <label class="form-check-label" for="referrer_right" data-key="t-referrer-right">ด้านขวา</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-referrer-name">ชื่อผู้แนะนำ</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" value="@userinfo.idcardname" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly disabled />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-upline-code">รหัสอัพไลน์</label>
                                                <div class="col-md-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" placeholder="กรอกรหัสอัพไลน์" />
                                                        <button type="button" class="btn btn-primary" data-key="t-search">
                                                            <i class="fas fa-search"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-upline-name">ชื่ออัพไลน์</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-upline-side">ด้านอัพไลน์</label>
                                                <div class="col-md-8">
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="upline_side" id="uplineside_left" checked />
                                                        <label class="form-check-label" for="uplineside_left" data-key="t-referrer-left">ด้านซ้าย</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="upline_side" id="uplineside_right" />
                                                        <label class="form-check-label" for="uplineside_right" data-key="t-referrer-right">ด้านขวา</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-types-of-businessmen">ประเภทนักธุรกิจ</label>
                                                <div class="col-md-8">
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="business_type" id="businessman" checked />
                                                        <label class="form-check-label" for="businessman" data-key="t-businessman">นักธุรกิจ</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="business_type" id="user" />
                                                        <label class="form-check-label" for="user" data-key="t-user">ผู้ใช้</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-user-code">รหัสผู้ใช้</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" value="" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-registration-date">วันที่สมัคร</label>
                                                <div class="col-md-8">
                                                    <input type="text" id="fullRegistrationDate" class="form-control" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-title">คำนำหน้า</label>
                                                <div class="col-md-8">
                                                    <select id="fullTitle" name="title" class="form-control">
