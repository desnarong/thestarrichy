@using TheStarRichyProject.Helper
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "สมาชิก";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cookieValue = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.UserInfoKey);
    var userinfo = JsonConvert.DeserializeObject<dynamic>(cookieValue)["memberInfo"][0];
    
    // Get language from cookie (default to 'th' if not set)
    var currentLang = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.LanguageKey) ?? "th";
    
    // Determine year format based on language
    var yearFormat = currentLang == "th" ? "yyyy" : "yyyy"; // bootstrap-datepicker uses Buddhist/S Buddhist/E Christian
    var yearStartOffset = currentLang == "th" ? 543 : 0;
}

<style>
    /* Full registration — improved spacing and sticky action bar */
    .full-card .card-body {
        padding: 1.25rem;
    }

    .full-card .form-group .form-control {
        padding: .65rem .75rem;
    }

    .full-action-bar {
        position: sticky;
        bottom: 0;
        background: #ffffff;
        padding: .75rem 1rem;
        box-shadow: 0 -6px 18px rgba(2,6,23,0.06);
        border-top: 1px solid #eef2f6;
        z-index: 1050;
    }

        .full-action-bar .btn {
            min-width: 140px;
        }

    /* Make the action bar slightly transparent on small screens to avoid covering inputs */
    @@media (max-width: 576px) {
        .full-action-bar {
            padding: .5rem;
        }

            .full-action-bar .btn {
                min-width: 120px;
            }
    }
</style>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
<link href="~/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.standalone.min.css" rel="stylesheet" />
<script src="~/plugins/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-member-register">ลงทะเบียนสมาชิก</h4>
