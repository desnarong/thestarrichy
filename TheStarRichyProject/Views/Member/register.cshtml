@{
    ViewData["Title"] = "สมาชิก";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-member-register">ลงทะเบียนสมาชิก</h4>
                <p class="text-muted mb-0">เลือกประเภทการลงทะเบียนที่ต้องการ</p>
            </div>
            <div class="card-block p-3">
                <!-- Registration Type Tabs -->
                <ul class="nav nav-tabs mb-4" id="registrationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="simple-tab" data-bs-toggle="tab" data-bs-target="#simple-tab-pane" type="button" role="tab" aria-controls="simple-tab-pane" aria-selected="true">
                            <i class="fas fa-bolt me-2"></i>ลงทะเบียนแบบง่าย
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="full-tab" data-bs-toggle="tab" data-bs-target="#full-tab-pane" type="button" role="tab" aria-controls="full-tab-pane" aria-selected="false">
                            <i class="fas fa-file-alt me-2"></i>ลงทะเบียนแบบเต็ม
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="registrationTabsContent">
                    <!-- Simple Registration Tab -->
                    <div class="tab-pane fade show active" id="simple-tab-pane" role="tabpanel" aria-labelledby="simple-tab" tabindex="0">
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong>ลงทะเบียนแบบง่าย:</strong> กรอกข้อมูลพื้นฐานที่จำเป็นเท่านั้น สามารถกรอกข้อมูลเพิ่มเติมได้ภายหลัง
                        </div>
                        
                        <form id="simpleRegistrationForm">
                            <div class="row">
                                <!-- Left Column - Basic Information -->
                                <div class="col-12 col-lg-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 data-key="t-basic-information">ข้อมูลพื้นฐาน</h5>
                                        </div>
                                        <div class="card-block p-3">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-country">ประเทศ</label>
                                                <div class="col-md-8">
                                                    <select name="simpleCountry" class="form-control" required>
                                                        <option value="">-- เลือกประเทศ --</option>
                                                        <option value="thailand" selected>ประเทศไทย</option>
                                                        <option value="laos">สาธารณรัฐประชาธิปไตยประชาชนลาว</option>
                                                        <option value="cambodia">ราชอาณาจักรกัมพูชา</option>
                                                        <option value="myanmar">สาธารณรัฐแห่งสหภาพเมียนมา</option>
                                                        <option value="vietnam">สาธารณรัฐสังคมนิยมเวียดนาม</option>
                                                        <option value="other">อื่นๆ</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-document-type">ประเภทเอกสาร</label>
                                                <div class="col-md-8">
                                                    <select name="simpleDocumentType" class="form-control" required id="simpleDocumentType">
                                                        <option value="">-- เลือกประเภทเอกสาร --</option>
                                                        <option value="citizen" selected>บัตรประชาชน</option>
                                                        <option value="passport">พาสปอร์ต</option>
                                                        <option value="alien">บัตรต่างด้าว</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-document-number">เลขที่เอกสาร</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleDocumentNumber" placeholder="กรอกเลขที่เอกสาร" required />
                                                    <small class="text-muted mt-1" id="documentValidationMessage"></small>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-referrer-code">รหัสผู้อ้างอิง</label>
                                                <div class="col-md-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="simpleReferrerCode" placeholder="กรอกรหัสผู้อ้างอิง" required />
                                                        <button type="button" class="btn btn-primary" id="btnSearchReferrer" data-key="t-search">
                                                            <i class="fas fa-search"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-referrer-name">ชื่อผู้อ้างอิง</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleReferrerName" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-title">คำนำหน้า</label>
                                                <div class="col-md-8">
                                                    <select name="simpleTitle" class="form-control" required>
                                                        <option value="">-- เลือกคำนำหน้า --</option>
                                                        <option value="mr">นาย</option>
                                                        <option value="mrs">นาง</option>
                                                        <option value="miss">นางสาว</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-name-on-the-card">ชื่อ-นามสกุล</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleFullName" placeholder="กรอกชื่อ-นามสกุล" required />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-mobile-phone">โทรศัพท์มือถือ</label>
                                                <div class="col-md-8">
                                                    <input type="tel" class="form-control" id="simpleMobile" placeholder="กรอกเบอร์โทรศัพท์มือถือ" required />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-email">อีเมล</label>
                                                <div class="col-md-8">
                                                    <input type="email" class="form-control" id="simpleEmail" placeholder="กรอกอีเมล" required />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-line-id">Line ID</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simpleLineId" placeholder="กรอก Line ID" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label required" data-key="t-identity-verification">ยืนยันตัวตน</label>
                                                <div class="col-md-8">
                                                    <div class="form-check mb-2">
                                                        <input type="radio" class="form-check-input" name="verificationMethod" id="verificationPhone" value="phone" checked />
                                                        <label class="form-check-label" for="verificationPhone" data-key="t-phone-verification">ยืนยันด้วยเบอร์โทรศัพท์</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="verificationMethod" id="verificationEmail" value="email" />
                                                        <label class="form-check-label" for="verificationEmail" data-key="t-email-verification">ยืนยันด้วยอีเมล</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label"></label>
                                                <div class="col-md-8">
                                                    <button type="button" class="btn btn-outline-primary w-100" id="btnSendOTP" data-key="t-send-otp">
                                                        <i class="fas fa-paper-plane me-2"></i>ส่งรหัส OTP
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right Column - Address Information (Optional) -->
                                <div class="col-12 col-lg-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 data-key="t-address-information">ข้อมูลที่อยู่ <small class="text-muted">(ไม่จำเป็นต้องกรอก)</small></h5>
                                        </div>
                                        <div class="card-block p-3">
                                            <div class="alert alert-warning mb-3">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <small>หากกรอกข้อมูลที่อยู่ กรุณากรอกให้ครบถ้วน</small>
                                            </div>
                                            
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-address-on-id-card">ที่อยู่ตามบัตรประชาชน</label>
                                                <div class="col-md-8">
                                                    <textarea class="form-control" rows="3" id="simpleAddressIdCard" placeholder="บ้านเลขที่, หมู่, ถนน, ตำบล/แขวง"></textarea>
                                                </div>
                                            </div>
                                            
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-postcode">รหัสไปรษณีย์</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" id="simplePostcode" maxlength="5" placeholder="กรอกรหัสไปรษณีย์ 5 หลัก" />
                                                </div>
                                            </div>
                                            
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-province">จังหวัด</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleProvince" disabled>
                                                        <option value="">-- รอผลจากรหัสไปรษณีย์ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-district">เขต/อำเภอ</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleDistrict" disabled>
                                                        <option value="">-- เลือกอำเภอ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-subdistrict">แขวง/ตำบล</label>
                                                <div class="col-md-8">
                                                    <select class="form-control" id="simpleSubdistrict" disabled>
                                                        <option value="">-- เลือกตำบล --</option>
                                                    </select>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Mobile-Friendly Action Buttons -->
                            <div class="row mt-4">
                                <div class="col-12">
                                    <div class="d-flex flex-column flex-md-row justify-content-center justify-content-md-end align-items-center gap-3">
                                        <button type="button" class="btn btn-outline-secondary w-100 w-md-auto" id="btnResetSimple" data-key="t-reset">
                                            <i class="fas fa-redo me-2"></i>ล้างข้อมูล
                                        </button>
                                        <button type="submit" class="btn btn-primary btn-lg w-100 w-md-auto" id="btnSubmitSimple" data-key="t-register-now">
                                            <i class="fas fa-user-plus me-2"></i>ลงทะเบียนทันที
                                        </button>
                                        <button type="button" class="btn btn-outline-primary w-100 w-md-auto" id="btnSwitchToFull">
                                            <i class="fas fa-arrow-right me-2"></i>ต้องการกรอกข้อมูลเพิ่มเติม
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Full Registration Tab -->
                    <div class="tab-pane fade" id="full-tab-pane" role="tabpanel" aria-labelledby="full-tab" tabindex="0">
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-exclamation-circle me-2"></i>
                            <strong>ลงทะเบียนแบบเต็ม:</strong> กรอกข้อมูลทั้งหมดครบถ้วนสำหรับสมาชิกที่ต้องการบันทึกข้อมูลทั้งหมดในครั้งเดียว
                        </div>
                        
                        <form id="fullRegistrationForm">
                            <!-- Mobile-Friendly Action Buttons -->
                            <div class="row mb-4">
                                <div class="col-12">
                                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3">
                                        <div class="text-center text-md-start">
                                            <label class="col-form-label text-danger mb-0" data-key="t-member-register-warn">
                                                <i class="fas fa-exclamation-triangle me-2"></i>คำเตือนการลงทะเบียนสมาชิก
                                            </label>
                                        </div>
                                        <div class="d-flex gap-2">
                                            <button type="submit" class="btn btn-primary btn-lg px-4" data-key="t-save">
                                                <i class="fas fa-save me-2"></i>บันทึกข้อมูล
                                            </button>
                                            <button type="button" class="btn btn-outline-danger btn-lg px-4" id="btnCancelFull" data-key="t-cancel">
                                                <i class="fas fa-times me-2"></i>ยกเลิก
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            
                            <div class="row">
                                <!-- Left Column - General Information -->
                                <div class="col-12 col-lg-6">
                                    <div class="card">
                                        <div class="card-header">
                                            <h5 data-key="t-general-information">ข้อมูลทั่วไป</h5>
                                        </div>
                                        <div class="card-block p-3">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-country">ประเทศ</label>
                                                <div class="col-md-8">
                                                    <select name="country" class="form-control">
                                                        <option value="1">ประเทศไทย</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-countries-conducting-business">ประเทศที่ดำเนินธุรกิจ</label>
                                                <div class="col-md-8">
                                                    <select name="business_country" class="form-control">
                                                        <option value="1">ประเทศไทย</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-referrer-code">รหัสผู้อ้างอิง</label>
                                                <div class="col-md-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" placeholder="กรอกรหัสผู้อ้างอิง" />
                                                        <button type="button" class="btn btn-primary" data-key="t-search">
                                                            <i class="fas fa-search"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label"></label>
                                                <div class="col-md-8">
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="referrer_side" id="referrer_left" checked />
                                                        <label class="form-check-label" for="referrer_left" data-key="t-referrer-left">ด้านซ้าย</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="referrer_side" id="referrer_right" />
                                                        <label class="form-check-label" for="referrer_right" data-key="t-referrer-right">ด้านขวา</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-referrer-name">ชื่อผู้อ้างอิง</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-upline-code">รหัสอัพไลน์</label>
                                                <div class="col-md-8">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" placeholder="กรอกรหัสอัพไลน์" />
                                                        <button type="button" class="btn btn-primary" data-key="t-search">
                                                            <i class="fas fa-search"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-upline-name">ชื่ออัพไลน์</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-upline-side">ด้านอัพไลน์</label>
                                                <div class="col-md-8">
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="upline_side" id="uplineside_left" checked />
                                                        <label class="form-check-label" for="uplineside_left" data-key="t-referrer-left">ด้านซ้าย</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="upline_side" id="uplineside_right" />
                                                        <label class="form-check-label" for="uplineside_right" data-key="t-referrer-right">ด้านขวา</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-types-of-businessmen">ประเภทนักธุรกิจ</label>
                                                <div class="col-md-8">
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="business_type" id="businessman" checked />
                                                        <label class="form-check-label" for="businessman" data-key="t-businessman">นักธุรกิจ</label>
                                                    </div>
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="business_type" id="user" />
                                                        <label class="form-check-label" for="user" data-key="t-user">ผู้ใช้</label>
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-user-code">รหัสผู้ใช้</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" value="" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-registration-date">วันที่สมัคร</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" value="01-10-2565" readonly />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-title">คำนำหน้า</label>
                                                <div class="col-md-8">
                                                    <select name="title" class="form-control">
                                                        <option value="1">บริษัท</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-name-on-the-card">ชื่อบนบัตร</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" placeholder="กรอกชื่อบนบัตร" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-business-name">ชื่อธุรกิจ</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" placeholder="กรอกชื่อธุรกิจ" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-date-of-birth">วันเกิด</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" placeholder="วว-ดด-ปปปป" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-citizen-number">เลขบัตรประชาชน/เลขหนังสือเดินทาง</label>
                                                <div class="col-md-8">
                                                    <input type="text" class="form-control" placeholder="กรอกเลขบัตรประชาชนหรือหนังสือเดินทาง" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-4 col-form-label" data-key="t-gender">เพศ</label>
                                                <div class="col-md-8">
                                                    <div class="form-check">
                                                        <input type="radio" class="form-check-input" name="gender" id="male" checked />
