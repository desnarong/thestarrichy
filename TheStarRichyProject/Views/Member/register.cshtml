            // 3. Validate Birth Date (วันเกิด)
            // ==========================================
            ['#fullBirthDay', '#fullBirthMonth', '#fullBirthYear'].forEach(sel => {
                if (!$(sel).val()) $(sel).addClass('is-invalid');
                else $(sel).removeClass('is-invalid');
            });

            const fBirthDay = $('#fullBirthDay').val();
            const fBirthMonth = $('#fullBirthMonth').val();
            const fBirthYear = $('#fullBirthYear').val();

            if (!fBirthDay || !fBirthMonth || !fBirthYear) {
                toastr.error('กรุณาเลือกวันเกิดให้ครบถ้วน');
                isValid = false;
            } else {
                var fYearCE = parseInt(fBirthYear);
                if (currentLang === 'th' && fYearCE > 2500) fYearCE -= 543;
                var fAge = Math.floor((today - new Date(fYearCE, parseInt(fBirthMonth) - 1, parseInt(fBirthDay))) / (365.25 * 24 * 60 * 60 * 1000));
                if (fAge < 18) {
                    $('#fullBirthYear').addClass('is-invalid');
                    toastr.error('อายุต้องมากกว่า 18 ปี จึงสามารถสมัครสมาชิกได้');
                    isValid = false;
