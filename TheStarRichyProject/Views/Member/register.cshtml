@using TheStarRichyProject.Helper
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "สมาชิก";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var cookieValue = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.UserInfoKey);
    var userinfo = JsonConvert.DeserializeObject<dynamic>(cookieValue)["memberInfo"][0];
    
    // Get language from cookie (default to 'th' if not set)
    var currentLang = CookieHelper.GetCookie(HttpContextAccessor, CookieHelper.LanguageKey) ?? "th";
    
    // Determine year format based on language
    var yearFormat = currentLang == "th" ? "yyyy" : "yyyy"; // bootstrap-datepicker uses Buddhist/S Buddhist/E Christian
    var yearStartOffset = currentLang == "th" ? 543 : 0;
}

<style>
    /* Full registration — improved spacing and sticky action bar */
    .full-card .card-body {
        padding: 1.25rem;
    }

    .full-card .form-group .form-control {
        padding: .65rem .75rem;
    }

    .full-action-bar {
        position: sticky;
        bottom: 0;
        background: #ffffff;
        padding: .75rem 1rem;
        box-shadow: 0 -6px 18px rgba(2,6,23,0.06);
        border-top: 1px solid #eef2f6;
        z-index: 1050;
    }

        .full-action-bar .btn {
            min-width: 140px;
        }

    /* Make the action bar slightly transparent on small screens to avoid covering inputs */
    @@media (max-width: 576px) {
        .full-action-bar {
            padding: .5rem;
        }

            .full-action-bar .btn {
                min-width: 120px;
            }
    }

    @@media (min-width: 768px) {
        .full-action-bar .btn {
            min-width: 140px; /* ปรับตัวเลขนี้ตามความเหมาะสม */
            justify-content: center;
        }
    }
</style>
<link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.min.css" rel="stylesheet" />
<link href="~/plugins/bootstrap-datepicker/css/bootstrap-datepicker3.standalone.min.css" rel="stylesheet" />
<script src="~/plugins/bootstrap-datepicker/js/bootstrap-datepicker.min.js"></script>

<div class="row">
    <div class="col-md-12 col-lg-12">
        <div class="card">
            <div class="card-header">
                <h4 data-key="t-member-register">ลงทะเบียนสมาชิก</h4>
                <p class="text-muted mb-0">เลือกประเภทการลงทะเบียนที่ต้องการ</p>
            </div>
            <div class="card-block p-3">
                <ul class="nav nav-tabs mb-4" id="registrationTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="simple-tab" data-bs-toggle="tab" data-bs-target="#simple-tab-pane" type="button" role="tab" aria-controls="simple-tab-pane" aria-selected="true">
                            <i class="fas fa-bolt me-2"></i><span data-key="t-simple-registration">ลงทะเบียนแบบง่าย</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="full-tab" data-bs-toggle="tab" data-bs-target="#full-tab-pane" type="button" role="tab" aria-controls="full-tab-pane" aria-selected="false">
                            <i class="fas fa-file-alt me-2"></i><span data-key="t-full-registration">ลงทะเบียนแบบเต็ม</span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="registrationTabsContent">
                    <div class="tab-pane fade show active" id="simple-tab-pane" role="tabpanel" aria-labelledby="simple-tab" tabindex="0">
                        <div class="alert alert-info mb-4">
                            <i class="fas fa-info-circle me-2"></i>
                            <strong data-key="t-simple-registration-desc"><strong>ลงทะเบียนแบบง่าย:</strong> กรอกข้อมูลพื้นฐานที่จำเป็นเท่านั้น สามารถกรอกข้อมูลเพิ่มเติมได้ภายหลัง</strong>
                        </div>

                        <form id="simpleRegistrationForm" method="post" novalidate>
                            <div class="row">
                                <div class="col-12 col-lg-6">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0" data-key="t-basic-information">ข้อมูลพื้นฐาน</h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-country">ประเทศ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select name="country" id="simpleCountry" class="form-control" required>
                                                        <option value="" data-key="t-select-country">-- เลือกประเทศ --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-country-business">ประเทศที่ดำเนินธุรกิจ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select name="countryBusiness" id="simpleCountryBusiness" class="form-control" required>
                                                        <option value="" data-key="t-select-country-business">-- เลือกประเทศที่ดำเนินธุรกิจ --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-referrer-code">รหัสผู้แนะนำ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <div class="input-group">
                                                        <input type="text" class="form-control" id="simpleReferrerCode" value="@userinfo.membercode" placeholder="กรอกรหัสผู้แนะนำ" required />
                                                        <button type="button" class="btn btn-primary" id="btnSearchReferrer"><i class="fas fa-search me-2"></i><span data-key="t-search">ค้นหา</span></button>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-position">ตำแหน่ง <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="position" id="positionLeft" value="left" checked />
                                                        <label class="form-check-label" for="positionLeft" data-key="t-left">ซ้ายสุด</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input type="radio" class="form-check-input" name="position" id="positionRight" value="right" />
                                                        <label class="form-check-label" for="positionRight" data-key="t-right">ขวาสุด</label>
                                                    </div>
                                                </div> 
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label" data-key="t-referrer-name">ชื่อผู้แนะนำ</label>
                                                <div class="col-md-7">
                                                    <input type="text" class="form-control" id="simpleReferrerName" value="@userinfo.bussinessName" placeholder="ชื่อจะแสดงที่นี่หลังจากค้นหา" readonly disabled />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-registration-date">วันที่สมัคร <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <div class="d-flex gap-2">
                                                        <select class="form-control" id="simpleRegDay" required style="width: 70px;" disabled>
                                                            <option value="" data-key="t-day">วัน</option>
                                                        </select>
                                                        <select class="form-control" id="simpleRegMonth" required style="width: 110px;" disabled>
                                                            <option value="" data-key="t-month">เดือน</option>
                                                            <option value="1" data-key="t-january">มกราคม</option>
                                                            <option value="2" data-key="t-february">กุมภาพันธ์</option>
                                                            <option value="3" data-key="t-march">มีนาคม</option>
                                                            <option value="4" data-key="t-april">เมษายน</option>
                                                            <option value="5" data-key="t-may">พฤษภาคม</option>
                                                            <option value="6" data-key="t-june">มิถุนายน</option>
                                                            <option value="7" data-key="t-july">กรกฎาคม</option>
                                                            <option value="8" data-key="t-august">สิงหาคม</option>
                                                            <option value="9" data-key="t-september">กันยายน</option>
                                                            <option value="10" data-key="t-october">ตุลาคม</option>
                                                            <option value="11" data-key="t-november">พฤศจิกายน</option>
                                                            <option value="12" data-key="t-december">ธันวาคม</option>
                                                        </select>
                                                        <select class="form-control" id="simpleRegYear" required style="width: 100px;" disabled>
                                                            <option value="" data-key="t-year">ปี</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-date-of-birth">วันเกิด <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <div class="d-flex gap-2">
                                                        <select class="form-control" id="simpleBirthDay" required style="width: 70px;">
                                                            <option value="" data-key="t-day">วัน</option>
                                                        </select>
                                                        <select class="form-control" id="simpleBirthMonth" required style="width: 110px;">
                                                            <option value="" data-key="t-month">เดือน</option>
                                                            <option value="1" data-key="t-january">มกราคม</option>
                                                            <option value="2" data-key="t-february">กุมภาพันธ์</option>
                                                            <option value="3" data-key="t-march">มีนาคม</option>
                                                            <option value="4" data-key="t-april">เมษายน</option>
                                                            <option value="5" data-key="t-may">พฤษภาคม</option>
                                                            <option value="6" data-key="t-june">มิถุนายน</option>
                                                            <option value="7" data-key="t-july">กรกฎาคม</option>
                                                            <option value="8" data-key="t-august">สิงหาคม</option>
                                                            <option value="9" data-key="t-september">กันยายน</option>
                                                            <option value="10" data-key="t-october">ตุลาคม</option>
                                                            <option value="11" data-key="t-november">พฤศจิกายน</option>
                                                            <option value="12" data-key="t-december">ธันวาคม</option>
                                                        </select>
                                                        <select class="form-control" id="simpleBirthYear" required style="width: 100px;">
                                                            <option value="" data-key="t-year">ปี</option>
                                                        </select>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-title">คำนำหน้า <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select name="simpleTitle" id="simpleTitle" class="form-control" required>
                                                        <option value="" data-key="t-select-title">-- เลือกคำนำหน้า --</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-name-on-card">ชื่อบนบัตร <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <input type="text" class="form-control" id="simpleFullName" placeholder="กรอกชื่อบนบัตร" required />
                                                    <small class="text-muted mt-1" id="simpleIdCardNameValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-business-name">ชื่อธุรกิจ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <input type="text" class="form-control" id="simpleBusinessName" placeholder="กรอกชื่อธุรกิจ" required />
                                                    <small class="text-muted mt-1" id="simpleBusinessNameValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-id-card-passport">เลขบัตรปชช./พาสปอร์ต <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <input type="text" class="form-control" id="simpleDocumentNumber" placeholder="กรอกเลขที่เอกสาร" required />
                                                    <small class="text-muted mt-1" id="documentValidationMessage"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-mobile-phone">โทรศัพท์มือถือ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <input type="tel" class="form-control" id="simpleMobile" placeholder="กรอกเบอร์โทรศัพท์มือถือ" required />
                                                    <small class="text-muted mt-1" id="mobileValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label" data-key="t-home-phone">โทรศัพท์บ้าน</label>
                                                <div class="col-md-7">
                                                    <input type="tel" class="form-control" id="simpleHomePhone" placeholder="กรอกเบอร์โทรศัพท์บ้าน" />
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label" data-key="t-email">อีเมล</label>
                                                <div class="col-md-7">
                                                    <input type="email" class="form-control" id="simpleEmail" placeholder="กรอกอีเมล" />
                                                    <small class="text-muted mt-1" id="emailValidation"></small>
                                                </div>
                                            </div>

                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label" data-key="t-line-id">Line ID</label>
                                                <div class="col-md-7">
                                                    <input type="text" class="form-control" id="simpleLineId" placeholder="กรอก Line ID" />
                                                    <small class="text-muted mt-1" id="lineIdValidation"></small>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0" data-key="t-upload-documents">อัปโหลดเอกสาร <small class="text-muted">(ไม่บังคับ)</small></h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-12 mb-3">
                                                    <label class="form-label" data-key="t-copy-of-id-card-passport">สำเนาบัตรประชาชน/พาสปอร์ต</label>
                                                    <input type="file" class="form-control" id="simpleIdCardCopy" accept="image/*" />
                                                    <img id="simpleIdCardPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview ID card" />
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <label class="form-label" data-key="t-copy-of-bank-book">สำเนาหน้าสมุดบัญชีธนาคาร</label>
                                                    <input type="file" class="form-control" id="simpleBankCardCopy" accept="image/*" />
                                                    <img id="simpleBankCardPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview bank book" />
                                                </div>
                                                <div class="col-12 mb-3">
                                                    <label class="form-label" data-key="t-business-photo">รูปถ่ายนักธุรกิจ</label>
                                                    <input type="file" class="form-control" id="simpleBusinessPhoto" accept="image/*" />
                                                    <img id="simpleBusinessPhotoPreview" class="img-fluid mt-2" style="max-height:150px;display:none;object-fit:contain;border:1px solid #e9ecef;padding:4px;border-radius:4px;" alt="Preview business photo" />
                                                </div>
                                            </div>
                                            <div class="alert alert-info py-2">
                                                <i class="fas fa-info-circle me-2"></i> รองรับไฟล์ JPG, PNG ขนาดไม่เกิน 5MB
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card border-0 shadow-sm">
                                        <div class="card-header bg-light">
                                            <h5 class="mb-0" data-key="t-address-information-for-shipping">ข้อมูลที่อยู่ <small class="text-muted">(สำหรับการจัดส่ง)</small></h5>
                                        </div>
                                        <div class="card-body">
                                            <div class="row g-2 mb-3">
                                                <div class="col-8 col-md-5">
                                                    <label class="form-label" data-key="t-house-number">บ้านเลขที่ <span class="text-danger">*</span></label>
                                                    <input type="text" class="form-control" id="simpleHouseNumber" placeholder="เช่น 123/4" required />
                                                </div>
                                                <div class="col-4 col-md-2">
                                                    <label class="form-label" data-key="t-moo">หมู่ที่</label>
                                                    <input type="text" class="form-control" id="simpleMoo" placeholder="หมู่" />
                                                </div>
                                                <div class="col-6 col-md-5">
                                                    <label class="form-label" data-key="t-alley">ซอย / ตรอก</label>
                                                    <input type="text" class="form-control" id="simpleAlley" placeholder="ชื่อซอย" />
                                                </div>
                                                <div class="col-6 col-md-4">
                                                    <label class="form-label" data-key="t-road">ถนน</label>
                                                    <input type="text" class="form-control" id="simpleRoad" placeholder="ชื่อถนน" />
                                                </div>
                                                <div class="col-8 col-md-5">
                                                    <label class="form-label" data-key="t-building">อาคาร / หมู่บ้าน</label>
                                                    <input type="text" class="form-control" id="simpleBuilding" placeholder="ชื่ออาคาร" />
                                                </div>
                                                <div class="col-4 col-md-2">
                                                    <label class="form-label" data-key="t-floor">ชั้น</label>
                                                    <input type="text" class="form-control" id="simpleFloor" placeholder="ชั้น" />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-postcode">รหัสไปรษณีย์ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <input type="text" class="form-control" id="simplePostcode" maxlength="5" placeholder="กรอกรหัสไปรษณีย์ 5 หลัก" required />
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-province">จังหวัด <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select class="form-control" id="simpleProvince" required disabled>
                                                        <option value="" data-key="t-waiting-postcode">-- รอผลจากรหัสไปรษณีย์ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-district">เขต/อำเภอ <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select class="form-control" id="simpleDistrict" required disabled>
                                                        <option value="" data-key="t-select-district">-- เลือกอำเภอ --</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="form-group row mb-3">
                                                <label class="col-md-5 col-form-label required" data-key="t-subdistrict">แขวง/ตำบล <span class="text-danger">*</span></label>
                                                <div class="col-md-7">
                                                    <select class="form-control" id="simpleSubdistrict" required disabled>
                                                        <option value="" data-key="t-select-subdistrict">-- เลือกตำบล --</option>
                                                    </select>
                                                    <input type="hidden" id="simpleTambonId" />
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="full-action-bar d-print-none py-3">
                                <div class="container-fluid">
                                    <!-- ใช้ row เพื่อควบคุม Grid -->
                                    <div class="row g-2 justify-content-md-end">
            
                                        <!-- ปุ่มที่ 1: ลงทะเบียน (เต็มแถวบนมือถือ col-12, ขนาดปกติในคอม col-md-auto) -->
                                        <div class="col-12 col-md-auto order-md-3">
                                            <button type="button" id="btnSubmitSimple" class="btn btn-primary btn-lg w-100" style="min-width: 140px;" onclick="$('#simpleRegistrationForm').submit();">
                                                <i class="fas fa-save me-2"></i><span>ลงทะเบียน</span>
                                            </button>
                                        </div>

                                        <!-- ปุ่มที่ 2: ยกเลิก (ครึ่งแถวบนมือถือ col-6, ขนาดปกติในคอม col-md-auto) -->
                                        <div class="col-6 col-md-auto order-md-2">
                                            <button type="button" id="btnResetSimple" class="btn btn-outline-danger btn-lg w-100" style="min-width: 140px;">
                                                <i class="fas fa-times me-2"></i><span>ยกเลิก</span>
                                            </button>
                                        </div>

                                        <!-- ปุ่มที่ 3: กลับหน้าหลัก (ครึ่งแถวบนมือถือ col-6, ขนาดปกติในคอม col-md-auto) -->
                                        <div class="col-6 col-md-auto order-md-1">
                                            <a href="/Home/Index" class="btn btn-outline-secondary btn-lg w-100" style="min-width: 140px;">
                                                <i class="fas fa-home me-2"></i><span>กลับหน้าหลัก</span>
                                            </a>
                                        </div>

                                    </div>
