        // Simple form submission
        $('#simpleRegistrationForm').submit(async function (e) {
            e.preventDefault();

            let isValid = true;

            // ==========================================
            // 1. Basic validation (ค้นหาตัวที่บังคับกรอก)
            // ==========================================
            const requiredFields = $(this).find('input[required], select[required], textarea[required]');

            requiredFields.each(function () {
                const field = $(this);

                if (field.is(':radio') || field.is(':checkbox')) {
                    const name = field.attr('name');
                    if ($('input[name="' + name + '"]:checked').length === 0) {
                        $('input[name="' + name + '"]').addClass('is-invalid');
                        isValid = false;
                    } else {
                        $('input[name="' + name + '"]').removeClass('is-invalid');
                    }
                }
                else {
                    const val = $.trim(field.val());
                    if (!val) {
                        field.addClass('is-invalid');
                        isValid = false;
                    } else {
                        field.removeClass('is-invalid');
                    }
                }
            });

            // ==========================================
            // 2. Validate Thai ID (บัตร ปชช.)
            // ==========================================
            // แก้ไข: ใช้ || "" ป้องกัน error
            const docNumber = ($('#simpleDocumentNumber').val() || "").replace(/[- ]/g, '');
            if (/^[0-9]{13}$/.test(docNumber) && !validateThaiID(docNumber)) {
                $('#simpleDocumentNumber').addClass('is-invalid');
                $('#documentValidationMessage').html('<span class="text-danger"><i class="fas fa-exclamation-circle"></i> เลขบัตรประชาชนไม่ถูกต้อง</span>');
                isValid = false;
                toastr.error('เลขบัตรประชาชนไม่ถูกต้อง');
            }

            // ==========================================
            // 3. Validate Address (บังคับกรอกที่อยู่ตามบัตรให้ครบทุกช่อง)
            // ==========================================
            const addressFields = ['#simpleHouseNumber', '#simplePostcode', '#simpleProvince', '#simpleDistrict', '#simpleSubdistrict'];
            let addressComplete = true;

            addressFields.forEach(fieldId => {
                if (!$.trim($(fieldId).val())) {
                    $(fieldId).addClass('is-invalid');
                    addressComplete = false;
                } else {
                    $(fieldId).removeClass('is-invalid');
                }
            });

            if (!addressComplete) {
                toastr.error('กรุณากรอกข้อมูลที่อยู่ตามบัตรให้ครบถ้วน');
                isValid = false;
            }

            // ==========================================
            // 4. Validate Birth Date (วันเกิด)
            // ==========================================
            ['#simpleBirthDay', '#simpleBirthMonth', '#simpleBirthYear'].forEach(sel => {
                if (!$(sel).val()) $(sel).addClass('is-invalid');
                else $(sel).removeClass('is-invalid');
            });

            const sBirthDay = $('#simpleBirthDay').val();
            const sBirthMonth = $('#simpleBirthMonth').val();
            const sBirthYear = $('#simpleBirthYear').val();

            if (!sBirthDay || !sBirthMonth || !sBirthYear) {
                toastr.error('กรุณาเลือกวันเกิดให้ครบถ้วน');
                isValid = false;
            } else {
                var yearCE = parseInt(sBirthYear);
                if (currentLang === 'th' && yearCE > 2500) yearCE -= 543;
                var sAge = Math.floor((today - new Date(yearCE, parseInt(sBirthMonth) - 1, parseInt(sBirthDay))) / (365.25 * 24 * 60 * 60 * 1000));
                if (sAge < 18) {
                    $('#simpleBirthYear').addClass('is-invalid');
                    toastr.error('อายุต้องมากกว่า 18 ปี จึงสามารถสมัครสมาชิกได้');
                    isValid = false;
                }
            }

            // ==========================================
            // 5. แสดงผลลัพธ์และส่งข้อมูล
            // ==========================================

            // Additional content validation (name/business/mobile/email/lineId)
            if (!validateSimpleFullName()) { isValid = false; }
            if (!validateSimpleBusinessName()) { isValid = false; }
            if (!validateSimpleEmail()) { isValid = false; }
            if (!validateSimpleMobile()) { isValid = false; }
            if (!validateSimpleLineId()) { isValid = false; }

            console.log("ฟอร์มผ่านหรือไม่: ", isValid);

            if (isValid) {
                Swal.fire({ title: 'กำลังตรวจสอบข้อมูล...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });

                // Construct birth date from dropdowns (format: dd-MM-yyyy, CE year)
                var simpleBirthDay = $('#simpleBirthDay').val();
                var simpleBirthMonth = $('#simpleBirthMonth').val();
                var simpleBirthYear = $('#simpleBirthYear').val();
                // ถ้าภาษาไทย year เป็น พ.ศ. → แปลงเป็น ค.ศ. ก่อนส่ง API
                var simpleBirthYearCE = parseInt(simpleBirthYear);
                if (currentLang === 'th' && simpleBirthYearCE > 2400) simpleBirthYearCE -= 543;
                var simpleBirthDateStr = simpleBirthDay && simpleBirthMonth && simpleBirthYear ? String(simpleBirthYearCE) + '-' + 
                String(simpleBirthMonth).padStart(2, '0') + '-' +  String(simpleBirthDay).padStart(2, '0') : '';

                const formData = {
                    country: $('#simpleCountry').val(),
                    countryBusiness: $('#simpleCountryBusiness').val(), // เพิ่ม: ประเทศธุรกิจ
                    documentNumber: ($('#simpleDocumentNumber').val() || "").replace(/[- ]/g, ''),
                    referrerCode: $('#simpleReferrerCode').val(),
                    position: $('input[name="position"]:checked').val(), // เพิ่ม: ตำแหน่งสายงาน
                    title: $('select[name="simpleTitle"]').val(),
                    idCardName: $('#simpleFullName').val(), // เปลี่ยนชื่อจาก fullName เป็น idCardName
                    birthDate: simpleBirthDateStr, // วันเกิดจาก dropdown
                    businessName: $('#simpleBusinessName').val(),
                    mobile: $('#simpleMobile').val(),
                    homePhone: $('#simpleHomePhone').val(), // เพิ่ม: เบอร์บ้าน
                    email: $('#simpleEmail').val(),
                    lineId: $('#simpleLineId').val(),
                    addressIdCard: [$('#simpleHouseNumber').val(), $('#simpleMoo').val() ? 'หมู่ ' + $('#simpleMoo').val() : '', $('#simpleAlley').val() ? 'ซ.' + $('#simpleAlley').val() : '', $('#simpleRoad').val() ? 'ถ.' + $('#simpleRoad').val() : '', $('#simpleBuilding').val(), $('#simpleFloor').val() ? 'ชั้น ' + $('#simpleFloor').val() : ''].filter(Boolean).join(' '),
                    houseNumber: $('#simpleHouseNumber').val(),
                    moo: $('#simpleMoo').val(),
                    alley: $('#simpleAlley').val(),
                    road: $('#simpleRoad').val(),
                    building: $('#simpleBuilding').val(),
                    floor: $('#simpleFloor').val(),
                    postcode: $('#simplePostcode').val(),
                    provinceCode: $('#simpleProvince').val(),
                    districtCode: $('#simpleDistrict').val(),
                    subdistrictCode: $('#simpleSubdistrict').val(),
                    tambonId: parseInt($('#simpleTambonId').val()) || null,
                    ipAddress: clientIpAddress
                };

                try {
                    const checks = [
                        checkDuplicateIDCard(formData.documentNumber),
                        checkDuplicateTelephone(formData.mobile),
                        checkDuplicateEmail(formData.email),
                        checkDuplicateIDCardName(formData.idCardName),
                        checkDuplicateBusinessName(formData.businessName)
                    ];

                    const results = await Promise.all(checks);
                    const failed = results.find(r => r && r.success === false);
                    if (failed) {
                        Swal.fire('ไม่สามารถสมัครได้', failed.message || 'พบข้อมูลซ้ำในระบบ', 'error');
                        return;
                    }

                    // ถ้าผ่านหมด -> ค่อยเรียกส่ง OTP
                    Swal.close();
                    console.log("sample ฟอร์มผ่านการตรวจสอบซ้ำทั้งหมดแล้ว, กำลังไปขั้นตอน OTP");
                    await sendOTPAndShowInput(formData);

                } catch (err) {
                    console.error(err);
                    const errMsg = (err.responseJSON && err.responseJSON.message) || err.responseText || err.message || 'เกิดข้อผิดพลาดในการตรวจสอบข้อมูล';
                    Swal.fire('เกิดข้อผิดพลาด', errMsg, 'error');
                }
            } else {
                // เลื่อนจอไปหาจุดที่ผิดที่แรกให้ User
                const firstError = $('.is-invalid').first();
                if (firstError.length > 0) {
                    $('html, body').animate({ scrollTop: firstError.closest('.form-group').offset().top - 100 }, 500);
                    firstError.focus();
                }
                toastr.error('กรุณากรอกข้อมูลที่จำเป็นให้ครบถ้วน');
            }
        });

        // โบนัส: ซ่อนแจ้งเตือนตอน User เริ่มแก้ข้อผิดพลาด
        $('#simpleRegistrationForm').on('input change', 'input, select, textarea', function() {
            
            const id = $(this).attr('id');
            if (id !== 'simpleDocumentNumber') {
                $('#documentValidationMessage').html('');
                $(this).removeClass('is-invalid');
            }
            if (id === 'simpleFullName') {
                $('#simpleIdCardNameValidation').text('');
            }
            if (id === 'simpleBusinessName') {
