@section scripts{
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
    <script>
        $(document).ready(function () {
            let masterData = [];

            // Load master address data
            loadMasterAddresses();

            // Switch to full registration tab
            $('#btnSwitchToFull').click(function () {
                $('#full-tab').tab('show');
            });

            // Reset simple form
            $('#btnResetSimple').click(function () {
                $('#simpleRegistrationForm')[0].reset();
                $('#simpleReferrerName').val('Star1');
                resetAddressDropdowns();
                $('#simpleCountry').val('thailand');
                $('#simpleDocumentType').val('citizen');
                $('#simpleDocumentNumber').val('3341900571937');
                $('#documentValidationMessage').text('');
            });

            // Search referrer
            $('#btnSearchReferrer').click(function () {
                const referrerCode = $('#simpleReferrerCode').val();
                if (referrerCode) {
                    // Call API to find referrer
                    $.get('/Registration/findreferrer?referrerCode=' + encodeURIComponent(referrerCode))
                        .done(function(response) {
                            if (response.success) {
                                $('#simpleReferrerName').val(response.memberName);
                                toastr.success('พบข้อมูลผู้อ้างอิงแล้ว');
                            } else {
                                $('#simpleReferrerName').val('');
                                toastr.error(response.message || 'ไม่พบข้อมูลผู้อ้างอิง');
                            }
                        })
                        .fail(function() {
                            $('#simpleReferrerName').val('');
                            toastr.error('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
                        });
                } else {
                    toastr.error('กรุณากรอกรหัสผู้อ้างอิง');
                }
            });

            // Document validation
            $('#btnValidateDocument').click(function () {
                const docType = $('#simpleDocumentType').val();
                const docNumber = $('#simpleDocumentNumber').val();
                
                if (!docType || !docNumber) {
                    toastr.error('กรุณาเลือกประเภทเอกสารและกรอกเลขที่เอกสาร');
                    return;
                }

                if (docType === 'citizen') {
                    // Validate Thai ID card (13 digits, valid checksum)
                    if (validateThaiID(docNumber)) {
                        $('#documentValidationMessage').html('<span class="text-success"><i class="fas fa-check-circle"></i> เลขบัตรประชาชนถูกต้อง</span>');
                        toastr.success('เลขบัตรประชาชนถูกต้อง');
                    } else {
                        $('#documentValidationMessage').html('<span class="text-danger"><i class="fas fa-exclamation-circle"></i> เลขบัตรประชาชนไม่ถูกต้อง</span>');
                        toastr.error('เลขบัตรประชาชนไม่ถูกต้อง');
                    }
                } else {
                    $('#documentValidationMessage').html('<span class="text-info"><i class="fas fa-info-circle"></i> ตรวจสอบเอกสารแล้ว</span>');
                    toastr.info('ตรวจสอบเอกสารแล้ว');
                }
            });

            // Document type change
            $('#simpleDocumentType').change(function () {
                const docType = $(this).val();
                $('#documentValidationMessage').text('');
                
                if (docType === 'citizen') {
                    $('#simpleDocumentNumber').attr('placeholder', 'กรอกเลขบัตรประชาชน 13 หลัก');
                } else if (docType === 'passport') {
                    $('#simpleDocumentNumber').attr('placeholder', 'กรอกเลขพาสปอร์ต');
                } else {
                    $('#simpleDocumentNumber').attr('placeholder', 'กรอกเลขบัตรต่างด้าว');
                }
            });

            // Zipcode input for address lookup
            $('#simplePostcode').on('input', function() {
                var selectedZip = $(this).val();
                resetAddressDropdowns();

                if (selectedZip.length === 5) {
                    // Filter data by zipcode
                    var filteredData = masterData.filter(item => item.zipcode === selectedZip);

                    if (filteredData.length > 0) {
                        // Get unique provinces
                        var uniqueProvinces = getUniqueList(filteredData, 'province_code', 'province');

                        // Create province options
                        $('#simpleProvince').empty().append('<option value="">-- เลือกจังหวัด --</option>');
                        $.each(uniqueProvinces, function(index, item) {
                            $('#simpleProvince').append('<option value="' + item.province_code + '">' + item.province + '</option>');
                        });
                        $('#simpleProvince').prop('disabled', false);

                        // Auto select if only one province
                        if (uniqueProvinces.length === 1) {
                            $('#simpleProvince').val(uniqueProvinces[0].province_code).trigger('change');
                        }
                    }
                }
            });

            // Province change
            $('#simpleProvince').change(function() {
                var selectedZip = $('#simplePostcode').val();
                var selectedProvCode = $(this).val();

                resetDropdown('#simpleDistrict', '-- เลือกอำเภอ --');
                resetDropdown('#simpleSubdistrict', '-- เลือกตำบล --');

                if (selectedProvCode) {
                    var filteredData = masterData.filter(item =>
                        item.zipcode === selectedZip &&
                        item.province_code == selectedProvCode
                    );

                    var uniqueDistricts = getUniqueList(filteredData, 'amphoe_code', 'amphoe');

                    $.each(uniqueDistricts, function(index, item) {
                        $('#simpleDistrict').append('<option value="' + item.amphoe_code + '">' + item.amphoe + '</option>');
                    });
                    $('#simpleDistrict').prop('disabled', false);

                    if (uniqueDistricts.length === 1) {
                        $('#simpleDistrict').val(uniqueDistricts[0].amphoe_code).trigger('change');
                    }
                }
            });

            // District change
            $('#simpleDistrict').change(function() {
                var selectedZip = $('#simplePostcode').val();
                var selectedProvCode = $('#simpleProvince').val();
                var selectedDistrictCode = $(this).val();

                resetDropdown('#simpleSubdistrict', '-- เลือกตำบล --');

                if (selectedDistrictCode) {
                    var filteredData = masterData.filter(item =>
                        item.zipcode === selectedZip &&
                        item.province_code == selectedProvCode &&
                        item.amphoe_code == selectedDistrictCode
                    );

                    $.each(filteredData, function(index, item) {
                        $('#simpleSubdistrict').append('<option value="' + item.tambon_code + '">' + item.tambon + '</option>');
                    });
                    $('#simpleSubdistrict').prop('disabled', false);
                }
            });

            // Simple form submission
            $('#simpleRegistrationForm').submit(function (e) {
                e.preventDefault();
                
                // Basic validation
                const requiredFields = $('#simpleRegistrationForm .required');
                let isValid = true;
                
                requiredFields.each(function () {
                    const field = $(this).find('input, select, textarea');
                    if (!field.val()) {
                        field.addClass('is-invalid');
                        isValid = false;
                    } else {
                        field.removeClass('is-invalid');
                    }
                });

                // Validate Thai ID if selected
                const docType = $('#simpleDocumentType').val();
                const docNumber = $('#simpleDocumentNumber').val();
                if (docType === 'citizen' && docNumber && !validateThaiID(docNumber)) {
                    $('#simpleDocumentNumber').addClass('is-invalid');
                    $('#documentValidationMessage').html('<span class="text-danger"><i class="fas fa-exclamation-circle"></i> เลขบัตรประชาชนไม่ถูกต้อง</span>');
                    isValid = false;
                    toastr.error('เลขบัตรประชาชนไม่ถูกต้อง');
                }

                // Validate address completeness if any address field is filled
                const addressFields = ['#simpleAddressIdCard', '#simplePostcode', '#simpleProvince', '#simpleDistrict', '#simpleSubdistrict'];
                let hasAddressData = false;
                let addressComplete = true;
                
                addressFields.forEach(fieldId => {
                    if ($(fieldId).val()) {
                        hasAddressData = true;
                    }
                });

                if (hasAddressData) {
                    addressFields.forEach(fieldId => {
                        if (!$(fieldId).val()) {
                            $(fieldId).addClass('is-invalid');
                            addressComplete = false;
                        } else {
                            $(fieldId).removeClass('is-invalid');
                        }
                    });

                    if (!addressComplete) {
                        toastr.error('หากกรอกข้อมูลที่อยู่ กรุณากรอกให้ครบถ้วน');
                        isValid = false;
                    }
                }

                if (isValid) {
                    toastr.info('กำลังดำเนินการลงทะเบียน...');
                    
                    // Prepare data for API
                    const formData = {
                        country: $('#simpleCountry').val(),
                        documentType: $('#simpleDocumentType').val(),
                        documentNumber: $('#simpleDocumentNumber').val(),
                        referrerCode: $('#simpleReferrerCode').val(),
                        title: $('select[name="simpleTitle"]').val(),
                        fullName: $('#simpleFullName').val(),
                        mobile: $('#simpleMobile').val(),
                        email: $('#simpleEmail').val(),
                        lineId: $('#simpleLineId').val(),
                        addressIdCard: $('#simpleAddressIdCard').val(),
                        postcode: $('#simplePostcode').val(),
                        provinceCode: $('#simpleProvince').val(),
                        districtCode: $('#simpleDistrict').val(),
                        subdistrictCode: $('#simpleSubdistrict').val(),
                        verificationMethod: $('input[name="verificationMethod"]:checked').val()
                    };

                    // Call API
                    $.ajax({
                        url: '/Registration/easyregistration',
                        method: 'POST',
                        contentType: 'application/json',
                        data: JSON.stringify(formData),
                        success: function(response) {
                            if (response.success) {
                                toastr.success(response.message || 'ลงทะเบียนสำเร็จ!');
                                // Show member code
                                if (response.memberCode) {
                                    setTimeout(() => {
                                        alert('รหัสสมาชิก: ' + response.memberCode + '\nชื่อ: ' + response.memberName);
                                        // Redirect or reset form
                                        $('#simpleRegistrationForm')[0].reset();
                                    }, 1000);
                                }
                            } else {
                                toastr.error(response.message || 'เกิดข้อผิดพลาดในการลงทะเบียน');
                            }
                        },
                        error: function(xhr) {
                            const response = xhr.responseJSON;
                            if (response && response.message) {
                                toastr.error(response.message);
                            } else {
                                toastr.error('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
                            }
                        }
                    });
                } else {
                    toastr.error('กรุณากรอกข้อมูลที่จำเป็นให้ครบถ้วน');
                }
            });

            // Full form submission
            $('#fullRegistrationForm').submit(function (e) {
                e.preventDefault();
                toastr.info('กำลังบันทึกข้อมูล...');
                
                // TODO: Collect all full registration form data
                const formData = {
                    country: $('select[name="country"]').val(),
                    businessCountry: $('select[name="business_country"]').val(),
                    referrerCode: $('#fullRegistrationForm input[placeholder="กรอกรหัสผู้อ้างอิง"]').eq(0).val(),
                    referrerSide: $('input[name="referrer_side"]:checked').val() === 'referrer_left' ? 'left' : 'right',
                    uplineCode: $('#fullRegistrationForm input[placeholder="กรอกรหัสอัพไลน์"]').val(),
                    uplineSide: $('input[name="upline_side"]:checked').val() === 'uplineside_left' ? 'left' : 'right',
                    businessType: $('input[name="business_type"]:checked').val() === 'businessman' ? 'businessman' : 'user',
                    title: $('select[name="title"]').val(),
                    nameOnCard: $('#fullRegistrationForm input[placeholder="กรอกชื่อบนบัตร"]').val(),
                    businessName: $('#fullRegistrationForm input[placeholder="กรอกชื่อธุรกิจ"]').val(),
                    citizenNumber: $('#fullRegistrationForm input[placeholder="กรอกเลขบัตรประชาชนหรือหนังสือเดินทาง"]').val(),
                    mobile: $('#fullRegistrationForm input[placeholder="กรอกเบอร์โทรศัพท์มือถือ"]').eq(1).val(),
                    email: $('#fullRegistrationForm input[placeholder="กรอกอีเมล"]').eq(1).val()
                    // TODO: Add more fields as needed
                };

                // Call API
                $.ajax({
                    url: '/Registration/fullregistration',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(formData),
                    success: function(response) {
                        if (response.success) {
                            toastr.success(response.message || 'บันทึกข้อมูลสำเร็จ!');
                            if (response.memberCode) {
                                setTimeout(() => {
                                    alert('รหัสสมาชิก: ' + response.memberCode + '\nชื่อ: ' + response.memberName);
                                    $('#fullRegistrationForm')[0].reset();
                                }, 1000);
                            }
                        } else {
                            toastr.error(response.message || 'เกิดข้อผิดพลาดในการลงทะเบียน');
                        }
                    },
                    error: function(xhr) {
                        const response = xhr.responseJSON;
                        if (response && response.message) {
                            toastr.error(response.message);
                        } else {
                            toastr.error('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์ได้');
                        }
                    }
                });
            });

            // Cancel full registration
            $('#btnCancelFull').click(function () {
                if (confirm('คุณต้องการยกเลิกการลงทะเบียนหรือไม่?')) {
                    $('#fullRegistrationForm')[0].reset();
                    toastr.info('ยกเลิกการลงทะเบียนแล้ว');
                }
            });

            // Add required field styling
            $('.required').each(function () {
                const label = $(this);
                const text = label.text();
                if (!text.includes('*')) {
                    label.html(text + ' <span class="text-danger">*</span>');
                }
            });

            // Helper functions
            function loadMasterAddresses() {
                // Use the same API as checkoutinfo.cshtml
                $.get('/orders/GetMasterAddress', function(res) {
                    // Handle the response format (same as checkoutinfo.cshtml)
                    if (typeof res === 'string') {
                        try { res = JSON.parse(res); } catch (e) { 
                            console.error("JSON Error", e); 
                            toastr.error('ไม่สามารถโหลดข้อมูลที่อยู่ได้');
                            return; 
                        }
                    }
                    
                    if (!Array.isArray(res)) {
                        // Check if data is nested in .data or .result
                        if (res.data && Array.isArray(res.data)) {
                            masterData = res.data;
                        } else if (res.result && Array.isArray(res.result)) {
                            masterData = res.result;
                        } else {
                            masterData = [];
                        }
                    } else {
                        masterData = res;
                    }
                    
                    console.log("Loaded " + masterData.length + " rows of address data");
                    $('#simplePostcode').prop('disabled', false).attr('placeholder', 'กรอกรหัสไปรษณีย์ 5 หลัก');
                    
                    if (masterData.length === 0) {
                        toastr.warning('ไม่พบข้อมูลที่อยู่ในระบบ');
                    }
                }).fail(function() {
                    toastr.error('ไม่สามารถเชื่อมต่อเซิร์ฟเวอร์เพื่อโหลดข้อมูลที่อยู่');
                    console.error("Failed to load master address data");
                });
            }

            function validateThaiID(id) {
                if (id.length !== 13) return false;
                
                let sum = 0;
                for (let i = 0; i < 12; i++) {
                    sum += parseInt(id.charAt(i)) * (13 - i);
                }
                
                let checkDigit = (11 - (sum % 11)) % 10;
                return checkDigit === parseInt(id.charAt(12));
            }

            function getUniqueList(data, codeKey, nameKey) {
                var seen = new Set();
                return data.filter(item => {
                    var k = item[codeKey];
                    return seen.has(k) ? false : seen.add(k);
                }).sort((a, b) => a[nameKey].localeCompare(b[nameKey]));
            }

            function resetDropdown(selector, defaultText) {
                $(selector).empty().append('<option value="">' + defaultText + '</option>').prop('disabled', true);
            }

            function resetAddressDropdowns() {
                resetDropdown('#simpleProvince', '-- รอผลจากรหัสไปรษณีย์ --');
                resetDropdown('#simpleDistrict', '-- เลือกอำเภอ --');
                resetDropdown('#simpleSubdistrict', '-- เลือกตำบล --');
            }
        });
    </script>
}
                                               
