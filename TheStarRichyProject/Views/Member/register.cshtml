            // Read selected file inputs and convert to base64 strings. Returns array of base64 strings (omit empty slots).
            function readFilesAsBase64(selectors) {
                return Promise.all(selectors.map(sel => {
                    return new Promise(resolve => {
                        const input = $(sel)[0];
                        if (!input || !input.files || input.files.length === 0) return resolve(null);
                        const file = input.files[0];
                        const reader = new FileReader();
                        reader.onload = function (e) {
                            // strip data:<mime>;base64, prefix
                            const s = (e.target.result || '').toString();
                            const parts = s.split(',');
                            resolve(parts.length > 1 ? parts[1] : parts[0]);
                        };
                        reader.onerror = function () { resolve(null); };
                        reader.readAsDataURL(file);
                    });
                })).then(results => results.filter(r => r));
            }

            function validateThaiID(id) {
                if (id.length !== 13) return false;
                
                let sum = 0;
                for (let i = 0; i < 12; i++) {
                    sum += parseInt(id.charAt(i)) * (13 - i);
                }
                
                let checkDigit = (11 - (sum % 11)) % 10;
                return checkDigit === parseInt(id.charAt(12));
            }

            function getUniqueList(data, codeKey, nameKey) {
                var seen = new Set();
                return data.filter(item => {
                    var k = item[codeKey];
                    return seen.has(k) ? false : seen.add(k);
                }).sort((a, b) => a[nameKey].localeCompare(b[nameKey]));
            }

