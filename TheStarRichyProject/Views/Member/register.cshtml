    }

    function resetAddressDropdowns() {
        resetDropdown('#simpleProvince', '-- รอผลจากรหัสไปรษณีย์ --');
        resetDropdown('#simpleDistrict', '-- เลือกอำเภอ --');
        resetDropdown('#simpleSubdistrict', '-- เลือกตำบล --');
    }

    // Setup synchronization between simple and full registration forms
    function setupFormSync() {
        const fieldMappings = {
            'simpleCountry': 'fullCountry',
            'simpleCountryBusiness': 'fullCountryBusiness',
            'simpleReferrerCode': 'fullReferrerCode',
            'simpleReferrerName': 'fullReferrerName',
            'simpleRegDay': 'fullRegDay',
            'simpleRegMonth': 'fullRegMonth',
            'simpleRegYear': 'fullRegYear',
            'simpleBirthDay': 'fullBirthDay',
            'simpleBirthMonth': 'fullBirthMonth',
            'simpleBirthYear': 'fullBirthYear',
            'simpleTitle': 'fullTitle',
            'simpleFullName': 'fullNameOnCard',
            'simpleBusinessName': 'fullBusinessName',
            'simpleDocumentNumber': 'fullDocumentNumber',
            'simpleMobile': 'fullMobile',
            'simpleHomePhone': 'fullHomePhone',
            'simpleEmail': 'fullEmail',
            'simpleLineId': 'fullLineId',
            'simpleHouseNumber': 'fullHouseNumber',
            'simpleMoo': 'fullMoo',
            'simpleAlley': 'fullAlley',
            'simpleRoad': 'fullRoad',
            'simpleBuilding': 'fullBuilding',
            'simpleFloor': 'fullFloor',
            'simplePostcode': 'fullPostcodeIdCard',
            'simpleProvince': 'fullProvinceIdCard',
            'simpleDistrict': 'fullDistrictIdCard',
            'simpleSubdistrict': 'fullSubdistrictIdCard'
        };

        // Sync inputs real-time
        Object.entries(fieldMappings).forEach(([simpleId, fullId]) => {
            const simpleEl = $(`#${simpleId}`);
            const fullEl = $(`#${fullId}`);
            
            if (simpleEl.length && fullEl.length) {
                if (simpleEl.is('select') || simpleEl.is('input[type="text"], input[type="tel"], input[type="email"]')) {
                    simpleEl.on('change input', function() { fullEl.val(simpleEl.val()); });
                    fullEl.on('change input', function() { simpleEl.val(fullEl.val()); });
                }
                
                if (simpleEl.is('input[type="file"]')) {
                    simpleEl.on('change', function() {
                        const file = this.files[0];
                        if (file) {
                            fullEl[0].files = this.files;
                            const targetPreviewId = `#${simpleId.replace('Photo', 'Photo')}Preview`.replace('simple', 'full');
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                $(targetPreviewId).attr('src', e.target.result);
                                setTimeout(() => { $(targetPreviewId).show(); }, 50);
                            };
                            reader.readAsDataURL(file);
                        }
                    });
                    
                    fullEl.on('change', function() {
                        const file = this.files[0];
                        if (file) {
                            simpleEl[0].files = this.files;
                            const targetPreviewId = `#${fullId.replace('Photo', 'Photo')}Preview`.replace('full', 'simple');
                            const reader = new FileReader();
                            reader.onload = function(e) {
                                $(targetPreviewId).attr('src', e.target.result);
                                setTimeout(() => { $(targetPreviewId).show(); }, 50);
                            };
                            reader.readAsDataURL(file);
                        }
                    });
                }
            }
        });

        $('input[name="position"]').on('change', function() {
            const val = $(this).val();
            $(`input[name="position"][value="${val}"]`).prop('checked', true);
        });

        let isSyncing = false;
        Object.entries(fieldMappings).forEach(([simpleId, fullId]) => {
            const simpleEl = $(`#${simpleId}`);
            const fullEl = $(`#${fullId}`);

            if (simpleEl.length && fullEl.length && simpleEl.is('select')) {
                simpleEl.on('change', function() {
                    if (isSyncing) return;
                    isSyncing = true;
                    fullEl.val(simpleEl.val());
                    setTimeout(() => { isSyncing = false; }, 0);
                });

                fullEl.on('change', function() {
                    if (isSyncing) return;
                    isSyncing = true;
                    simpleEl.val(fullEl.val());
                    setTimeout(() => { isSyncing = false; }, 0);
                });
            }
        });

        // ✅ ปรับแก้ระบบซิงค์ข้าม Tab ให้ดึง Base64 Data URL ตรงๆ ไม่ผ่าน createObjectURL
        $('#full-tab').on('shown.bs.tab', function() {
            Object.entries(fieldMappings).forEach(([simpleId, fullId]) => {
                const simpleEl = $(`#${simpleId}`);
                const fullEl = $(`#${fullId}`);
                if (simpleEl.length && fullEl.length) {
                    fullEl.val(simpleEl.val());
                }
            });
            const positionVal = $('input[name="position"]:checked').val();
            if (positionVal) {
                $(`#full-tab-pane input[name="position"][value="${positionVal}"]`).prop('checked', true);
            }
            syncImagePreview('simpleIdCardPreview', 'fullIdCardPreview');
            syncImagePreview('simpleBankCardPreview', 'fullBankCardPreview');
            syncImagePreview('simpleBusinessPhotoPreview', 'fullBusinessPhotoPreview');
        });

        $('#simple-tab').on('shown.bs.tab', function() {
            Object.entries(fieldMappings).forEach(([simpleId, fullId]) => {
                const simpleEl = $(`#${simpleId}`);
                const fullEl = $(`#${fullId}`);
                if (simpleEl.length && fullEl.length) {
                    simpleEl.val(fullEl.val());
                }
            });
            const positionVal = $(`#full-tab-pane input[name="position"]:checked`).val();
            if (positionVal) {
                $(`input[name="position"][value="${positionVal}"]`).prop('checked', true);
            }
            syncImagePreview('fullIdCardPreview', 'simpleIdCardPreview');
            syncImagePreview('fullBankCardPreview', 'simpleBankCardPreview');
            syncImagePreview('fullBusinessPhotoPreview', 'simpleBusinessPhotoPreview');
        });
    }

    // ✅ ฟังก์ชันซิงค์รูปพรีวิวข้ามแท็บที่เสถียรที่สุด โดยดึงผ่านค่า src โดยตรง
    function syncImagePreview(sourcePreviewId, targetPreviewId) {
        const sourceSrc = $(`#${sourcePreviewId}`).attr('src');
        const targetPreview = $(`#${targetPreviewId}`);
        
        if (sourceSrc && sourceSrc.startsWith('data:image')) {
            targetPreview.attr('src', sourceSrc);
            setTimeout(() => { targetPreview.show(); }, 50);
        } else {
            targetPreview.hide().attr('src', '');
        }
    }

    function normalizeDuplicateResult(response, defaultMessage) {
        const parsed = (typeof response === 'string') ? JSON.parse(response) : response;
        if (!parsed || typeof parsed !== 'object') return { success: true, message: '' };

        if (typeof parsed.success === 'boolean') {
            return { success: parsed.success, message: parsed.message || (parsed.success ? '' : defaultMessage) };
        }
        if (typeof parsed.isDuplicate === 'boolean') {
            return { success: !parsed.isDuplicate, message: parsed.isDuplicate ? (parsed.message || defaultMessage) : '' };
        }
        if (typeof parsed.exists === 'boolean') {
            return { success: !parsed.exists, message: parsed.exists ? (parsed.message || defaultMessage) : '' };
        }
        return { success: true, message: '' };
    }

    async function checkDuplicateIDCard(id) {
        try {
            const response = await $.get('/ExternalRegistration/CheckDupIDcard?id=' + encodeURIComponent(id));
            return normalizeDuplicateResult(response, 'เลขบัตรประชาชนนี้มีในระบบแล้ว');
        } catch (error) {
            return { success: true };
        }
    }

    async function checkDuplicateTelephone(phone) {
        try {
            const response = await $.get('/ExternalRegistration/CheckDupTelephone?phone=' + encodeURIComponent(phone));
            return normalizeDuplicateResult(response, 'เบอร์โทรศัพท์มือถือมีในระบบแล้ว');
        } catch (error) {
            return { success: true };
        }
    }

    async function checkDuplicateEmail(email) {
        if (!email) return { success: true, message: '' };
        try {
            const response = await $.get('/ExternalRegistration/CheckDupEmail?email=' + encodeURIComponent(email));
            return normalizeDuplicateResult(response, 'อีเมลนี้มีในระบบแล้ว');
        } catch (error) {
            return { success: true };
        }
    }

    async function checkDuplicateIDCardName(name) {
        try {
            const response = await $.get('/ExternalRegistration/CheckDupIDcardname?name=' + encodeURIComponent(name));
            return normalizeDuplicateResult(response, 'ชื่อตามบัตรนี้มีในระบบแล้ว');
        } catch (error) {
            return { success: true };
        }
    }

    async function checkDuplicateBusinessName(name) {
        try {
            const response = await $.get('/ExternalRegistration/CheckDupBusinessname?name=' + encodeURIComponent(name));
            return normalizeDuplicateResult(response, 'ชื่อธุรกิจนี้มีในระบบแล้ว');
        } catch (error) {
            return { success: true };
        }
    }

    // OTP logic
    let countdownInterval;
    window.currentFormData = null;
    window.currentReferenceId = null;

    async function sendOTPAndShowInput(formData) {
        try {
            let skipOTP = false;
            try {
                const sysData = await $.get('/Static/system');
                const sys = Array.isArray(sysData) ? sysData[0] : sysData;
                if (sys && String(sys.SendOTPRegister) === '1') {
                    skipOTP = true;
                }
            } catch (sysErr) {
                console.warn('ไม่สามารถดึงค่า SendOTPRegister ได้, ใช้ค่า default (ส่ง OTP):', sysErr);
            }

            if (skipOTP) {
                window.currentFormData = formData;
                window.currentReferenceId = null;
                Swal.close();
                await finalRegistration(formData, '');
                return;
            }

            const sendOTPResponse = await $.ajax({
                url: '/ExternalRegistration/SendOTP',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ phone: formData.mobile, method: 'sms' })
            });

            if (sendOTPResponse && sendOTPResponse.success) {
                window.currentFormData = formData;
                window.currentReferenceId = sendOTPResponse.referenceId;

                $('#otpPhoneNumber').text(formData.mobile);
                $('#otpInput').val('').removeClass('is-invalid');
                $('#otpError').text('');

                const otpModal = new bootstrap.Modal(document.getElementById('otpModal'));
                otpModal.show();
                startResendCountdown();
                Swal.close();
            } else {
                Swal.fire('ส่ง OTP ไม่สำเร็จ', (sendOTPResponse && sendOTPResponse.message) || 'ไม่สามารถส่งรหัสได้', 'error');
            }
        } catch (e) {
            console.error('SendOTP error:', e);
            const errMsg = (e.responseJSON && e.responseJSON.message) || e.responseText || e.message || 'ไม่สามารถส่ง OTP ได้';
            Swal.fire('ส่ง OTP ไม่สำเร็จ', errMsg, 'error');
        }
    }

    function startResendCountdown() {
        let countdown = 30;
        const btn = $('#resendOTPBtn');
        btn.prop('disabled', true);
        clearInterval(countdownInterval);

        countdownInterval = setInterval(() => {
            btn.find('small').text(`ส่งรหัสใหม่ (${countdown})`);
            countdown--;
            if (countdown < 0) {
                clearInterval(countdownInterval);
                btn.prop('disabled', false).find('small').text('ส่งรหัสใหม่');
            }
        }, 1000);
    }

    $('#otpInput').on('input', function () {
        this.value = this.value.replace(/\D/g, '');
        $('#verifyOTPBtn').prop('disabled', this.value.length < 6);
    });

    $('#verifyOTPBtn').click(async function () {
        const otp = $('#otpInput').val();
        if (otp.length < 6) return;
        
        $(this).prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i>');

        try {
            const verifyResponse = await $.ajax({
                url: '/ExternalRegistration/VerifyOTP',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify({ phone: window.currentFormData.mobile, otp: otp, referenceId: window.currentReferenceId })
            });

            if (verifyResponse && verifyResponse.isValid) {
                bootstrap.Modal.getInstance(document.getElementById('otpModal')).hide();
                await finalRegistration(window.currentFormData, otp);
            } else {
                $('#otpInput').addClass('is-invalid');
                $('#otpError').text('รหัส OTP ไม่ถูกต้อง');
                $(this).prop('disabled', false).html('ยืนยัน');
            }
        } catch (e) {
            bootstrap.Modal.getInstance(document.getElementById('otpModal')).hide();
            await finalRegistration(window.currentFormData, otp);
        }
    });

    async function finalRegistration(formData, otp) {
        Swal.fire({ title: 'กำลังบันทึกข้อมูล...', didOpen: () => Swal.showLoading() });

        const selectors = (formData && formData._origin === 'full')
            ? ['#fullIdCardCopy', '#fullBankCardCopy', '#fullApplicationForm', '#fullBusinessPhoto']
            : ['#simpleIdCardCopy', '#simpleBankCardCopy', '#simpleBusinessPhoto'];

        const memberpics = await readFilesAsBase64(selectors);

        const registrationData = {
            ...formData,
            verificationMethod: 'otp',
            otp: otp,
            referenceId: window.currentReferenceId,
            memberpic: memberpics
        };

        try {
            const targetUrl = (formData && formData._origin === 'full') ? 'FullFinalizeRegistration' : 'FinalizeRegistration';
            const response = await $.ajax({
                url: targetUrl,
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(registrationData)
            });

            const data = (typeof response === 'string') ? JSON.parse(response) : response;
            if (data && data.success) {
                Swal.fire('สำเร็จ', `ลงทะเบียนเรียบร้อย Member Code: ${data.memberCode}`, 'success')
                    .then(() => location.reload());
            } else {
                Swal.fire('ไม่สำเร็จ', (data && data.message) || 'เกิดข้อผิดพลาด', 'error');
            }
        } catch (err) {
            console.error(err);
            const errMsg = (err.responseJSON && err.responseJSON.message) || err.responseText || err.message || 'ไม่สามารถบันทึกข้อมูลได้';
            Swal.fire('เกิดข้อผิดพลาด', errMsg, 'error');
        }
    }
});
</script>
