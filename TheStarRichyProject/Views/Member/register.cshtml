            var day = parseInt($(daySel).val());
            var month = parseInt($(monthSel).val());
            var yearBE = parseInt($(yearSel).val());
            
            if (!day || !month || !yearBE) return;
            
            // Convert BE to CE for age calculation
            var yearCE = yearBE;
            if (currentLang === 'th' && yearBE > 2400) {
                yearCE = yearBE - 543;
            }
            
            var birthDate = new Date(yearCE, month - 1, day);
            var age = Math.floor((today - birthDate) / (365.25 * 24 * 60 * 60 * 1000));
            
            if (age < 18) {
                toastr.error('อายุต้องมากกว่า 18 ปี จึงสามารถสมัครสมาชิกได้');
