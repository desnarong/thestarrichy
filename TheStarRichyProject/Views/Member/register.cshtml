            // Helper functions
            function loadMasterAddresses() {
                // Use the same API as checkoutinfo.cshtml
                $.get('/orders/GetMasterAddress', function(res) {
                    // Handle the response format (same as checkoutinfo.cshtml)
                    if (typeof res === 'string') {
                        try { res = JSON.parse(res); } catch (e) { 
                            console.error("JSON Error", e); 
                            toastr.error('ไม่สามารถโหลดข้อมูลที่อยู่ได้');
                            return; 
                        }
                    }
                    
                    if (!Array.isArray(res)) {
                        // Check if data is nested in .data or .result
                        if (res.data && Array.isArray(res.data)) {
                            masterData = res.data;
                        } else if (res.result && Array.isArray(res.result)) {
                            masterData = res.result;
                        } else {
                            masterData = [];
                        }
                    } else {
                        masterData = res;
                    }
                    
                    console.log("Loaded " + masterData.length + " rows of address data");
                    $('#simplePostcode').prop('disabled', false).attr('placeholder', 'กรอกรหัสไปรษณีย์ 5 หลัก');
                    
                    if (masterData.length === 0) {
                        toastr.warning('ไม่พบข้อมูลที่อยู่ในระบบ');
                    }
                }).fail(function() {
