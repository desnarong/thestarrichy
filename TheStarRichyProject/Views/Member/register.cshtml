                                                    <small class="text-muted mt-1" id="lineIdValidation"></small>
                                                </div>
                                            </div>

                                        </div>
                                    </div>
                                </div>

                                <div class="col-12 col-lg-6">
                                    <div class="card border-0 shadow-sm mb-4">
                                        <div class="card-header bg-light">
