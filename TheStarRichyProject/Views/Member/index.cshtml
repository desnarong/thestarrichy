    function populateAddressCard(addr) {
        const typeMap = { 1: 'idcard', 2: 'present', 3: 'inv' };
        const prefix = typeMap[addr.addressType];
        if (!prefix) return;

        $(`#info-${prefix}-housenumber`).val(addr.houseNumber || '');
        $(`#info-${prefix}-moo`).val(addr.moo || '');
        $(`#info-${prefix}-alley`).val(addr.alley || '');
        $(`#info-${prefix}-road`).val(addr.road || '');
        $(`#info-${prefix}-building`).val(addr.building || '');
        $(`#info-${prefix}-floor`).val(addr.floor || '');
        $(`#info-${prefix}-other`).val(addr.other || '');

        if (addr.zipcode) {
            $(`#info-${prefix}-zipcode`).val(addr.zipcode).trigger('input');
            const match = addr.tambonId
                ? masterAddressData.find(item => item.id === addr.tambonId || String(item.tambon_code) === String(addr.tambonCode))
                : null;
            if (match) {
                setTimeout(() => {
                    $(`#info-${prefix}-province`).val(match.province_code).trigger('change');
                    setTimeout(() => {
                        $(`#info-${prefix}-district`).val(match.amphoe_code).trigger('change');
                        setTimeout(() => {
                            $(`#info-${prefix}-subdistrict`).val(match.tambon_code);
                            $(`#info-${prefix}-tambonid`).val(addr.tambonId);
                        }, 60);
                    }, 60);
                }, 60);
            }
        }

        if (prefix === 'inv') {
            $('#info-inv-companyname').val(addr.companyName || '');
            $('#info-inv-companytaxid').val(addr.companyTaxId || '');
            $('#info-inv-branchcode').val(addr.branchCode || '');
            $('#info-inv-branchname').val(addr.branchName || '');
        }
    }

    function buildAddressPayload() {
        function getAddr(prefix, type) {
            return {
                addressType: type,
                houseNumber: $(`#info-${prefix}-housenumber`).val() || null,
                moo: $(`#info-${prefix}-moo`).val() || null,
                alley: $(`#info-${prefix}-alley`).val() || null,
                road: $(`#info-${prefix}-road`).val() || null,
                building: $(`#info-${prefix}-building`).val() || null,
                floor: $(`#info-${prefix}-floor`).val() || null,
                other: $(`#info-${prefix}-other`).val() || null,
                tambonId: parseInt($(`#info-${prefix}-tambonid`).val()) || null,
                zipcode: $(`#info-${prefix}-zipcode`).val() || null,
                companyName: prefix === 'inv' ? ($('#info-inv-companyname').val() || null) : null,
                companyTaxId: prefix === 'inv' ? ($('#info-inv-companytaxid').val() || null) : null,
                branchCode: prefix === 'inv' ? ($('#info-inv-branchcode').val() || null) : null,
                branchName: prefix === 'inv' ? ($('#info-inv-branchname').val() || null) : null
            };
        }
        return { addresses: [getAddr('idcard', 1), getAddr('present', 2), getAddr('inv', 3)] };
    }

    async function submitAddressUpdate() {
        const payload = buildAddressPayload();
        const response = await fetch('/Member/UpdateProfileAddresses', {
            method: 'PUT',
            credentials: 'include',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const raw = await response.text();
        let result = null;
        try { result = JSON.parse(raw); } catch { result = { success: response.ok, message: raw || '' }; }
        if (!response.ok || result?.success === false) {
            throw new Error(result?.message || 'ไม่สามารถอัปเดตที่อยู่ได้');
        }
        return result;
    }

