        function copyAddressFields(prefix) {
            ['housenumber', 'moo', 'alley', 'road', 'building', 'floor', 'other'].forEach(f =>
                $(`#info-${prefix}-${f}`).val($(`#info-idcard-${f}`).val() || '')
            );
            const postcode = ($('#info-idcard-zipcode').val() || '').replace(/\D/g, '').slice(0, 5);
            $(`#info-${prefix}-zipcode`).val(postcode).trigger('input');
            const prov = $('#info-idcard-province').val() || '';
            if (prov) $(`#info-${prefix}-province`).val(prov).trigger('change');
            const dist = $('#info-idcard-district').val() || '';
            if (dist) $(`#info-${prefix}-district`).val(dist).trigger('change');
            const sub = $('#info-idcard-subdistrict').val() || '';
            if (sub) {
                $(`#info-${prefix}-subdistrict`).val(sub).trigger('change.tambonid');
                $(`#info-${prefix}-tambonid`).val($('#info-idcard-tambonid').val() || '');
            }
        }

        function clearAddressFields(prefix) {
            ['housenumber', 'moo', 'alley', 'road', 'building', 'floor', 'other'].forEach(f =>
                $(`#info-${prefix}-${f}`).val('')
            );
            $(`#info-${prefix}-zipcode`).val('');
            $(`#info-${prefix}-tambonid`).val('');
            resetAddressDropdown(`#info-${prefix}-province`, '-- รอรหัสไปรษณีย์ --');
            resetAddressDropdown(`#info-${prefix}-district`, '-- เลือกอำเภอ --');
            resetAddressDropdown(`#info-${prefix}-subdistrict`, '-- เลือกตำบล --');
        }

        $('#info-present-copyidcard').off('change').on('change', function () {
            if ($(this).is(':checked')) copyAddressFields('present');
            else clearAddressFields('present');
        });

        $('#info-inv-copyidcard').off('change').on('change', function () {
            if ($(this).is(':checked')) copyAddressFields('inv');
            else clearAddressFields('inv');
        });
    }

