<style>
    .member-doc-preview {
        display: block;
        width: 100%;
        max-width: 100%;
        max-height: 260px;
        height: auto;
        object-fit: contain;
        border: 1px solid #e9ebec;
        border-radius: 0.5rem;
        background: #f8f9fa;
    }
</style>

<script>
    const language = localStorage.getItem("language");
    let memberinfo = null;
    let masterAddressData = [];
    const uploadState = {
        profileImage: null,
        copyIdCard: null,
        copyBankBook: null,
        applicationForm: null
    };

    function previewImage(file, targetSelector) {
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function (e) {
            $(targetSelector).attr('src', e.target.result);
        };
        reader.readAsDataURL(file);
    }

    function sanitizeImageUrlForApi(url) {
        const value = (url || '').trim();
        if (!value || value.toUpperCase() === 'N/A' || value.startsWith('data:')) {
            return null;
        }
        return value;
    }

    function bindUploadPreview() {
        $('#profile-img-file-input').on('change', async function (event) {
            const file = event.target.files?.[0];
            if (!file) return;

            const previousProfileImage = $('#user-profile-image').attr('src') || '';
            uploadState.profileImage = file;
            previewImage(file, '#user-profile-image');

            const confirmResult = await Swal.fire({
                title: "ยืนยันเปลี่ยนรูปโปรไฟล์",
                text: "ต้องการอัปโหลดรูปโปรไฟล์นี้ใช่หรือไม่",
                icon: "question",
                showCancelButton: true,
                customClass: {
                    confirmButton: "btn btn-primary w-xs me-2 mt-2",
                    cancelButton: "btn btn-danger w-xs mt-2"
                },
                confirmButtonText: "ยืนยัน",
                cancelButtonText: "ยกเลิก",
                buttonsStyling: false,
                showCloseButton: true
            });

            if (!confirmResult.isConfirmed) {
                uploadState.profileImage = null;
                $('#profile-img-file-input').val('');
                $('#user-profile-image').attr('src', previousProfileImage);
                return;
            }

            try {
                const formData = new FormData();
                if (memberinfo?.membercode) {
                    formData.append('memberCode', memberinfo.membercode);
                }
                formData.append('profileImage', file);

                const response = await fetch('/Member/UploadProfilePic4', {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });

                const result = await response.json();
                if (!response.ok || !result?.success) {
                    throw new Error(result?.message || 'Upload failed');
                }

                if (result.url) {
                    $('#user-profile-image').attr('src', result.url);
                }

                uploadState.profileImage = null;
                $('#profile-img-file-input').val('');

                Swal.fire({
                    title: "สำเร็จ",
                    text: "อัปโหลดรูปโปรไฟล์และบันทึกข้อมูลเรียบร้อยแล้ว",
                    icon: "success",
                    customClass: {
                        confirmButton: "btn btn-primary w-xs mt-2"
                    },
                    buttonsStyling: !1
                });
            } catch (error) {
                uploadState.profileImage = null;
                $('#profile-img-file-input').val('');
                $('#user-profile-image').attr('src', previousProfileImage);

                Swal.fire({
                    title: "เกิดข้อผิดพลาด",
                    text: error?.message || "ไม่สามารถอัปโหลดรูปโปรไฟล์ได้",
                    icon: "error",
                    customClass: {
                        confirmButton: "btn btn-primary w-xs mt-2"
                    },
                    buttonsStyling: !1
                });
            }
        });

        $('#info-uploadcopyidcard').on('change', function (event) {
            const file = event.target.files?.[0];
            if (!file) return;
            uploadState.copyIdCard = file;
            previewImage(file, '#info-copyidcard');
            $('#info-flagsendidcard').prop('checked', true);
        });

        $('#info-uploadcopybankaccountbook').on('change', function (event) {
            const file = event.target.files?.[0];
            if (!file) return;
            uploadState.copyBankBook = file;
            previewImage(file, '#info-copybankaccountbook');
            $('#info-flagsendbookbank').prop('checked', true);
        });

        $('#info-uploadapplicationsubmitte').on('change', function (event) {
            const file = event.target.files?.[0];
            if (!file) return;
            uploadState.applicationForm = file;
            previewImage(file, '#info-applicationsubmitte');
            $('#info-registerfrombranch').prop('checked', true);
        });
    }

    function getUniqueAddressList(data, codeKey, nameKey) {
        const seen = new Set();
        return data.filter(item => {
            const key = item[codeKey];
            if (seen.has(key)) return false;
            seen.add(key);
            return true;
        }).sort((a, b) => (a[nameKey] || '').localeCompare(b[nameKey] || ''));
    }

    function resetAddressDropdown(selector, defaultText) {
        $(selector)
            .empty()
            .append(`<option value="">${defaultText}</option>`)
            .prop('disabled', true);
    }

    function bindAddressByPostcode(config) {
        const postcodeSelector = config.postcodeSelector;
        const provinceSelector = config.provinceSelector;
        const districtSelector = config.districtSelector;
        const subdistrictSelector = config.subdistrictSelector;

        resetAddressDropdown(provinceSelector, '-- รอผลจากรหัสไปรษณีย์ --');
        resetAddressDropdown(districtSelector, '-- เลือกอำเภอ --');
        resetAddressDropdown(subdistrictSelector, '-- เลือกตำบล --');

        $(postcodeSelector).off('input').on('input', function () {
            const cleaned = ($(this).val() || '').replace(/\D/g, '').slice(0, 5);
            $(this).val(cleaned);

            resetAddressDropdown(provinceSelector, '-- รอผลจากรหัสไปรษณีย์ --');
            resetAddressDropdown(districtSelector, '-- เลือกอำเภอ --');
            resetAddressDropdown(subdistrictSelector, '-- เลือกตำบล --');

            if (cleaned.length !== 5 || masterAddressData.length === 0) {
                return;
            }

            const filtered = masterAddressData.filter(item => item.zipcode === cleaned);
            if (filtered.length === 0) {
                return;
            }

            const provinces = getUniqueAddressList(filtered, 'province_code', 'province');
            $(provinceSelector).empty().append('<option value="">-- เลือกจังหวัด --</option>');
            provinces.forEach(p => {
                $(provinceSelector).append(`<option value="${p.province_code}">${p.province}</option>`);
            });
            $(provinceSelector).prop('disabled', false);

            if (provinces.length === 1) {
                $(provinceSelector).val(provinces[0].province_code).trigger('change');
            }
        });

        $(provinceSelector).off('change').on('change', function () {
            const selectedZip = $(postcodeSelector).val();
            const selectedProvCode = $(this).val();

            resetAddressDropdown(districtSelector, '-- เลือกอำเภอ --');
            resetAddressDropdown(subdistrictSelector, '-- เลือกตำบล --');

            if (!selectedZip || !selectedProvCode) {
                return;
            }

            const filtered = masterAddressData.filter(item =>
                item.zipcode === selectedZip && item.province_code == selectedProvCode
            );

            const districts = getUniqueAddressList(filtered, 'amphoe_code', 'amphoe');
            $(districtSelector).empty().append('<option value="">-- เลือกอำเภอ --</option>');
            districts.forEach(d => {
                $(districtSelector).append(`<option value="${d.amphoe_code}">${d.amphoe}</option>`);
            });
            $(districtSelector).prop('disabled', false);

            if (districts.length === 1) {
                $(districtSelector).val(districts[0].amphoe_code).trigger('change');
            }
        });

        $(districtSelector).off('change').on('change', function () {
            const selectedZip = $(postcodeSelector).val();
            const selectedProvCode = $(provinceSelector).val();
            const selectedDistrictCode = $(this).val();

            resetAddressDropdown(subdistrictSelector, '-- เลือกตำบล --');

            if (!selectedZip || !selectedProvCode || !selectedDistrictCode) {
                return;
            }

            const filtered = masterAddressData.filter(item =>
                item.zipcode === selectedZip &&
                item.province_code == selectedProvCode &&
                item.amphoe_code == selectedDistrictCode
            );

            $(subdistrictSelector).empty().append('<option value="">-- เลือกตำบล --</option>');
            filtered.forEach(item => {
                $(subdistrictSelector).append(`<option value="${item.tambon_code}">${item.tambon}</option>`);
            });
            $(subdistrictSelector).prop('disabled', false);
        });
    }

    function copyAddressFromSource(source, target) {
        if (source.addressSelector && target.addressSelector) {
            $(target.addressSelector).val($(source.addressSelector).val() || '');
        }

        const postcode = (($(source.postcodeSelector).val() || '').toString()).replace(/\D/g, '').slice(0, 5);
        $(target.postcodeSelector).val(postcode).trigger('input');

        const provinceCode = $(source.provinceSelector).val() || '';
        if (provinceCode) {
            $(target.provinceSelector).val(provinceCode).trigger('change');
        }

        const districtCode = $(source.districtSelector).val() || '';
        if (districtCode) {
            $(target.districtSelector).val(districtCode).trigger('change');
        }

        const subdistrictCode = $(source.subdistrictSelector).val() || '';
        if (subdistrictCode) {
            $(target.subdistrictSelector).val(subdistrictCode);
        }
    }

    function initializeAddressLookups() {
        bindAddressByPostcode({
            postcodeSelector: '#info-idcard-zipcode',
            provinceSelector: '#info-idcard-province',
            districtSelector: '#info-idcard-district',
            subdistrictSelector: '#info-idcard-subdistrict'
        });
        $('#info-idcard-subdistrict').off('change.tambonid').on('change.tambonid', function () {
            const code = $(this).val();
            const match = masterAddressData.find(item => String(item.tambon_code) === String(code));
            $('#info-idcard-tambonid').val(match ? match.id : '');
        });

        bindAddressByPostcode({
            postcodeSelector: '#info-present-zipcode',
            provinceSelector: '#info-present-province',
            districtSelector: '#info-present-district',
            subdistrictSelector: '#info-present-subdistrict'
        });
        $('#info-present-subdistrict').off('change.tambonid').on('change.tambonid', function () {
            const code = $(this).val();
            const match = masterAddressData.find(item => String(item.tambon_code) === String(code));
            $('#info-present-tambonid').val(match ? match.id : '');
        });

        bindAddressByPostcode({
            postcodeSelector: '#info-inv-zipcode',
            provinceSelector: '#info-inv-province',
            districtSelector: '#info-inv-district',
            subdistrictSelector: '#info-inv-subdistrict'
        });
