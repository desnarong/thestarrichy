    async function submitMemberProfileUpdate(updateScope) {
        const payload = buildMemberUpdatePayload(updateScope);

        const response = await fetch('/Member/UpdateMemberProfile', {
            method: 'PUT',
            credentials: 'include',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
        });

        const raw = await response.text();
        let result = null;
        try {
            result = JSON.parse(raw);
        } catch {
            result = { success: response.ok, message: raw || '' };
        }

        if (!response.ok || result?.success === false) {
            throw new Error(result?.message || 'ไม่สามารถอัปเดตข้อมูลได้');
        }

        return result;
    }

