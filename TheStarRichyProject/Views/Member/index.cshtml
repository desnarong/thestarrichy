                    text: error?.message || "ยังไม่สามารถอัปเดตข้อมูลได้",
                    icon: "warning",
                    customClass: {
                        confirmButton: "btn btn-primary w-xs mt-2"
                    },
                    buttonsStyling: !1
                });
            }
        })
    })

    document.getElementById("btn-docupdate").addEventListener("click", async function () {
        Swal.fire({
            title: "ยืนยัน",
            text: "ยืนยันอัพเดทข้อมูล",
            icon: "warning",
            showCancelButton: !0,
            customClass: {
                confirmButton: "btn btn-primary w-xs me-2 mt-2",
                cancelButton: "btn btn-danger w-xs mt-2"
            },
            confirmButtonText: "ยืนยัน",
            buttonsStyling: !1,
            showCloseButton: !0
        }).then(async function (t) {
            if (!t.value) {
                return;
            }

            const hasFileToUpload = uploadState.profileImage || uploadState.copyIdCard || uploadState.copyBankBook || uploadState.applicationForm;
            if (!hasFileToUpload) {
                Swal.fire({
                    title: "ไม่มีไฟล์",
                    text: "กรุณาเลือกไฟล์ที่ต้องการอัปโหลดอย่างน้อย 1 รายการ",
                    icon: "warning",
                    customClass: {
                        confirmButton: "btn btn-primary w-xs mt-2"
                    },
                    buttonsStyling: !1
                });
                return;
            }

            try {
                const formData = new FormData();
                if (memberinfo?.membercode) {
                    formData.append('memberCode', memberinfo.membercode);
                }

                if (uploadState.profileImage) formData.append('profileImage', uploadState.profileImage);
                if (uploadState.copyIdCard) formData.append('copyIdCard', uploadState.copyIdCard);
                if (uploadState.copyBankBook) formData.append('copyBankBook', uploadState.copyBankBook);
                if (uploadState.applicationForm) formData.append('applicationForm', uploadState.applicationForm);

                const response = await fetch('/Member/UploadMemberDocuments', {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });

                const result = await response.json();
                if (!response.ok || !result?.success) {
                    throw new Error(result?.message || 'Upload failed');
                }

                if (result.urls?.profileImage) {
                    $('#user-profile-image').attr('src', result.urls.profileImage);
                }
                if (result.urls?.copyIdCard) {
                    $('#info-copyidcard').attr('src', result.urls.copyIdCard);
                    $('#info-flagsendidcard').prop('checked', true);
                }
                if (result.urls?.copyBankBook) {
                    $('#info-copybankaccountbook').attr('src', result.urls.copyBankBook);
                    $('#info-flagsendbookbank').prop('checked', true);
                }
                if (result.urls?.applicationForm) {
                    $('#info-applicationsubmitte').attr('src', result.urls.applicationForm);
                    $('#info-registerfrombranch').prop('checked', true);
                }

                await submitMemberProfileUpdate('document');

                uploadState.profileImage = null;
                uploadState.copyIdCard = null;
                uploadState.copyBankBook = null;
                uploadState.applicationForm = null;
                $('#profile-img-file-input').val('');
                $('#info-uploadcopyidcard').val('');
                $('#info-uploadcopybankaccountbook').val('');
                $('#info-uploadapplicationsubmitte').val('');

                Swal.fire({
                    title: "สำเร็จ",
                    text: "อัปโหลดเอกสารและบันทึกข้อมูลเรียบร้อยแล้ว",
                    icon: "success",
                    customClass: {
                        confirmButton: "btn btn-primary w-xs mt-2"
                    },
                    buttonsStyling: !1
                });
            } catch (error) {
                Swal.fire({
                    title: "เกิดข้อผิดพลาด",
                    text: error?.message || "ไม่สามารถอัปโหลดไฟล์ได้",
                    icon: "error",
                    customClass: {
                        confirmButton: "btn btn-primary w-xs mt-2"
                    },
                    buttonsStyling: !1
                });
            }
        })
    })

    // Load member info when page loads using jQuery
    $(document).ready(function () {
        bindUploadPreview();
        (async () => {
            await loadMasterAddresses();
            await loadCountries();
            await loadCountryBusinesses();
            await loadMemberInfo();
        })();
    });
</script>
@section scripts{
    <!-- App js -->
    <script src="~/assets/js/app.js"></script>
}