@{
    ViewData["Title"] = "แจงยอดสินค้า";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row mb-3">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
                <i class="bx bx-cart fs-4 text-white"></i>
                <h5 class="mb-0 text-white fw-semibold">แจงยอดสินค้า</h5>
            </div>
            <div class="card-body py-3">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card border-0 text-center py-2 px-3" style="background:#e3f2fd;border:2px solid #42a5f5 !important;">
                            <div class="text-muted small">รวมเงินทั้งหมด</div>
                            <div class="fs-4 fw-bold text-primary" id="sumAmount">0.00</div>
                            <div class="text-muted" style="font-size:.7rem;">บาท</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card border-0 text-center py-2 px-3" style="background:#e8f5e9;border:2px solid #66bb6a !important;">
                            <div class="text-muted small">รวม PV ทั้งหมด</div>
                            <div class="fs-4 fw-bold text-success" id="sumPV">0</div>
                            <div class="text-muted" style="font-size:.7rem;">PV</div>
                        </div>
                    </div>
                </div>

                <div class="row align-items-end g-2 mb-1">
                    <div class="col-auto">
                        <label class="form-label mb-1 small fw-semibold">รหัสสมาชิก</label>
                        <input type="text" class="form-control form-control-sm" id="memberCode" placeholder="ระบุรหัส สมาชิก" style="min-width:160px;">
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-1 small fw-semibold">ชื่อ สมาชิก</label>
                        <input type="text" class="form-control form-control-sm" id="memberName" placeholder="ระบุชื่อ สมาชิก" style="min-width:200px;" readonly>
                    </div>
                    <div class="col-auto align-self-end">
                        <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
                        <button class="btn btn-sm" id="btnSearch" style="background:#1565c0;border-color:#1565c0;color:#fff;"><i class="bx bx-search me-1"></i>ค้นหา</button>
                    </div>
                    <div class="col-auto ms-4">
                        <label class="form-label mb-1 small fw-semibold">เลขที่บิลแจง <small class="text-danger">(return ค่าเลขที่บิลมาจาก API ...)</small></label>
                        <input type="text" class="form-control form-control-sm" id="billNo" style="min-width:180px;" readonly>
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-1 small fw-semibold">วันที่แจง <small class="text-muted">default getdate() format dd/mm/yyyy</small></label>
                        <input type="text" class="form-control form-control-sm" id="billDate" style="min-width:130px;" disabled>
                    </div>
                </div>
                <div class="mb-1">
                    <div class="p-2 rounded" style="background:#fff9c4;border:1px solid #f9a825;font-size:.8rem;display:inline-block;">
                        <strong>API : FindMembercodeForSaleService</strong><br>
                        <span class="text-danger">บังคับใส่รหัสก่อน</span>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block"><i class="bx bx-info-circle me-1"></i>กรอกข้อมูลเพื่อค้นหา
                    <span style="color:red;text-decoration:underline;">หรือปล่อยว่างเพื่อดูข้อมูลทั้งหมด</span>
                </small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex align-items-center justify-content-between" style="background:#e3f2fd;border-bottom:2px solid #42a5f5;">
                <h5 class="mb-0 fw-semibold text-primary"><i class="bx bx-table me-2"></i>รายการสินค้า &nbsp;<span class="badge bg-primary" id="rowCount">0</span></h5>
                <span class="text-muted small">View : 000_Member_Order_for_mobile</span>
            </div>
            <div class="card-body">
                <div class="alert alert-secondary py-2 mb-2" id="msg">พบข้อมูล 0 รายการ</div>
                <div class="table-responsive">
                    <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.78rem;white-space:nowrap;">
                        <style>
                            table.table-hover tbody tr:hover {
                                background-color: #e0e0e0 !important;
                                transition: background-color 0.2s ease;
                            }
                        </style>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(function(){
    var mainTbl = null;

    // ตั้งค่าวันที่แจงเป็นวันปัจจุบัน (dd/mm/yyyy)
    (function(){
        var now = new Date();
        var dd = String(now.getDate()).padStart(2,'0');
        var mm = String(now.getMonth()+1).padStart(2,'0');
        var yyyy = now.getFullYear();
        $('#billDate').val(dd+'/'+mm+'/'+yyyy);
    })();

    function norm(raw) {
        var d = raw;
        if (typeof d === 'string') {
            try { d = JSON.parse(d); } catch (e) { return []; }
        }
        if (d && Array.isArray(d.data)) return d.data;
        if (d && Array.isArray(d.result)) return d.result;
        return Array.isArray(d) ? d : [];
    }

    function p(o, k, def) {
        def = def === undefined ? '' : def;
        for (var i = 0; i < k.length; i++) {
            if (o && o[k[i]] != null) return o[k[i]];
        }
        return def;
    }

    function num(v) {
        var n = parseFloat(v);
        return isNaN(n) ? 0 : n;
    }

    function fmt2(v) {
        return num(v).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function fmt0(v) {
        return Math.round(num(v)).toLocaleString('th-TH');
    }

    function fmtDate(v) {
        if (!v || typeof v === 'object') return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return String(v);
        var day = String(d.getDate()).padStart(2,'0');
        var month = String(d.getMonth()+1).padStart(2,'0');
        var year = d.getFullYear();
        return day+'/'+month+'/'+year;
    }

    function esc(s) {
        return s == null ? '' : String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    // ค้นหาชื่อสมาชิกจาก FindMembercodeForSaleService เมื่อกรอกรหัส
    $('#memberCode').on('blur', function(){
        var code = $(this).val().trim();
        if (!code) { $('#memberName').val(''); return; }
        $.ajax({
            url: '/buyorders/FindMemberForSale',
            type: 'GET',
            data: { membercode: code },
            success: function(res) {
                var rows = norm(res);
                if (rows.length > 0) {
                    var name = p(rows[0], ['Membername','membername','MemberName','Name','name'], '');
                    $('#memberName').val(name);
                } else {
                    $('#memberName').val('');
                }
            },
            error: function() { $('#memberName').val(''); }
        });
    });

    function loadData() {
        var membercode = $('#memberCode').val().trim();
        if (!membercode) {
            $('#msg').removeClass('alert-danger alert-success').addClass('alert-warning').text('กรุณาระบุรหัสสมาชิกก่อนค้นหา').show();
            return;
        }

        $('#msg').removeClass('alert-danger alert-success alert-warning').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();

        $.ajax({
            url: '/buyorders/GetSaleOrderFromHold',
            type: 'GET',
            data: { membercode: membercode },
            success: function(json) {
                var rows = norm(json);
                buildTable(rows);
            },
            error: function() {
                $('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');
            }
        });
    }

    function buildTable(rows) {
        if (mainTbl) { mainTbl.destroy(); mainTbl = null; }
        $('#mainTable').empty();

        var thead = '<thead class="text-center" style="background:#f5f5f5;font-size:.75rem;">' +
            '<tr>' +
            '<th class="text-center" style="width:40px;">#<br><small class="text-muted">No</small></th>' +
            '<th class="text-center">รหัสสินค้า<br><small class="text-danger">[ProductID]</small></th>' +
            '<th class="text-center">ชื่อสินค้า<br><small class="text-danger">[ProductName]</small></th>' +
            '<th class="text-end">ราคาขาย<br><small class="text-danger">[UnitPrice]</small></th>' +
            '<th class="text-center">จำนวน PV<br><small class="text-danger">[PV]</small></th>' +
            '<th class="text-center">จำนวน<br><small><u style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</u></small></th>' +
            '<th class="text-end">รวมเงิน<br><small><u style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</u></small></th>' +
            '<th class="text-center">รวม PV<br><small><u style="color:red;">&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;</u></small></th>' +
            '<th class="text-center">จำนวนคงเหลือ<br><small class="text-danger">Remain</small></th>' +
            '<th class="text-center">เลขที่บิล Hold<br><small class="text-danger">[Billno]</small></th>' +
            '<th class="text-center">วันหมดอายุบิล<br><small class="text-danger">[ExpireDate]</small></th>' +
            '<th class="text-center">รหัสชุดสินค้า<br><small class="text-danger">[ProductSet]</small></th>' +
            '</tr></thead>';

        var tbody = '<tbody>';
        var totalAmount = 0;
        var totalPV = 0;

        rows.forEach(function(r, i) {
            var productCode = p(r, ['ProductID','productID'], '');
            var productName = p(r, ['ProductName','productName'], '');
            var price       = num(p(r, ['UnitPrice','unitPrice'], 0));
            var pv          = num(p(r, ['PV','pv'], 0));
            var remain      = num(p(r, ['Remain','remain'], 0));
            var billNo      = p(r, ['BillNo','billNo','Billno'], '-');
            var expireDate  = fmtDate(p(r, ['ExpireDate','expireDate'], ''));
            var productSet  = p(r, ['ProductSet','productSet'], '');

            // จำนวน = remain, รวมเงิน และ รวม PV คำนวณจาก remain
            var amount     = price * remain;
            var pvTotal    = pv * remain;

            totalAmount += amount;
            totalPV += pvTotal;

            tbody += '<tr>' +
                '<td class="text-center">' + (i+1) + '</td>' +
                '<td class="text-center">' + esc(productCode) + '</td>' +
                '<td>' + esc(productName) + '</td>' +
                '<td class="text-end">' + fmt2(price) + '</td>' +
                '<td class="text-center">' + fmt0(pv) + '</td>' +
                '<td class="text-center">' + fmt0(remain) + '</td>' +
                '<td class="text-end fw-bold text-primary">' + fmt2(amount) + '</td>' +
                '<td class="text-center fw-bold text-success">' + fmt0(pvTotal) + '</td>' +
                '<td class="text-center">' + fmt0(remain) + '</td>' +
                '<td class="text-center">' + esc(billNo) + '</td>' +
                '<td class="text-center">' + expireDate + '</td>' +
                '<td class="text-center">' + esc(productSet) + '</td>' +
                '</tr>';
        });

        tbody += '</tbody>';

        var tfoot = '<tfoot>' +
            '<tr class="table-primary fw-bold">' +
            '<td colspan="6" class="text-end bg-primary text-white">รวมทั้งหมด</td>' +
            '<td class="text-end bg-primary text-white">' + fmt2(totalAmount) + ' บาท</td>' +
            '<td class="text-center bg-primary text-white">' + fmt0(totalPV) + ' PV</td>' +
            '<td colspan="4"></td>' +
            '</tr></tfoot>';

        $('#mainTable').html(thead + tbody + tfoot);

        mainTbl = $('#mainTable').DataTable({
            paging: true,
            pageLength: 25,
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'ทั้งหมด']],
            ordering: true,
            searching: false,
            info: true,
            language: {
                emptyTable: 'ไม่พบข้อมูล',
                zeroRecords: 'ไม่พบข้อมูล',
                lengthMenu: 'แสดง _MENU_ รายการ',
                info: '_START_-_END_ จาก _TOTAL_',
                paginate: { first: '«', last: '»', next: '›', previous: '‹' }
            },
            drawCallback: function() {
                $('#mainTable thead th').addClass('text-center');
            }
        });

        $('#sumAmount').text(fmt2(totalAmount));
        $('#sumPV').text(fmt0(totalPV));
        $('#rowCount').text(rows.length);

        if (rows.length > 0) {
            $('#msg').removeClass('alert-secondary alert-warning').addClass('alert-success').text('พบข้อมูล ' + rows.length + ' รายการ');
        } else {
            $('#msg').removeClass('alert-secondary alert-warning').addClass('alert-secondary').text('พบข้อมูล 0 รายการ');
        }
    }

    $('#btnSearch').on('click', loadData);

    $('#btnReset').on('click', function() {
        $('input[name="purchase_type"][value="topup"]').prop('checked', true);
        $('#memberCode').val('');
        $('#memberName').val('');
        $('#billNo').val('');
        if (mainTbl) { mainTbl.destroy(); mainTbl = null; }
        $('#mainTable').empty();
        $('#rowCount').text(0);
        $('#sumAmount').text('0.00');
        $('#sumPV').text('0');
        $('#msg').removeClass('alert-danger alert-success alert-warning').addClass('alert-secondary').text('พบข้อมูล 0 รายการ').show();
    });

    $('#memberCode, #memberName').on('keypress', function(e) {
        if (e.which === 13) loadData();
    });
});
</script>


<div class="row mb-3">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex align-items-center gap-2" style="background:linear-gradient(135deg,#1565c0,#42a5f5);">
                <i class="bx bx-cart fs-4 text-white"></i>
                <h5 class="mb-0 text-white fw-semibold">สั่งซื้อจากใบสั่งถือครอง</h5>
            </div>
            <div class="card-body py-3">
                <div class="row g-3 mb-3">
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card border-0 text-center py-2 px-3" style="background:#e3f2fd;border:2px solid #42a5f5 !important;">
                            <div class="text-muted small">รวมเงินทั้งหมด</div>
                            <div class="fs-4 fw-bold text-primary" id="sumAmount">-</div>
                            <div class="text-muted" style="font-size:.7rem;">บาท</div>
                        </div>
                    </div>
                    <div class="col-sm-6 col-md-4 col-lg-3">
                        <div class="card border-0 text-center py-2 px-3" style="background:#e8f5e9;border:2px solid #66bb6a !important;">
                            <div class="text-muted small">รวม PV ทั้งหมด</div>
                            <div class="fs-4 fw-bold text-success" id="sumPV">-</div>
                            <div class="text-muted" style="font-size:.7rem;">PV</div>
                        </div>
                    </div>
                </div>
                
                <div class="row align-items-end g-2 mb-2">
                    <div class="col-auto">
                        <label class="form-label mb-1 small fw-semibold">ประเภทการซื้อ</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="purchase_type" id="topup_maintenance" value="topup" checked>
                                <label class="form-check-label" for="topup_maintenance">เติมเงิน/รักษายอด</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="purchase_type" id="hurry_active" value="hurry">
                                <label class="form-check-label" for="hurry_active">Hurry Active</label>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="row align-items-end g-2">
                    <div class="col-auto">
                        <label class="form-label mb-1 small fw-semibold">รหัสสินค้า</label>
                        <input type="text" class="form-control form-control-sm" id="productCode" placeholder="ระบุรหัสสินค้า" style="min-width:150px;">
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-1 small fw-semibold">ชื่อสินค้า</label>
                        <input type="text" class="form-control form-control-sm" id="productName" placeholder="ระบุชื่อสินค้า" style="min-width:200px;">
                    </div>
                    <div class="col-auto">
                        <label class="form-label mb-1 small fw-semibold">จำนวน</label>
                        <input type="number" class="form-control form-control-sm" id="quantity" placeholder="จำนวน" style="min-width:100px;">
                    </div>
                    <div class="col-auto align-self-end">
                        <button class="btn btn-sm btn-secondary me-1" id="btnReset"><i class="bx bx-reset me-1"></i>รีเซ็ต</button>
                        <button class="btn btn-sm" id="btnSearch" style="background:#1565c0;border-color:#1565c0;color:#fff;"><i class="bx bx-search me-1"></i>ค้นหา</button>
                    </div>
                </div>
                <small class="text-muted mt-1 d-block"><i class="bx bx-info-circle me-1"></i>กรอกข้อมูลเพื่อค้นหา หรือปล่อยว่างเพื่อดูข้อมูลทั้งหมด</small>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-header d-flex align-items-center justify-content-between" style="background:#e3f2fd;border-bottom:2px solid #42a5f5;">
                <h5 class="mb-0 fw-semibold text-primary"><i class="bx bx-table me-2"></i>รายการสินค้า &nbsp;<span class="badge bg-primary" id="rowCount">0</span></h5>
            </div>
            <div class="card-body">
                <div class="alert alert-secondary py-2 mb-2" id="msg">กำลังโหลดข้อมูล...</div>
                <div class="table-responsive">
                    <table id="mainTable" class="table table-bordered table-sm table-hover align-middle" style="font-size:.78rem;white-space:nowrap;">
                        <style>
                            table.table-hover tbody tr:hover {
                                background-color: #e0e0e0 !important;
                                transition: background-color 0.2s ease;
                            }
                        </style>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
$(function(){
    var mainTbl = null;
    
    function norm(raw) {
        var d = raw;
        if (typeof d === 'string') {
            try { d = JSON.parse(d); } catch (e) { return []; }
        }
        if (d && Array.isArray(d.data)) return d.data;
        if (d && Array.isArray(d.result)) return d.result;
        return Array.isArray(d) ? d : [];
    }
    
    function p(o, k, d) {
        d = d === undefined ? '' : d;
        for (var i = 0; i < k.length; i++) {
            if (o && o[k[i]] != null) return o[k[i]];
        }
        return d;
    }
    
    function num(v) {
        var n = parseFloat(v);
        return isNaN(n) ? 0 : n;
    }
    
    function fmt2(v) {
        return num(v).toLocaleString('th-TH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }
    
    function fmt0(v) {
        return Math.round(num(v)).toLocaleString('th-TH');
    }
    
    function fmtDate(v) {
        if (!v || typeof v === 'object') return '-';
        var d = new Date(v);
        if (isNaN(d.getTime())) return String(v);
        var day = String(d.getDate()).padStart(2, '0');
        var month = String(d.getMonth() + 1).padStart(2, '0');
        var year = d.getFullYear();
        return day + '/' + month + '/' + year;
    }
    
    function esc(s) {
        return s == null ? '' : String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }
    
    function loadData() {
        $('#msg').removeClass('alert-danger alert-success').addClass('alert-secondary').text('กำลังโหลดข้อมูล...').show();
        
        var purchaseType = $('input[name="purchase_type"]:checked').val() || 'topup';
        var prodCode = $('#productCode').val() || '';
        var prodName = $('#productName').val() || '';
        var qty = $('#quantity').val() || '';
        
        // เรียกผ่าน Controller ของตัวเอง (ถูกต้องตาม flow)
        $.ajax({
            url: '/buyorders/GetSaleOrderFromHold',
            type: 'GET',
            data: {
                purchaseType: purchaseType,
                productCode: prodCode,
                productName: prodName,
                quantity: qty
            },
            success: function(json) {
                var rows = norm(json);
                
                // กรองผลลัพธ์ตามชื่อสินค้าและจำนวน (ถ้ามี) - client-side filtering
                if (prodName || qty) {
                    rows = rows.filter(function(r) {
                        var name = (r.ProductThaiName || r.ProductName || '').toLowerCase();
                        var stock = parseFloat(r.Totalproduct || r.Stock || r.Remain || 0);
                        
                        var matchName = !prodName || name.includes(prodName.toLowerCase());
                        var matchQty = !qty || stock >= parseFloat(qty);
                        
                        return matchName && matchQty;
                    });
                }
                
                buildTable(rows);
            },
            error: function() {
                $('#msg').removeClass('alert-secondary').addClass('alert-danger').text('เกิดข้อผิดพลาดในการดึงข้อมูล');
            }
        });
    }
    
    function buildTable(rows) {
        if (mainTbl) { mainTbl.destroy(); mainTbl = null; }
        $('#mainTable').empty();
        
        var thead = '<thead class="text-center" style="background:#f5f5f5;font-size:.75rem;">' +
            '<tr>' +
            '<th class="text-center" style="width:40px;">#</th>' +
            '<th class="text-center">รหัสสินค้า</th>' +
            '<th class="text-center">ชื่อสินค้า</th>' +
            '<th class="text-end">ราคาขาย</th>' +
            '<th class="text-center">จำนวน PV</th>' +
            '<th class="text-center">จำนวน</th>' +
            '<th class="text-end">รวมเงิน</th>' +
            '<th class="text-center">รวม PV</th>' +
            '<th class="text-center">จำนวนคงเหลือ</th>' +
            '<th class="text-center">เลขที่บิล Hold</th>' +
            '<th class="text-center">วันหมดอายุบิล</th>' +
            '<th class="text-center">รหัสชุดสินค้า</th>' +
            '</tr></thead>';
        
        var tbody = '<tbody>';
        var totalAmount = 0;
        var totalPV = 0;
        
        rows.forEach(function(r, i) {
            // ดึงข้อมูลจาก response ของ API
            var productCode = p(r, ['ProductID', 'productID', 'ProductCode', 'productCode'], '');
            var productName = p(r, ['ProductThaiName', 'productThaiName', 'ProductName', 'productName'], '');
            var price = num(p(r, ['MemberPrice', 'memberPrice', 'Price', 'price'], 0));
            var pv = num(p(r, ['PV', 'pv'], 0));
            var quantity = num(p(r, ['Totalproduct', 'totalproduct', 'Stock', 'stock', 'Remain', 'remain'], 0));
            var amount = price * quantity;
            var totalPVItem = pv * quantity;
            
            totalAmount += amount;
            totalPV += totalPVItem;
            
            tbody += '<tr>' +
                '<td class="text-center">' + (i + 1) + '</td>' +
                '<td class="text-center">' + esc(productCode) + '</td>' +
                '<td>' + esc(productName) + '</td>' +
                '<td class="text-end">' + fmt2(price) + '</td>' +
                '<td class="text-center">' + fmt0(pv) + '</td>' +
                '<td class="text-center">' + fmt0(quantity) + '</td>' +
                '<td class="text-end fw-bold text-primary">' + fmt2(amount) + '</td>' +
                '<td class="text-center fw-bold text-success">' + fmt0(totalPVItem) + '</td>' +
                '<td class="text-center">' + fmt0(quantity) + '</td>' +
                '<td class="text-center">-</td>' +  // เลขที่บิล Hold (ยังไม่มีใน API นี้)
                '<td class="text-center">-</td>' +  // วันหมดอายุบิล (ยังไม่มีใน API นี้)
                '<td class="text-center">' + esc(p(r, ['ProductGroupcode', 'productGroupCode', 'GroupCode', 'groupCode'], '')) + '</td>' +
                '</tr>';
        });
        
        tbody += '</tbody>';
        
        var tfoot = '<tfoot>' +
            '<tr class="table-primary fw-bold">' +
            '<td colspan="6" class="text-end bg-primary text-white">รวมทั้งหมด</td>' +
            '<td class="text-end bg-primary text-white">' + fmt2(totalAmount) + ' บาท</td>' +
            '<td class="text-center bg-primary text-white">' + fmt0(totalPV) + ' PV</td>' +
            '<td colspan="4"></td>' +
            '</tr></tfoot>';
        
        $('#mainTable').html(thead + tbody + tfoot);
        
        mainTbl = $('#mainTable').DataTable({
            paging: true,
            pageLength: 25,
            lengthMenu: [[10, 25, 50, -1], [10, 25, 50, 'ทั้งหมด']],
            ordering: true,
            searching: false,
            info: true,
            language: {
                emptyTable: 'ไม่พบข้อมูล',
                zeroRecords: 'ไม่พบข้อมูล',
                lengthMenu: 'แสดง _MENU_ รายการ',
                info: '_START_-_END_ จาก _TOTAL_',
                paginate: { first: '«', last: '»', next: '›', previous: '‹' }
            },
            drawCallback: function() {
                $('#mainTable thead th').addClass('text-center');
            }
        });
        
        $('#sumAmount').text(fmt2(totalAmount));
        $('#sumPV').text(fmt0(totalPV));
        $('#rowCount').text(rows.length);
        $('#msg').removeClass('alert-secondary').addClass('alert-success').text('พบข้อมูล ' + rows.length + ' รายการ');
    }
    
    $('#btnSearch').on('click', loadData);
    
    $('#btnReset').on('click', function() {
        $('input[name="purchase_type"][value="topup"]').prop('checked', true);
        $('#productCode').val('');
        $('#productName').val('');
        $('#quantity').val('');
        loadData();
    });
    
    // Change purchase type radio - auto search
    $('input[name="purchase_type"]').on('change', function() {
        loadData();
    });
    
    // Enter key to search
    $('#productCode, #productName, #quantity').on('keypress', function(e) {
        if (e.which === 13) {
            loadData();
        }
    });
    
    loadData();
});
</script>

